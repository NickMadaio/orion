#!/usr/bin/env node
/*
 orion-proactive — ORION speaking first, with context (2026-10-07).

   orion-proactive tick [--dry-run]    run by the ORION app every ~5 minutes
   orion-proactive status              what it has said today

 Gathers where Nick is (orion-presence), his focus session, today's day, his
 sleep plan and focus time, decides what is worth saying (lib/reach/proactive.mjs:
 no bedtime nagging during a session or while he's out; a session's end says
 how it went and what's next), and sends it through orion-reach (phone when
 he's away, the Mac when he's here). Each message at most once a day.
*/
import { readFileSync, writeFileSync, renameSync, mkdirSync, existsSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import { execFileSync, spawnSync } from "node:child_process";
import { decide } from "./lib/reach/proactive.mjs";
import { deliveryOutcome } from "./lib/reach/delivery.mjs";
import { presence } from "./lib/reach/presence.mjs";
import { liveDay, localDate } from "./lib/life/live-day.mjs";
import { focusToday, formatFocusToday } from "./lib/focus/day-total.mjs";
import { sandbox, bridgeRequest } from "./lib/life/bridge-path.mjs";
import { loadConfig } from "./lib/life/config.mjs";
import { commuteWalls } from "./lib/life/commute.mjs";
import { waitsFor } from "./lib/life/task-spread.mjs";

const DIR = process.env.ORION_CONTROLLED_DIR || join(homedir(), ".openclaw/orion-controlled");
const STATE = join(DIR, "proactive-sent.json");
const here = import.meta.dirname;
const [command] = process.argv.slice(2).filter((a) => !a.startsWith("--"));
const dry = process.argv.includes("--dry-run");
const now = new Date();
// A night belongs to the evening it started: until 6 AM it is still "yesterday".
const dayKey = new Date(now.getTime() - 6 * 3600000).toLocaleDateString("en-CA");
const readJson = (p) => { try { return JSON.parse(readFileSync(p, "utf8")); } catch { return null; } };
const state = readJson(STATE) ?? {};
const sent = state[dayKey] ?? {};
// Failed sends, kept so a retry is visible (and orion-doctor can show it).
const FAILED = join(DIR, "proactive-failed.json");
const failures = (readJson(FAILED) ?? {})[dayKey] ?? {};

if (command === "status") {
  console.log(Object.keys(sent).length ? `Said today: ${Object.keys(sent).join(", ")}` : "Nothing said today.");
  process.exit(0);
}
if (command !== "tick") { console.error("usage: orion-proactive tick [--dry-run] | status"); process.exit(2); }
if (sandbox()) process.exit(0);

const run = (script, args) => { try { return execFileSync(process.execPath, [join(here, script), ...args], { encoding: "utf8", timeout: 15000 }); } catch { return ""; } };
const minute = now.getHours() * 60 + now.getMinutes();
const p = await presence(now);
let session = null;
try { session = JSON.parse(run("orion-session", ["status", "--json"])); } catch {}
const history = (() => { const f = join(DIR, "focus-history.jsonl"); return existsSync(f) ? readFileSync(f, "utf8").trim().split("\n").flatMap((l) => { try { return [JSON.parse(l)]; } catch { return []; } }) : []; })();
const last = history.at(-1);
if ((!session || !["running", "paused"].includes(session.status)) && last?.endedAt && now - Date.parse(last.endedAt) < 15 * 60000) {
  const ended = new Date(last.endedAt);
  session = { status: "finished", sessionId: last.sessionID, endedMinute: ended.getHours() * 60 + ended.getMinutes() };
}
let sleep = {};
try { sleep = JSON.parse(run("orion-now", ["--json"])).sleep ?? {}; } catch {}
let day = [];
try { day = await liveDay(localDate(now)); } catch {}
const total = focusToday(history, { dayKey: localDate(now) });
const config = loadConfig();
const travel = (() => { try { return commuteWalls(day, config); } catch { return []; } })();
const same = (a, b) => String(a).toLowerCase().includes(String(b).toLowerCase()) || String(b).toLowerCase().includes(String(a).toLowerCase());
let todos = [];
try {
  const raw = JSON.parse((await bridgeRequest("list_incomplete_reminders", { list: config.todoList })).reminders_json ?? "[]");
  const titles = raw.map((t) => t.title);
  todos = raw.map((t) => ({ title: t.title, dueDate: t.due ? localDate(new Date(t.due)) : null,
    booked: day.some((b) => same(b.title, t.title)), waiting: !!waitsFor(t.notes, titles.filter((x) => x !== t.title)) }));
} catch {}
const tomorrow = localDate(new Date(now.getTime() + 86400000));

const messages = decide({ minute, day, session, travel, todos, today: localDate(now), tomorrow, out: p.out, where: p.where, idleSeconds: p.idleSeconds,
  bed: sleep.bedtime, wake: sleep.wake, focusToday: total.focusSeconds >= 60 ? formatFocusToday(total).replace(/^Focused today: /, "").replace(/ \(latest.*$/, "") : null, sent });

for (const m of messages) {
  if (dry) { console.log(`DRY RUN would say (${m.key}): ${m.text}`); continue; }
  const r = spawnSync(process.execPath, [join(here, "orion-reach"), m.text, "--kind", m.kind, "--why", `proactive: ${m.key}`,
    ...(m.urgent ? ["--urgent"] : []), ...(m.urgentKind ? ["--urgent-kind", m.urgentKind] : []), ...(m.expires ? ["--no-queue"] : [])], { encoding: "utf8", timeout: 30000 });
  // 2026-10-16 audit, finding 6: a key is "said" only when orion-reach really sent, held or already said it.
  // A refusal (exit 3) or a failed delivery (exit 4) stays unsaid so the next tick retries, and a failure is recorded.
  const outcome = deliveryOutcome({ status: r.status, stdout: r.stdout });
  if (outcome.said) sent[m.key] = true;
  else if (outcome.failed) failures[m.key] = { at: now.toISOString(), attempts: (failures[m.key]?.attempts ?? 0) + 1 };
  process.stdout.write(r.stdout ?? "");
}
if (!dry && Object.keys(failures).length) { try { writeFileSync(`${FAILED}.tmp`, JSON.stringify({ [dayKey]: failures }, null, 2)); renameSync(`${FAILED}.tmp`, FAILED); } catch {} }
if (!dry && messages.length) {
  mkdirSync(DIR, { recursive: true });
  const keep = Object.fromEntries(Object.entries({ ...state, [dayKey]: sent }).sort().slice(-7));
  writeFileSync(`${STATE}.tmp`, JSON.stringify(keep, null, 2)); renameSync(`${STATE}.tmp`, STATE);
}
if (!messages.length) console.log(`Nothing to say (${p.where}${session?.status === "running" ? ", in a focus session" : ""}).`);
