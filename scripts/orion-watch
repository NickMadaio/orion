#!/usr/bin/env node
// orion-watch — ORION noticing the day without being asked (2026-09-29).
//   orion-watch tick [--json]    run by the ORION app every ~5 minutes
//   orion-watch status           what it has asked / done today
//   --at HH:MM --dry-run         (testing) pretend it is that time; change nothing, send nothing
//
// 1. An empty day. Once he's up, if the rest of today has three or more hours
//    with nothing planned, ORION asks what the plan is — in the morning, and
//    again right after his last class if it's still empty. (Nick: "he should
//    probe and ask. and once he has my solidified plans he fills in the blanks.")
// 2. A short night. The morning after less than six hours (WHOOP, or a late
//    "Going to bed"), early heavy work moves later and a nap goes in after the
//    first class past noon — done, then told, with undo. He'll be too tired to
//    be asked.
// Alerts are printed (JSON with --json) and appended to the phone link's outbox.
import { readFileSync, writeFileSync, renameSync, mkdirSync, appendFileSync } from "node:fs";
import { join, dirname } from "node:path";
import { homedir } from "node:os";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";
import { calendarEvents, toBlocks, localDate } from "./lib/life/live-day.mjs";
import { freeGaps } from "./lib/life/gaps.mjs";
import { adjustForShortSleep, tomorrowProposal, awakeLateFlag, goToBedMessage } from "./lib/life/after-late-night.mjs";
import { recoveryFromLog } from "./lib/life/recovery.mjs";
import { sensorHealth, macExpected, macFacet, phoneFacet } from "./lib/awareness/facets.mjs";
import { sensorNotices, noticeLine } from "./lib/life/stale-sensors.mjs";
import { sleepPlanFor, readNowRecord } from "./lib/life/now-state.mjs";
import { readSlips } from "./lib/life/slips.mjs";
import { loadConfig, toMinute } from "./lib/life/config.mjs";
import { applyPlan, bridge } from "./lib/life/calendar-write.mjs";
import { morningBrief } from "./lib/life/morning-brief.mjs";
import { commuteBlocks } from "./lib/life/commute.mjs";
import { sweep } from "./lib/life/todo-lists.mjs";
import { nightMarkers, readWakeRequest, actualWake, actualSleep } from "./lib/life/night.mjs";
import { summarize } from "./lib/life/history.mjs";

import { evalMode } from "./lib/eval-mode.mjs";
import { classReminders } from "./lib/life/class-reminders.mjs";
import { classAttendance, phoneMinutes } from "./lib/life/attendance.mjs";
import { announced, markAnnounced } from "./lib/reach/announce.mjs";
import { appendHeld } from "./lib/reach/held.mjs";
import { gate, resolveAwareness } from "./lib/reach/gate.mjs";
import { logCheckinAlerts } from "./lib/reach/log-outreach.mjs";
import { controlledDir, clockNow, isolated, toOutbox } from "./lib/clock.mjs";
// A watcher invoked by an evaluation must not mutate live state or queue alerts.
if (evalMode()) { console.log(process.argv.includes("--json") ? "[]" : "Watcher paused during evaluation."); process.exit(0); }
const CONTROLLED = controlledDir();
const STATE = process.env.ORION_WATCH_FILE || join(CONTROLLED, "watch.json");
const OUTBOX = join(CONTROLLED, "alerts-outbox.jsonl");
const read = (f, fallback) => { try { return JSON.parse(readFileSync(f, "utf8")); } catch { return fallback; } };
// These messages go straight to Nick's phone: 12-hour, the way he says it (2026-09-29).
const hhmm = (m) => { const h = Math.floor((m % 1440) / 60), mm = String(m % 60).padStart(2, "0"); return `${h % 12 || 12}:${mm} ${h < 12 ? "AM" : "PM"}`; };
const argAt = (() => { const i = process.argv.indexOf("--at"); return i > 0 ? process.argv[i + 1] : null; })();
const dry = process.argv.includes("--dry-run");
const now = clockNow();   // ORION_NOW (lib/clock.mjs); --at still pins the hour on top
if (argAt && /^\d{1,2}:\d{2}$/.test(argAt)) { const [h, m] = argAt.split(":").map(Number); now.setHours(h, m, 0, 0); }
const minute = now.getHours() * 60 + now.getMinutes();
const today = localDate(new Date(now.getTime() - 4 * 3600000));   // the day turns at 4 AM
const config = loadConfig();
const state = read(STATE, {});
const day = state[today] ?? { asked: [], adjusted: false };
const save = () => {
  mkdirSync(dirname(STATE), { recursive: true });
  const keep = Object.fromEntries(Object.entries({ ...state, [today]: day }).sort().slice(-7));
  writeFileSync(`${STATE}.tmp`, JSON.stringify(keep, null, 2)); renameSync(`${STATE}.tmp`, STATE);
};
if (process.argv[2] === "status") { console.log(JSON.stringify(day, null, 2)); process.exit(0); }

const log = read(process.env.ORION_HEALTH_LOG || join(CONTROLLED, "health-log.json"), {});
const record = (log.days ?? {})[today] ?? {};
const upToday = (log.sleepLog ?? []).some((e) => e.event === "up" && localDate(new Date(e.at)) === today)
  || (log.phoneSignals ?? []).some((s) => localDate(new Date(s.at)) === today && new Date(s.at).getHours() >= 5);
const awake = upToday || record.recovery != null || minute >= toMinute(config.usualWake);
const alerts = [];
// One to-do list: whatever Siri or the phone put on the default list moves onto
// his to-do list (todo-lists, 2026-09-30). Quiet; a failure never stops the tick.
if (!dry) { try { day.swept = (day.swept ?? 0) + (await sweep(bridge, config)).length; } catch { /* reminders unreadable: try next tick */ } }
let blocks = []; let events = null;
try { events = await calendarEvents(); blocks = toBlocks(events, localDate(now)); day.calendar = "ok"; }
catch (error) { day.calendar = `unreadable: ${String(error?.message ?? error).slice(0, 100)}`; /* ask nothing blind */ }
// Wake and asleep-by for today and tomorrow (night.mjs, the phone alarm's rule):
// the Mac draws them on its day view, and today's asleep line ends the day here.
const wakeRequest = await readWakeRequest();
// What actually happened beats the plan once it is known (2026-10-01: "have the
// wake up line move to when I actually wake up"): WHOOP via the ORION app, else the phone.
const evidence = { nights: read(join(CONTROLLED, "sleep-actual.json"), {}).nights ?? [], sleepLog: log.sleepLog ?? [], phoneSignals: log.phoneSignals ?? [], now };
const withActual = (entry) => {
  if (!entry) return entry;
  const woke = actualWake(entry.date, evidence);
  const slept = actualSleep(entry.date, evidence);
  return { ...entry, plannedWake: entry.plannedWake ?? entry.wake,
    ...(woke ? { wake: woke.minute, woke: true, wakeSource: woke.source } : {}),
    ...(slept ? { asleepAt: slept.minute, asleepSource: slept.source } : {}) };
};
const nightOf = (date) => events ? withActual(nightMarkers(date, { blocksOf: (d) => toBlocks(events, d), config, wakeRequest })) : null;
const tonight = nightOf(localDate(now));
const bed = tonight ? Math.min(1440, tonight.bed) : toMinute(config.bedtime) <= 360 ? 1440 : toMinute(config.bedtime);
if (!dry && events) {
  const tomorrowDate = localDate(new Date(now.getTime() + 86400000));
  // Yesterday is kept as it was worked out while it was today: the calendar feed
  // starts at now, so after midnight its classes are gone and a recomputed wake
  // line would fall back to the free-day time (9:00 on a 9:00-seminar day).
  const yesterday = localDate(new Date(now.getTime() - 86400000));
  const yesterdayKept = withActual((read(join(CONTROLLED, "night.json"), {}).days ?? []).find((d) => d?.date === yesterday) ?? null);
  try {
    mkdirSync(CONTROLLED, { recursive: true });
    writeFileSync(join(CONTROLLED, "night.json.tmp"), JSON.stringify({ updatedAt: now.toISOString(), days: [yesterdayKept, tonight, nightOf(tomorrowDate)].filter(Boolean) }, null, 2));
    renameSync(join(CONTROLLED, "night.json.tmp"), join(CONTROLLED, "night.json"));
  } catch { /* markers are a nicety; the tick goes on */ }
}
const freeLeft = () => freeGaps(blocks, { start: Math.max(minute, toMinute(config.usualWake)), end: bed }, { minimum: 30 })
  .reduce((a, g) => a + g.end - g.start, 0);
const fixed = blocks.filter((b) => b.fixed);
const classes = fixed.filter((b) => b.kind === "class");
// 2026-10-16 audit, finding 11: one key per class. If orion-proactive's leave nudge (or anything else) already
// announced this class today, this reminder stays quiet instead of being a second and third announcement.
const classAlerts = classReminders(blocks, {now: minute, sent: day.classReminded ?? []})
  .filter((a) => { const b = blocks.find((x) => x.id === a.id); return !b || !announced(CONTROLLED, localDate(now), `class-${b.start}`); });
if (!dry) for (const a of classAlerts) { const b = blocks.find((x) => x.id === a.id); if (b) markAnnounced(CONTROLLED, localDate(now), `class-${b.start}`, "watch"); }
for (const alert of classAlerts) alerts.push({id: `class-${alert.id}`, level: 0, text: alert.text});
day.classReminded = [...(day.classReminded ?? []), ...classAlerts.map(a => a.id)];
const lastClass = classes.at(-1);
const short_ = (t) => t.replace(/ — .*$/, "").replace(/^[A-Z]{2,4}\d{3,4}\s+/, "");
const plans = (list) => list.map((b) => `${short_(b.title)} at ${hhmm(b.start)}`).join(", ");

// 1b. Awake past the sleep plan (2026-10-30: the 10-25 all-nighter, a 9:00 class, and nothing said). Past bedtime with the
// Mac or the phone in use is flagged here; the plan for the coming day is a PROPOSAL (class and alarm stay, a nap after
// class, heavy study later and shorter, the gym full length as an easier session) that the morning brief states. The go-to-bed words are written to
// awake-late.json for the bedtime guard, which owns whether and when a message goes.
const readJson = (f) => read(join(CONTROLLED, f), null);
const bedPlan = (() => {
  if (minute < 360) {
    const kept = (readJson("night.json")?.days ?? []).find((d) => d?.date === localDate(new Date(now.getTime() - 86400000)));
    return (kept?.bed ?? toMinute(config.bedtime)) % 1440;
  }
  const planned = readNowRecord(CONTROLLED)?.sleepPlan?.bedtime;
  return (planned ? toMinute(planned) : bed) % 1440;
})();
const macNow = macFacet(readJson("focus-activity.json"), null, now);
const phoneNow = phoneFacet(log, now);
const lateFlag = awakeLateFlag({ minute, bedMinute: bedPlan, macActive: macNow.state === "active", phoneInUse: phoneNow.state === "in-use" });
if (lateFlag.awake && events) {
  const targetDate = minute < 360 ? localDate(now) : localDate(new Date(now.getTime() + 86400000));
  const coming = toBlocks(events, targetDate);
  const wakeMin = toMinute(sleepPlanFor({ minute, tomorrow: coming }).wake);
  const sleptMinutes = Math.max(0, (wakeMin - minute + 1440) % 1440);
  const recovery = recoveryFromLog(log, today, { sleptHours: sleptMinutes / 60 });
  const proposal = tomorrowProposal([...coming, ...commuteBlocks(coming, config)], { sleptMinutes, wake: wakeMin, window: { start: wakeMin, end: 1380 }, recovery, minimums: config.minimums });
  const firstClass = coming.filter((b) => b.fixed && b.kind === "class").sort((a, b) => a.start - b.start)[0] ?? null;
  const flagged = { since: day.awakeLate?.since ?? new Date(now.getTime() - lateFlag.minutesPastBed * 60000).toISOString(), at: now.toISOString(), minutes: lateFlag.minutesPastBed,
    evidence: lateFlag.evidence, night: today, targetDate, sleptMinutes,
    message: goToBedMessage({ minute, firstClass: firstClass && { title: firstClass.title.replace(/ — .*$/, ""), start: firstClass.start }, wake: wakeMin, lightened: false, proposed: proposal.changes.length > 0 }),
    proposal: { text: proposal.text, changes: proposal.changes, protect: proposal.protect } };
  day.awakeLate = flagged;
  if (!dry) { mkdirSync(CONTROLLED, { recursive: true }); writeFileSync(join(CONTROLLED, "awake-late.json.tmp"), JSON.stringify(flagged, null, 2)); renameSync(join(CONTROLLED, "awake-late.json.tmp"), join(CONTROLLED, "awake-late.json")); }
}
// The proposal waiting for today (made in the night, or one earlier tick): not stated if WHOOP says he slept after all.
const proposalToday = [...Object.values(state), day].map((d) => d?.awakeLate).filter((a) => a?.targetDate === localDate(now)).at(-1) ?? null;
const proposalLive = proposalToday && !(typeof record.sleepHours === "number" && record.sleepHours >= 6.5 && !lateFlag.awake) ? proposalToday : null;

// 2. A short night: reshape the morning, once, as soon as he is up.
const slept = typeof record.sleepHours === "number" ? record.sleepHours * 60 : null;
const lateBed = (log.sleepLog ?? []).filter((e) => e.event === "bed").map((e) => new Date(e.at))
  .filter((d) => now - d < 16 * 3600000 && (d.getHours() >= 2 && d.getHours() < 8)).at(-1);
const short = (slept !== null && slept < 360) || lateBed;
// An all-nighter ORION already made a proposal for is stated in the brief, not rewritten on the calendar behind his back.
if (awake && short && !day.adjusted && minute < 780 && blocks.length && !proposalLive) {
  const sleptMinutes = slept ?? Math.max(0, Math.round((toMinute(config.usualWake) + 1440 - (lateBed.getHours() * 60 + lateBed.getMinutes())) % 1440));
  // The commute home after class is not nap time: gaps are found around it, and
  // the pseudo-blocks never reach the calendar.
  const withCommute = [...blocks, ...commuteBlocks(blocks, config)];
  const reshaped = adjustForShortSleep(withCommute, { sleptMinutes, wake: minute, window: { start: minute, end: bed }, minimums: config.minimums });
  const r = { ...reshaped, blocks: reshaped.blocks.filter((b) => !String(b.id).startsWith("commute-")) };
  const before = new Map(blocks.map((b) => [b.id, b]));
  const moves = r.blocks.filter((b) => before.has(b.id) && before.get(b.id).start !== b.start)
    .map((b) => ({ id: b.id, title: b.title, from: before.get(b.id).start, to: b.start }));
  const created = r.blocks.filter((b) => !before.has(b.id)).map((b) => ({ ...b, fixed: false, kind: "rest" }));
  if (moves.length || created.length) {
    try {
      if (!dry) await applyPlan({ date: localDate(now), moves, created, blocksById: before });
      alerts.push({ id: "watch-short-night", level: 1,
        text: `Short night (${Math.round((sleptMinutes / 60) * 10) / 10} h). ${r.changes.join(". ")}. Tell me "undo" if you'd rather keep the day as it was.` });
    } catch { /* leave the day alone if the calendar refuses */ }
  }
  day.adjusted = true;
}

// 2a. A to-do he ticked off (on any device) loses the sessions ORION booked for it,
// within a tick (2026-10-13: finished cert courses stayed booked). Quiet and cheap
// when nothing it booked has been finished.
if (!dry) {
  const r = spawnSync(process.execPath, [join(dirname(fileURLToPath(import.meta.url)), "orion-tasks"), "sweep"], { encoding: "utf8", timeout: 60000 });
  const swept = (r.stdout || "").trim();
  if (swept) day.tasksSwept = [...(day.tasksSwept ?? []), swept.slice(0, 300)];
}

// 2b. To-dos with due dates and spreads (orion-tasks): re-planned once each
// morning, so a due date or spread he changed in Reminders shows up in his days.
if (awake && !day.tasksPlanned && minute < 780) {
  if (!dry) {
    const r = spawnSync(process.execPath, [join(dirname(fileURLToPath(import.meta.url)), "orion-tasks"), "plan"], { encoding: "utf8", timeout: 120000 });
    day.tasksPlannedNote = (r.stdout || r.stderr || "").trim().slice(0, 500);
  }
  day.tasksPlanned = true;
}

// 0. The morning brief (tighten-orion/morning-brief, 2026-09-30): once, when
// he is up and before 1 PM — sleep, the first fixed thing, the nearest deadline,
// the side-project hour. On an empty day it leads into the question below.
let brief = null;
// What ORION cannot see (facets.sensorHealth: the Mac or WHOOP stale past 2 h, the phone past 12 h, while it should be live), said ONCE per outage, in the brief when
// there is one this tick and as its own message otherwise.
const sensorTimes = (() => {
  const days = log.days ?? {}; const lastDay = Object.keys(days).sort().at(-1);
  const newest = (...at) => at.filter((x) => x && !Number.isNaN(Date.parse(x))).sort().at(-1) ?? null;
  return { phone: newest((log.phoneSignals ?? []).at(-1)?.at, (Array.isArray(log.phoneScreen) ? log.phoneScreen.at(-1) : log.phoneScreen)?.at),
    mac: newest(readJson("focus-activity.json")?.at),
    whoop: newest(evidence.nights.at(-1)?.wokeAt, lastDay ? days[lastDay]?.updatedAt : null) };
})();
// Asleep, nothing is expected; a locked or sleeping Mac is off, not stale; the phone only after 12 h quiet or none all day (2026-10-31 review).
const dayStartAt = new Date(`${today}T04:00:00`);
const sensorsSeen = sensorHealth({ now, at: sensorTimes, dayStart: dayStartAt,
  expected: { phone: awake, mac: macExpected({ awake, activity: readJson("focus-activity.json") }), whoop: awake } });
const toldBefore = Object.assign({}, ...Object.values(state).map((d) => d?.sensorTold ?? {}), day.sensorTold ?? {});
const sensorSaid = sensorNotices({ health: sensorsSeen, told: toldBefore, now });
let sensorsInBrief = false;
if (awake && minute >= 300 && minute < 780 && day.calendar === "ok" && !day.asked.includes("brief")) {
  const deadlines = await bridge("list_deadlines", {}).then((r) => JSON.parse(r.events_json ?? "[]")).catch(() => [])
    .then((list) => list.filter((e) => /\b(quiz|exam|midterm|final|test|due|submission|presentation|essay|assignment|coursework)\b/i.test(e.title))
      .map((e) => ({ title: e.title, date: localDate(new Date(e.start)) })));   // assessments, not holidays
  // The top of the list is recomputed from today's real deadlines, his to-dos and what keeps slipping, and remembered per day so
  // the same item cannot head it three days running without being called out.
  const todos = await bridge("list_incomplete_reminders", { list: config.todoList }).then((r) => JSON.parse(r.reminders_json ?? "[]")).catch(() => []);
  const weekAgo = localDate(new Date(now.getTime() - 7 * 86400000));
  const candidates = [
    ...todos.map((t) => ({ title: t.title, due: t.due ? localDate(new Date(t.due)) : null })),
    ...readSlips().filter((s) => s.date >= weekAgo && s.planned?.title).map((s) => ({ title: s.planned.title, rank: s.planned.rank })),
  ];
  const history = Object.entries(state).filter(([d, v]) => d < today && v?.briefHead).sort(([a], [b]) => (a < b ? 1 : -1)).map(([date, v]) => ({ date, head: v.briefHead }));
  const gymBlock = blocks.find((b) => b.kind === "gym");
  const lowRecovery = recoveryFromLog(log, today).level === "low";
  const made = morningBrief({
    now: { date: localDate(now), minute },
    blocks: blocks.map((b) => ({ title: short_(b.title), kind: b.kind, start: b.start, end: b.end, fixed: b.fixed })),
    deadlines, sleep: { hours: record.sleepHours ?? null, recovery: record.recovery ?? null },
    sideProjectLabel: config.sideProjectLabel, candidates, history,
    proposal: proposalLive?.proposal?.text ?? null,
    gym: gymBlock && !proposalLive ? { start: gymBlock.start, minutes: gymBlock.end - gymBlock.start, easy: lowRecovery } : null,   // low recovery: the full 90, an easier session (2026-10-31 policy)
    sensorNotices: sensorSaid.notices.map((n) => n.text),
  });
  brief = made.text;
  if (made.head) day.briefHead = made.head.key;
  sensorsInBrief = sensorSaid.notices.length > 0;
  day.asked.push("brief");
}

// 1. An empty day: ask, don't guess.
// An unreadable calendar is unknown, never an empty day (2026-10-16: never say "nothing on the calendar" blind).
const free = awake && day.calendar === "ok" ? freeLeft() : 0;
if (awake && free >= 180) {
  if (!day.asked.includes("morning") && minute < 780) {
    day.asked.push("morning");
    alerts.push({ id: "watch-morning", level: 1, text: brief
      ? `Morning. ${brief} After that the day's open — what's the plan? Anything fixed? Tell me and I'll fill in the rest.`
      : classes.length
      ? `Morning. Today: ${plans(classes)}. After that nothing's planned until bed. What's the plan? Anything fixed — friends, going out? Tell me and I'll fill in the rest.`
      : `Morning. Nothing's on the calendar today. What's the plan? Tell me what's fixed and I'll fill in the rest.` });
    brief = null;
  } else if (!day.asked.includes("afterClass") && lastClass && minute >= lastClass.end && minute <= lastClass.end + 45) {
    // 2026-10-16 audit, finding 1: on 2026-10-15 this said "Discrete Structures's done" about a class he
    // slept through (WHOOP: woke 9:29 for a 9:00 class). "Done" needs evidence he was there.
    const attendance = classAttendance(lastClass, { wokeAt: actualWake(localDate(now), evidence)?.minute ?? null, phone: phoneMinutes(log.phoneSignals, localDate(now)) });
    const open = "The rest of today is open - what's the plan? Anything fixed tonight? I'll fill in the rest around it.";
    if (attendance === "missed") {
      day.asked.push("afterClass");   // the one kind replan about a missed class belongs to orion-proactive (class-missed)
    } else {
      day.asked.push("afterClass");
      alerts.push({ id: "watch-after-class", level: 1, text: attendance === "attended"
        ? `${short_(lastClass.title)} is done. ${open}`
        : `${short_(lastClass.title)} is over - I can't tell if you got to it, did you make it? ${open}` });
    }
  }
}
if (brief) alerts.unshift({ id: "watch-brief", level: 1, text: `Morning. ${brief}` });
// Sensors missing, told once: inside the brief when there was one, otherwise alone (awake, and not in the small hours).
if (sensorSaid.notices.length && (sensorsInBrief || (awake && minute >= 300 && !lateFlag.awake))) {
  if (!sensorsInBrief) alerts.push({ id: "watch-sensors", level: 1, text: noticeLine(sensorSaid.notices) });
  day.sensorTold = sensorSaid.told;
}
// One delivery gate (awareness 3.2): everything but a class reminder waits in the held queue during focus, the first
// minutes of a pause and class, and is released on a break or the end. His own wake/awake test above already says he is
// up, so sleep never holds these. Released by orion-reach --drain-held / orion-proactive's tick.
const aw = resolveAwareness({ dir: CONTROLLED, now, env: process.env, probe: !dry });
if (awake) aw.sleep = { state: "awake", source: "watch" };
const verdictFor = (a) => gate(aw, { kind: "checkin", urgentKind: a.id.startsWith("class-") ? "class" : null, now });
const verdicts = alerts.map((a) => ({ a, v: verdictFor(a) }));
const deliverNow = dry ? alerts : verdicts.filter((x) => x.v.action === "deliver").map((x) => x.a);
const heldAlerts = dry ? [] : verdicts.filter((x) => x.v.action === "hold");
if (deliverNow.length) {
  day.lastQuestion = deliverNow.at(-1).text;
  day.lastQuestionAt = now.toISOString();
}
if (alerts.length) {
  mkdirSync(CONTROLLED, { recursive: true });
  if (!dry) {
    for (const a of deliverNow) appendFileSync(OUTBOX, `${JSON.stringify({ ...a, kind: "checkin" })}\n`);
    logCheckinAlerts(CONTROLLED, deliverNow, { now, why: "watch" });   // the Mac chat and reply-context see it too
    // in a state copy the copy's alerts-outbox is read by nothing; the isolated outbox is where a test looks
    if (isolated()) for (const a of deliverNow) toOutbox("phone", { id: a.id, text: a.text }, { by: "orion-watch" });
    for (const { a, v } of heldAlerts) appendHeld(CONTROLLED, { id: `held-${Date.now()}-${a.id}`, alertId: a.id, at: now.toISOString(), text: a.text, level: a.level, via: "alerts-outbox", heldFor: v.heldFor ?? "focus" });
  }
}
if (!dry) { save(); summarize(log); }
if (process.argv.includes("--json")) console.log(JSON.stringify(alerts));
else for (const a of alerts) console.log(a.text);
