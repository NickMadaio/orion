#!/usr/bin/env node
/*
 Orion's inbound ear while Nick is away. The other half of orion-notify.

 orion-notify can say a mission is BLOCKED. Until this existed that was the end
 of the conversation -- the mission sat dead until Nick walked back to the Mac.
 This turns that notification into something he can answer from a phone.

 An inbound message is UNTRUSTED. It arrives over a channel anyone can write to
 once they know the address, and it is text, which this project has repeatedly
 proved must never become an instruction (orion-control/src/provenance.ts). So
 the rule is orion-notify's own noise-control rule pointed the other way: the
 safety is not a filter on the text, it is a filter on the VOCABULARY.

   1. Seven verbs. The first meaningful token must match one EXACTLY -- no fuzzy
      matching, no fallthrough to a model, no parser to confuse.
   2. Arguments are validated by SHAPE in the dispatcher, never in the handlers,
      so a new verb cannot forget to check. Every id must already name something
      Orion minted: inbound text points at his own state, it cannot introduce a
      new noun.
   3. Inbound text never reaches a shell, a model, or a subprocess argv. Only
      ids that survived validation cross into execFile. There is no `sh -c`.
   4. `approve` resolves exactly the id it was handed. No verb means "yes to
      everything" -- the id IS the authorisation, and it is orion-notify's own
      `ap-xxxxxxxx` minting rather than a parallel scheme.

 Transport is deliberately separate from all of that. No OpenClaw channel can be
 configured today without a credential only Nick can create, so the default
 transport is a pair of local append-only files: a bridge appends envelopes to
 inbox.jsonl, `poll` drains them, replies land in outbox.jsonl. Attaching a real
 channel changes nothing above it -- hence building it in this order.
*/

import { execFile, spawn, spawnSync } from "node:child_process";
import { thinkingLevel } from "./lib/thinking-policy.mjs";
import { classifyClaim } from "./lib/remote/claims.mjs";
import { fixReply, lintReply } from "./lib/remote/reply-lint.mjs";
import { readStandingRules } from "./lib/remote/standing-rules.mjs";
import { compactPhoneMessage, localRoutingOn, relevance } from "./lib/remote/phone-context.mjs";
import { existsSync, lstatSync, readdirSync, readFileSync, statSync, writeFileSync } from "node:fs";
import { appendFile, mkdir, open, readdir, readFile, rename, rm, stat, writeFile } from "node:fs/promises";
import { homedir, hostname } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { promisify } from "node:util";
import { randomBytes } from "node:crypto";

import { sandbox, clockNow } from "./lib/life/bridge-path.mjs";
import { readDelivered, outreachKind } from "./lib/reach/reply-context.mjs";
const run = promisify(execFile);
const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
const CONTROLLED = join(homedir(), ".openclaw/orion-controlled");
const STATE = join(CONTROLLED, "remote.json"); // shared with orion-notify
const MISSIONS = join(CONTROLLED, "missions");
const INBOX = join(CONTROLLED, "inbox.jsonl");
const OUTBOX = join(CONTROLLED, "outbox.jsonl");
const AUDIT = join(CONTROLLED, "remote-audit.jsonl");
const INBOUND = join(CONTROLLED, `${sandbox() ? "eval-" : ""}remote-inbound.json`); // cursor + rate limits
const INBOUND_LOCK = join(CONTROLLED, `${sandbox() ? "eval-" : ""}remote-inbound.lock`);
const RUNNER_LOG = join(CONTROLLED, "remote-runner.log");
const LOCK = join(CONTROLLED, "lock.json");
const OPENCLAW = join(homedir(), ".openclaw/bin/openclaw");

// A test seam, not a config knob: whoever sets this already owns the process.
// It is recorded in the audit line whenever it differs from the real binary.
const MISSION_BIN = process.env.ORION_REMOTE_MISSION_BIN || join(ROOT, "scripts/orion-mission");

/*
 THE BRAIN. Nick's decision, 2026-09-02: "the idea is that its a remote way to
 directly speak to the orion brain."

 This file was built on the opposite principle, and the header above still says
 so: seven verbs, no fuzzy matching, NO FALLTHROUGH TO A MODEL. That was a
 deliberate safety property and attaching the brain gives it up on purpose --
 recorded here rather than quietly loosened, because someone reading this file
 in six months needs to know it was a decision and not a drift.

 What survives, and it is most of it. Everything in front of the brain still
 runs first and in the same order: the sender allowlist, LOCK ORION, device
 routing, replay, expiry, and the rate limit. Only a message that has passed all
 six reaches the model, and it reaches it as a FILE rather than as argv, so
 inbound text still never becomes a shell word or a process argument.

 `orion-app-v2` is not a new session. It is the exact key `GatewayClient.swift`
 uses, so a DM lands in the same conversation as the one Nick has standing at
 the Mac -- one Orion with one memory, which is what he asked for. Using a
 separate key would have been easier and would have produced a forgetful
 stranger wearing Orion's name.

 The seven verbs stay as FAST PATHS. `device` should answer from `pmset` in a
 quarter of a second, not cost a model turn to tell you the battery level.
*/
const BRAIN_SESSION = process.env.ORION_BRAIN_SESSION || "orion-app-v2";
// A test seam, not a config knob -- the same shape as MISSION_BIN above, and
// for the same reason: a check suite must be able to exercise the routing
// without spending a model turn, and whoever sets this already owns the process.
const BRAIN_BIN = process.env.ORION_BRAIN_BIN || OPENCLAW;
const BRAIN_TIMEOUT_S = 90;

const MISSION_RE = /^[a-z0-9][a-z0-9-]{0,39}$/; // the shape orion-notify enforces
const APPROVAL_RE = /^ap-[0-9a-f]{8}$/; // exactly what `ap-${randomBytes(4)}` mints
/*
 The second kind of approval id, added 2026-09-02.

 `ap-1a2b3c4d` is a MISSION approval, minted by `orion-notify` when a long
 mission blocks. `A-7F3K` is a GATE approval, minted by the plugin when an
 action's approval gate stops, and it is the one that carries real authority --
 it is what lets a message be sent or an authority flag be set.

 Two shapes rather than one because they are answered by different code and
 mean different things, and collapsing them would make "approve" ambiguous at
 exactly the moment it matters. Four characters, no 0/O/1/I/L, because Nick
 reads these back out loud.
*/
const GATE_RE = /^[Aa]-[23456789ABCDEFGHJKMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz]{4}$/;
const PRIORITIES = new Set(["low", "normal", "high", "urgent"]);
// The development agent's closed vocabulary, and the project-id shape
// `projects.mjs` mints. Declared up here because HINTS below reads them at load
// time; what they mean is explained beside doAgent.
const AGENT_ACTIONS = new Set(["status", "pause", "resume", "stop", "exterminate"]);
const ACTION_VERBS = new Set(["list", "cancel"]);
const TASK_ID_RE = /^orion-[a-f0-9]{16}$/;
const ACTIONS_DIR = join(CONTROLLED, "actions");
const PROJECT_RE = /^[a-z0-9][a-z0-9-]{1,63}$/; // projectRoot() in scripts/lib/agentic/projects.mjs
const TERMINAL = new Set(["succeeded", "needs_human", "needs_permission", "budget_exhausted", "unsafe", "aborted"]);
// 200 bytes and 8 tokens were a COMMAND's dimensions. A sentence addressed to
// the brain is not a command, so the verb grammar keeps its tight bounds and
// anything longer is simply not a verb -- it is a question, and gets one.
const [MAX_BYTES, MAX_TOKENS] = [200, 8];
const MAX_BRAIN_BYTES = 4000;
const RATE_WINDOW_MS = 10 * 60_000;
/*
 Forty, not twelve.

 Twelve per ten minutes was sized for a COMMAND channel that anyone who learned
 the address could write to. It is far too low for a conversation: the first
 real debugging session with Orion died on "too many commands in the last ten
 minutes" while Nick was mid-problem, which is the worst possible moment to be
 silenced by your own assistant.

 The threat it was sized against is now handled better upstream -- the sender
 allowlist means only named accounts are answered at all, and the bridge drops
 everyone else before a process is even spawned. What remains for this limit to
 do is stop a runaway loop, and forty does that without ending a conversation.
*/
const RATE_CAP = 40; // per sender, counting rejects too, so garbage cannot flood
const SEEN_KEPT = 200; // replayed envelope ids are refused, never re-executed

/*
 Phase 45's two guards that were missing entirely until 2026-09-02.

 EXPIRY. Every envelope has always carried `at`, and nothing ever read it back
 -- so an envelope from three weeks ago executed the moment it was delivered,
 provided its id had not been seen. A remote command is a thing a person wanted
 THEN; ten minutes is generous for "still wanted now", and the replay guard
 cannot help here because a stale envelope is not a repeated one.

 ROUTING. An envelope carried a sender and no target, so "wrong-device routing"
 had nothing to route on. A message addressed to another Mac is refused here,
 and deliberately WITHOUT being recorded as seen: recording it would let anyone
 fill this device's replay memory with envelopes meant for somebody else, which
 costs the sender nothing and needs no valid credential.
*/
const MAX_ENVELOPE_AGE_MS = 10 * 60_000;
const DEVICE_ID = (process.env.ORION_DEVICE_ID || hostname()).toLowerCase();

/*
 Phase 45's `files.safe_metadata`, as a closed set of roots.

 Not a path argument. A path from an inbound message is a path an attacker
 chooses, and every safe-path check ever written has been bypassed by somebody
 patient. Three names that map to three directories cannot be traversed,
 escaped, or pointed anywhere else, and the manifest only asked for metadata.
*/
const SAFE_ROOTS = new Map([
  ["desktop", join(homedir(), "Desktop")],
  ["documents", join(homedir(), "Documents")],
  ["downloads", join(homedir(), "Downloads")],
]);
const MAX_LISTED = 40;

// Only these senders are obeyed. `local` is the file transport; a real channel
// adds Nick's handle here through the environment, never via an inbound message.
/*
 Read PER MESSAGE, not once at startup.

 `orion-remote-bridge run` stays connected indefinitely, so a set captured at
 process start meant withdrawing an account's authority required killing the
 bridge -- revocation that depends on remembering to restart something is
 revocation that will not happen during the incident it is for. `isLocked()`
 was already re-read per message for the same reason; this now matches it.
*/
const allowedSenders = () => new Set(
  (process.env.ORION_REMOTE_ALLOW || "local").split(",").map((s) => s.trim().toLowerCase()).filter(Boolean),
);

const VERBS = {
  status: { aliases: ["status", "state", "sitrep"], min: 0, shape: ["mission"] },
  pause: { aliases: ["pause", "hold", "halt"], min: 1, shape: ["mission"] },
  resume: { aliases: ["resume", "continue", "unpause"], min: 1, shape: ["mission"] },
  cancel: { aliases: ["cancel", "abort", "stop"], min: 1, shape: ["mission"] },
  approve: { aliases: ["approve", "approved", "yes", "ok"], min: 1, shape: ["approval"] },
  deny: { aliases: ["deny", "denied", "no", "reject"], min: 1, shape: ["approval"] },
  priority: { aliases: ["priority", "prioritise", "prioritize"], min: 2, shape: ["mission", "level"] },

  /*
   Phase 45 -- the three low-risk READS the manifest begins with, and nothing
   else. Every one of them only looks: no handler below writes a file, changes a
   setting, starts a process or touches Orion's own state. That is what makes a
   lost reply safe to retry, and it is why the manifest puts these before
   Phase 46's actions rather than after.
  */
  /*
   The unattended development agent, controlled from a phone.

   ONE verb with a fixed sub-vocabulary, rather than teaching `pause` and
   `cancel` a second kind of target. Two reasons. The existing verbs act on
   MISSIONS and their shape proves the id is one Orion minted; an agent is not a
   mission and pretending otherwise would weaken that check. And the destructive
   action has to be something Nick typed on purpose: `agent exterminate` is two
   deliberate tokens, so no one stops a night's work by texting "stop".

   The sub-action must match the fixed set exactly — it is a vocabulary check,
   not a parse. An optional second token names the PROJECT (`agent stop
   advance-orion-capabilities`) for the night more than one project has a run.
   It reaches argv too, which is why it has a shape of its own: the id must be
   one `projects.mjs` could have minted AND name a project directory that
   already exists, so inbound text can point at a project Orion registered and
   can never introduce a path.
  */
  agent: { aliases: ["agent", "loop", "dev"], min: 1, shape: ["agentAction", "project"] },

  /*
   Actions ORION is running right now, and stopping one (Phase 46: "supports
   mobile cancellation"). Its own verb for the same reason `agent` has one: a
   task id is not a mission id, and "stop" alone already means cancel-a-mission.
   `action cancel <id>` takes an id the plugin minted (orion- + 16 hex) that is
   listed as running; the plugin stops before the next step and never kills
   the one in flight (plugin/orion-control/src/cancellation.ts).
  */
  action: { aliases: ["action", "actions"], min: 0, shape: ["actionVerb", "taskId"] },

  device: { aliases: ["device", "mac", "machine", "battery"], min: 0, shape: [] },
  apps: { aliases: ["apps", "applications", "app"], min: 0, shape: [] },
  files: { aliases: ["files", "file", "folder"], min: 1, shape: ["root"] },
};
const ALIAS_TO_VERB = new Map(Object.entries(VERBS).flatMap(([v, s]) => s.aliases.map((a) => [a, v])));
// Dropped before matching. Phones add politeness; the grammar should not care.
const FILLER = new Set(["orion", "please", "change", "set", "mission", "the", "to", "for"]);

const fail = (message, code = 2) => {
  console.error(`orion-remote: ${message}`);
  process.exit(code);
};

/* ---------- state ---------- */

// remote.json has two writers now. orion-notify does a bare read-modify-write,
// so a lock here cannot make the race impossible -- it shrinks this side's
// window from a subprocess lifetime to a few milliseconds.
async function withStateLock(fn) {
  const lock = `${STATE}.lock`;
  for (let attempt = 0; attempt < 60; attempt += 1) {
    try {
      await (await open(lock, "wx")).close();
      try {
        return await fn();
      } finally {
        await rm(lock, { force: true });
      }
    } catch (error) {
      if (error?.code !== "EEXIST") throw error;
      const age = await stat(lock).then((s) => Date.now() - s.mtimeMs).catch(() => Infinity);
      if (age > 15_000) await rm(lock, { force: true }); // a killed process must not lock Nick out
      else await new Promise((resolve) => setTimeout(resolve, 100));
    }
  }
  throw new Error("remote.json stayed locked for six seconds");
}

async function readState() {
  if (!existsSync(STATE)) return { missions: {}, pending: {}, notify: { sent: [], deferred: [] } };
  try {
    const parsed = JSON.parse(await readFile(STATE, "utf8"));
    return { ...parsed, missions: parsed.missions ?? {}, pending: parsed.pending ?? {} };
  } catch (error) {
    // Unlike orion-notify, unreadable state is fatal here: an empty history
    // would make every id look unknown, and "unknown id" is how this file says
    // no. Failing loudly beats silently refusing everything Nick sends.
    throw new Error(`remote.json is unreadable (${error instanceof Error ? error.message : error})`);
  }
}

async function writeState(next) {
  await mkdir(CONTROLLED, { recursive: true });
  const tmp = `${STATE}.tmp-${randomBytes(4).toString("hex")}`;
  await writeFile(tmp, JSON.stringify(next, null, 2), { mode: 0o600 });
  await rename(tmp, STATE); // atomic: a crash never leaves truncated state
}

async function readInbound() {
  if (!existsSync(INBOUND)) return { cursor: 0, seen: [], hits: [] };
  try {
    const p = JSON.parse(await readFile(INBOUND, "utf8"));
    return { cursor: p.cursor ?? 0, seen: p.seen ?? [], hits: p.hits ?? [] };
  } catch {
    // Losing the cursor must never mean replaying the inbox, so a corrupt file
    // resets to "everything so far has already been handled".
    return { cursor: Number.MAX_SAFE_INTEGER, seen: [], hits: [] };
  }
}

const writeInbound = (next) => writeFile(INBOUND, JSON.stringify(next, null, 2), { mode: 0o600 });
const audit = (entry) =>
  appendFile(AUDIT, `${JSON.stringify({ at: new Date().toISOString(), ...entry })}\n`, { mode: 0o600 });

/* ---------- views over Orion's own nouns ---------- */

function parseJson(text) {
  try {
    return JSON.parse(text);
  } catch {
    return null;
  }
}

const readJson = (path) => (existsSync(path) ? parseJson(readFileSync(path, "utf8")) : null);
const runnerMission = (id) => readJson(join(MISSIONS, id, "mission.json"));
const knownMission = (state, id) => Boolean(state.missions?.[id]) || Boolean(runnerMission(id));

// The mission lock records the stepper's pid, which is the only handle this
// file has on a running mission. Signal 0 merely tests that it is still alive.
// SIGTERM rather than SIGKILL: the stepper writes mission.json between steps,
// so a polite stop leaves durable state plus the lock `resume` knows to break.
function signalRunner(id, signal) {
  const held = readJson(join(MISSIONS, id, "mission.lock"));
  if (!Number.isInteger(held?.pid) || held.pid <= 1) return null;
  try {
    process.kill(held.pid, signal);
    return held.pid;
  } catch {
    return null;
  }
}
const livePid = (id) => signalRunner(id, 0);
const stopRunner = (id) => signalRunner(id, "SIGTERM");

const withMission = (state, id, patch) => ({
  ...state,
  missions: { ...state.missions, [id]: { ...(state.missions[id] ?? { priority: "normal", history: [] }), ...patch } },
});

/* ---------- parsing and the argument shapes ---------- */

// Returns { verb, args } or { error }. Never throws, never partially matches.
/// Whether the panic button is down. A missing or unreadable file is NOT a lock:
/// failing closed here would make an unrelated disk problem look like an
/// emergency and leave Nick unable to ask why. The lock is an explicit state.
function isLocked() {
  try { return JSON.parse(readFileSync(LOCK, "utf8"))?.locked === true; }
  catch { return false; }
}

function parse(raw) {
  const text = String(raw ?? "");
  if (!text.trim()) return { error: "empty message" };
  if (Buffer.byteLength(text, "utf8") > MAX_BYTES) return { error: "message too long" };
  // Refused rather than stripped: a control character is never part of a real
  // command, and it is the classic way to smuggle a terminal escape.
  if (/[\u0000-\u001f\u007f]/.test(text)) return { error: "control characters in message" };
  const tokens = text.toLowerCase().split(/\s+/)
    .map((t) => t.replace(/^[^a-z0-9-]+/, "").replace(/[^a-z0-9-]+$/, "")).filter(Boolean);
  if (!tokens.length) return { error: "no usable words" };
  if (tokens.length > MAX_TOKENS) return { error: "too many words" };
  // Filler is skipped only until a verb is found. After that every token is an
  // argument matched against a shape, so leniency there costs nothing.
  const start = tokens.findIndex((t) => !FILLER.has(t));
  if (start === -1) return { error: "no command in message" };
  const verb = ALIAS_TO_VERB.get(tokens[start]);
  if (!verb) return { error: `"${tokens[start].slice(0, 24)}" is not a command` };
  const args = tokens.slice(start + 1).filter((t) => !FILLER.has(t));
  const { min, shape } = VERBS[verb];
  if (args.length < min || args.length > shape.length) {
    // `verb` is carried so the caller can tell "I do not know that word" from
    // "I know it and you gave me the wrong arguments". They are different
    // things and used to produce the same sentence.
    return { error: usage(verb), verb, args };
  }
  return { verb, args };
}

// The taint gate. Declared per-verb above and applied by the dispatcher, so no
// handler ever receives a value it has not already proved Orion owns.
const SHAPES = {
  mission: (v, state) => (MISSION_RE.test(v) && knownMission(state, v) ? null : `no mission called ${v}`),
  approval: (v, state) =>
    (APPROVAL_RE.test(v) && state.pending[v]) || GATE_RE.test(v)
      ? null
      : `no pending approval ${v}`,
  level: (v) => (PRIORITIES.has(v) ? null : `priority must be one of ${[...PRIORITIES].join(", ")}`),
  root: (v) => (SAFE_ROOTS.has(v) ? null : `root must be one of ${[...SAFE_ROOTS.keys()].join(", ")}`),
  agentAction: (v) =>
    AGENT_ACTIONS.has(v) ? null : `agent takes one of ${[...AGENT_ACTIONS].join(", ")}`,
  // Shape first, filesystem second: a value that fails the regex never becomes
  // part of a path, so `../` and friends are refused before anything is read.
  project: (v) => (projectDir(v) ? null : `no project called ${v}`),
  actionVerb: (v) => (ACTION_VERBS.has(v) ? null : `action takes ${[...ACTION_VERBS].join(" or ")}`),
  // Regex first, so nothing that is not an id ever becomes part of a path.
  taskId: (v) => (TASK_ID_RE.test(v) && existsSync(join(ACTIONS_DIR, "running", `${v}.json`)) ? null : `no running action ${v}`),
};

const checkArgs = (verb, args, state) =>
  args.map((arg, i) => SHAPES[VERBS[verb].shape[i]](arg, state)).find(Boolean) ?? null;

/*
 What each argument shape will accept, in words.

 Added because the live channel gave a genuinely bad answer on its first day:
 typing `files` returned "not a command I know (files takes 1 argument(s))",
 which is wrong twice over -- `files` IS a command it knows, and the reply named
 neither what was missing nor what would satisfy it. A vocabulary this small
 should be able to teach itself in one line.
*/
const HINTS = {
  mission: "a mission id",
  approval: "an approval id — A-7F3K for an action, ap-1a2b3c4d for a mission",
  level: `one of ${[...PRIORITIES].join(", ")}`,
  root: `one of ${[...SAFE_ROOTS.keys()].join(", ")}`,
  // "agent needs agentAction" was what this said before the hint existed -- the
  // internal shape name, which teaches nobody anything.
  agentAction: `one of ${[...AGENT_ACTIONS].join(", ")}, optionally then a project id`,
  project: "a project id",
  actionVerb: "list, or cancel followed by an action id",
  taskId: "an action id from `actions`, like orion-1a2b3c4d5e6f7a8b",
};

const usage = (verb) => {
  const { min, shape } = VERBS[verb];
  // A verb that takes NO arguments and was given some produced "device needs "
  // -- the empty half of a sentence -- because slicing a zero-length shape
  // yields nothing to describe. Caught by the check suite, not by reading.
  if (shape.length === 0) return `${verb} takes no arguments`;
  const wanted = shape.slice(0, Math.max(min, 1)).map((name) => HINTS[name] ?? name);
  return `${verb} needs ${wanted.join(", then ")}`;
};

/* ---------- the brain ---------- */

/*
 One conversation turn with Orion, through the same `openclaw agent` path
 `orion-mission` uses -- durable, restart-surviving, and auditable for free with
 `openclaw tasks show <runId>`. Not a second route to the model; the existing one.
*/
/*
 What the brain is told about the channel it is speaking through.

 Without this it has no idea the remote channel exists, and the first live
 conversation showed exactly what that costs. Asked whether it was persistent,
 Orion answered that "orion-remote is live and gated at R1/R2 (approval level)"
 -- a confident description of its own configuration, assembled from documents
 in its context rather than from any fact. Told the exec had failed, it
 announced it would "enable exec to reach remote", not realising it was ALREADY
 reachable and was answering over that very channel. Asked about an approval id,
 it invented a slash-command syntax that does not exist.

 None of that is the model being stupid. It is the model being asked about a
 mechanism nobody told it about, which is a question it cannot answer honestly
 and will answer anyway. Before the brain was attached, an unknown word got a
 true "not a command I know" and the real verb list; afterwards it got a
 fluent fabrication. That is a regression in TRUTHFULNESS caused by attaching
 the brain, and this is the repair.

 Deliberately only facts, and only facts about this channel. It is not a
 personality, it does not tell Orion how to be, and it must never grow into
 one -- the assistant's own instructions live in plugin/workspace/AGENTS.md
 and are not this file's business.

 ## The vocabulary this text may not use

 The host records CHANNEL_BRIEF + Nick's message as ONE user turn, so every word
 here counts as something Nick said. The plugin's `AUTHORITY_INSTRUCTION` regex
 (catalog.ts) searches the user's words for enable/allow/grant/permission/
 capability/profile/unlock and friends, and `authorityInstructionMissing` is one
 of the four gates gutting self-modification.

 The first version of this brief contained "enable" and "permission". That
 satisfied the gate on EVERY Discord turn, whatever Nick had actually said --
 the transport's own boilerplate quietly disarming a security check meant to
 require his explicit instruction. Found by an independent review, 2026-09-02.

 So: no word from that regex may appear here. `scripts/orion_v2_remote_check.sh`
 asserts it, matched against the regex itself rather than a copied list, so the
 check cannot drift from the gate it is protecting.
*/
const CHANNEL_BRIEF = [
  "[orion-remote] Context from the transport, not from Nick:",
  // Lines tagged @discord or @phone are kept only for that channel (briefFor).
  "@discord - This message arrived over Discord. Nick is away from the Mac.",
  "@phone - This message arrived from the ORION app on Nick's iPhone. It is the same",
  "@phone   conversation as the Mac app; he may or may not be at the Mac.",
  "- The remote channel is ALREADY working -- you are answering through it right now.",
  "  Never offer to configure or repair it, and never claim it is unavailable.",
  "- These words are handled by the transport before you ever see them, so never",
  "  claim to have run them and never describe them as things you do:",
  "  status, pause, resume, cancel, approve, deny, priority, device, apps, files, agent.",
  "- The development run (the unattended coding loop) is controlled by Nick sending",
  "  `agent` then one of: status, pause, stop, exterminate, resume -- optionally",
  // A placeholder rather than a real project id. This example is recorded as
  // part of Nick's turn like every other line here, and the first draft's
  // (`advance-orion-…`) ended in a word AUTHORITY_INSTRUCTION matches. The
  // remote check caught it -- see the vocabulary note above.
  "  followed by a project id, e.g. `agent stop <project-id>`.",
  "  pause holds at the next task boundary; stop finishes the task in flight and",
  "  ends resumably; exterminate abandons the model call in flight now; resume",
  "  clears any of them. Nothing over this channel starts a run -- that is done at",
  "  the Mac. If he asks how to halt the run, tell him these exact words.",
  "- Approvals: you CANNOT create an approval id, and you cannot approve one.",
  "  There are two kinds and both are minted for you, never by you:",
  "    A-7F3K        an ACTION is waiting. The plugin minted it and handed it to",
  "                  you in the run result under `waitingOn`. Read the id out.",
  "    ap-1a2b3c4d   a MISSION blocked. orion-notify minted it.",
  "  If you do not have a real one in front of you, say you have no pending",
  "  approval. Never invent an id, never guess one, and never claim one was",
  "  truncated -- on 2026-09-02 you produced two fabricated ids in a row and sent",
  "  Nick round a loop approving something that did not exist.",
  "  Nick answers one by sending: approve <id>   (no slash, no other syntax).",
  "  He can also just say it in an ordinary message -- \"yes, approve A-7F3K\" --",
  "  and the plugin reads his own words before you see them. Either way it is",
  "  HIS act. A mention is not a decision: \"what does A-7F3K do\" is a question.",
  "  An approve from the local process is refused, so you cannot do it for him,",
  "  and saying the action is done when it is not is the worst answer available.",
  "- If you do not know something about your own configuration, say so. Do not",
  "  describe your own state from memory; it changes without you.",
  "@discord - Discord truncates near 2000 characters. Keep replies shorter than that.",
  "@phone - The phone shows plain text with light markdown. Keep replies short enough to",
  "@phone   read on a phone screen.",
  "--- Nick's message follows ---",
].join("\n");

// The brief for one channel: its own tagged lines, untagged, and no other's.
const briefFor = (sender) => {
  const channel = sender === "phone" ? "phone" : "discord";
  return CHANNEL_BRIEF.split("\n").flatMap((line) => {
    const tag = /^@([a-z]+) /.exec(line);
    if (!tag) return [line];
    return tag[1] === channel ? [line.slice(tag[0].length)] : [];
  }).join("\n");
};

/*
 What the brain cannot see from the phone and kept guessing at (2026-09-28):
 which apps are open (it told Nick Opera Air "isn't installed" while it was
 running) and what "ORION" is (it opened http://localhost:3000/tasks for "the
 task page"). Read fresh for each phone message; facts, not instructions.
*/
async function todaySchedule() {
  try {
    const { liveDay, localDate } = await import("./lib/life/live-day.mjs");
    const { clockNow } = await import("./lib/life/bridge-path.mjs");
    const now = clockNow();
    const blocks = await liveDay(localDate(now));
    const t = (m) => `${String(Math.floor(m / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;
    if (!blocks.length) return "- Today's calendar: nothing planned.";
    const lastClass = blocks.filter((b) => b.kind === "class").at(-1);
    // What already happened stays visible (2026-10-01: "extend the DS lab" — the
    // lab had ended on the calendar, ORION could not see it, and booked a second).
    const nowMinute = now.getHours() * 60 + now.getMinutes();
    const { loadConfig } = await import("./lib/life/config.mjs");
    const { rankOf } = await import("./lib/life/priority.mjs");
    const { commuteWalls } = await import("./lib/life/commute.mjs");
    const config = loadConfig();
    const line = (b) => `${b.title.replace(/ — .*$/, "").slice(0, 40)} ${t(b.start)}–${t(b.end)} [${rankOf(b, config)}${b.fixed ? "" : ", movable"}]`;
    const travel = commuteWalls(blocks, config).filter((w) => w.end > nowMinute);
    const earlier = blocks.filter((b) => b.end <= nowMinute);
    const current = blocks.filter((b) => b.start <= nowMinute && b.end > nowMinute);
    const ahead = blocks.filter((b) => b.start > nowMinute);
    return [
      earlier.length ? `- Earlier today (already over on the calendar): ${earlier.map(line).join("; ")}.` : null,
      `- On the calendar now (${t(nowMinute)}): ${current.length ? current.map(line).join("; ") : "nothing"}.`,
      `- Later today: ${ahead.length ? ahead.map(line).join("; ") : "nothing"}.`
        + (lastClass ? ` His last class ENDS at ${t(lastClass.end)} — "after class" means from ${t(lastClass.end)}.` : ""),
      travel.length ? `- Travel (not free time, nothing goes here): ${travel.map((w) => `${w.title} ${t(w.start)}–${t(w.end)}`).join("; ")}. Rule: ${config.commuteMinutes} min before his first class and after his last; a gap of ${Math.round(config.homeGapMinutes / 6) / 10} h or more between classes means home and back.` : null,
      "- [fixed] never moves unless he says so; [high] is protected; [medium] can move; [low] moves or shrinks first. His own ranks: orion-life rank <thing> high|medium|low.",
    ].filter(Boolean).join("\n");
  } catch { return null; }
}

/*
 What ORION said to him first (orion-reach), linked to the message he is sending (WP5, 2026-10-16).

 The old rule attached the last 3 rows from 6 hours to every phone turn, so a stale question rode along
 on unrelated messages (the Mac side fixed the same bug in 8220d23). Now, one rule shared with the Mac
 app's OutreachContext: the exact id when the phone sends one (`--reply-to`, a reply to a notification),
 else the single latest non-held row within 25 minutes, or 90 if it carries an `ask` (a text from away
 is answered late), only if no turn has happened since it was sent, and only once.
*/
const OUTREACH_PLAIN_MS = 25 * 60000;
const OUTREACH_ASK_MS = 90 * 60000;
const consumedFile = () => join(CONTROLLED, `${sandbox() ? "eval-" : ""}outreach-consumed.json`);

// The newest row per id, without held, dropped or failed ones (lib/reach/reply-context.mjs: one parser for every path).
function deliveredRows() { return readDelivered(CONTROLLED); }

function pickOutreach(rows, { replyTo, consumed, now }) {
  const exact = replyTo ? rows.find((r) => r.id === replyTo || r.askId === replyTo || `${r.id}-orion` === replyTo) : null;
  if (exact) return exact;
  const latest = rows.reduce((best, r) => (!best || Date.parse(r.at) > Date.parse(best.at) ? r : best), null);
  if (!latest) return null;
  const age = now - Date.parse(latest.at);
  if (age < 0 || age > (latest.ask ? OUTREACH_ASK_MS : OUTREACH_PLAIN_MS)) return null;
  if (consumed.lastTurnAt >= Date.parse(latest.at) || consumed.ids.includes(latest.id)) return null;
  return latest;
}

function askDetail(ask) {
  if (!ask || typeof ask !== "object") return "";
  const hm = (v) => (typeof v === "string" && v ? v : Number.isFinite(v) ? `${String(Math.floor(v / 60) % 24).padStart(2, "0")}:${String(v % 60).padStart(2, "0")}` : null);
  const w = ask.window;
  const from = hm(w?.start);
  const span = from ? ` about ${from}-${hm(w.end) ?? "now"}` : "";
  const place = typeof ask.place === "string" && ask.place ? `, at ${ask.place}` : "";
  const kind = String(ask.kind ?? ask.type ?? "open");
  const block = kind === "mismatch" && (ask.title || ask.blockId) ? ` "${String(ask.title ?? ask.blockId).slice(0, 60)}", planned${span}, not started` : span;
  return ` (${kind.slice(0, 20)} ask${block}${place})`;
}

function recentOutreach({ replyTo = null, now = Date.now() } = {}) {
  try {
    let consumed = { lastTurnAt: 0, ids: [] };
    try { const c = JSON.parse(readFileSync(consumedFile(), "utf8")); consumed = { lastTurnAt: Number(c.lastTurnAt) || 0, ids: Array.isArray(c.ids) ? c.ids : [] }; } catch {}
    const row = pickOutreach(deliveredRows(), { replyTo, consumed, now });
    // Every turn is recorded, so a row is only ever the answer to the first message after it.
    try { writeFileSync(consumedFile(), JSON.stringify({ lastTurnAt: now, ids: [...consumed.ids, ...(row?.id ? [row.id] : [])].slice(-50) }), { mode: 0o600 }); } catch {}
    if (!row) return null;
    const minutes = Math.max(0, Math.round((now - Date.parse(row.at)) / 60000));
    if (row.ask) return `- ${minutes} min ago you asked him "${row.text.slice(0, 200)}"${askDetail(row.ask)}. If he says what he did or is doing, log it.`;
    return `- ${minutes} min ago you messaged him first (${outreachKind(row)}): "${row.text.slice(0, 200)}" — his message is most likely his reply to it; read short answers ("yeah", "not yet", "in 10", "already did") against it.`;
  } catch { return null; }
}

/*
 He sent a message: log the turn and close the curiosity ask it answers (WP3, 2026-10-16). The same script the Mac app
 calls (orion-inbound-turn), so both paths log the same way. `replyTo` is the id of the message he answered, when the phone
 sent one. Best effort: a chat turn never waits on, or fails because of, this.
*/
function noteInboundTurn({ text, replyTo = null }) {
  if (sandbox()) return;
  try {
    const bin = process.env.ORION_INBOUND_BIN || join(dirname(fileURLToPath(import.meta.url)), "orion-inbound-turn");
    if (!existsSync(bin)) return;
    // --session: the outreach he is answering is written into this session as ORION's own turn before the brain runs (2026-10-23).
    spawnSync(process.execPath, [bin, ...(replyTo ? ["--reply-to", replyTo] : []), "--source", "phone", "--session", BRAIN_SESSION, "--text", String(text ?? "").slice(0, 200)],
      { timeout: 10000, stdio: "ignore", env: { ...process.env, ORION_CONTROLLED_DIR: CONTROLLED } });
  } catch { /* never blocks the turn */ }
}

function watchQuestion() {
  try {
    const day = new Date(Date.now() - 4 * 3600000).toLocaleDateString("en-CA");
    const q = JSON.parse(readFileSync(join(CONTROLLED, "watch.json"), "utf8"))?.[day];
    if (!q?.lastQuestion) return null;
    // Only a recent question can be what he is answering (at 00:24 the morning's nap message was still shown).
    // 90 minutes, the same window as an ask: a text from away is answered late.
    if (q.lastQuestionAt && Date.now() - new Date(q.lastQuestionAt).getTime() > OUTREACH_ASK_MS) return null;
    return `- Earlier today you asked him (on his phone): "${String(q.lastQuestion).slice(0, 220)}" — this message may be his answer.`;
  } catch { return null; }
}

// His phone's Screen Time lock, as the phone last reported it (2026-10-01: asked
// to unblock his apps, ORION checked the Mac's focus timer and said nothing was locked).
function phoneLock({ compact = false } = {}) {
  try {
    const r = spawnSync(process.execPath, [join(homedir(), "Desktop/ORION/scripts/orion-phone-time"), "status"], { encoding: "utf8", timeout: 5000 });
    const line = (r.stdout ?? "").trim();
    // Compact (r8b2): the verb word itself would satisfy the authority gate, so point at --help instead.
    if (compact) return line ? `- His phone's app lock: ${line} Extra time for him: run orion-phone-time --help for the verb (max 60 min, needs his reason; it re-locks by itself). Mac focus sessions are orion-session, not the phone.` : null;
    return line ? `- His phone's app lock: ${line} Extra time: orion-phone-time grant <minutes|HH:MM> --because "<his reason>" (max 60 min; it re-locks by itself). Mac focus sessions are orion-session, not the phone.` : null;
  } catch { return null; }
}

function openCheckins() {
  try {
    const state = JSON.parse(readFileSync(join(CONTROLLED, `${sandbox() ? "eval-" : ""}checkins.json`), "utf8"));
    const open = (state.checkins ?? []).filter((c) => !["done", "cancelled", "given_up"].includes(c.loop?.phase));
    return open.length ? `- Open check-ins: ${open.map((c) => `${c.id} "${c.what}" (${c.loop.phase})`).join("; ")}.` : "- No open check-ins.";
  } catch { return "- No open check-ins."; }
}

async function phoneContext({ replyTo = null } = {}) {
  const apps = await doApps().catch(() => null);
  const names = apps?.ok ? apps.reply.split("\n").filter((l) => l.startsWith("- ")).map((l) => l.slice(2)) : [];
  return [
    "[orion-remote] Live facts for this message (read just now, not from Nick):",
    // Evaluation only: the message's own timestamp is the real clock, the
    // sandbox day runs on its own (2026-10-07: "your 9am already happened").
    ...(sandbox() ? [`- TEST CLOCK: this is a schedule evaluation; it is ${(() => { const n = clockNow(); return `${String(n.getHours()).padStart(2, "0")}:${String(n.getMinutes()).padStart(2, "0")}`; })()} now. Ignore any other time or timestamp.`] : []),
    (() => { try { return "[Scheduling preferences — read before planning]\n" + readFileSync(join(homedir(), ".openclaw/workspace/SCHEDULING.md"), "utf8").slice(0, 12000); } catch { return "Scheduling memory unavailable: read SCHEDULING.md before planning."; } })(),
    names.length ? `- Apps open on the Mac: ${names.join(", ")}.` : "- The list of open apps could not be read.",
    "- ORION's own app is the native Mac app Orion.app. It is not a website: never open a",
    "  localhost or http address for it. Its tabs are Home, Tasks (to-dos, calendar and",
    "  ORION's day plan), Projects, Health, Finances, Brand and Settings. To show one, run",
    `  ${join(homedir(), "Desktop/ORION/scripts/orion-show")} <tab> through exec.`,
    "- From the phone you have every tool you have at the Mac: app_open, the browser, calendar,",
    `  reminders, memory. For the coding run, ${join(homedir(), "Desktop/ORION/scripts/orion-runs")}.`,
    "- Before saying an app is not installed, try app_open; it reports whether it opened.",
    ...[await todaySchedule()].filter(Boolean),
    openCheckins(),
    ...[phoneLock()].filter(Boolean),
    ...[watchQuestion()].filter(Boolean),
    ...[recentOutreach({ replyTo })].filter(Boolean),
    `- His day: ONE orion-reschedule call. \`day --plan "<title>, <min>[, HH:MM][, fixed]" …\` in the order he said them; HH:MM ONLY if he said a time ("nap 60 so 3" = 14:00); ", fixed" only for plans with people; relative words in the title ("gym after soccer, 60"); --fill only if he asks to fill the gaps; --date YYYY-MM-DD for any other day.`,
    "  \"Fix my schedule\" / overlaps → `tidy`. Every change obeys the day rules; NOTHING WAS CHANGED means ask him, never retry.",
    "  Doing something NOW (eating, a break, just got home) → `now \"Lunch, 25\" \"Break, 15\"` — it slides the rest in order; never retype the day to rearrange it.",
    "  Name blocks with HIS words (\"swap study and the internship applications\" → `swap \"study\" \"internship applications\"`): the tool picks the block whose title matches them best. Never translate his words into a different block's title.",
    "  Change ONE block, never retype the day: Still doing X / need N more minutes → `extend \"X\" N` (N minutes from now if its old end has passed); never use orion-checkin for ongoing scheduled work. X is taking longer / extend X to 3 → `extend \"X\" --until 15:00` (works even if X already ended on the calendar; add `--then \"Nap\"` when he says what comes straight after). Make X shorter/longer, shrink it → `resize \"X\" <min>`. Replace/swap X with Y in its slot → `rename \"X\" \"Y\"`. Two changes in one message → run them one after another, the block he named first first.",
    "  To-dos with due dates and spreads (\"due Friday, 2 hours a day\", \"four 1-hour blocks instead\", \"push it to Monday\", \"high priority\") → orion-tasks add|set|list|plan (it updates the to-do AND re-plans its sessions). A group (\"cert courses\" with its courses as parts): only the parent is scheduled; parts and their % → orion-tasks sub \"<task>\" add|set|remove. See SCHEDULING.md.",
    "  From his to-do list → `day --todos [--date …]` (one block per to-do; never paste the list). Get rid of X → `drop \"X\"` (never undo). Move one thing → `move \"X\" --to HH:MM`; push back half an hour → `move \"X\" --by 30`; swap two blocks → `swap \"X\" \"Y\"`. Class running over → `overrun <min>`. He is late right now → `late <min>`. `day --replace` ONLY when he says to clear or redo the whole day; it drops everything he does not restate.",
    "  Remove exactly what he names → `drop \"A\" \"B\"`; everything after X → `drop --after \"X\"`; only \"clear/wipe everything\" → `clear` (classes and plans with people stay).",
    "  Skipping a class and doing something else (\"not going to CS2100, work on orion at 11 instead\") → `skip \"<class>\"`, then book what he said at the time he said. He is not on campus, so no travel applies — never ask whether he meant later.",
    "  He is skipping a class or a plan (\"skip Marketing\", \"not going to the lab\") → `skip \"Marketing\"` — no approval, undoable. Schedule changes NEVER use the generic calendar actions (they need approval).",
    "  Never re-plan something that is in \"Earlier today\": it happened. A time that has passed is never a valid --at or --plan time.",
    "  When the day overflows, low-priority blocks (breaks, side projects, anything optional) shrink automatically; SHRUNK lines must be told to him.",
    "  Report only what the output says was written; SHIFTED / NOT BOOKED means tell him.",
    `- Closing the loop is your job. In THIS message, if he delays something with a reason → ${join(homedir(), "Desktop/ORION/scripts/orion-checkin")} add <min> "<what>" --because "<reason>";`,
    "  says he is starting → orion-checkin started (or started \"<what>\"); finished → done; plans changed → cancel.",
    "  \"One more video\" or \"later\" is not a reason: say so and add a short check-in anyway.",
    "  Don't ask how long a normal pause takes — food 25 min, shower 20, a call 15 — set it and tell him when you'll be back.",
  ].join("\n");
}

// r8b2 (2026-10-16): under local routing a phone turn carries only what it needs (lib/remote/phone-context.mjs);
// the lock/apps reads are skipped when his words do not touch them. The cloud path keeps phoneContext() whole.
async function compactPhoneText(text, savedNote, replyTo = null) {
  const need = relevance(text);
  const apps = need.apps ? await doApps().catch(() => null) : null;
  return compactPhoneMessage({
    text,
    paths: { show: join(homedir(), "Desktop/ORION/scripts/orion-show"), checkin: join(homedir(), "Desktop/ORION/scripts/orion-checkin") },
    parts: {
      testClock: sandbox() ? `- TEST CLOCK: this is a schedule evaluation; it is ${(() => { const n = clockNow(); return `${String(n.getHours()).padStart(2, "0")}:${String(n.getMinutes()).padStart(2, "0")}`; })()} now. Ignore any other time or timestamp.` : null,
      today: await todaySchedule(),
      checkins: openCheckins(),
      lock: need.lock ? phoneLock({ compact: true }) : null,
      watch: watchQuestion(),
      outreach: recentOutreach({ replyTo }),
      apps: apps?.ok ? apps.reply.split("\n").filter((l) => l.startsWith("- ")).map((l) => l.slice(2)) : [],
      savedNote,
    },
  });
}

/*
 The truth check (2026-09-29).

 Real scenario runs caught the brain doing the two things Nick hates most, on
 the same night: "wake me up at 7:30" answered "Done. I'll wake you at 7:30."
 with NO tool run at all, and "can you see my screen?" answered "No" although a
 screen-capture action is live. Rules in AGENTS.md already forbid both; the
 model does not always follow them.

 The envelope says how many tools a turn actually ran. So: a reply that claims
 an action with zero tools run, or claims an inability without looking, is sent
 back ONCE in the same session with a plain note, and the second answer is the
 one Nick gets. Narrow patterns, one retry, never a loop.
*/
// "have" is not in the verb list: "I don't have a location for that event" is
// missing data, not a claimed inability, and re-asking it (2026-09-29) made
// ORION narrate his investigation of the calendar script to Nick.
// …but "I don't have a direct weather tool" IS a claimed inability (it had one), as
// is "can't list them through the phone". Interim until Qwen's claims.mjs lands.
const CHECK_DONE = "[orion-remote check] Your last reply says something was done, but no tool ran in that turn, so nothing happened. Do it now with the right tool, or tell Nick plainly that it is not done and why. Reply to Nick directly with just the answer: never mention scripts, tools or this check.";
const NO_REPLY = /^\W*Agent couldn'?t generate a response/i;
const CHECK_SILENT = "[orion-remote check] Your last turn ended without a reply to Nick. Tell him in one or two sentences what you did or what happens next. Do not run the tools again.";
const CHECK_CANT = "[orion-remote check] Your last reply says you can't do that, but you did not look. Check TOOLS.md or use tool_search for it. If a tool exists, use it now; if it truly does not, say so plainly. Reply to Nick directly with just the answer: never mention scripts, tools, this check or what you looked at.";

/*
 The model decision (2026-09-29). Haiku stays the everyday brain: a week of real
 use including every scenario run cost about $1.60, and Nick's budget is $0–10 a
 month; a Sonnet-class brain for every turn would be about three times that.
 But the turns the truth check catches are exactly the ones Haiku got wrong, so
 the one retry goes to the stronger model. It is rare, so it is cheap, and it is
 where the extra reasoning pays. ORION_ESCALATION_MODEL overrides; "off" keeps
 retries on the default model.
*/
const ESCALATION_MODEL = process.env.ORION_ESCALATION_MODEL ?? "anthropic/claude-sonnet-5";
const escalate = ESCALATION_MODEL && ESCALATION_MODEL !== "off" ? ESCALATION_MODEL : null;

/*
 The clock answers the clock questions (2026-09-29): "what time is it" cost a
 brain round trip and came back as "20:32 GMT+1 (8:32 PM)". Only the whole,
 plain question qualifies; "what time is my class" still goes to ORION. The
 same list as MobileCore's QuickAnswer, which the Mac's voice path uses.
*/
const QUICK_FILLERS = new Set(["and", "so", "ok", "okay", "hey", "orion", "um", "uh", "well", "yo", "quick", "question", "then", "now", "sorry", "wait", "also", "but"]);
const QUICK_TIME = new Set(["what time is it", "what time is it now", "what time is it right now", "whats the time", "what is the time",
  "whats the time now", "time", "the time", "do you know what time it is", "tell me the time", "what time is it currently"]);
const QUICK_DAY = new Set(["what day is it", "what day is it today", "whats today", "what is today", "what day is today", "whats the date",
  "what is the date", "whats todays date", "what is todays date", "whats the date today", "what is the date today", "todays date"]);
export function quickAnswer(text, now = new Date()) {
  let words = String(text).toLowerCase().replace(/[’']/g, "").replace(/[^a-z ]+/g, " ").split(/\s+/).filter(Boolean);
  while (words.length > 2 && QUICK_FILLERS.has(words[0])) words = words.slice(1);
  const said = words.join(" ");
  if (QUICK_TIME.has(said)) return `It's ${now.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" })}.`;
  if (QUICK_DAY.has(said)) return `It's ${now.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" })}.`;
  return null;
}

async function askBrain(text, sender, { replyTo = null } = {}) {
  const quick = quickAnswer(text);
  if (quick) return { ok: true, reply: quick, tools: 0, runId: null, checked: "quick" };
  const first = await askBrainOnce(text, sender, { replyTo });
  // The runtime's own "couldn't generate a response" after tools ran: ask for the words, once.
  if (first.ok && NO_REPLY.test(first.reply)) {
    const words = await askBrainOnce(CHECK_SILENT, sender, { raw: true, model: escalate });
    return words.ok && words.reply.trim() && !NO_REPLY.test(words.reply) ? { ...words, checked: "no-reply" } : first;
  }
  if (!first.ok || first.tools !== 0) return first;
  // A refusal leads with it; a limit mentioned in passing ("…and I can't buy
  // things") is not one. 2026-09-29: a good "who are you" answer was re-asked for
  // that, and the unanchored re-ask made ORION answer the previous question.
  const opening = first.reply.split(/(?<=[.!?])\s/)[0] ?? first.reply;
  // Qwen's tested classifier (tighten-orion/claims), 2026-09-30: data absence is
  // not an inability, and edits ("combined", "renamed") are claims too.
  const claimed = classifyClaim(first.reply, { toolsRun: 0 });
  const refused = classifyClaim(opening, { toolsRun: 0 });
  const check = claimed.kind === "done" ? CHECK_DONE : refused.kind === "cant" ? CHECK_CANT : null;
  if (!check) return first;
  const asked = String(text).split("--- Nick's message follows ---").pop().trim().slice(0, 300);
  const second = await askBrainOnce(`${check}\nHis message was: "${asked}"`, sender, { raw: true, model: escalate });
  return second.ok && second.reply.trim() ? { ...second, checked: check === CHECK_DONE ? "claimed-done" : "claimed-cant" } : first;
}

/*
 Standing rules are saved from his own words before the model answers
 (2026-10-01: "naps at least an hour and 15 ALWAYS" and "going forward…" both got
 "Noted" and neither was saved). Durations become scheduling minimums the
 planner enforces; every rule goes into USER.md, which every session loads.
*/
async function saveStandingRules(text) {
  let rules;
  try { rules = readStandingRules(String(text)); } catch { return null; }
  if (!rules.standing) return null;
  const saved = [];
  const { setMinimum } = await import("./lib/life/config.mjs");
  const { evalMode } = await import("./lib/eval-mode.mjs");
  for (const m of rules.minimums) {
    try { setMinimum(m.key, m.minutes); saved.push(`${m.key} is always at least ${m.minutes} minutes (the planner enforces it)`); } catch { /* not a usable rule */ }
  }
  if (saved.length) {
    const result = spawnSync(process.execPath, [join(dirname(fileURLToPath(import.meta.url)), "orion-reschedule"), "minimums"], { encoding: "utf8", timeout: 30000 });
    saved.push(`Today minimums: ${result.status === 0 ? result.stdout.trim() : `could not apply: ${(result.stdout + result.stderr).trim()}`}`);
  }
  const statement = rules.statement || rules.minimums.map((m) => `${m.key} at least ${m.minutes} minutes`).join("; ");
  if (statement && !evalMode()) {
    // Into the brain too (Basic Memory vault): one running note seeding never overwrites.
    try {
      const vaultNote = join(homedir(), "Documents/orionBrain/20 Areas/Me/Learned about Nick.md");
      if (!existsSync(vaultNote)) {
        await mkdir(dirname(vaultNote), { recursive: true });
        await writeFile(vaultNote, "---\ntitle: Learned about Nick\ntype: person-notes\npermalink: 20-areas-me/learned-about-nick\ntags: [me, learned]\n---\n\n# Learned about Nick\n\nWhat he told ORION, in his words, newest last.\n\n## Relations\n- about [[Nick]]\n\n## Observations\n");
      }
      await appendFile(vaultNote, `- [rule] ${statement.replace(/\s+/g, " ").slice(0, 300)} (said ${new Date().toISOString().slice(0, 10)})\n`);
      saved.push("added to his brain note \"Learned about Nick\"");
    } catch { /* the profile save above still stands */ }
  }
  if (statement && evalMode()) saved.push(`his words would be saved to his profile: "${statement.slice(0, 160)}" (evaluation run: not written)`);
  else if (statement) {
    const remember = join(dirname(fileURLToPath(import.meta.url)), "orion-remember");
    const r = spawnSync(process.execPath, [remember, "--user", `Standing rule (${new Date().toISOString().slice(0, 10)}, his words): ${statement}`], { encoding: "utf8", timeout: 15000 });
    if (r.status === 0) saved.push(`his words saved to his profile: "${statement.slice(0, 160)}"`);
  }
  return saved.length ? saved : null;
}

async function askBrainOnce(text, sender, { raw = false, model = null, replyTo = null } = {}) {
  await mkdir(CONTROLLED, { recursive: true });
  // Via a FILE, never argv. The message is untrusted text and this is the one
  // property from the original design that costs nothing to keep.
  const file = join(CONTROLLED, `brain-${randomBytes(6).toString("hex")}.txt`);
  const saved = raw ? null : await saveStandingRules(text);
  const savedNote = saved ? `[orion-remote] Already saved from his message (by the transport, not by you): ${saved.join("; ")}. Tell him in one short clause that it is saved; do not save it again, and never say "noted" for anything that is not in this line.\n` : "";
  const compactPhone = sender === "phone" && !raw && localRoutingOn(homedir());
  const live = `${sender === "phone" && !raw && !compactPhone ? `${await phoneContext({ replyTo })}\n` : ""}${savedNote}`;
  await writeFile(file, raw ? text : compactPhone ? await compactPhoneText(text, savedNote, replyTo) : `${live}${briefFor(sender)}\n${text}`, { mode: 0o600 });
  try {
    const { stdout } = await run(
      BRAIN_BIN,
      ["agent", "--session-key", BRAIN_SESSION, "--timeout", String(BRAIN_TIMEOUT_S),
       // ORION_BRAIN_MODEL: the model a whole run uses (orion-eval-schedule compares them).
       ...((model ?? process.env.ORION_BRAIN_MODEL) ? ["--model", model ?? process.env.ORION_BRAIN_MODEL] : []),
       // ORION_BRAIN_THINKING: off | minimal | low | medium | high for a whole run.
       // Thinking was off for every message (openclaw thinkingDefault "off", chosen for
       // voice speed); text messages that change his day need it (2026-10-01).
       // Otherwise per message (lib/thinking-policy.mjs, 2026-10-07): off for talk,
       // low for anything that changes his day.
       "--thinking", process.env.ORION_BRAIN_THINKING ?? thinkingLevel(text.split("--- Nick's message follows ---").pop(), { model: model ?? process.env.ORION_BRAIN_MODEL }),
       "--json", "--message-file", file],
      { timeout: (BRAIN_TIMEOUT_S + 30) * 1000, maxBuffer: 32 * 1024 * 1024 },
    );
    const envelope = JSON.parse(stdout);
    /*
     `result.payloads` is an array of { text, mediaUrl }, and that is the ONLY
     place the reply lives. The first draft of this guessed at result.reply /
     result.text / reply / text -- none of which exist -- and would have
     answered every question with "(Orion had nothing to say)" while reporting
     success. Verified against the real envelope before shipping, which is the
     only reason it is right.

     Joined rather than [0], because a turn may legitimately emit several.
    */
    const payloads = Array.isArray(envelope?.result?.payloads) ? envelope.result.payloads : [];
    // The gateway appends "⚠️ 🛠️ Exec failed: …" when any tool attempt failed on
    // the way to an answer. That is plumbing, not something Nick should read
    // (2026-09-29: it trailed a perfectly good desktop listing). Kept in the audit.
    const joined = payloads.map((p) => p?.text ?? "").filter(Boolean).join("\n\n");
    const toolNoise = joined.split("\n").filter((line) => /^\s*⚠️\s*🛠️/u.test(line));
    // Mixed or 24-hour times and repeated sentences are fixed here, the same way
    // every time (tighten-orion/reply-lint); what cannot be fixed is recorded.
    const fixed = fixReply(joined.split("\n").filter((line) => !/^\s*⚠️\s*🛠️/u.test(line)).join("\n").trim());
    const reply = fixed.text;
    const lint = lintReply(reply).map((finding) => finding.rule);
    // runId is TOP level, not under result.meta. It is the handle for
    // `openclaw tasks show <runId>`, so the audit is worth nothing without it.
    const runId = envelope?.runId ?? envelope?.result?.meta?.agentMeta?.runId ?? null;
    // A turn that ran no tool has NO toolSummary at all (not calls: 0) -- found
    // when the truth check never fired in real runs. Missing means zero, as long
    // as the run reported its meta at all.
    const meta = envelope?.result?.meta;
    const calls = meta?.toolSummary?.calls;
    const tools = Number.isInteger(calls) ? calls : meta ? 0 : null;
    if (envelope?.status && envelope.status !== "ok") {
      return { ok: false, reply: `Orion did not finish: ${String(envelope.summary ?? envelope.status).slice(0, 140)}`, runId };
    }
    /*
     A turn CAN legitimately complete with no text -- a bare "Test" did, in
     under a second, because there was nothing in it to answer. That is Orion
     choosing silence rather than a bug, and the first version said only
     "(Orion had nothing to say)", which is true and useless: it looks
     identical to a broken reply path, and it cost a round of diagnosis to
     tell the two apart. Naming the run makes it checkable in one command.
    */
    if (!reply.trim()) {
      return {
        ok: true,
        reply: `Orion finished that turn without saying anything — there may have been nothing to answer.`
          + (runId ? ` (openclaw tasks show ${runId})` : ""),
        runId,
      };
    }
    return { ok: true, reply: reply.trim(), runId, tools, ...(toolNoise.length ? { toolNoise } : {}),
             ...(fixed.changed.length ? { fixedReply: fixed.changed } : {}), ...(lint.length ? { lint } : {}) };
  } catch (error) {
    const detail = String(error?.stderr || error?.message || error).slice(0, 300);
    // The gateway refuses a second turn in a session that is already running
    // one. That is not a failure, it is Nick talking at the Mac and on his
    // phone at the same time -- and saying so is more useful than an error.
    if (/already running|busy/i.test(detail)) {
      return { ok: false, reply: "You have a turn running at the Mac — give it a moment and send that again.", runId: null };
    }
    /*
     A hard exec failure -- the CLI call itself crashed, or ran past the
     120-second safety net past its own --timeout -- rejects with Node's own
     "Command failed: <node path> <openclaw path> agent --session-key
     orion-app-v2 --timeout 90 --json --message-file <path>". Before this, that
     string went straight into the Discord reply: this Mac's absolute paths,
     the live session key and the message-file location, in a DM, on every
     crash. Found auditing the Discord path 2026-09-05.

     `error.killed` is set whenever execFile's own timeout fired, which is the
     other shape this same leak takes without the words "Command failed" in
     it. Both are exec failing outright, not the brain answering -- there is no
     summary to relay, only argv to hide.
    */
    if (error?.killed || /^Command failed:/.test(detail)) {
      return { ok: false, reply: "Orion is taking too long to answer — try again in a moment.", runId: null };
    }
    return { ok: false, reply: `Orion could not answer: ${detail.split("\n")[0].slice(0, 140)}`, runId: null };
  } finally {
    await rm(file, { force: true });
  }
}

/* ---------- Phase 45: the read-only capabilities ---------- */

/*
 All three shell out with FIXED argv and no inbound value anywhere in it. The
 only thing a message can influence is which of three directory names is read,
 and that is checked against a closed Map before any handler runs.
*/

async function doAction(args) {
  const [verb = "list", id] = args;
  if (verb === "cancel") {
    if (!id) return { ok: false, reply: "cancel which one? Send `actions` to see what is running." };
    await mkdir(join(ACTIONS_DIR, "cancel"), { recursive: true, mode: 0o700 });
    await writeFile(join(ACTIONS_DIR, "cancel", id), new Date().toISOString(), { mode: 0o600 });
    return { ok: true, reply: `Orion | cancel requested for ${id}. The step in flight finishes; nothing after it starts.` };
  }
  let names = [];
  try { names = (await readdir(join(ACTIONS_DIR, "running"))).filter((name) => TASK_ID_RE.test(name.replace(/\.json$/, ""))); }
  catch { /* nothing has ever run */ }
  const rows = [];
  for (const name of names) {
    try {
      const entry = JSON.parse(await readFile(join(ACTIONS_DIR, "running", name), "utf8"));
      rows.push(`- ${entry.taskId}: ${String(entry.goal).slice(0, 80)} (${(entry.actions ?? []).join(", ").slice(0, 80)}) since ${String(entry.startedAt).slice(11, 16)} UTC`);
    } catch { /* finished while listing */ }
  }
  return { ok: true, reply: rows.length
    ? ["Orion | ACTIONS RUNNING", ...rows, "Stop one with: action cancel <id>"].join("\n")
    : "Orion | nothing is running" };
}

async function doDevice() {
  const read = async (bin, args) => {
    try { return (await run(bin, args, { timeout: 10_000 })).stdout.trim(); }
    catch { return ""; }
  };
  const [battery, up, disk] = await Promise.all([
    read("/usr/bin/pmset", ["-g", "batt"]),
    read("/usr/bin/uptime", []),
    read("/bin/df", ["-k", "/"]),
  ]);
  const percent = (battery.match(/(\d+)%/) || [])[1];
  const power = /AC Power/.test(battery) ? "on AC" : /Battery Power/.test(battery) ? "on battery" : "";
  const load = (up.match(/load averages?: ([\d.]+)/) || [])[1];
  const upFor = (up.match(/up\s+([^,]+(?:,\s*\d+:\d+)?)/) || [])[1];
  const diskLine = disk.split("\n")[1]?.split(/\s+/) ?? [];
  const freeGB = diskLine[3] ? Math.round(Number(diskLine[3]) / 1024 / 1024) : null;
  return {
    ok: true,
    reply: [
      "Orion | DEVICE",
      percent ? `- battery ${percent}%${power ? ` ${power}` : ""}` : "- battery unknown",
      upFor ? `- up ${upFor.trim()}${load ? `, load ${load}` : ""}` : "- uptime unknown",
      freeGB !== null ? `- ${freeGB} GB free on /` : "- disk unknown",
    ].join("\n"),
  };
}

async function doApps() {
  // `ps` rather than System Events: reading the process table needs no
  // Automation permission, so this cannot start a TCC prompt on a Mac nobody
  // is sitting at. Only bundled applications are reported -- the daemons and
  // helpers below them are noise, not an answer.
  let out = "";
  try { out = (await run("/bin/ps", ["-Ao", "comm="], { timeout: 10_000 })).stdout; }
  catch { return { ok: false, reply: "could not read the process list" }; }
  /*
   Only applications a person would name. The first version matched any bundle
   in the process table and answered "62 apps running", most of which were
   agents like AccessibilityUIServer and AirPlayUIAgent living under
   /System/Library. That is a true list and a useless answer -- the question is
   "what have I got open", so the bundle has to live somewhere a person installs
   things.
  */
  /*
   Only applications a person would name, which took three attempts to define.

   Matching any bundle in the process table answered "62 running", nearly all of
   them agents like AirPlayUIAgent. Matching the OUTERMOST bundle then reported
   News, Stocks and Home as running, because their WIDGET extensions
   (`.appex` under Contents/PlugIns) are always alive while the apps are not.

   The honest definition is narrower than either: an executable sitting directly
   in a top-level bundle's Contents/MacOS. That excludes both plugin extensions
   and the nested helper bundles Electron apps spawn, so Discord counts once
   rather than four times. Measured on this Mac it gives eleven names, all of
   which are genuinely open.
  */
  const names = new Set();
  for (const line of out.split("\n")) {
    const match = line.trim().match(
      /^(?:\/(?:System\/)?Applications\/|\/Users\/[^/]+\/Applications\/)([^/]+)\.app\/Contents\/MacOS\/[^/]+$/,
    );
    if (match) names.add(match[1]);
  }
  const sorted = [...names].sort((a, b) => a.localeCompare(b));
  return {
    ok: true,
    reply: sorted.length
      ? [`Orion | ${sorted.length} APP(S) RUNNING`, ...sorted.slice(0, MAX_LISTED).map((n) => `- ${n}`)].join("\n")
      : "Orion | no bundled applications are running",
  };
}

async function doFiles([root]) {
  const directory = SAFE_ROOTS.get(root);
  if (!directory) return { ok: false, reply: "unknown folder" };
  let entries;
  try { entries = readdirSync(directory, { withFileTypes: true }); }
  catch (error) {
    // A refusal here is almost always macOS privacy, not a missing folder, and
    // saying so is more useful than "could not read".
    return { ok: false, reply: `cannot read ${root} (${String(error?.code ?? "error")}) — Orion may not have permission to that folder` };
  }
  const rows = entries
    .filter((entry) => !entry.name.startsWith("."))
    .slice(0, MAX_LISTED)
    .map((entry) => {
      // METADATA ONLY. Nothing here opens a file. The manifest's word is
      // "safe_metadata", and the difference between listing a name and reading
      // a document is the whole of Phase 45.
      try {
        const info = statSync(join(directory, entry.name));
        const size = entry.isDirectory() ? "dir" : `${Math.max(1, Math.round(info.size / 1024))} KB`;
        return `- ${entry.name.slice(0, 60)} · ${size} · ${info.mtime.toISOString().slice(0, 10)}`;
      } catch { return `- ${entry.name.slice(0, 60)} · unreadable`; }
    });
  const total = entries.filter((e) => !e.name.startsWith(".")).length;
  return {
    ok: true,
    reply: rows.length
      ? [`Orion | ${root.toUpperCase()} (${total} item(s)${total > MAX_LISTED ? `, first ${MAX_LISTED}` : ""})`, ...rows].join("\n")
      : `Orion | ${root} is empty`,
  };
}

/* ---------- verb handlers: each returns one short line for Nick's phone ---------- */

async function doStatus(args, state) {
  // Two registers hold missions: the notify view in remote.json and the runner's
  // own directories. Nick does not care which is which, so status merges them.
  const onDisk = existsSync(MISSIONS)
    ? readdirSync(MISSIONS, { withFileTypes: true }).filter((e) => e.isDirectory()).map((e) => e.name)
    : [];
  const ids = args[0] ? [args[0]] : [...new Set([...Object.keys(state.missions), ...onDisk])];
  const pending = Object.entries(state.pending).filter(([, item]) => item.status === "pending");
  const lines = ["Orion | REMOTE STATUS", ...(ids.length ? [] : ["- no missions"])];
  for (const id of ids) {
    const tracked = state.missions[id];
    const status = runnerMission(id)?.status ?? tracked?.status ?? "unknown";
    lines.push(`- ${id}: ${status} (${tracked?.priority ?? "normal"})${livePid(id) ? " · runner live" : ""}`);
  }
  if (pending.length) lines.push("waiting on you:");
  for (const [id, item] of pending) lines.push(`- ${id} · ${item.missionId}: ${item.request}`);
  return { ok: true, reply: lines.join("\n") };
}

async function doPause([id], state) {
  const pid = stopRunner(id);
  await writeState(withMission(state, id, { status: "paused", pausedAt: new Date().toISOString() }));
  return { ok: true, reply: pid ? `paused ${id} (stopped runner pid ${pid})` : `marked ${id} paused (no runner was live)` };
}

async function doResume([id], state) {
  const runner = runnerMission(id);
  if (runner && TERMINAL.has(runner.status)) return { ok: false, reply: `${id} already finished (${runner.status})` };
  if (livePid(id)) return { ok: false, reply: `${id} is already running` };
  await writeState(withMission(state, id, { status: "running", pausedAt: null }));
  if (!runner) return { ok: true, reply: `marked ${id} running (no local runner to start)` };
  // Detached on purpose: a mission outlives the message that restarted it. The
  // output goes to a log rather than /dev/null so a failed restart is findable.
  const log = await open(RUNNER_LOG, "a");
  try {
    const child = spawn(MISSION_BIN, ["resume", id], { detached: true, stdio: ["ignore", log.fd, log.fd] });
    child.unref();
    return { ok: true, reply: `resumed ${id} (runner pid ${child.pid})` };
  } finally {
    await log.close();
  }
}

async function doCancel([id], state) {
  const runner = runnerMission(id);
  if (runner && TERMINAL.has(runner.status)) return { ok: false, reply: `${id} already finished (${runner.status})` };
  stopRunner(id);
  await writeState(withMission(state, id, { status: "cancelled" }));
  if (!runner) return { ok: true, reply: `marked ${id} cancelled (no local runner)` };
  try {
    // Fixed reason string. No part of the inbound message reaches this argv.
    await run(MISSION_BIN, ["abort", id, "cancelled remotely by Nick"], { timeout: 30_000 });
    return { ok: true, reply: `cancelled ${id}` };
  } catch (error) {
    const reason = error instanceof Error ? error.message : String(error);
    return { ok: false, reply: `marked ${id} cancelled but abort failed: ${reason.slice(0, 120)}` };
  }
}

// approve and deny are one motion against one id, which is the point: no code
// path here can resolve anything other than the single item it was handed.
async function resolveApproval([id], state, decision, sender) {
  /*
   THE HOLE THIS CLOSES, found 2026-09-02.

   `orion-remote` is on Orion's exec allowlist. `orion-remote handle -- approve
   ap-1a2b3c4d` takes no `--from`, so `sender` defaulted to "local", and
   "local" is in the default allow set. Orion could answer his own approval
   requests over the channel that exists for Nick to answer them, and the audit
   log recorded it as an ordinary approval.

   The bridge always passes `--from <discord author id>`. So refusing "local"
   costs a real channel nothing and closes the only route an exec call has.
  */
  const who = String(sender ?? "").toLowerCase();
  if (!who || who === "local" || who === "orion") {
    return {
      ok: false,
      reply: "an approval has to come from a person. This one came from the local process.",
    };
  }

  if (GATE_RE.test(id)) return resolveGateApproval(id, decision, who);

  const item = state.pending[id];
  if (!item) return { ok: false, reply: `no pending approval ${id}` };
  if (item.status !== "pending") return { ok: false, reply: `${id} was already ${item.status}` };
  const decided = { ...item, status: decision, decidedAt: new Date().toISOString() };
  await writeState({ ...state, pending: { ...state.pending, [id]: decided } });
  return { ok: true, reply: `${decision} ${id} — ${item.request} (${item.missionId})` };
}

/*
 A gate approval: the one that lets an ACTION run.

 Delegated to the plugin's own `approvals.js` rather than reimplemented here.
 That module owns the ticket/grant/nonce rules and is loaded from the INSTALLED
 dist, which is the code the daemon runs -- a second implementation of "what
 counts as a yes" is the shape of bug this whole change exists to remove.
*/
async function resolveGateApproval(id, decision, who) {
  let gate;
  try {
    const lib = await import(join(homedir(), ".openclaw/extensions/orion-control/dist/approvals.js"));
    gate = { lib, paths: lib.approvalPaths(join(homedir(), ".openclaw/orion-gate/approvals")) };
  } catch (error) {
    return { ok: false, reply: `I cannot reach the approval store: ${String(error?.message).slice(0, 80)}` };
  }
  if (decision === "denied") {
    return (await gate.lib.deny(gate.paths, id))
      ? { ok: true, reply: `refused ${id}. Orion will not do it.` }
      : { ok: false, reply: `nothing called ${id} is waiting (it may have expired)` };
  }
  const result = await gate.lib.grant(gate.paths, id, `discord:${who}`);
  return result.ok
    ? { ok: true, reply: `approved ${result.ticket.id} — ${result.ticket.summary}. Tell him to go ahead.` }
    : { ok: false, reply: result.reason };
}

async function doPriority([id, level], state) {
  await writeState(withMission(state, id, { priority: level }));
  return { ok: true, reply: `${id} priority is now ${level}` };
}

/*
 What may be asked of the development agent from a phone.

 `status` reads. `pause` holds. `stop` ends the run at a safe boundary, leaving
 it resumable. `exterminate` abandons the generation in flight. `resume` clears
 a pause or a stop. Nothing here can START a run: beginning unattended work on
 real code is a decision made at the machine, and the enablement gate lives in a
 file outside the repository for the same reason.

 (AGENT_ACTIONS and PROJECT_RE are declared with the other shapes near the top.)
*/
const AGENT_HOME = join(CONTROLLED, "project-agent");
const AGENT_PROJECTS = join(AGENT_HOME, "projects");
// Held by `orion-agent run` for exactly as long as a project's supervisor runs.
// Its owner.json is lease.mjs's ownerRecord, which carries `projectID`.
const FLEET_LOCK = join(AGENT_HOME, "active-project.lock");
const MAX_PROJECTS_LISTED = 15; // each line is ~80 characters; Discord stops near 2000
// Under withStateLock's fifteen seconds on purpose: the dispatcher runs every
// handler inside remote.json's lock, and a halt still waiting on the controller
// when that lock turns stale would let a second message break it mid-command.
const OPERATOR_TIMEOUT_MS = 12_000;

/*
 WHICH RUN THE VERB IS ABOUT.

 Runs are per project now: each lives in project-agent/projects/<id>/. This verb
 was written when there was one run at project-agent/state.json, and it kept
 reading only that file -- so while a project was running, `agent status`
 answered "no development run exists" and every halt was refused before it
 reached the controller. A stop button that silently addresses the wrong place
 is worse than none, because Nick stops looking for another way to stop it.

 The order, most specific first:

   named     `agent stop <id>` -- already validated by the dispatcher's shape
   running   the fleet lock names the project `orion-agent run` holds it for
   only      exactly one project has a run
   legacy    the pre-project single root, when no project has a run at all

 Several candidates and nothing running is AMBIGUOUS, and the answer is the
 list rather than a guess. Picking one would be a coin toss about which night's
 work gets stopped.

 The lock is believed even when its holder has died: the only process that
 releases it is the supervisor's own `finally`, so a lock left behind names the
 project that was running when something crashed -- which is precisely the run
 Nick is asking about. The reply says whether a supervisor is actually alive,
 so a dead one is never reported as working.
*/
function projectDir(id) {
  if (typeof id !== "string" || !PROJECT_RE.test(id)) return null;
  const dir = join(AGENT_PROJECTS, id);
  // lstat, not stat: a symlinked project directory is refused here exactly as
  // projects.mjs refuses it, rather than followed somewhere else on disk.
  try { return lstatSync(dir).isDirectory() ? dir : null; } catch { return null; }
}

// Orion's own files, but read defensively anyway: an unreadable file must
// produce a sentence, never an exception whose message carries a path.
const readQuiet = (path) => { try { return readJson(path); } catch { return null; } };
const hasRun = (root) => existsSync(join(root, "state.json"));

function projectsWithRuns() {
  let names;
  try { names = readdirSync(AGENT_PROJECTS); } catch { return []; }
  return names.filter((id) => projectDir(id) && hasRun(join(AGENT_PROJECTS, id))).sort();
}

function agentTarget(named) {
  const project = (id, how) => ({ id, root: join(AGENT_PROJECTS, id), how });
  if (named) return project(named, "named");
  const owner = readQuiet(join(FLEET_LOCK, "owner.json"));
  // Validated like inbound text even though Orion wrote it: this id is about to
  // become an argv entry, and "Orion wrote it" is a claim about a file on disk.
  if (owner && typeof owner.projectID === "string" && projectDir(owner.projectID)) {
    return project(owner.projectID, "running");
  }
  // `orion-agent run` without --project records a null projectID: the legacy root.
  if (owner && owner.projectID == null && hasRun(AGENT_HOME)) return { id: null, root: AGENT_HOME, how: "running" };
  const runs = projectsWithRuns();
  if (runs.length === 1) return project(runs[0], "only");
  if (runs.length > 1) return { ambiguous: runs };
  if (hasRun(AGENT_HOME)) return { id: null, root: AGENT_HOME, how: "legacy" };
  return { none: true };
}

// The CLI's own rule, so the phone and the panel never disagree about "live":
// a heartbeat under a minute old that is not the supervisor's farewell beat.
function supervisorLive(root) {
  const beat = readQuiet(join(root, "heartbeat.json"));
  const age = Date.now() - Date.parse(beat?.at);
  return Boolean(beat) && beat.phase !== "stopped" && Number.isFinite(age) && age >= 0 && age < 60_000;
}

const oneLine = (value, max) => String(value ?? "").replace(/[\u0000-\u001f\u007f]+/g, " ").trim().slice(0, max);

function agentHeader(state, target) {
  const status = state ? ` ${oneLine(state.status ?? "unknown", 24).toUpperCase()}` : "";
  return `Orion | AGENT${status}${target.id ? ` · ${target.id}` : ""}`;
}

/*
 The summary is rebuilt from state read AFTER the action, not before it.

 Reporting the pre-command state is how a phone reply ends up saying "READY"
 in answer to `agent pause` — which reads as the command not having landed,
 at exactly the moment Nick is away from the machine and cannot check. For the
 same reason a standing request is spelled out: `stop` leaves the status at
 RUNNING until the task in flight finishes, and "RUNNING" alone would read as
 the stop having been ignored.
*/
function describeRun(state, target) {
  const tasks = Array.isArray(state.tasks) ? state.tasks : [];
  const task = tasks.find((item) => item.id === state.activeTask);
  const accepted = tasks.filter((item) => item.status === "accepted").length;
  const open = (Array.isArray(state.escalations) ? state.escalations : []).filter((item) => !item.resolvedAt).length;
  const name = oneLine(readQuiet(join(target.root, "project.json"))?.name, 80);
  const standing = state.exterminateRequested ? "exterminate requested"
    : state.stopRequested ? "stop requested"
      : state.pauseRequested && state.status !== "paused" ? "pause requested, waiting for the task boundary" : null;
  return [
    ...(name && name !== target.id ? [`- ${name}`] : []),
    `- ${accepted}/${tasks.length} tasks accepted${open ? `, ${open} need you` : ""}`,
    task ? `- on ${oneLine(task.id, 40)}: ${oneLine(task.title, 80)}` : "- no task running",
    ...(standing ? [`- ${standing}`] : []),
    `- supervisor ${supervisorLive(target.root) ? "live" : "not running"}`,
  ];
}

function listRuns(ids, action) {
  const shown = ids.slice(0, MAX_PROJECTS_LISTED).map((id) => {
    const status = readQuiet(join(AGENT_PROJECTS, id, "state.json"))?.status ?? "unreadable";
    return `- ${id}: ${oneLine(status, 24).toUpperCase()}`;
  });
  return [
    `Orion | AGENT · ${ids.length} projects have runs, none is running`,
    ...shown,
    ...(ids.length > shown.length ? [`- and ${ids.length - shown.length} more`] : []),
    action === "status"
      ? "Name one for detail: agent status <project id>"
      : `Nothing was changed. Name one: agent ${action} <project id>`,
  ].join("\n");
}

/*
 WHERE THE CONTROLLER LIVES, and why it is not beside this file.

 The Discord bridge does not run this file from the repository. launchd cannot
 read ~/Desktop, so `orion-remote-install` copies scripts/ to
 ~/.openclaw/orion-remote and THAT copy answers Discord. It records no path back
 to the repository, and the copy is a snapshot from whenever the installer last
 ran -- so resolving the operator CLI relative to this file would, at best, find
 nothing (the copy predates it) and at worst run a stale controller's state
 transaction against a state file a newer supervisor owns.

 So the halt goes through the REPOSITORY's controller, found the way this repo
 already finds itself from outside (orion-forge, orion-identity-check):
 ORION_REPO when it is set, otherwise $HOME/Desktop/ORION. Before that, the
 checkout this file lives in is preferred, so a run from a worktree drives its
 own controller -- and "checkout" means it has a .git, which the installer never
 copies. That is what keeps the installed copy from qualifying even once it
 carries a snapshot of the CLI.

 ORION_REPO is also the test seam, like MISSION_BIN: whoever sets it already
 owns the process, and the audit line records which controller ran.

 AND THEN THE FALLBACK THAT MAKES IT WORK ON THE LIVE BRIDGE (2026-09-23).
 Under launchd the repository is not merely inconvenient but unreachable —
 macOS privacy blocks ~/Desktop, which is the whole reason the installer copies
 scripts/ out. So on the live bridge both repository candidates are "blocked",
 and without a fallback every halt sent from a phone would fail: the one control
 Nick said he must always have. The installer copies ALL of scripts/ (`cp -R`),
 so the operator CLI and controller are right beside this file, readable by
 launchd. When no repository is reachable, that copy is used.

 The stale-copy concern above is real but bounded. A re-install re-syncs it and
 `orion-remote-install --status` names any drift; a halt only sets a flag, the
 most stable transition the controller has; and a controller that does not
 recognise the state file's schema version refuses to touch it rather than
 guessing. A halt refused with a reason beats a halt that cannot be sent.
*/
const OPERATOR_BLOCKED = "macOS privacy is keeping the remote bridge out of ~/Desktop, where the ORION repository lives. "
  + "Stop it at the Mac, or give the node under ~/.openclaw/tools Desktop access "
  + "(System Settings › Privacy & Security › Files and Folders, or Full Disk Access)";

function probe(path) {
  try { statSync(path); return "ok"; }
  catch (error) { return error?.code === "EPERM" || error?.code === "EACCES" ? "blocked" : "missing"; }
}

function locateOperator() {
  const explicit = process.env.ORION_REPO;
  const candidates = explicit ? [explicit] : [ROOT, join(homedir(), "Desktop/ORION")];
  let blocked = false;
  for (const repo of candidates) {
    const cli = join(repo, "scripts/orion-project-agent");
    const needed = [cli, join(repo, "scripts/lib/orion-project-agent.mjs"), ...(explicit ? [] : [join(repo, ".git")])];
    const found = needed.map(probe);
    if (found.every((result) => result === "ok")) return { cli, source: "repository" };
    if (found.includes("blocked")) blocked = true;
  }
  // The installed copy beside this file — the only one launchd can read.
  if (!explicit) {
    const installed = join(ROOT, "scripts/orion-project-agent");
    if ([installed, join(ROOT, "scripts/lib/orion-project-agent.mjs")].map(probe).every((result) => result === "ok")) {
      return { cli: installed, source: "installed" };
    }
  }
  return {
    error: blocked ? OPERATOR_BLOCKED
      : "the ORION repository was not found (no checkout with scripts/orion-project-agent; set ORION_REPO for the bridge)",
  };
}

/*
 What the controller said, made safe for a phone.

 The CLI's own refusals are one plain line ("run completed", "Controller is
 busy; refresh and retry.") and are worth relaying verbatim. Anything else --
 an uncaught throw prints a stack, a timeout rejects with Node's "Command
 failed: <node> <script> ..." -- carries this Mac's absolute paths, which is the
 leak askBrain() was fixed for on 2026-09-05. So: the thrown message if there is
 one, else the first line, with any absolute path cut out.
*/
const ABSOLUTE_PATH = /(?:file:\/\/)?\/(?:Users|private|var|tmp|Volumes|opt|System|Library|Applications)\/[^\s'"`:]*/g;

function operatorRefusal(error) {
  if (error?.killed) return `the controller did not answer within ${OPERATOR_TIMEOUT_MS / 1000} seconds; check it at the Mac`;
  const stderr = String(error?.stderr ?? "");
  if (/\bEPERM\b|operation not permitted/i.test(stderr)) return OPERATOR_BLOCKED;
  const thrown = stderr.match(/^\s*\w*Error(?: \[\w+\])?: (.+)$/m)?.[1];
  const first = stderr.split("\n").map((line) => line.trim()).find(Boolean);
  const said = oneLine(thrown ?? first ?? "", 400).replace(ABSOLUTE_PATH, "…").slice(0, 160);
  return said || "the controller refused it";
}

/*
 Resume must come from a person; the halts need not.

 The same hole resolveApproval() closes: `orion-remote` is on Orion's exec
 allowlist, and a direct `handle` call arrives as "local". Pause, stop and
 exterminate are the safe direction -- anything allowed to talk here may make
 the run stop. But `resume` UNDOES Nick's halt, and the process he halted must
 not be able to undo it through the channel that exists for him to halt it.
*/
const fromPerson = (sender) => {
  const who = String(sender ?? "").toLowerCase().trim();
  return Boolean(who) && who !== "local" && who !== "orion";
};

function haltSentence(action, target, live) {
  if (action === "pause") {
    return live ? "pause recorded; it holds at the next task boundary" : "pause recorded; no supervisor is running, so it simply stays held";
  }
  if (action === "stop") {
    return live
      ? "stop recorded; the task in flight finishes, then the run ends where it can be resumed"
      : "stop recorded; no supervisor is running, and the run will not continue until it is resumed";
  }
  if (action === "exterminate") {
    return live
      ? "exterminate recorded; the supervisor abandons the model call in flight within seconds. "
        + "Uncertain worker files stay untouched until recovery proves the worker has stopped"
      : "exterminate recorded; no supervisor is running, so nothing was in flight. The run will not continue until it is resumed";
  }
  const restart = target.id ? `scripts/orion-projects launch ${target.id} --until-stopped` : "scripts/orion-agent run --until-stopped";
  return live
    ? "resume recorded; the live supervisor carries on at its next boundary"
    : `halt cleared, but no supervisor is running. Continue it at the Mac (Projects view, or ${restart})`;
}

async function doAgent([action, named], _state, sender) {
  const target = agentTarget(named);
  // Only `status` can succeed without acting, so everything else that finds
  // nothing to act on is recorded as refused -- the audit should not say
  // "accepted" about a stop that stopped nothing.
  const answered = action === "status";
  if (target.ambiguous) return { ok: answered, reply: listRuns(target.ambiguous, action) };
  if (target.none) return { ok: answered, reply: "Orion | AGENT\n- no development run exists" };
  const forensics = { project: target.id ?? "legacy", resolvedBy: target.how };
  const before = readQuiet(join(target.root, "state.json"));
  if (!before) {
    const why = hasRun(target.root) ? "its run state could not be read; check it at the Mac"
      : "no run yet; it begins when the project is launched at the Mac";
    return { ok: answered, reply: `${agentHeader(null, target)}\n- ${why}`, audit: forensics };
  }
  if (action === "status") {
    return { ok: true, reply: [agentHeader(before, target), ...describeRun(before, target)].join("\n"), audit: forensics };
  }
  if (action === "resume" && !fromPerson(sender)) {
    return {
      ok: false,
      reply: `${agentHeader(before, target)}\n- a resume has to come from a person. This one came from the local process.`,
      audit: forensics,
    };
  }

  const operator = locateOperator();
  if (operator.error) return { ok: false, reply: `${agentHeader(before, target)}\n- could not ${action}: ${operator.error}`, audit: forensics };
  /*
   Fixed argv: the action survived the vocabulary check, the project id survived
   its shape check (or came from the fleet lock, validated the same way), and
   nothing else from the message crosses.

   No --revision. A halt that can lose a race with the thing it is halting is
   not a halt: the supervisor bumps the revision at every stage change, so a
   revision read here can be stale by the time the CLI checks it, and the stop
   would bounce at exactly the moment it was needed.

   process.execPath, not the script's `#!/usr/bin/env node`. Under launchd PATH
   is /usr/bin:/bin:/usr/sbin:/sbin, where there is no node, so the shebang
   would fail on the live bridge and only there. The bridge invokes this file
   the same way for the same reason.
  */
  const argv = [operator.cli, ...(target.id ? ["--project", target.id] : []), action];
  try {
    await run(process.execPath, argv, { timeout: OPERATOR_TIMEOUT_MS, maxBuffer: 32 * 1024 * 1024 });
  } catch (error) {
    return {
      ok: false,
      reply: `${agentHeader(before, target)}\n- could not ${action}: ${operatorRefusal(error)}`,
      audit: { ...forensics, operator: operator.cli },
    };
  }
  const after = readQuiet(join(target.root, "state.json")) ?? before;
  return {
    ok: true,
    reply: [
      agentHeader(after, target),
      `- ${haltSentence(action, target, supervisorLive(target.root))}`,
      ...describeRun(after, target),
    ].join("\n"),
    audit: { ...forensics, operator: operator.cli },
  };
}

const HANDLERS = {
  status: doStatus,
  pause: doPause,
  resume: doResume,
  cancel: doCancel,
  approve: (args, state, sender) => resolveApproval(args, state, "approved", sender),
  deny: (args, state, sender) => resolveApproval(args, state, "denied", sender),
  priority: doPriority,
  agent: doAgent,
  action: doAction,
  device: doDevice,
  apps: doApps,
  files: doFiles,
};

/* ---------- the one path every inbound message takes ---------- */

async function handleUnlocked({ text, from, envelopeId, at: sentAt, to: target, mode = "command", replyTo = null }) {
  const sender = String(from ?? "").toLowerCase().trim();
  // The raw text is kept for forensics, but only ever as a JSON string field:
  // control characters out, length capped, and nothing downstream re-reads it.
  const record = { from: sender, text: String(text ?? "").replace(/[\u0000-\u001f\u007f]/g, " ").slice(0, 200) };
  const now = Date.now();
  if (!allowedSenders().has(sender)) {
    await audit({ ...record, decision: "rejected", reason: "sender not allowed" });
    return { ok: false, reply: null }; // silence: never confirm the address works
  }
  /*
   Phase 45's order of judgement, and it is a decision rather than an accident:
   routing, then authority, then freshness, then replay. It matches
   MobileCore's JobGate, which carries the tests.

   Routing is judged FIRST and returns before any state is written, so an
   envelope addressed to another Mac consumes nothing here -- not a replay slot,
   not a rate-limit hit. The alternative lets anybody exhaust this device's
   memory with envelopes meant for somebody else.
  */
  if (target && String(target).toLowerCase().trim() !== DEVICE_ID) {
    await audit({ ...record, decision: "rejected", reason: `addressed to ${String(target).slice(0, 40)}, not ${DEVICE_ID}` });
    return { ok: false, reply: null };
  }

  /*
   LOCK ORION, checked before anything else can happen.

   Phase 43 requires the panic button to "stop new remote dispatches", and this
   is the half that does the stopping -- orion-lock raises the flag, and every
   inbound message dies here while it is up. Read fresh from disk on every
   message rather than cached at startup, because a bridge that has been running
   for a week would otherwise never notice it.

   Deliberately AFTER the allowlist and BEFORE everything else: a stranger still
   gets silence rather than "he is locked", which would confirm both that the
   address works and that now is an interesting time to try again.
  */
  /*
   Chat mode (2026-09-28): the phone's ORION tab is a conversation, not a
   command line. "No, I mean the task page" parsed as `deny` and died as a
   usage error, because half the verb aliases are ordinary English (no, yes,
   ok, stop, pause). In chat mode nothing is a verb: every message goes to the
   brain, after every guard below has run. Commands have their own buttons.
  */
  const parsed = mode === "chat" ? { error: "conversation", verb: null, args: [] } : parse(text);
  const lockedAgentHalt = (parsed.verb === "agent" &&
    ["status", "pause", "stop", "exterminate"].includes(parsed.args?.[0])) ||
    // Stopping an action is a halt too; a lock must never prevent one.
    (parsed.verb === "action" && ["list", "cancel", undefined].includes(parsed.args?.[0]));
  if (isLocked() && !lockedAgentHalt) {
    await audit({ ...record, decision: "rejected", reason: "ORION is locked" });
    return { ok: false, reply: "Orion is locked. Nothing will run until it is released at the Mac." };
  }

  /*
   Freshness. A stale envelope is not a repeated one, so the replay guard above
   cannot catch it: until this existed, an envelope that had sat in a queue for
   three weeks executed on delivery. Judged after replay so a replayed stale
   message is still reported as a replay, which is the more useful of the two.
  */
  /*
   Freshness, and a distinction that has to be made explicitly.

   An envelope whose `at` is missing, a string, or null used to get age 0 and
   never expire -- the fail-open-on-absent-field pattern. An envelope that
   cannot say when it was sent cannot be shown to be fresh, so it is stale.

   But `handle` is also invoked DIRECTLY at the terminal, with no envelope at
   all, and that is not a stale envelope -- it is a person typing now. The first
   version of this fix conflated the two and made the local CLI refuse every
   command it was given. So the two cases are separated by whether the caller
   passed the field at all: `poll` always passes it (as null if the envelope
   lacked one), and a direct call passes nothing.
  */
  const fromQueue = sentAt !== undefined;
  // `typeof === "number"`, NOT Number(). Number(null) is 0, not NaN, so an
  // unstamped envelope coerced to the epoch and was reported as "29806188 min
  // old" -- refused, correctly, but the audit line was nonsense. A timestamp is
  // a number or it is absent; there is no third thing to coerce.
  const stamped = typeof sentAt === "number" && Number.isFinite(sentAt) ? sentAt : null;
  const age = !fromQueue ? 0 : stamped === null ? Number.POSITIVE_INFINITY : now - stamped;
  if (age > MAX_ENVELOPE_AGE_MS) {
    const how = Number.isFinite(age) ? `${Math.round(age / 60_000)} min old` : "no usable timestamp";
    await audit({ ...record, decision: "rejected", reason: `expired (${how})` });
    return { ok: false, reply: "that command was too old to run — send it again if you still want it" };
  }

  /*
   Replay is judged LAST of the four, matching MobileCore's JobGate, whose doc
   comment calls that order pinned. The two used to disagree -- this path put
   replay before expiry and called THAT deliberate -- and a gate limitation
   saying they were "not mechanically proven to agree" was describing an active
   disagreement rather than an unproven agreement. Independent review, 2026-09-02.
  */
  const admission = await admitInbound({ sender, envelopeId, now, record });
  if (!admission.ok) return admission.result;
  // Only a person's message is his turn: `local` is ORION's own process (or a check script), never Nick replying (2026-10-23).
  if (sender !== "local") noteInboundTurn({ text, replyTo });
  if (parsed.error) {
    /*
     A bare verb word is CONVERSATION, not a command. This is the fix for the
     worst moment of the first real conversation: Nick typed "pause", meaning
     pause the music, and got "pause needs a mission id" -- the vocabulary
     hijacked an ordinary English word and the model never saw it.

     Half the verb list is ordinary English: pause, resume, cancel, status,
     files, device, apps, priority. Once the brain is attached those are no
     longer safe to capture on sight.

     So the rule is: a verb with NO arguments falls through to the brain, which
     can do the thing or ask what he meant. A verb WITH arguments that fail
     validation was clearly meant as a command, and still gets the usage line.
     "pause" reaches the brain; "files ~" still says which folders exist.
    */
    if (parsed.verb && parsed.args && parsed.args.length > 0) {
      await audit({ ...record, decision: "rejected", reason: parsed.error });
      return { ok: false, reply: parsed.error };
    }
    // Anything else is Nick talking. Every guard above has already run.
    //
    // MAX_BRAIN_BYTES was declared and then never used -- a cap that exists
    // only as a constant is not a cap. Enforced here rather than in parse(),
    // because parse()'s tight bounds are the VERB grammar and a question is
    // not a verb.
    if (Buffer.byteLength(text, "utf8") > MAX_BRAIN_BYTES) {
      await audit({ ...record, decision: "rejected", reason: "message too long for one turn" });
      return { ok: false, reply: `that is longer than ${MAX_BRAIN_BYTES} bytes — send it in pieces` };
    }
    const answer = await askBrain(text, sender, { replyTo });
    await audit({
      ...record,
      decision: answer.ok ? "accepted" : "error",
      verb: "brain",
      session: BRAIN_SESSION,
      runId: answer.runId,
      reply: answer.reply.slice(0, 200),
      ...(answer.checked ? { checked: answer.checked } : {}),
    });
    return answer;
  }
  try {
    /*
     "pause the music" is not a mission command.

     The bare-verb fix was not enough. `the` is filler, so "pause the music"
     parses as pause(music), reaches checkArgs, and dies as "no mission called
     music" -- Nick's actual sentence, answered with a category error. Same for
     "stop the music", "cancel my alarm", "resume playback".

     So a MISSION-shaped argument that names no mission Orion owns is treated as
     conversation rather than as a typo. Every other shape still refuses: an
     unknown approval id, a bad priority level and an unknown folder are all
     genuine command mistakes, and answering those with a model turn would be
     slower and less useful than saying what was wrong.
    */
    const preState = await readState();
    const preInvalid = checkArgs(parsed.verb, parsed.args, preState);
    if (preInvalid && VERBS[parsed.verb].shape[0] === "mission") {
      const answer = await askBrain(text, sender, { replyTo });
      await audit({ ...record, decision: answer.ok ? "accepted" : "error", verb: "brain",
                    reason: `"${parsed.verb}" named no mission; treated as conversation`,
                    session: BRAIN_SESSION, runId: answer.runId, reply: answer.reply.slice(0, 200), ...(answer.checked ? { checked: answer.checked } : {}) });
      return answer;
    }

    const result = await withStateLock(async () => {
      const state = await readState();
      const invalid = checkArgs(parsed.verb, parsed.args, state);
      return invalid ? { ok: false, reply: invalid } : HANDLERS[parsed.verb](parsed.args, state, sender);
    });
    const decision = result.ok ? "accepted" : "refused";
    const seam = MISSION_BIN.endsWith("/orion-mission") ? {} : { runner: MISSION_BIN };
    // A handler may add forensic fields -- `agent` records which project it
    // resolved and which controller ran, because the bridge runs an installed
    // copy and "which code acted" is otherwise unanswerable after the fact.
    await audit({ ...record, decision, verb: parsed.verb, args: parsed.args, reply: result.reply, ...seam, ...(result.audit ?? {}) });
    return result;
  } catch (error) {
    const reason = error instanceof Error ? error.message : String(error);
    await audit({ ...record, decision: "error", verb: parsed.verb, args: parsed.args, reason: reason.slice(0, 200) });
    return { ok: false, reply: `that failed: ${reason.slice(0, 120)}` };
  }
}

// Serialize only the replay/rate-limit read-modify-write. A brain response may
// take two minutes; holding this lock across dispatch would make a phone
// Exterminate wait behind conversation, exactly when it must remain immediate.
async function admitInbound({ sender, envelopeId, now, record }) {
  await mkdir(CONTROLLED, { recursive: true, mode: 0o700 });
  const deadline = Date.now() + 10_000;
  for (;;) {
    try {
      await mkdir(INBOUND_LOCK, { mode: 0o700 });
      await writeFile(join(INBOUND_LOCK, 'owner.json'), JSON.stringify({ pid: process.pid }), { mode: 0o600 });
      break;
    }
    catch (error) {
      if (error.code !== "EEXIST") throw error;
      const owner = await readFile(join(INBOUND_LOCK, 'owner.json'), 'utf8').then(JSON.parse, () => null);
      let live = false;
      if (Number.isInteger(owner?.pid) && owner.pid > 1) {
        try { process.kill(owner.pid, 0); live = true; } catch {}
      }
      const age = await stat(INBOUND_LOCK).then(info => Date.now() - info.mtimeMs, () => 0);
      if (!live && age > 5_000) { await rm(INBOUND_LOCK, { recursive: true, force: true }); continue; }
      if (Date.now() >= deadline) throw new Error("remote controller is busy; retry the message");
      await new Promise(resolve => setTimeout(resolve, 20));
    }
  }
  try {
    const inbound = await readInbound();
    if (envelopeId && inbound.seen.includes(envelopeId)) {
      await audit({ ...record, decision: "rejected", reason: "replayed envelope" });
      return { ok: false, result: { ok: false, reply: null } };
    }
    const recent = inbound.hits.filter((hit) => now - hit.at < RATE_WINDOW_MS);
    if (recent.filter((hit) => hit.from === sender).length >= RATE_CAP) {
      await audit({ ...record, decision: "rejected", reason: "rate limited" });
      return { ok: false, result: { ok: false, reply: "too many commands in the last ten minutes — try again shortly" } };
    }
    // Spend the budget before dispatch, so invalid messages are not free.
    await writeInbound({ ...inbound,
      hits: [...recent, { from: sender, at: now }],
      seen: envelopeId ? [...inbound.seen, envelopeId].slice(-SEEN_KEPT) : inbound.seen });
    return { ok: true };
  }
  finally { await rm(INBOUND_LOCK, { recursive: true, force: true }); }
}

async function handle(input) { return handleUnlocked(input); }

async function reply(envelope, text) {
  if (!text) return;
  // `envelopeId` is carried so a transport can match a reply to the message it
  // answers. Without it a bridge has to guess by position, and guessing means
  // that under any concurrency an answer can be delivered to the wrong person.
  await appendFile(
    OUTBOX,
    `${JSON.stringify({ at: new Date().toISOString(), envelopeId: envelope.id ?? null, to: envelope.from, text })}\n`,
    { mode: 0o600 },
  );
  // The attach point, and the reason it is environment rather than config: an
  // unconfigured Orion writes replies to a file and talks to nobody. Wiring a
  // real channel is a deliberate act, never a default.
  const [channel, target] = [process.env.ORION_REMOTE_REPLY_CHANNEL, process.env.ORION_REMOTE_REPLY_TARGET];
  if (!channel || !target) return;
  await run(OPENCLAW, ["message", "send", "--channel", channel, "--target", target, "--message", text], {
    timeout: 30_000,
  }).catch((error) => console.error(`orion-remote: reply failed: ${String(error?.message).slice(0, 160)}`));
}

/* ---------- cli ---------- */

const [command, ...rest] = process.argv.slice(2);

/*
 Argument parsing, and an allowlist bypass it used to contain.

 The old loop treated ANY argv entry beginning with `--` as a flag name and took
 the next entry as its value. The message text is attacker-controlled and
 arrives as an argv entry, so a message of "--x" consumed the following
 `--from` as its value: `flags.from` was then never set, the sender silently
 fell back to "local", and a stranger's message was attributed to -- and
 potentially authorised as -- the local account. It also put the real sender id
 into the audit as the message TEXT, so the log recorded the wrong person.

 Three changes, because one is not enough:

   1. A `--` terminator. Everything after it is positional, verbatim.
   2. UNKNOWN FLAGS ARE REFUSED. The bypass depended on `--x` being silently
      accepted as a flag nobody reads; now it is an error. This is the change
      that would have caught it even without the terminator.
   3. A flag at the end with no value is an error rather than `undefined`.

 The caller (`orion-remote-bridge`) additionally passes `--from` BEFORE the text
 and separates them with `--`, so the text cannot reach this loop as a flag at
 all. Defence in depth: any one of the four stops it.
*/
const KNOWN_FLAGS = new Set(["from", "to", "id", "at", "mode", "reply-to"]);
const flags = {};
const positional = [];
let terminated = false;
for (let i = 0; i < rest.length; i += 1) {
  const arg = rest[i];
  if (!terminated && arg === "--") { terminated = true; continue; }
  if (!terminated && arg.startsWith("--")) {
    const key = arg.slice(2);
    if (!KNOWN_FLAGS.has(key)) fail(`unknown option --${key.slice(0, 24)}`);
    if (i + 1 >= rest.length) fail(`--${key} needs a value`);
    flags[key] = rest[i + 1];
    i += 1;
    continue;
  }
  positional.push(arg);
}
const sender = flags.from ?? "local";

if (command === "inject") {
  if (!positional.join(" ").trim()) fail('inject needs a message, e.g. inject "status"');
  if (!["local", "orion"].includes(String(sender).toLowerCase())) {
    fail("inject cannot impersonate a remote sender; the authenticated bridge uses handle directly");
  }
  const envelope = {
    id: randomBytes(6).toString("hex"),
    from: sender,
    text: positional.join(" "),
    at: Date.now(),
    // Absent means "whichever Mac drains this queue", which is the local case.
    // A transport that serves more than one device sets it.
    ...(flags.to ? { to: String(flags.to).toLowerCase() } : {}),
  };
  await mkdir(CONTROLLED, { recursive: true });
  await appendFile(INBOX, `${JSON.stringify(envelope)}\n`, { mode: 0o600 });
  console.log(`queued ${envelope.id}`);
} else if (command === "handle") {
  // `--mode chat`: the phone's conversation tab. Never parsed as a verb -- see
  // handleUnlocked. Anything else is refused rather than guessed at.
  if (flags.mode !== undefined && !["chat", "command"].includes(flags.mode)) fail("--mode must be chat or command");
  // `--reply-to <reachId>`: the phone answered that outreach message (a notification reply); see recentOutreach.
  if (flags["reply-to"] !== undefined && !/^[A-Za-z0-9._:-]{1,80}$/.test(flags["reply-to"])) fail("--reply-to must be a message id");
  const result = await handle({ text: positional.join(" "), from: sender, mode: flags.mode ?? "command",
    envelopeId: flags.id ?? null, replyTo: flags["reply-to"] ?? null,
    ...(flags.at !== undefined ? { at: Number(flags.at) } : {}) });
  if (result.reply) console.log(result.reply);
  process.exit(result.ok ? 0 : 1);
} else if (command === "poll") {
  const lines = existsSync(INBOX) ? (await readFile(INBOX, "utf8")).split("\n").filter(Boolean) : [];
  const inbound = await readInbound();
  const cursor = Math.min(inbound.cursor, lines.length); // truncation must not replay
  if (cursor !== inbound.cursor) await writeInbound({ ...inbound, cursor });
  for (const [offset, line] of lines.slice(cursor).entries()) {
    const envelope = parseJson(line);
    if (!envelope) await audit({ decision: "rejected", reason: "unparseable envelope" });
    else {
      const result = await handle({
        text: envelope.text, from: envelope.from, envelopeId: envelope.id,
        // `?? null` rather than leaving it undefined: an envelope from the queue
        // with no timestamp must read as unstampable, not as a direct call.
        at: envelope.at ?? null, to: envelope.to,
      });
      await reply(envelope, result.reply);
      if (result.reply) console.log(`[${envelope.from}] ${envelope.text}\n${result.reply}\n`);
    }
    // Advance one at a time, so a crash mid-drain re-reads at most one message
    // -- and the replay guard refuses that one anyway.
    await writeInbound({ ...(await readInbound()), cursor: cursor + offset + 1 });
  }
  console.log(`polled ${lines.length - cursor} message(s)`);
} else if (command === "audit") {
  if (!existsSync(AUDIT)) fail("no audit log yet", 1);
  const count = Number(positional[0] ?? 20);
  const lines = (await readFile(AUDIT, "utf8")).split("\n").filter(Boolean);
  for (const line of lines.slice(-(Number.isInteger(count) && count > 0 ? count : 20))) console.log(line);
} else {
  fail(
    [
      'usage: orion-remote inject "<message>" [--from <sender>] | poll | audit [n]',
      '       orion-remote handle "<message>" [--from <sender>]',
      `verbs Nick can send: ${Object.keys(VERBS).join(", ")}`,
    ].join("\n"),
  );
}
