#!/usr/bin/env node
/*
 LOCK ORION — the off switch. Manifest Phase 43.

 The manifest is explicit that this exists before the dangerous things do:
 "stop dispatch, cancel queued jobs, suspend automations, kill delegations,
 expire leases, reauth", and one of the Final Success Conditions is that "users
 can stop ORION instantly". Until now nothing did. There was no panic path, no
 kill switch, no single command — 78 actions across 24 tiers, all reachable,
 and no way to stop them at once.

 What this does, on the system that actually exists today:

   1. Drops the permission profile to `restricted_read_only`, the bottom rung —
      simulation, desktop_read and ambient_info only. Nothing writes, nothing
      sends, nothing modifies Orion, nothing touches the browser or Messages.
   2. Disables every cron job, which is the only thing that starts work nobody
      asked for.

 Two things it deliberately does NOT do:

 • It does not kill the gateway. A dead gateway cannot be asked why it is dead,
   cannot be unlocked, and takes the voice down with it. Removing Orion's
   AUTHORITY is the goal; removing his ability to answer is collateral.
 • It does not write permission-state.json itself. It calls the plugin's own
   `changePermissionProfile`, so the append-only permission audit is written
   BEFORE the state, under the same lock, with the same O_EXCL-and-rename that
   every other change uses. A panic button that bypasses the audit is a panic
   button you cannot reconstruct afterwards, which is exactly when you need to.

 The unlock is deliberately not symmetrical. Locking is one word; raising the
 profile back is a decision you make in the Settings panel or by asking Orion
 in as many words, because "undo the emergency" should cost more than the
 emergency did.

   orion-lock            lock everything down, and say what changed
   orion-lock status     what the current profile and jobs are
*/

import { execFile } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { mkdir, readFile, rename, rm, writeFile } from "node:fs/promises";
import { randomBytes } from "node:crypto";
import { homedir } from "node:os";
import { join, dirname } from "node:path";
import { fileURLToPath } from "node:url";
import { promisify } from "node:util";
import { createRequire } from "node:module";

const run = promisify(execFile);
const require = createRequire(import.meta.url);
const HERE = dirname(fileURLToPath(import.meta.url));

const STATE = join(homedir(), ".openclaw/orion-controlled/permission-state.json");
const CONTROLLED = join(homedir(), ".openclaw/orion-controlled");
/*
 The lock FLAG, added 2026-09-02 when the remote transport made it matter.

 Until now "locked" was inferred from `profile === restricted_read_only`, and
 that inference is ambiguous: it is also a profile somebody could legitimately
 choose with no emergency involved. "Is ORION locked" and "is ORION at its most
 restrictive" are not the same question, and once an inbound channel exists the
 difference is the difference between refusing remote commands and not.
*/
const LOCK = join(CONTROLLED, "lock.json");
const REMOTE_STATE = join(CONTROLLED, "remote.json");
const INBOUND = join(CONTROLLED, "remote-inbound.json");
const INBOX = join(CONTROLLED, "inbox.jsonl");
const LINK = join(CONTROLLED, "remote-link.json");
const AUDIT = join(homedir(), ".openclaw/orion-controlled/permission-audit.jsonl");
const OPENCLAW = join(homedir(), ".openclaw/bin/openclaw");
const FLOOR = "restricted_read_only";

const ESC = String.fromCharCode(27);
const bold = `${ESC}[1m`, dim = `${ESC}[2m`, grn = `${ESC}[32m`;
const yel = `${ESC}[33m`, red = `${ESC}[31m`, off = `${ESC}[0m`;


/// Never throws. A lockdown step that cannot complete must report and let the
/// remaining steps run -- the whole point of doing these first is that they do
/// not depend on anything else succeeding.
async function writeJSONNoThrow(path, value) {
  try { await writeJSON(path, value); return true; }
  catch (error) {
    console.log(`  ${red}could not write${off} ${path} - ${String(error?.message).slice(0, 60)}`);
    return false;
  }
}

function readJSON(path) {
  try { return JSON.parse(readFileSync(path, "utf8")); } catch { return null; }
}

async function writeJSON(path, value) {
  const temporary = `${path}.tmp-${randomBytes(4).toString("hex")}`;
  await writeFile(temporary, JSON.stringify(value, null, 2), { mode: 0o600 });
  await rename(temporary, path); // atomic, so a crash never leaves half a lock
}

function permissions() {
  // The installed plugin, not the repo copy: locking must act on what is
  // actually running. They are byte-identical today and that is worth keeping
  // true, but if they ever drift the running one is the one with authority.
  const installed = join(homedir(), ".openclaw/extensions/orion-control/dist/permissions.js");
  try { return require(installed); }
  catch { return require(join(HERE, "../plugin/orion-control/dist/permissions.js")); }
}

async function cronJobs() {
  try {
    const { stdout } = await run(OPENCLAW, ["cron", "list"], { timeout: 15000 });
    return stdout.split("\n").slice(1)
      .map((line) => line.trim().split(/\s+/))
      .filter((parts) => parts.length > 2 && /^[0-9a-f-]{36}$/.test(parts[0]))
      .map((parts) => ({ id: parts[0], name: parts[2] }));
  } catch { return []; }
}

async function status() {
  const { readPermissionState } = permissions();
  const state = await readPermissionState(STATE);
  const jobs = await cronJobs();
  const shown = state.profile === FLOOR ? grn + state.profile + off : yel + state.profile + off;
  console.log("");
  console.log(`  ${bold}Orion - authority${off}`);
  console.log(`  profile   ${shown}  ${dim}(version ${state.version})${off}`);
  console.log(`  cron      ${jobs.length} job(s)${jobs.length ? ": " + jobs.map((j) => j.name).join(", ") : ""}`);
  const lock = readJSON(LOCK);
  console.log(`  remote    ${lock?.locked ? red + "LOCKED" + off + dim + ` since ${lock.at}` + off : grn + "accepting" + off}`);
  console.log("");
  return { state, jobs };
}

async function lock() {
  console.log("");
  console.log(`  ${bold}${red}LOCKING ORION${off}`);
  console.log("");

  /*
   THE REMOTE STOP HAPPENS FIRST, AND UNCONDITIONALLY.

   It used to happen after the permission change, and a comment claimed it went
   first. It did not, and the consequence was a panic button that FAILED OPEN:
   if `changePermissionProfile` returned `stale` -- which it does whenever
   anything else writes the profile during the fifteen seconds `cron list` can
   take -- this function exited 1 before writing the flag, and five of the six
   things a lockdown is supposed to do silently did not happen. A corrupt
   permission-state.json was worse: an unhandled JSON.parse threw before
   anything was touched, and inbound commands kept executing.

   So the order is inverted. Stopping the channel needs no cooperation from
   anything that can fail, so it happens before everything that can, and each
   step is guarded on its own -- one unwritable file must not stop the other
   three. Found by an independent review, 2026-09-02.
  */
  await stopTheChannel();

  let failed = false;
  const { readPermissionState, changePermissionProfile } = permissions();

  let before;
  try {
    before = await readPermissionState(STATE);
  } catch (error) {
    // Reported, not fatal, and no longer first. The channel is already stopped.
    console.log(`  profile   ${red}unreadable${off} - ${String(error?.message).slice(0, 70)}`);
    console.log(`            ${dim}Fix permission-state.json by hand; the remote channel IS stopped.${off}`);
    before = null;
    failed = true;
  }

  if (before && before.profile === FLOOR) {
    console.log(`  profile   ${dim}already ${FLOOR}${off}`);
  } else if (before) {
    const result = await changePermissionProfile(
      {
        requestedProfile: FLOOR,
        expectedVersion: before.version,
        context: "Emergency lockdown requested at the terminal by Nick (orion-lock).",
        request: {
          kind: "instruction",
          trust: "trusted_user",
          // Names the profile and carries a permission word, because the writer
          // requires both -- a guard against the MODEL doing this, which a
          // person at a terminal is not.
          content: `Set the permission profile to ${FLOOR} immediately. This is an emergency lockdown.`,
        },
      },
      { statePath: STATE, auditPath: AUDIT },
    );
    // The writer's vocabulary, checked against permissions.ts rather than
    // guessed: changed | unchanged | rejected | stale | needs_approval. An
    // earlier draft tested for "applied", which never occurs, and would have
    // reported a SUCCESSFUL lockdown as a failure.
    if (result.status !== "changed" && result.status !== "unchanged") {
      // NOT fatal. Refusing to disable cron as well, because the profile write
      // lost a race, is the fail-open this ordering exists to prevent.
      console.log(`  profile   ${red}NOT changed${off} - ${result.reason ?? result.status}`);
      console.log(`            ${dim}still ${before.profile}. The remote channel IS stopped; cron follows.${off}`);
      failed = true;
    } else {
      console.log(`  profile   ${before.profile} ${dim}->${off} ${grn}${FLOOR}${off}`);
    }
  }

  const jobs = await cronJobs();
  for (const job of jobs) {
    try {
      await run(OPENCLAW, ["cron", "disable", job.id], { timeout: 15000 });
      console.log(`  cron      ${grn}disabled${off} ${job.name}`);
    } catch (error) {
      console.log(`  cron      ${red}could not disable${off} ${job.name} - ${error.message.split("\n")[0]}`);
      failed = true;
    }
  }
  if (!jobs.length) console.log(`  cron      ${dim}no jobs scheduled${off}`);

  console.log("");
  console.log(`  ${dim}Orion can still answer. He can read the desktop, report status and`);
  console.log(`  talk. He cannot write, send, modify himself, or act unasked.${off}`);
  console.log("");
  console.log(`  ${dim}To undo: raise the profile in Settings, or ask Orion in as many`);
  console.log(`  words, then re-enable jobs with: openclaw cron enable <id>${off}`);
  console.log(`  ${dim}Audit: ${AUDIT}${off}`);
  console.log("");
  // Non-zero when anything failed, so a caller can tell a complete lockdown
  // from a partial one -- but only AFTER everything has been attempted.
  if (failed) process.exit(1);
}

/*
 Phase 43's transport-dependent requirements. Every step is guarded on its own.
*/
async function stopTheChannel() {
  await mkdir(CONTROLLED, { recursive: true });
  await writeJSONNoThrow(LOCK, {
    locked: true,
    at: new Date().toISOString(),
    by: "orion-lock",
    reason: "Emergency lockdown requested at the terminal.",
  });
  console.log(`  remote    ${grn}dispatch stopped${off} ${dim}(lock.json)${off}`);

  // Cancel what is queued. "Where possible" is the manifest's own hedge, and
  // this is what is possible: the inbox cursor is advanced past everything
  // waiting, so queued envelopes are never handed to a verb. They stay on disk
  // for the audit -- what was cancelled is itself something you want to know.
  const queued = existsSync(INBOX)
    ? readFileSync(INBOX, "utf8").split("\n").filter(Boolean).length
    : 0;
  const inbound = readJSON(INBOUND) ?? { cursor: 0, seen: [], hits: [] };
  await writeJSONNoThrow(INBOUND, { ...inbound, cursor: queued });
  console.log(`  remote    ${grn}cancelled${off} ${queued - (inbound.cursor ?? 0)} queued job(s)`);

  // Expire the leases. Pending approvals are the standing authorisations a
  // remote message could still redeem, so a lockdown that left them redeemable
  // would leave behind the one thing that grants permission.
  const remote = readJSON(REMOTE_STATE);
  if (remote?.pending && Object.keys(remote.pending).length) {
    const expired = Object.fromEntries(Object.entries(remote.pending).map(([id, item]) => [
      id, { ...item, status: item.status === "pending" ? "expired_by_lock" : item.status },
    ]));
    await writeJSONNoThrow(REMOTE_STATE, { ...remote, pending: expired });
    console.log(`  remote    ${grn}expired${off} ${Object.keys(expired).length} pending approval(s)`);
  }

  // And drop the link's session, so a reconnect must identify afresh rather
  // than resume the one that was live when the panic button was pressed.
  const link = readJSON(LINK);
  if (link) await writeJSONNoThrow(LINK, { ...link, state: "offline", connectionId: null, lockedOut: true });
}

const command = process.argv[2] ?? "lock";
if (command === "status") { await status(); }
else if (command === "lock") { await lock(); }
else if (command === "release") {
  /*
   Releases the REMOTE lock and nothing else.

   Deliberately not an unlock. The permission profile stays on the floor and the
   cron jobs stay disabled, because those are the things whose restoration
   should cost a decision -- "undo the emergency" should be more work than the
   emergency was. This only makes Orion willing to listen again.
  */
  if (!readJSON(LOCK)?.locked) { console.log("  not locked"); process.exit(0); }
  await rm(LOCK, { force: true });
  console.log("");
  console.log(`  remote    ${grn}accepting commands again${off}`);
  console.log(`  ${dim}The profile is still ${((await permissions().readPermissionState(STATE)).profile)} and cron is still disabled.`);
  console.log(`  Raise the profile in Settings and re-enable jobs deliberately.${off}`);
  console.log("");
}
else {
  console.error("usage: orion-lock [lock|status|release]");
  process.exit(2);
}
