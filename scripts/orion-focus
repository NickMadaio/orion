#!/usr/bin/env node
/*
 Lockdown mode. Orion as the friend who takes your phone away.

 Nick asked for this in his own words: when he is off task and something needs
 doing, Orion should yell at him, lock him onto the task, and make him REASON
 his way back out rather than clicking dismiss.

 Two design choices worth stating, because both were the second idea:

 1. **Refocus, don't kill.** The obvious enforcement is quitting the distracting
    app. That is destructive (unsaved work), it needs Automation permission per
    target app, and it makes Orion something to be afraid of rather than argued
    with. Instead this brings the TASK app back to the front, repeatedly, which
    needs no permission at all and is exactly as annoying as it needs to be.

 2. **The unlock is a conversation, not a password.** A timer you can cancel is
    a timer you will cancel. So relief is granted by a model that has been told
    what the deadline is and instructed to be sceptical -- "I'm bored" fails,
    "the build is running and I can't do anything for six minutes" passes. It
    can be argued with, which is the point, and it cannot be no-oped.

 Nothing here needs a permission Nick has not already given. `lsappinfo` reads
 the frontmost app with no TCC prompt; `open -a` raises a window; `say` speaks.

   orion-focus start "finish the essay" 90 Zed Safari
   orion-focus start "fix the gate" 90 Zed --repo orion
   orion-focus next [Zed Safari]     start a session for the next calendar block
   orion-focus prepare               open the apps and read the context back
   orion-focus check                 one enforcement tick (cron calls this)
   orion-focus status
   orion-focus plead "the build is running, six minutes"
   orion-focus end
*/

import { execFile } from "node:child_process";
import { existsSync } from "node:fs";
import { readFile, writeFile } from "node:fs/promises";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { promisify } from "node:util";

const run = promisify(execFile);

// This script's own directory, so `prepare` can reach orion-agenda without
// depending on the caller's cwd -- cron calls this, and cron has no cwd worth
// depending on.
const HERE = dirname(fileURLToPath(import.meta.url));

const STATE = join(homedir(), ".openclaw/orion-controlled/focus.json");
const MODEL = "gpt-oss:20b";

// Apps that are never a distraction: Orion himself needs to be reachable, and
// locking someone out of Finder or their password manager is just cruelty.
const ALWAYS_ALLOWED = ["Orion", "Finder", "loginwindow", "1Password", "System Settings"];

const [command, ...rest] = process.argv.slice(2);

function fail(message, code = 2) {
  console.error(`orion-focus: ${message}`);
  process.exit(code);
}

async function readState() {
  if (!existsSync(STATE)) return {};
  try {
    return JSON.parse(await readFile(STATE, "utf8"));
  } catch {
    // A corrupt state file must not mean "locked forever with no way out".
    return {};
  }
}

// Immutable writes: every caller builds a new session object rather than
// mutating the one it read, so a half-applied update cannot exist on disk.
async function writeState(next) {
  await writeFile(STATE, JSON.stringify(next, null, 2));
}

async function frontmostApp() {
  try {
    const { stdout } = await run("/bin/sh", [
      "-c",
      "lsappinfo info -only name $(lsappinfo front) 2>/dev/null",
    ]);
    const match = /"LSDisplayName"="([^"]+)"/.exec(stdout);
    return match?.[1] ?? "";
  } catch {
    return "";
  }
}

const speak = (line) => run("/usr/bin/say", ["-r", "190", line]).catch(() => {});

/*
 PHASE 60 — notification preferences, and what is actually possible.

 macOS Focus modes cannot be set from a command line. There is no public API,
 no `defaults` key that survives a reboot, and the private route is a plist
 under DoNotDisturb that Apple has moved twice. Writing it would be a change
 that works until an OS update and then fails silently, which is the worst
 shape a "do not disturb" feature can have -- Nick would believe he was
 undisturbed.

 The supported route is a Shortcut, which Nick creates once and which this
 calls by name. If it does not exist, this says so and the session starts
 anyway: a focus session without Do Not Disturb is worth having, and refusing
 to start one because a shortcut is missing would be the tail wagging the dog.
*/
async function setFocusMode(on) {
  const name = on ? "Orion Focus On" : "Orion Focus Off";
  const result = await run("/usr/bin/shortcuts", ["run", name], { timeout: 10000 })
    .then(() => ({ ok: true }))
    .catch((error) => ({ ok: false, reason: String(error?.stderr || error?.message).slice(0, 120) }));
  return result.ok
    ? `  notifications: ${on ? "silenced" : "restored"} via the "${name}" shortcut`
    : `  notifications: unchanged — no "${name}" shortcut. Create one in Shortcuts (set a Focus, name it exactly that) and I will use it.`;
}
const raise = (app) => run("/usr/bin/open", ["-a", app]).catch(() => {});

function activeSession(state) {
  const session = state.session;
  if (!session) return null;
  if (Date.now() > session.until) return null;
  return session;
}

const minutesLeft = (session) => Math.max(0, Math.round((session.until - Date.now()) / 60000));

/*
 PHASE 60 — the half that was missing.

 This file enforced a session and never opened one. The manifest asks for both,
 and the two halves fail differently: enforcement that starts before the tools
 are up spends its first minutes dragging Nick back to an app that is not
 running yet.

 Three things, and only three, because "prepare" is exactly where a focus tool
 turns into a workflow engine nobody asked for:

   APPLICATIONS   `open -a`, which raises a window and needs no permission the
                  enforcement half does not already have. Never a launch of
                  something not named in the session.
   PROJECT        `git status` and `git log` against a repository named by KEY,
                  through the same closed table Phase 51 built. There is no
                  path argument here either, for the same reason.
   CONTEXT        what is on the calendar during the block, so a session that
                  runs into a meeting says so before it starts rather than
                  being interrupted by one.

 It reads and it opens. It does not write a file, change a setting, or touch
 the repository -- `git status` and `git log` are the two operations in the
 Phase 51 table that open no network connection and write nothing.
*/
async function prepare(session) {
  const lines = [];

  for (const app of session.allowedApps.filter((a) => !ALWAYS_ALLOWED.includes(a))) {
    // `open -a` is idempotent: an app already running is raised, not relaunched.
    const ok = await run("/usr/bin/open", ["-a", app]).then(() => true).catch(() => false);
    lines.push(ok ? `  opened ${app}` : `  could not open ${app} — is it installed?`);
  }

  if (session.repo) {
    for (const [label, argv] of [
      ["state", ["git", "status", "--short", "--branch"]],
      ["recent", ["git", "log", "--oneline", "--no-decorate", "-5"]],
    ]) {
      const out = await run(argv[0], argv.slice(1), { cwd: session.repoPath })
        .then((r) => r.stdout.trim())
        .catch((error) => `unavailable: ${String(error?.message).slice(0, 60)}`);
      lines.push(`  ${label}:`);
      for (const line of out.split("\n").slice(0, 8)) lines.push(`    ${line}`);
    }
  }

  // A blind spot is REPORTED, never absorbed -- the same rule orion-standing
  // learned the hard way. "Nothing on the calendar" and "nobody could look"
  // are different sentences and must not collapse into the first one.
  const agenda = await run(join(HERE, "orion-agenda"), ["today"], { timeout: 20000 })
    .then((r) => r.stdout.trim())
    .catch(() => null);
  lines.push(agenda ? "  today:" : "  today: could not read the calendar — that is a blind spot, not an empty day");
  if (agenda) for (const line of agenda.split("\n").slice(0, 6)) lines.push(`    ${line}`);

  return lines;
}

switch (command) {
  case "start": {
    // `--repo <key>` is pulled out before the positional apps, so it can be
    // written anywhere and cannot be mistaken for an application name.
    const repoAt = rest.indexOf("--repo");
    const repoKey = repoAt >= 0 ? rest[repoAt + 1] : null;
    const positional = repoAt >= 0 ? [...rest.slice(0, repoAt), ...rest.slice(repoAt + 2)] : rest;
    const [task, minutesText, ...apps] = positional;
    if (!task?.trim()) fail('start needs a task, e.g. start "finish the essay" 90 Zed');

    const minutes = Number(minutesText ?? 60);
    if (!Number.isInteger(minutes) || minutes < 5 || minutes > 480) {
      fail("length must be a whole number of minutes between 5 and 480");
    }

    // The repository is resolved against Phase 51's closed table rather than
    // taken as a path. One table, two callers -- a second copy of "which
    // repositories exist" is the shape of bug this program keeps paying for.
    let repoPath = null;
    if (repoKey) {
      const { DEV_REPOSITORIES } = await import(
        join(homedir(), ".openclaw/extensions/orion-control/dist/devops.js")
      ).catch(() => ({ DEV_REPOSITORIES: new Map() }));
      const repo = DEV_REPOSITORIES.get(repoKey);
      if (!repo) {
        fail(`'${String(repoKey).slice(0, 30)}' is not a repository I know. They are: ${[...DEV_REPOSITORIES.keys()].join(", ") || "none"}`);
      }
      repoPath = repo.root;
    }

    const session = {
      task: task.trim(),
      startedAt: Date.now(),
      until: Date.now() + minutes * 60000,
      allowedApps: [...new Set([...apps, ...ALWAYS_ALLOWED])],
      // The app to drag him back to. First named wins; without one, refocusing
      // is meaningless and enforcement degrades to nagging.
      anchor: apps[0] ?? null,
      ...(repoKey ? { repo: repoKey, repoPath } : {}),
      strikes: 0,
      grants: [],
    };

    await writeState({ ...(await readState()), session });
    console.log(`locked on: ${session.task} for ${minutes} min`);
    console.log(`allowed: ${session.allowedApps.join(", ")}`);
    // Prepare BEFORE speaking, so the spoken "locked in" is true when it is
    // said rather than a promise about the next few seconds.
    console.log("preparing:");
    for (const line of await prepare(session)) console.log(line);
    console.log(await setFocusMode(true));
    await speak(`Locked in. ${task.trim()}. ${minutes} minutes.`);
    break;
  }

  case "next": {
    /*
     PHASE 60 — a session bound to a calendar block.

     The manifest asks for the session to CONNECT a task and a calendar block,
     and the honest reading is that the block supplies both the task and the
     length. Reading them from the event rather than asking for them is the
     whole point: a session whose end time is a guess drifts away from the
     meeting it was supposed to protect.

     `orion-agenda today --json` is the source. If it cannot be read that is a
     blind spot and this refuses rather than inventing a 60-minute block, which
     is the same rule everything else here follows.
    */
    const apps = rest;
    const raw = await run(join(HERE, "orion-agenda"), ["upcoming", "--json"], { timeout: 20000 })
      .then((r) => r.stdout)
      .catch((error) => { fail(`I cannot read the calendar, so I will not guess at a block: ${String(error?.message).slice(0, 100)}`); });

    let events;
    try {
      const parsed = JSON.parse(raw);
      events = Array.isArray(parsed) ? parsed : (parsed.events ?? []);
    } catch {
      fail("the calendar came back in a shape I do not understand; not guessing at a block");
    }

    const upcoming = events
      .map((event) => ({
        title: event.title ?? event.summary ?? "an appointment",
        start: new Date(event.start ?? event.at ?? event.startDate ?? NaN),
        end: new Date(event.end ?? event.endDate ?? NaN),
      }))
      .filter((event) => !Number.isNaN(event.start.getTime()) && event.start > new Date())
      .sort((a, b) => a.start - b.start);

    if (upcoming.length === 0) fail("nothing left on the calendar today to lock onto", 1);
    const block = upcoming[0];
    const minutes = Number.isNaN(block.end.getTime())
      ? 60
      : Math.max(5, Math.min(480, Math.round((block.end - block.start) / 60000)));

    const session = {
      task: block.title,
      startedAt: Date.now(),
      // The BLOCK's end, not now-plus-minutes. If the block has already
      // started, a session that ran the full length would run past it.
      until: Number.isNaN(block.end.getTime()) ? Date.now() + minutes * 60000 : block.end.getTime(),
      allowedApps: [...new Set([...apps, ...ALWAYS_ALLOWED])],
      anchor: apps[0] ?? null,
      fromCalendar: block.start.toISOString(),
      strikes: 0,
      grants: [],
    };
    await writeState({ ...(await readState()), session });
    console.log(`locked on: ${session.task} until ${block.end.toLocaleTimeString?.() ?? "the end of the block"}`);
    console.log("preparing:");
    for (const line of await prepare(session)) console.log(line);
    console.log(await setFocusMode(true));
    await speak(`Locked in on ${block.title}.`);
    break;
  }

  case "prepare": {
    const session = activeSession(await readState());
    if (!session) fail("no active session to prepare for. Start one first.", 1);
    console.log(`preparing for: ${session.task}`);
    for (const line of await prepare(session)) console.log(line);
    break;
  }

  case "check": {
    const state = await readState();
    const session = activeSession(state);

    if (!session) {
      // Expired sessions are cleared here rather than lingering as a trap that
      // starts shouting again the next time anything calls check.
      if (state.session) {
        await writeState({ ...state, session: null });
        await speak("Time's up. You're free.");
        console.log("session ended");
      } else {
        console.log("no active session");
      }
      break;
    }

    // A granted exception suspends enforcement without ending the session.
    const grant = session.grants[session.grants.length - 1];
    if (grant && Date.now() < grant.until) {
      console.log(`grace: ${Math.round((grant.until - Date.now()) / 60000)} min left (${grant.reason})`);
      break;
    }

    const front = await frontmostApp();
    if (!front || session.allowedApps.includes(front)) {
      // On task. Strikes decay, so one wander does not leave him one step from
      // being shouted at an hour later.
      if (session.strikes > 0) {
        await writeState({ ...state, session: { ...session, strikes: session.strikes - 1 } });
      }
      console.log(`on task (${front || "unknown"}) — ${minutesLeft(session)} min left`);
      break;
    }

    const strikes = session.strikes + 1;

    /*
     Count every minute, but do NOT speak every minute.

     The guard runs on a 1-minute cron, and the first version said something out
     loud on every off-task tick. Twenty minutes in a browser would be twenty
     spoken interruptions — which is not an accountability partner, it is a car
     alarm, and the only rational response is to kill the session and never use
     it again. The escalation is supposed to come from the STRIKE COUNT, not from
     repetition.

     Quiet hours deliberately do NOT apply here: Nick started this session on
     purpose, possibly at 1am precisely because that is when he is avoiding the
     thing. Silencing it then would defeat the feature he asked for.
    */
    const COOLDOWN_MS = { 1: 6 * 60_000, 2: 4 * 60_000 }[strikes] ?? 2 * 60_000;
    const spokeAgo = Date.now() - (session.lastSpokeAt ?? 0);
    const maySpeak = spokeAgo >= COOLDOWN_MS;

    await writeState({
      ...state,
      session: { ...session, strikes, lastSpokeAt: maySpeak ? Date.now() : session.lastSpokeAt },
    });

    if (!maySpeak) {
      console.log(
        `OFF TASK: ${front} (strike ${strikes}, quiet for another ` +
          `${Math.ceil((COOLDOWN_MS - spokeAgo) / 60000)} min) — ${minutesLeft(session)} min left`,
      );
      break;
    }

    /*
     Escalation. The first step is quiet on purpose -- being shouted at for
     three seconds in the wrong window teaches you to turn the thing off.
    */
    if (strikes === 1) {
      await speak(`${front}. You're meant to be on ${session.task}.`);
    } else if (strikes === 2) {
      await speak(`Nick. ${session.task}. Not ${front}.`);
    } else {
      await speak(
        `Enough. ${session.task}. ${minutesLeft(session)} minutes left. ` +
          `Talk to me if you have an actual reason.`,
      );
      if (session.anchor) await raise(session.anchor);
    }

    console.log(`OFF TASK: ${front} (strike ${strikes}) — ${minutesLeft(session)} min left`);
    break;
  }

  case "status": {
    const session = activeSession(await readState());
    if (!session) {
      console.log("no active focus session");
      break;
    }
    const grant = session.grants[session.grants.length - 1];
    const grace = grant && Date.now() < grant.until
      ? ` · grace ${Math.round((grant.until - Date.now()) / 60000)} min`
      : "";
    console.log(`focused on: ${session.task}`);
    console.log(`${minutesLeft(session)} min left · ${session.strikes} strike(s)${grace}`);
    console.log(`allowed: ${session.allowedApps.join(", ")}`);
    break;
  }

  case "plead": {
    const argument = rest.join(" ").trim();
    if (!argument) fail('plead needs a reason, e.g. plead "the build is running for six minutes"');

    const state = await readState();
    const session = activeSession(state);
    if (!session) fail("nothing to plead against — no active session", 1);

    const prompt = `Nick is in a focus session he set himself.

Task: ${session.task}
Time remaining: ${minutesLeft(session)} minutes
Times he has already wandered off: ${session.strikes}
Exceptions already granted this session: ${session.grants.length}

He is asking to be let off. His reason:

"${argument}"

Decide. Reply with exactly one line, in one of these two forms:

GRANT <minutes> <short reason>
DENY <short reason>

Rules for deciding:
- Grant only for something genuinely outside his control or genuinely urgent:
  a build or test running, someone at the door, a call he has to take, feeling
  ill, an actual emergency.
- Refuse boredom, restlessness, "just five minutes", "I'll make it up later",
  wanting to check something, and anything that is just not wanting to.
- Grant no more than 15 minutes, and less if the reason implies less.
- He has already been granted ${session.grants.length} exception(s). Be harder
  each time.
- You are his assistant, not his boss. Be short and human, never preachy.`;

    let verdict = "";
    try {
      const { stdout } = await run(
        "/bin/sh",
        [
          "-c",
          `curl -s -m 180 http://127.0.0.1:11434/api/generate -d @- <<'JSON' | /usr/bin/python3 -c "import sys,json;print(json.load(sys.stdin)['response'])"
${JSON.stringify({ model: MODEL, stream: false, prompt })}
JSON`,
        ],
        { timeout: 200000, maxBuffer: 1024 * 1024 * 8 },
      );
      verdict = stdout.trim().split("\n").filter(Boolean).pop() ?? "";
    } catch {
      // If the judge cannot run, the answer is no. A broken model must not be
      // the way out of a lockdown -- that would make it the easiest way out.
      fail("could not reach the local model, so the answer is no", 1);
    }

    const granted = /^GRANT\s+(\d+)\s*(.*)$/i.exec(verdict);
    if (!granted) {
      const reason = verdict.replace(/^DENY\s*/i, "").trim() || "not good enough";
      await speak(`No. ${reason}`);
      console.log(`DENIED — ${reason}`);
      process.exit(1);
    }

    const granting = Math.min(15, Math.max(1, Number(granted[1])));
    const reason = granted[2].trim() || "fair enough";
    const grants = [...session.grants, { until: Date.now() + granting * 60000, reason, argument }];

    await writeState({ ...state, session: { ...session, grants, strikes: 0 } });
    await speak(`Fine. ${granting} minutes.`);
    console.log(`GRANTED ${granting} min — ${reason}`);
    break;
  }

  case "end": {
    const state = await readState();
    if (!activeSession(state)) {
      console.log("no active session");
      break;
    }
    await writeState({ ...state, session: null });
    // Restore notifications on the way out. Paired with the call in `start`
    // and `next` -- a focus mode that switches on and never off is a worse
    // bug than one that never switches on at all, because it is silent.
    console.log(await setFocusMode(false));
    console.log("session ended");
    break;
  }

  default:
    fail('usage: orion-focus start "<task>" <minutes> [apps...] | check | status | plead "<reason>" | end');
}
