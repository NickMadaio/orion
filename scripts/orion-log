#!/usr/bin/env node
// orion-log — log water or food into Nick's health log (2026-09-29).
//   orion-log water [bottles]                  +1 by default, 1..3
//   orion-log water-goal [bottles]             the daily goal (nutritionGoals.water, 1..30, default 9); no number reads it
//   orion-log food "<what>" <kcal> [protein_g] [breakfast|lunch|dinner|snack]
//   orion-log water-off [bottles]              takes bottles back off today (default 1, 1..30; never below 0)    (w20 r3)
//   orion-log food-off "<words>" | --last      takes the newest food entry of today matching the words (or the newest one) off  (w20 r3)
//                                              the removed entry is kept in food-off-undo.json beside the log (w20 r4)
//   orion-log food-restore                     puts the entry food-off took off last back (an "undo" of the removal)
// "I just had a big bottle of water" got "you're at 1 of 9" and nothing was
// logged: the brain had no way to write it. This writes the same file the app
// and the phone write, under the same lock (<file>.lock, O_EXCL, broken after
// 15 s, given up after 6 s) and with every day-record key the app requires.
import { readFileSync, writeFileSync, renameSync, openSync, closeSync, unlinkSync, statSync, mkdirSync, chmodSync } from "node:fs";
import { join, dirname } from "node:path";
import { homedir } from "node:os";
import { randomUUID } from "node:crypto";

// ORION_HEALTH_LOG redirects it for tests, exactly as the app allows.
const FILE = process.env.ORION_HEALTH_LOG || join(homedir(), ".openclaw/orion-controlled/health-log.json");
const [kind, ...rest] = process.argv.slice(2);
const usage = () => { console.error('usage: orion-log water [1-3] | orion-log water-off [1-30] | orion-log food-off "<words>" | orion-log food-restore | orion-log water-goal [1-30] | orion-log food "<what>" <kcal> [protein_g] [breakfast|lunch|dinner|snack]'); process.exit(2); };
const day = new Date(Date.now() - 4 * 3600_000).toLocaleDateString("en-CA");
const sleep = (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);

function withLock(body) {
  const lock = `${FILE}.lock`; const deadline = Date.now() + 6000;
  mkdirSync(dirname(FILE), { recursive: true });
  for (;;) {
    try { closeSync(openSync(lock, "wx")); break; } catch (error) {
      if (error.code !== "EEXIST") throw error;
      try { if (Date.now() - statSync(lock).mtimeMs > 15000) unlinkSync(lock); } catch {}
      if (Date.now() > deadline) { console.error("the health log stayed busy; try again"); process.exit(1); }
      sleep(20);
    }
  }
  try { return body(); } finally { try { unlinkSync(lock); } catch {} }
}

// The goal lives in nutritionGoals.water (default 9, clamped to 1..30), the same place the app, Link and the phone read it.
const goalOf = (log) => { const w = log?.nutritionGoals?.water; return typeof w === "number" && Number.isFinite(w) ? Math.min(30, Math.max(1, Math.round(w))) : 9; };

const JOURNAL = join(dirname(FILE), "food-off-undo.json");
const readJournal = () => { try { const j = JSON.parse(readFileSync(JOURNAL, "utf8")); return Array.isArray(j) ? j : []; } catch { return []; } };
const writeJournal = (rows) => { const tmp = `${JOURNAL}.${process.pid}.tmp`; writeFileSync(tmp, JSON.stringify(rows.slice(-20))); renameSync(tmp, JOURNAL); };
const journalOff = (forDay, entry) => writeJournal([...readJournal(), { day: forDay, entry, at: new Date().toISOString() }]);

let reply;
if (kind === "water-goal") {
  const bottle = (n) => `${n} bottle${n === 1 ? "" : "s"}`;
  if (rest[0] === undefined) {
    let log = {}; try { log = JSON.parse(readFileSync(FILE, "utf8")); } catch {}
    reply = `Your water goal is ${bottle(goalOf(log))} a day.`;
  } else {
    const n = Number(rest[0]);
    if (!/^\d+$/.test(rest[0]) || n < 1 || n > 30) usage();
    withLock(() => update((log) => {
      log.nutritionGoals = { calories: 2200, protein: 150, carbohydrates: 250, fat: 70, fiber: 30, ...(log.nutritionGoals ?? {}), water: n };
      reply = `Water goal is now ${bottle(n)} a day.`;
    }));
  }
} else if (kind === "water") {
  const n = rest[0] === undefined ? 1 : Number(rest[0]);
  if (!Number.isInteger(n) || n < 1 || n > 3) usage();
  withLock(() => update((log, record) => { record.waterBottles = (record.waterBottles ?? 0) + n; reply = `Logged ${n} bottle${n > 1 ? "s" : ""}: ${record.waterBottles} of ${goalOf(log)} today.`; }));
} else if (kind === "water-off") {
  const n = rest[0] === undefined ? 1 : Number(rest[0]);
  if (!Number.isInteger(n) || n < 1 || n > 30) usage();
  let failed = false;
  withLock(() => update((log, record) => {
    const had = record.waterBottles ?? 0;
    if (had < 1) { failed = true; reply = "No water is logged today, so there is nothing to take off."; return; }
    const off = Math.min(n, had);
    record.waterBottles = had - off;
    reply = `Took ${off} bottle${off > 1 ? "s" : ""} off: ${record.waterBottles} of ${goalOf(log)} today.`;
  }));
  if (failed) { console.log(reply); process.exit(1); }
} else if (kind === "food-off") {
  const words = rest.filter((w) => w !== "--last").join(" ").toLowerCase().split(/[^a-z0-9]+/).filter((w) => w.length >= 2);
  if (!rest.length || (!words.length && !rest.includes("--last"))) usage();
  let failed = false;
  withLock(() => update((log, record) => {
    const nutrition = log.nutritionLog ?? {}; const entries = nutrition[day] ?? [];
    const index = entries.map((e, i) => ({ e, i })).reverse().find(({ e }) => !words.length || words.every((w) => String(e.title ?? "").toLowerCase().includes(w)))?.i;
    if (index === undefined) { failed = true; reply = `No food entry matching "${words.join(" ")}" is logged today.`; return; }
    const [gone] = entries.splice(index, 1);
    journalOff(day, gone);
    nutrition[day] = entries; log.nutritionLog = nutrition;
    record.calories = entries.reduce((a, e) => a + (e.calories ?? 0), 0);
    reply = `Took ${String(gone.title).trim()} off (${gone.calories ?? 0} kcal): ${record.calories} kcal today.`;
  }));
  if (failed) { console.log(reply); process.exit(1); }
} else if (kind === "food-restore") {
  let failed = false;
  withLock(() => update((log, record) => {
    const journal = readJournal();
    const last = journal.pop();
    if (!last) { failed = true; reply = "There's no removed food entry to put back."; return; }
    const nutrition = log.nutritionLog ?? {}; const entries = nutrition[last.day] ?? [];
    if (!entries.some((e) => e.id === last.entry.id)) entries.push(last.entry);
    nutrition[last.day] = entries; log.nutritionLog = nutrition;
    if (last.day === day) record.calories = entries.reduce((a, e) => a + (e.calories ?? 0), 0);
    writeJournal(journal);
    reply = `Put ${String(last.entry.title).trim()} back (${last.entry.calories ?? 0} kcal): ${entries.reduce((a, e) => a + (e.calories ?? 0), 0)} kcal ${last.day === day ? "today" : `on ${last.day}`}.`;
  }));
  if (failed) { console.log(reply); process.exit(1); }
} else if (kind === "food") {
  const [title, kcal, protein, said] = rest;
  const calories = Number(kcal), grams = protein === undefined ? 0 : Number(protein);
  if (!title?.trim() || title.length > 80 || !Number.isInteger(calories) || calories < 0 || calories > 5000 || !Number.isInteger(grams) || grams < 0 || grams > 500) usage();
  const hour = new Date().getHours();
  const named = { breakfast: "Breakfast", lunch: "Lunch", dinner: "Dinner", snack: "Snack" }[String(said ?? "").toLowerCase()];
  if (said !== undefined && !named) usage();
  // What he called it wins over the clock ("for lunch" at 4 AM is still lunch).
  const meal = named ?? (hour >= 4 && hour < 11 ? "Breakfast" : hour < 15 && hour >= 11 ? "Lunch" : hour >= 17 && hour < 22 ? "Dinner" : "Snack");
  withLock(() => update((log, record) => {
    const nutrition = log.nutritionLog ?? {}; const entries = nutrition[day] ?? [];
    entries.push({ id: randomUUID().toUpperCase(), title: title.trim(), meal, calories, protein: grams, carbohydrates: 0, fat: 0, fiber: 0,
                   notes: "Logged by ORION.", loggedAt: new Date().toISOString().replace(/\.\d{3}Z$/, "Z") });
    nutrition[day] = entries; log.nutritionLog = nutrition;
    record.calories = entries.reduce((a, e) => a + (e.calories ?? 0), 0);
    reply = `Logged ${title.trim()} (${calories} kcal): ${record.calories} kcal today.`;
  }));
} else usage();
console.log(reply);

function update(change) {
  const log = JSON.parse(readFileSync(FILE, "utf8"));
  const days = log.days ?? {};
  const record = { waterBottles: 0, calories: 0, supplementIDs: [], updatedAt: "", ...(days[day] ?? {}) };
  change(log, record);
  const stamp = new Date().toISOString().replace(/\.\d{3}Z$/, "Z");
  record.updatedAt = stamp; days[day] = record; log.days = days; log.updatedAt = stamp;
  const scratch = join(dirname(FILE), `.health-log.${randomUUID()}.tmp`);
  writeFileSync(scratch, JSON.stringify(log, null, 2)); chmodSync(scratch, 0o600); renameSync(scratch, FILE);
}
