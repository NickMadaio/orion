#!/bin/zsh
#
# ORION — why does Accessibility say it is granted when it is not?
#
# Because it is granted, to a different app.
#
# Orion is ad-hoc signed, which means it carries no signing identity and macOS
# has to identify it by its cdhash — a hash of the binary. Every rebuild
# produces a different binary, so every rebuild is a NEW application as far as
# the privacy database is concerned. The old grant stays attached to the old
# binary, which no longer exists, while the one you are running has nothing.
#
# The rows in System Settings all say "Orion" because they all came from a
# bundle named Orion. They are not the same app.
#
# This script shows what is actually there, and what to do about it.
#
emulate -L zsh
set -u

app_installed="/Applications/Orion.app"
app_build="${0:A:h:h}/native/Orion/.build/Orion.app"

bold=$'\033[1m'; dim=$'\033[2m'; grn=$'\033[32m'; yel=$'\033[33m'; red=$'\033[31m'; off=$'\033[0m'

print ""
print "${bold}Orion — permissions${off}"
print ""

# --- which copies exist ---------------------------------------------------
print "${bold}Bundles on this Mac${off}"
found=0
for candidate in "$app_installed" "$app_build"; do
  [[ -d "$candidate" ]] || continue
  found=1
  print "  $candidate"
  info="$(codesign -dvvv "$candidate" 2>&1)"
  ident="$(print -r -- "$info" | grep -i '^Identifier=' | head -1 | cut -d= -f2-)"
  auth="$(print -r -- "$info"  | grep -i '^Authority=' | head -1 | cut -d= -f2-)"
  cdhash="$(print -r -- "$info" | grep -i '^CDHash=' | head -1 | cut -d= -f2-)"
  print "    identifier  ${ident:-<none>}"
  print "    cdhash      ${cdhash:-<none>}   ${dim}(this is the identity TCC uses)${off}"
  if [[ -n "$auth" ]]; then
    print "    signed by   ${grn}${auth}${off}"
  else
    print "    signed by   ${yel}ad-hoc — no identity${off}"
  fi
done
(( found )) || print "  ${red}none built yet${off} — run ./scripts/orion-setup"

# --- what is running ------------------------------------------------------
print ""
print "${bold}Running${off}"
pids=(${(f)"$(pgrep -x Orion 2>/dev/null)"})
if (( ${#pids} )); then
  for pid in $pids; do
    exe="$(ps -o comm= -p "$pid" 2>/dev/null)"
    print "  pid $pid  ${dim}${exe}${off}"
  done
  if (( ${#pids} > 1 )); then
    print "  ${yel}More than one copy is running.${off} Quit them all before testing:"
    print "    pkill -x Orion"
  fi
else
  print "  ${yel}not running${off}"
fi

# --- the actual advice ----------------------------------------------------
cat <<ADVICE

${bold}If Accessibility says granted but push-to-talk does nothing${off}

  The rows are stale. Each one is a previous build. Fix:

  1. System Settings ▸ Privacy & Security ▸ Accessibility
  2. Select EVERY row named "Orion" and remove it with the ${bold}(−)${off} button.
     Do not just toggle them off — remove them. A toggled-off stale row still
     occupies the slot and macOS will not re-prompt while it is there.
  3. Quit Orion completely:      pkill -x Orion
  4. Relaunch from /Applications (not from .build — TCC keys on path too).
  5. Press Right Option once. macOS will prompt. Approve it.
     If no prompt appears, add it manually with (+) → /Applications/Orion.app

${bold}To stop this happening on every rebuild${off}

  Give the app a stable signing identity. Two minutes, once, and permanent:

  1. Open ${bold}Keychain Access${off}
  2. Menu ▸ Keychain Access ▸ Certificate Assistant ▸ Create a Certificate…
       Name:              Orion Local Signing
       Identity Type:     Self Signed Root
       Certificate Type:  Code Signing
  3. Create ▸ continue past the warning ▸ Done
  4. Re-run  ./scripts/orion-setup

  Doing it through Certificate Assistant is what makes it work: it registers
  the certificate as trusted in the same step. The scripted openssl route
  imports the key fine but cannot mark it trusted, and marking a root
  certificate as trusted is not something a script should do to your keychain
  without you watching.

  After that, TCC identifies Orion by the certificate instead of the binary
  hash, and the grant survives every rebuild.

ADVICE
