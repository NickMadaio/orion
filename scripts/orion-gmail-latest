#!/usr/bin/env node
/*
 The newest thread in the inbox, read-only.

   orion-gmail-latest            who it is from, what about, when, a preview
   orion-gmail-latest --full     the same, plus the cleaned body
   orion-gmail-latest --max 3    the newest three
   orion-gmail-latest --json     the same data, structured

 Same problem as `orion-gmail-search`, same fix: this printed the entire thread
 verbatim, so "who emailed me last" cost a few thousand characters of Orion's
 context, most of it unsubscribe boilerplate and privacy policy. The preview
 answers the question that gets asked; `--full` is there for when it does not.

 READS ONLY, and cannot send: the client applies `--readonly` and
 `--gmail-no-send` to every call.
*/

import { fileURLToPath } from "node:url";
import { dirname } from "node:path";
import { getThread, searchThreads, withSnippets } from "./lib/gmail-client.mjs";
import { renderFull, renderSummaries, summarise } from "./lib/gmail-format.mjs";

const ORION_ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
const MAX_LIMIT = 10;

function parseArguments(argv) {
  let full = false;
  let json = false;
  let max = 1;

  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "--full" || argument === "--body") full = true;
    else if (argument === "--json") json = true;
    else if (argument === "--max") {
      const value = Number.parseInt(argv[index + 1] ?? "", 10);
      max = Number.isInteger(value) ? Math.min(MAX_LIMIT, Math.max(1, value)) : 1;
      index += 1;
    } else if (argument === "--help" || argument === "-h") {
      console.log("usage: orion-gmail-latest [--full] [--max N] [--json]");
      process.exit(0);
    }
  }

  return { full, json, max };
}

async function main() {
  const options = parseArguments(process.argv.slice(2));

  const found = await searchThreads(ORION_ROOT, "in:inbox", options.max);
  if (found.length === 0) {
    console.log(options.json ? JSON.stringify({ results: [] }) : "No inbox email found.");
    return;
  }

  if (options.full) {
    const threads = await Promise.all(found.map((thread) => getThread(ORION_ROOT, thread.id)));
    console.log(
      options.json
        ? JSON.stringify({ threads })
        : threads.map((thread) => renderFull(thread)).join("\n\n===\n\n"),
    );
    return;
  }

  const summaries = (await withSnippets(ORION_ROOT, found)).map((thread) => summarise(thread));
  console.log(
    options.json ? JSON.stringify({ results: summaries }) : renderSummaries(summaries),
  );
}

main().catch((error) => {
  console.error(error instanceof Error ? error.message : String(error));
  process.exit(1);
});
