{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orion://schemas/execution-result/v1",
  "title": "ORION Execution Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "proposal_id",
    "status",
    "observed_outcome",
    "audit_reference",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "execution_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "proposal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "status": {"enum": ["SUCCEEDED", "FAILED", "DENIED", "CANCELLED"]},
    "observed_outcome": {"type": "object"},
    "audit_reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"}
  }
}
