#!/usr/bin/env node
// orion-now — "what should Nick do right now", from his real day (2026-09-29; the now record since 2026-10-30).
//   orion-now          one recommendation and its reasons, for a person
//   orion-now --json   the now record (schemaVersion 1, lib/life/now-record.mjs): the same record orion-proactive writes
//                      to now.json on every tick. Read-only: this prints, it never writes now.json.
// Test seams (lib/clock.mjs): ORION_NOW=<ISO> is the clock, ORION_CONTROLLED_DIR=<dir> the state directory.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { buildNow } from "./lib/life/now-state.mjs";
import { bedtimeNudge } from "./lib/life/bedtime.mjs";
import { loadPatterns } from "./lib/life/history.mjs";
import { clockNow, controlledDir } from "./lib/clock.mjs";

const read = (f) => { try { return JSON.parse(readFileSync(f, "utf8")); } catch { return null; } };
const hhmm = (m) => `${String(Math.floor(((m % 1440) + 1440) % 1440 / 60)).padStart(2, "0")}:${String(((m % 60) + 60) % 60).padStart(2, "0")}`;
const local = (iso) => { const d = new Date(iso); return Number.isNaN(d.getTime()) ? "?" : hhmm(d.getHours() * 60 + d.getMinutes()); };
const at = clockNow();
const dir = controlledDir();
const record = await buildNow({ dir, now: at });
if (process.argv.includes("--json")) { console.log(JSON.stringify(record, null, 2)); process.exit(0); }

const minute = at.getHours() * 60 + at.getMinutes();
const { shouldBe, mismatch, next } = record;
const head = shouldBe.kind === "sleep"
  ? bedtimeNudge({ state: mismatch ? "awake_late" : "winding_down", minutesPastBedtime: mismatch?.minutes ?? 0, nudgesSent: 2, firstFixedTomorrow: null, now: minute }).message
  : `${shouldBe.kind === "free" ? "FREE" : shouldBe.kind === "travel" ? "LEAVE" : shouldBe.kind === "prepare" ? "PREPARE" : "DO"}: ${shouldBe.kind === "free" ? shouldBe.why : `${shouldBe.title} (${local(shouldBe.start)}-${local(shouldBe.end)}). ${shouldBe.why}`}`;
console.log(`It's ${hhmm(minute)}. ${head}`);
if (mismatch) console.log(`Off plan: ${mismatch.kind}, ${mismatch.minutes} min (since ${local(mismatch.since)}). Tone: ${record.strictness}.`);
if (next) console.log(`Next: ${next.title} at ${local(next.start)}${next.leaveBy ? `, leave by ${local(next.leaveBy)}` : ""}.`);
if (record.declared.length) console.log(`He said today: ${record.declared.map((f) => `"${f.text}"`).join("; ")}.`);
if (record.slipsToday.length) console.log(`Slipped today: ${record.slipsToday.map((s) => `${s.title} (${s.reason})`).join(", ")}.`);
const checkins = (read(process.env.ORION_CHECKIN_FILE || join(dir, "checkins.json"))?.checkins ?? [])
  .filter((c) => !["done", "cancelled", "given_up"].includes(c.loop?.phase));
if (checkins.length) console.log(`Open check-ins: ${checkins.map((c) => `${c.id}: ${c.what} (${c.loop.phase})`).join("; ")}`);
console.log(`Tonight: bed by ${record.sleepPlan.bedtime}, up at ${record.sleepPlan.wake}.`);
const stale = Object.entries(record.sensors).filter(([, s]) => s.stale).map(([name]) => name);
if (stale.length) console.log(`Stale sensors: ${stale.join(", ")}.`);
const patterns = loadPatterns();
const learned = Object.entries(patterns?.byKind ?? {}).filter(([, k]) => k.planned >= 3)
  .map(([kind, k]) => `${kind}: happens ${Math.round(k.rate * 100)}% of the time${k.medianDelay !== null && k.medianDelay >= 10 ? `, usually ${k.medianDelay} min late` : ""}`);
if (patterns?.sleep?.median != null) learned.push(`usually asleep around ${hhmm(patterns.sleep.median)}`);
if (learned.length) console.log(`Patterns so far: ${learned.join("; ")}.`);
if (shouldBe.kind === "unknown") console.log("(Calendar unreadable.)");
