#!/usr/bin/env node
/*
 Calendar and reminders for Orion, through OrionMacBridge.

 Why this and not `accli`: accli needs its own macOS Calendar grant, which was
 never given, so Orion spent a week telling Nick he had no calendar. The bridge
 is Orion's own binary, already written, already speaking EventKit — the
 capability existed the whole time with nothing plugged into it.

 A caution that is easy to get wrong: macOS attributes Calendar access to the
 RESPONSIBLE process, not the binary. Running the bridge from a terminal
 inherits that terminal's grant, which tells you nothing about what happens when
 the OpenClaw gateway LaunchAgent runs it. So this script is verified by an
 actual agent turn, not by running it here.

   orion-agenda today                 events for today
   orion-agenda upcoming              everything the bridge can see ahead
   orion-agenda tasks                 incomplete reminders
   orion-agenda day <when>            events on ONE named day
                                      <when> is a date (2026-09-11), a weekday
                                      (friday), `today`, or `tomorrow`

 Every subcommand prints a dated header before anything else, and that is not
 decoration. On 2026-09-05 the same question -- "I have something this Friday"
 -- was put to Orion four times with identical state and produced three
 different answers: "this Friday (Sep 5)", "this Friday is September 12th", and
 "September 5th, that's today". Sep 5 was a SATURDAY and so is Sep 12. He was
 not misreading the calendar; he was doing weekday arithmetic in his head with
 nothing to check it against, and `today | upcoming | tasks` gave him no way to
 ask about a named day even if he had got the date right -- one run tried to
 invent `orion-agenda friday` and got an exec failure.

 So the resolution is done HERE, in a program that can count, and printed as
 evidence. A date the model read out of tool output is a fact; a date it
 inferred is a guess that looks exactly like a fact.

 Mutations intentionally live in the non-allowlisted orion-agenda-change
 wrapper and are reachable only through typed orion-control actions.
*/

import { execFile } from "node:child_process";
import { existsSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import { promisify } from "node:util";
import { ignoredEvent, loadConfig } from "./lib/life/config.mjs";   // events he never goes to ("(optional)" workshops)

import { sandbox, bridgeRequest, clockNow } from "./lib/life/bridge-path.mjs";
const run = promisify(execFile);

const BRIDGE = join(
  homedir(),
  "Desktop/ORION/native/OrionMacBridge/.build/release/orion-mac-bridge",
);

const [command, ...rest] = process.argv.slice(2);

function fail(message, code = 2) {
  console.error(`orion-agenda: ${message}`);
  process.exit(code);
}

if (!sandbox() && !existsSync(BRIDGE)) {
  fail("the bridge binary is missing — build it with `swift build -c release` in native/OrionMacBridge", 1);
}

/*
 The bridge is a JSON-lines process: one request on stdin, one response on
 stdout. It is not a daemon, so a call is a spawn.
*/
async function ask(action, payload = {}) {
  if (sandbox()) return bridgeRequest(action, payload);
  // Arguments go UNDER `payload` — the bridge decodes `request.payload["title"]`,
  // so spreading them at the top level silently loses every one of them and
  // comes back as "an event needs a title and valid start and end times".
  const request = JSON.stringify({ id: String(Date.now()), action, payload });
  let stdout = "";
  try {
    ({ stdout } = await run("/bin/sh", ["-c", `printf '%s\\n' '${request.replace(/'/g, "'\\''")}' | "${BRIDGE}"`], {
      timeout: 30000,
      maxBuffer: 1024 * 1024 * 8,
    }));
  } catch (error) {
    fail(`bridge did not respond — ${(error.stderr || error.message || "").slice(0, 200)}`, 1);
  }

  const line = stdout.split("\n").find((l) => l.trim().startsWith("{"));
  if (!line) fail(`bridge returned nothing usable: ${stdout.slice(0, 200)}`, 1);

  const parsed = JSON.parse(line);
  if (!parsed.ok) {
    // The bridge's own words. Access failures say which permission is missing,
    // which is the difference between "you have no calendar" and "click this".
    fail(parsed.error || "bridge reported an unspecified failure", 1);
  }
  return parsed.result ?? {};
}

// The bridge hands back JSON inside a JSON string field.
function unpack(result, field) {
  const raw = result[field];
  if (!raw) return [];
  try {
    return JSON.parse(raw);
  } catch {
    return [];
  }
}

const localDay = (at) => at.toLocaleDateString("en-CA");
const timeLabel = (iso) =>
  new Date(iso).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });

function describeEvents(events, { onlyToday }) {
  const today = localDay(new Date());
  const wanted = onlyToday
    ? events.filter((e) => localDay(new Date(e.start)) === today)
    : events;

  if (wanted.length === 0) {
    console.log(onlyToday ? "nothing on the calendar today" : "nothing upcoming");
    return;
  }

  for (const event of wanted.sort((a, b) => new Date(a.start) - new Date(b.start))) {
    const start = new Date(event.start);
    const day = localDay(start) === today ? "today" : start.toLocaleDateString("en-US", {
      weekday: "short",
      month: "short",
      day: "numeric",
    });
    const when = event.allDay === "true" ? "all day" : timeLabel(event.start);
    console.log(`  ${day} ${when} — ${event.title}${event.location ? ` @ ${event.location}` : ""}`);
    // Printed so `remove` works on anything listed, not only on what `add`
    // just returned. Indented under the event so it reads as a detail.
    if (event.identifier) console.log(`      id: ${event.identifier}`);
  }
}

const WEEKDAYS = [
  "sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday",
];

const longDate = (at) =>
  at.toLocaleDateString("en-US", {
    weekday: "long", year: "numeric", month: "long", day: "numeric",
  });

/*
 Resolve a spoken day to one calendar date, in local time.

 A bare weekday means its NEXT occurrence, counting today as day zero: asked on
 a Saturday, "friday" is six days away; asked on a Friday, it is today. That is
 what "this Friday" means to a person, and the only reading that never resolves
 to the past.
*/
function resolveDay(when) {
  const now = clockNow();
  const midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const word = String(when ?? "").trim().toLowerCase();

  if (word === "" || word === "today") return midnight;
  if (word === "tomorrow") {
    return new Date(midnight.getFullYear(), midnight.getMonth(), midnight.getDate() + 1);
  }
  if (/^\d{4}-\d{2}-\d{2}$/.test(word)) {
    const [y, m, d] = word.split("-").map(Number);
    const parsed = new Date(y, m - 1, d);
    if (Number.isNaN(parsed.getTime())) fail(`not a real date: ${when}`);
    return parsed;
  }
  const index = WEEKDAYS.indexOf(word);
  if (index >= 0) {
    const ahead = (index - midnight.getDay() + 7) % 7;
    return new Date(midnight.getFullYear(), midnight.getMonth(), midnight.getDate() + ahead);
  }
  fail(`can't read "${when}" as a day — use a date (2026-09-11), a weekday, today, or tomorrow`);
}

/*
 Printed first by every subcommand, so the model never has to work out what day
 it is. See the note at the top of this file for what happens when it does.
*/
function printGrounding(target) {
  const now = clockNow();
  console.log(`today is ${longDate(now)}`);
  if (!target) return;
  const midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const days = Math.round((target - midnight) / 86400000);
  const distance =
    days === 0 ? "today" : days === 1 ? "tomorrow" : `${days} days from today`;
  console.log(`asked about ${longDate(target)} — ${distance}`);
}

// This program is on OpenClaw's exec allowlist, so its contract must be
// uniformly read-only. An allowlist cannot attach different approval policy to
// different subcommands of the same executable.
if (!["today", "upcoming", "tasks", "day", "deadlines"].includes(command)) {
  // Point at the schedule tools, not the approval-gated calendar actions
  // (2026-10-06: this sentence sent ORION looking for a "typed action" for two minutes).
  fail('this wrapper only reads. To change his day use orion-reschedule: clear (every planned block left today), drop "X", skip "<class>", move/resize/extend "X"; to-dos: orion-tasks');
}

switch (command) {
  case "day": {
    const target = resolveDay(rest.find((a) => !a.startsWith("--")));
    // Suppressed under --json for the same reason `upcoming` suppresses it:
    // that output is parsed by other programs, and a fingerprint that carries
    // today's date is a fingerprint that changes at midnight.
    if (!rest.includes("--json")) printGrounding(target);
    const events = unpack(await ask("list_upcoming_calendar_events"), "events_json").filter((e) => !ignoredEvent(e.title));
    const wanted = events.filter((e) => localDay(new Date(e.start)) === localDay(target));
    if (rest.includes("--json")) {
      console.log(JSON.stringify(wanted, null, 2));
      break;
    }
    if (wanted.length === 0) {
      // Said as a fact about that day rather than as a shrug, because
      // "nothing found" and "I did not look" have to sound different.
      console.log("nothing on the calendar that day");
      break;
    }
    for (const event of wanted.sort((a, b) => new Date(a.start) - new Date(b.start))) {
      console.log(`  ${timeLabel(event.start)} — ${event.title}`);
      if (event.identifier) console.log(`      id: ${event.identifier}`);
    }
    break;
  }

  case "today":
  case "upcoming": {
    if (!rest.includes("--json")) printGrounding(null);
    const result = await ask("list_upcoming_calendar_events");
    const events = unpack(result, "events_json").filter((e) => !ignoredEvent(e.title));
    /*
     `--json` emits what was already unpacked, unchanged.

     Added for `orion-focus next`, which binds a session to a calendar BLOCK
     and therefore needs the block's end time. The human format carries only a
     start -- `Mon, Sep 7 12:00 AM — Labor Day` -- so a caller parsing it has
     to guess at a length, and a session whose end time is a guess drifts away
     from the meeting it was supposed to protect.

     Still read-only, which is the contract this whole file is bound by: it is
     the same query, printed differently.
    */
    if (rest.includes("--json")) {
      const today = new Date().toLocaleDateString("en-CA");
      const chosen =
        command === "today"
          ? events.filter((event) => {
              const at = new Date(event.startDate ?? event.start ?? NaN);
              return !Number.isNaN(at.getTime()) && at.toLocaleDateString("en-CA") === today;
            })
          : events;
      console.log(JSON.stringify(chosen, null, 2));
      break;
    }
    describeEvents(events, { onlyToday: command === "today" });
    break;
  }

  case "deadlines": {
    // One-off events for the next 90 days: quizzes, submissions, trips. Weekly
    // classes are left out so they cannot crowd the list.
    printGrounding(null);
    describeEvents(unpack(await ask("list_deadlines"), "events_json"), { onlyToday: false });
    break;
  }

  case "tasks": {
    // His to-do list only (config todoList, "Orion"); Groceries and other lists
    // are not things to plan his day around (2026-09-30). --all shows every list.
    printGrounding(null);
    const { todoList } = loadConfig();
    const all = process.argv.includes("--all");
    const tasks = unpack(await ask("list_incomplete_reminders", all ? {} : { list: todoList }), "reminders_json");
    if (tasks.length === 0) {
      console.log(all ? "nothing outstanding on any list" : `nothing outstanding on ${todoList}`);
      break;
    }
    const lists = [...new Set(tasks.map((task) => task.list || todoList))];
    for (const list of lists) {
      console.log(`${list}${!all ? " (his to-do list)" : list === todoList ? " (his to-do list)" : ""}:`);
      for (const task of tasks.filter((t) => (t.list || todoList) === list)) {
        const due = task.due ? ` (due ${new Date(task.due).toLocaleDateString("en-US")})` : "";
        console.log(`  ${task.title}${due}`);
      }
    }
    break;
  }

  default:
    fail("usage: orion-agenda today | upcoming | deadlines | tasks | day <date|weekday|today|tomorrow>");
}
