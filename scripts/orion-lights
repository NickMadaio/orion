#!/usr/bin/env node
/*
 orion-lights — Nick's LED strip (Lotus Lamp X, Bluetooth), through the ORION app (2026-10-08).

   orion-lights on [brightness 0-100] [warm|white|red|blue|green|purple|RRGGBB]
   orion-lights off
   orion-lights brightness 40
   orion-lights color warm
   orion-lights scan        which strips the Mac can see

 The ORION app does the Bluetooth (native/Orion/Sources/Orion/StripLight.swift)
 and writes the result to orion-controlled/lights-status.json, which this waits
 for. The strip takes one connection: if Lotus Lamp X is open on the phone, close it.
*/
import { readFileSync, statSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import { execFileSync } from "node:child_process";

const STATUS = join(process.env.ORION_CONTROLLED_DIR || join(homedir(), ".openclaw/orion-controlled"), "lights-status.json");
const COLORS = { warm: "ffa040", white: "ffffff", red: "ff0000", green: "00ff00", blue: "0000ff", purple: "8000ff", orange: "ff6000", pink: "ff3080" };
const usage = "usage: orion-lights on [0-100] [warm|white|red|blue|green|purple|orange|pink|RRGGBB] | off | brightness N | color NAME | scan";
const words = process.argv.slice(2).map((w) => w.toLowerCase());
const fail = (m) => { console.error(m); process.exit(2); };

const query = new URLSearchParams();
const [verb, ...rest] = words;
if (verb === "on") query.set("do", "on");
else if (verb === "off") query.set("do", "off");
else if (verb === "scan") query.set("do", "scan");
else if (verb !== "brightness" && verb !== "color") fail(usage);
for (const w of rest) {
  if (/^\d{1,3}%?$/.test(w)) { const n = Number(w.replace("%", "")); if (n > 100) fail("brightness is 0 to 100"); query.set("brightness", String(n)); }
  else if (COLORS[w]) query.set("color", COLORS[w]);
  else if (/^#?[0-9a-f]{6}$/.test(w)) query.set("color", w.replace("#", ""));
  else fail(`don't know "${w}". ${usage}`);
}
if (verb === "brightness" && !query.has("brightness")) fail("orion-lights brightness 0-100");
if (verb === "color" && !query.has("color")) fail("orion-lights color warm|white|red|…|RRGGBB");

const before = (() => { try { return statSync(STATUS).mtimeMs; } catch { return 0; } })();
try { execFileSync(process.env.ORION_REACH_OPEN_BIN || "/usr/bin/open", ["-g", `orion://lights?${query}`], { timeout: 5000 }); }
catch { console.log("The ORION app isn't running, so the lights can't be reached."); process.exit(1); }

const until = Date.now() + 20000;
while (Date.now() < until) {
  await new Promise((r) => setTimeout(r, 300));
  let mtime = 0; try { mtime = statSync(STATUS).mtimeMs; } catch {}
  if (mtime > before) {
    const s = JSON.parse(readFileSync(STATUS, "utf8"));
    if (s.devices) for (const d of s.devices) console.log(`  ${d.name || "(no name)"}  signal ${d.rssi}  ${d.id}`);
    console.log(s.ok ? `Lights: ${s.message}.` : `Lights not changed: ${s.message}.`);
    process.exit(s.ok ? 0 : 1);
  }
}
console.log("No answer from the ORION app about the lights (it may be asking for Bluetooth permission on the Mac).");
process.exit(1);
