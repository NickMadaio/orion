{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orion://schemas/proposal/v1",
  "title": "ORION Proposal Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "correlation_id",
    "source",
    "capability",
    "arguments",
    "created_at",
    "provenance",
    "sensitivity"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "proposal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "source": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,63}$"},
    "capability": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,63}$"},
    "arguments": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "sensitivity": {
      "enum": ["PUBLIC", "INTERNAL", "SENSITIVE", "RESTRICTED"]
    }
  }
}
