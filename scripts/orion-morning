#!/usr/bin/env node
/*
 orion-morning — ORION says good morning when Nick is actually up (2026-10-08).

   orion-morning signal unplugged|used|up [--at ISO] [--dry-run]
        the phone link runs this when the phone reports a wake signal:
          unplugged  the charger came off (a Shortcuts automation on the phone)
          used       a few minutes of phone use after the alarm (Screen Time)
          up         ORION opened on the phone after the alarm
   orion-morning preview     what he would hear right now (nothing is sent)
   orion-morning show        put the morning screen up on the Mac now (silent)
   orion-morning status      whether this morning's briefing went out

 Turning an alarm off is one tap; getting up is the phone off the charger, or
 minutes of use. Either one, after (or just before) the alarm and before 1 PM,
 starts the briefing once a morning: today's plan, when to leave, what's due,
 the weather, and a question. The LED strip comes on (orion-lights), then it is said aloud on the Mac at full volume, then
 ORION listens for a few seconds; nothing heard and the conversation closes.
 The Mac's display wakes to the morning screen (MorningScreen.swift): the day,
 big, on the left; the weather on the right. A locked Mac stays locked — the
 screen is there the moment he unlocks. The gate and the words are lib/reach/morning.mjs.
*/
import { readFileSync, writeFileSync, renameSync, mkdirSync, appendFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import { execFileSync, spawnSync } from "node:child_process";
import { shouldBrief, composeBriefing, buildView } from "./lib/reach/morning.mjs";
import { weather } from "./lib/reach/weather.mjs";
import { liveDay, localDate } from "./lib/life/live-day.mjs";
import { sandbox, bridgeRequest } from "./lib/life/bridge-path.mjs";
import { loadConfig } from "./lib/life/config.mjs";
import { commuteWalls } from "./lib/life/commute.mjs";
import { waitsFor } from "./lib/life/task-spread.mjs";

const DIR = process.env.ORION_CONTROLLED_DIR || join(homedir(), ".openclaw/orion-controlled");
const STATE = join(DIR, "morning-sent.json");
const here = import.meta.dirname;
const args = process.argv.slice(2);
const flag = (n) => { const i = args.indexOf(n); return i >= 0 ? args[i + 1] : undefined; };
const [command, signal] = args.filter((a, i) => !a.startsWith("--") && args[i - 1] !== "--at");
const dry = args.includes("--dry-run");
const now = new Date();
const today = localDate(now);
const readJson = (p) => { try { return JSON.parse(readFileSync(p, "utf8")); } catch { return null; } };
const state = readJson(STATE) ?? {};
const usage = "usage: orion-morning signal unplugged|used|up [--at ISO] [--dry-run] | preview | show | status";

if (command === "status") {
  const sent = state[today];
  console.log(sent ? `Briefed at ${new Date(sent.at).toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })} (phone ${sent.signal}).` : "No morning briefing yet today.");
  process.exit(0);
}
if (!["signal", "preview", "show"].includes(command)) { console.error(usage); process.exit(2); }
if (sandbox()) { console.log("Not during an evaluation."); process.exit(0); }

if (command === "preview") {
  console.log((await gather()).text);
  process.exit(0);
}
if (command === "show") {
  console.log(showScreen((await gather()).view) ? "Morning screen is up on the Mac." : "The ORION app isn't running.");
  process.exit(0);
}

const signalAt = flag("--at") ? new Date(flag("--at")) : now;
// The alarm that actually rang: a wake-up he asked for (orion-wake) beats the
// planner's automatic one. 2026-10-08: alarm moved to 7:15, the planner still
// said 09:00, and his 7:15 unplug was judged "too early". Earliest one wins.
let wake = null;
try { wake = JSON.parse(run("orion-now", ["--json"])).sleep?.wake ?? null; } catch {}
const asked = readJson(join(DIR, "wake-request.json"))?.at;
if (asked && localDate(new Date(asked)) === today) {
  const clock = new Date(asked).toTimeString().slice(0, 5);
  if (!wake || clock < wake) wake = clock;
}
const gate = shouldBrief({ signal, signalAt, now, wake, briefedToday: !!state[today] });
// Every signal and what was decided, for checking a morning afterwards.
if (!dry) { try { appendFileSync(join(DIR, "morning.log"), `${now.toISOString()} ${signal} at ${flag("--at") ?? "now"} → ${gate.ok ? "briefing" : `no: ${gate.reason}`}\n`); } catch {} }
if (!gate.ok) { console.log(`No briefing: ${gate.reason}.`); process.exit(0); }

const { text, view } = await gather();
if (dry) { console.log(`DRY RUN — would say aloud (${gate.reason}): ${text}`); process.exit(0); }
// The screen, then the lights (2026-10-08): the strip coming on is the cue that ORION is about to talk.
showScreen(view);
spawnSync(process.execPath, [join(here, "orion-lights"), "on", "100", "warm"], { encoding: "utf8", timeout: 25000 });
const sent = spawnSync(process.execPath, [join(here, "orion-reach"), text, "--kind", "morning", "--urgent", "--loud", "--listen",
  "--channel", "mac", "--why", `morning: ${gate.reason}`], { encoding: "utf8", timeout: 30000 });
process.stdout.write(sent.stdout ?? "");
if (sent.status === 0 && /^Sent/.test(sent.stdout ?? "")) {
  mkdirSync(DIR, { recursive: true });
  const keep = Object.fromEntries(Object.entries({ ...state, [today]: { at: now.toISOString(), signal } }).sort().slice(-14));
  writeFileSync(`${STATE}.tmp`, JSON.stringify(keep, null, 2));
  renameSync(`${STATE}.tmp`, STATE);
}

function run(script, list) {
  try { return execFileSync(process.execPath, [join(here, script), ...list], { encoding: "utf8", timeout: 15000 }); } catch { return ""; }
}

/** Write what the screen shows and ask the ORION app to put it up. */
function showScreen(view) {
  try {
    mkdirSync(DIR, { recursive: true });
    writeFileSync(join(DIR, "morning-view.json"), JSON.stringify(view, null, 2));
    execFileSync("/usr/bin/open", ["-g", "orion://morning-screen"], { timeout: 5000 });
    return true;
  } catch { return false; }
}

async function gather() {
  let day = [];
  try { day = await liveDay(today); } catch {}
  const travel = (() => { try { return commuteWalls(day, loadConfig()); } catch { return []; } })();
  const same = (a, b) => String(a).toLowerCase().includes(String(b).toLowerCase()) || String(b).toLowerCase().includes(String(a).toLowerCase());
  let todos = [];
  try {
    const raw = JSON.parse((await bridgeRequest("list_incomplete_reminders", { list: loadConfig().todoList })).reminders_json ?? "[]");
    const titles = raw.map((t) => t.title);
    todos = raw.map((t) => ({ title: t.title, dueDate: t.due ? localDate(new Date(t.due)) : null,
      booked: day.some((b) => same(b.title, t.title)), waiting: !!waitsFor(t.notes, titles.filter((x) => x !== t.title)) }));
  } catch {}
  const sky = await weather(DIR, now).catch(() => null);
  const facts = { now, day, travel, todos, today, weather: sky };
  return { text: composeBriefing(facts), view: buildView(facts) };
}
