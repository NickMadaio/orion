{
  "schemaVersion": 1,
  "purpose": "One ordering rule, two implementations: backend/sync/ordering.py and native/OrionMobile/Sources/MobileCore/Conversation.swift. Two implementations of one rule is exactly how two devices end up disagreeing about history -- the failure Phase 17 exists to prevent. Both sides are checked against these cases: scripts/orion_v2_sync_check.py and MobileCoreCheck.",
  "rule": "sort by (sequence, device_id, message_id). Wall-clock time is never an input.",
  "expectationsWrittenBy": "hand, on 2026-08-25, not generated from either implementation",
  "cases": [
    {
      "name": "arrival order does not matter",
      "input": [
        {
          "message_id": "m2",
          "device_id": "phone",
          "sequence": 2
        },
        {
          "message_id": "m1",
          "device_id": "phone",
          "sequence": 1
        },
        {
          "message_id": "m3",
          "device_id": "phone",
          "sequence": 3
        }
      ],
      "expected_order": [
        "m1",
        "m2",
        "m3"
      ]
    },
    {
      "name": "equal sequences break on device id",
      "input": [
        {
          "message_id": "from-mac",
          "device_id": "mac",
          "sequence": 4
        },
        {
          "message_id": "from-iphone",
          "device_id": "iphone",
          "sequence": 4
        }
      ],
      "expected_order": [
        "from-iphone",
        "from-mac"
      ]
    },
    {
      "name": "equal sequence and device break on message id",
      "input": [
        {
          "message_id": "b",
          "device_id": "phone",
          "sequence": 7
        },
        {
          "message_id": "a",
          "device_id": "phone",
          "sequence": 7
        }
      ],
      "expected_order": [
        "a",
        "b"
      ]
    },
    {
      "name": "a device returning from offline sorts after what happened without it",
      "input": [
        {
          "message_id": "late",
          "device_id": "phone",
          "sequence": 9
        },
        {
          "message_id": "meanwhile-1",
          "device_id": "mac",
          "sequence": 7
        },
        {
          "message_id": "meanwhile-2",
          "device_id": "mac",
          "sequence": 8
        }
      ],
      "expected_order": [
        "meanwhile-1",
        "meanwhile-2",
        "late"
      ]
    },
    {
      "name": "device ids compare as text, not as numbers",
      "input": [
        {
          "message_id": "ten",
          "device_id": "device-10",
          "sequence": 1
        },
        {
          "message_id": "two",
          "device_id": "device-2",
          "sequence": 1
        }
      ],
      "expected_order": [
        "ten",
        "two"
      ]
    },
    {
      "name": "large sequences stay in order",
      "input": [
        {
          "message_id": "big",
          "device_id": "phone",
          "sequence": 1000000
        },
        {
          "message_id": "bigger",
          "device_id": "phone",
          "sequence": 1000001
        },
        {
          "message_id": "small",
          "device_id": "phone",
          "sequence": 2
        }
      ],
      "expected_order": [
        "small",
        "big",
        "bigger"
      ]
    }
  ]
}
