# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Cloud reasoning (Anthropic) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Master switch. With this false, Orion is 100% local and never makes a paid call.
ORION_ENABLE_CLOUD=false

# Tier models. Orion picks between these; it does not use anything else.
ORION_MODEL_LOCAL=gpt-oss:20b
ORION_MODEL_FAST=claude-haiku-4-5-20251001
ORION_MODEL_DEEP=claude-sonnet-5

# Hard ceiling in USD per calendar month. Orion refuses cloud calls past this
# and falls back to local. Set what you can actually afford to lose.
ORION_MONTHLY_BUDGET_USD=15

# --- Web access ---
# Free tier: 2000 queries/month, no card required.
# Get a key at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# --- Voice providers (optional; both fall back to the local engine) ---
# These are ears and mouth only: audio in, audio out. They never carry a
# request to a model and never touch the gateway.
#
# Text-to-speech. Get a key at https://elevenlabs.io/app/settings/api-keys
# Turn it on in Orion ▸ Preferences ▸ Voice, or with ORION_TTS_CLOUD_VOICE=1.
ELEVENLABS_API_KEY=

# Speech-to-text. Get a key at https://console.deepgram.com/signup
# Turn it on in Orion ▸ Preferences ▸ Voice ▸ Listening.
DEEPGRAM_API_KEY=

# --- Remote notifications (optional) ---
# Create a private Discord channel and a webhook when you are ready. Keep this
# URL private: anyone with it can post into that channel.
ORION_DISCORD_WEBHOOK_URL=
ORION_DISCORD_NOTIFICATIONS=false

# --- Personal finance dashboard (optional, read-only) ---
# Start with Plaid Sandbox. Do not add bank credentials here: Plaid Link handles
# bank authorization in its own secure browser flow.
ORION_PLAID_ENABLED=false
ORION_PLAID_ENV=sandbox
ORION_PLAID_CLIENT_ID=
ORION_PLAID_SECRET=
