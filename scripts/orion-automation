#!/usr/bin/env node
/*
 Turning a proposal into something that actually runs. Nick's half.

 ## Why this is a separate program, again

 Phase 57 is two sentences:

     Model may propose automation.
     Model may not silently install permanent automation.

 The second was already true by ABSENCE — nothing in ACTION_CATALOG could
 write a LaunchAgent or a crontab, and `openclaw` is not on the exec allowlist.
 Absence is strong enforcement and it is also brittle: it holds until somebody
 adds a wrapper for an unrelated reason and does not notice what it reaches.

 So it is structural now. The plugin has `automation_propose`, `automation_list`,
 `automation_simulate` and `automation_withdraw`, and there is no install
 action — installing lives here, and this file is:

   · absent from `~/.openclaw/exec-approvals.json`, so with `ask: off` and
     `askFallback: deny` Orion's call to it is refused rather than prompted;
   · in FORBIDDEN_SCRIPTS, so the repair engine will not edit it;
   · the only writer of `automations/installed/`, which is the directory the
     scheduler is driven from.

 Same argument as `orion-approve` and `orion-mode`, and the same check suite
 holds it.

 ## What install actually does

 Derives the cron expression from the proposal's TRIGGER SHAPE. The expression
 is never accepted as input, from anybody — a minute-field typo is a factor of
 sixty, and there is no reason a person should be typing one when the shape is
 already written down.

   orion-automation                  what is proposed and what is running
   orion-automation show <name>      the whole proposal, every field
   orion-automation simulate <name>  how often it would fire, before deciding
   orion-automation schedule-plan <name> --timezone <IANA>  preview guarded schedule
   orion-automation install <name>   unavailable pending guarded registration
   orion-automation remove <name>    stop it and put it back in proposed
*/

import { execFile } from "node:child_process";
import { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync, unlinkSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import { promisify } from "node:util";

import { loadPlugin } from "./lib/orion-plugin.mjs";
import { automationSchedulePlan } from "./lib/orion-automation-schedule.mjs";
import { removeAutomationSchedule } from "./lib/orion-automation-removal.mjs";
import { readAutomationHistory } from "./lib/orion-automation-history.mjs";
import { summarizeAutomationHistory } from "./lib/orion-automation-history-summary.mjs";
import { withHistory } from "./lib/orion-automation-history-forecast.mjs";

const run = promisify(execFile);
const HOME = homedir();
const ROOT = join(HOME, ".openclaw/orion-controlled/automations");
const PROPOSED = join(ROOT, "proposed");
const INSTALLED = join(ROOT, "installed");
const OPENCLAW = join(HOME, ".openclaw/bin/openclaw");

const plugin = await loadPlugin().catch((error) => {
  console.error(`orion-automation: ${error.message}`);
  process.exit(1);
});
const { describeTrigger, simulate } =
  plugin.automation;

const fail = (message, code = 2) => {
  console.error(`orion-automation: ${message}`);
  process.exit(code);
};

const readDir = (dir) => {
  if (!existsSync(dir)) return [];
  return readdirSync(dir)
    .filter((f) => f.endsWith(".json"))
    .map((f) => {
      try {
        return JSON.parse(readFileSync(join(dir, f), "utf8"));
      } catch {
        return null;
      }
    })
    .filter(Boolean);
};

const [command = "list", name, ...options] = process.argv.slice(2);

if (command === "list") {
  const waiting = readDir(PROPOSED);
  const live = readDir(INSTALLED);
  console.log("");
  console.log(`  ${waiting.length} proposed, waiting on you:`);
  for (const p of waiting) {
    console.log(`    ${p.name.padEnd(24)} ${describeTrigger(p.trigger)}  ->  ${p.action}`);
    console.log(`      ${p.intent}`);
  }
  console.log("");
  console.log(`  ${live.length} running:`);
  for (const p of live) {
    console.log(`    ${p.name.padEnd(24)} ${describeTrigger(p.trigger)}  until ${p.expiresOn}`);
  }
  console.log("");
  if (waiting.length) {
    console.log(`  look first:  orion-automation simulate ${waiting[0].name}`);
    console.log(`  preview:     orion-automation schedule-plan ${waiting[0].name} --timezone <IANA timezone>`);
    console.log("");
  }
  process.exit(0);
}

if (!name) fail(`${command} needs a name. Run orion-automation to see them.`);
if (!plugin.automation.NAME_RE.test(name)) fail("invalid automation name");
const file = join(PROPOSED, `${name}.json`);
const liveFile = join(INSTALLED, `${name}.json`);

if (command === "show") {
  const source = existsSync(file) ? file : liveFile;
  if (!existsSync(source)) fail(`no automation called '${name}'`, 1);
  process.stdout.write(readFileSync(source, "utf8"));
  process.exit(0);
}

if (command === "simulate") {
  if (!existsSync(file)) fail(`no proposal called '${name}'`, 1);
  const proposal = JSON.parse(readFileSync(file, "utf8"));
  const forecast = simulate(proposal);

  // Read history and merge into forecast
  const now = Date.now();
  let summary = null;
  try {
    const histResult = await readAutomationHistory(
      join(ROOT, "history", `${name}.jsonl`),
      { since: now - forecast.windowDays * 86400000, until: now },
    );
    if (histResult.entries.length > 0) {
      summary = summarizeAutomationHistory(histResult.entries, { from: now, windowDays: forecast.windowDays });
    }
  } catch {
    // Treat any read error as no history
  }

  const shown = withHistory(forecast, summary);

  console.log("");
  console.log(`  ${proposal.name} — ${describeTrigger(proposal.trigger)}`);
  console.log(`  ${proposal.intent}`);
  console.log("");
  console.log(`  Over the last ${shown.windowDays} days it would have fired ${shown.fireCount} time(s).`);
  console.log(`  ${shown.suppressedCount} suppressed by its own conditions.`);
  console.log(`  At most ${shown.messageCount} message(s) would have reached you.`);
  if (shown.observed) {
    const o = shown.observed;
    console.log(`  Observed: fired ${o.firings}, suppressed ${o.suppressed}, delivered ${o.delivered} on ${o.observedDays} day(s) with history.`);
  }
  console.log("");
  for (const note of shown.notes) console.log(`  - ${note}`);
  console.log("");
  process.exit(0);
}

if (command === "schedule-plan") {
  if (options.length !== 2 || options[0] !== "--timezone") fail("schedule-plan needs --timezone <IANA timezone>");
  if (!existsSync(file)) fail(`no proposal called '${name}'`, 1);
  try {
    const proposal = JSON.parse(readFileSync(file, "utf8"));
    if (proposal.name !== name) throw new Error("proposal name does not match its file");
    console.log(JSON.stringify(automationSchedulePlan(proposal, options[1], join(HOME, "Desktop/ORION")), null, 2));
  } catch (error) { fail(`cannot prepare schedule: ${error.message}`, 1); }
  process.exit(0);
}

if (command === "install") {
  // The legacy path used unsupported cron flags and bypassed every runtime
  // limit. Never fall back to it while the guarded installer is unfinished.
  fail("installation is unavailable until guarded scheduler registration is connected. Preview with: orion-automation schedule-plan <name> --timezone <IANA timezone>. Nothing was scheduled.", 1);
}

if (command === "remove") {
  if (!existsSync(liveFile)) fail(`'${name}' is not installed`, 1);
  const proposal = JSON.parse(readFileSync(liveFile, "utf8"));
  let removal;
  try {
    removal = await removeAutomationSchedule(run, OPENCLAW, name);
  } catch {
    // Keep the installed record so an outage cannot masquerade as removal.
    // Scheduler errors may contain private command text; do not echo them.
    fail("could not verify scheduler removal; local installation retained. Retry when the scheduler is available.", 1);
  }
  // Back to proposed rather than deleted. Removing a capability should cost
  // less than rebuilding it, and this way "turn it off for now" does not throw
  // away the thing Nick approved.
  mkdirSync(PROPOSED, { recursive: true, mode: 0o700 });
  delete proposal.installedAt;
  delete proposal.cron;
  writeFileSync(file, JSON.stringify(proposal, null, 2) + "\n", { mode: 0o600 });
  unlinkSync(liveFile);
  console.log(`schedule removed for '${name}'${removal.alreadyAbsent ? " (already absent)" : ""}; the proposal is kept. An already-running task may still finish.`);
  process.exit(0);
}

fail("usage: orion-automation [list | show <name> | simulate <name> | schedule-plan <name> --timezone <IANA> | install <name> | remove <name>]");
