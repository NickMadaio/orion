#!/usr/bin/env node
/*
 What Orion may do on his own, and why — derived, never declared.

 Orion's authority already exists in two places that do not know about each
 other. The plugin gate decides whether a catalog ACTION runs: a capability
 tier has to be switched on in the plugin config AND allowed by the permission
 profile AND, for a couple of actions, carry an approval hash bound to the exact
 arguments. The exec layer decides whether a COMMAND runs: it matches the
 command name against an allowlist and, with `ask: off` and `askFallback: deny`,
 denies everything else outright.

 Neither can answer the question Nick actually asks out loud — "what can you do
 without asking me?" — because neither knows the other exists, and because both
 answer in yes/no when the honest answer has four levels in it.

 So this reads both, live, and projects them onto one ladder:

   AUTO      do it, say nothing. Reads, retries, reversible work inside roots
             Orion owns, his own internal state.
   NOTIFY    do it, then say so. Irreversible-by-Orion, or high risk, or it
             changed something in Nick's own space rather than Orion's.
   APPROVAL  ask first. The gate demands a bound approval hash, or the effect
             leaves the machine and cannot be taken back.
  NEVER     not directly reachable — normally an internal implementation
            command whose user-facing typed route enforces the real gate.

 THE ONE RULE THAT MATTERS: nothing here is a hand-written list of what Orion
 can do. Levels are computed from live metadata every run — `ACTION_CATALOG`
 out of the installed plugin, the tier flags out of `openclaw.json`, the profile
 out of `permission-state.json`, the allowlist out of `exec-approvals.json`, and
 the wrapper scripts out of their own source text. Change any of those and the
 output changes with it. This project has been burned by capability prose that
 was true when it was written; prose is the one thing this file must not be.

 Where a capability cannot be classified — a new tier with no config flag, a new
 command on the allowlist — it fails CLOSED to APPROVAL or NEVER and says so
 loudly, rather than guessing AUTO.

   orion-authority show                  the full map
   orion-authority check <capability>    one capability, with the derivation
   orion-authority explain               the spoken answer, for a voice turn
   orion-authority show --json           machine-readable

 What-if flags, all read-only, for asking "what changes if…":
   --profile <name>      derive against a different permission profile
   --mode <name>         derive against a different strictness mode
   --config <path>       derive against a different openclaw.json
   --approvals <path>    derive against a different exec-approvals.json

 THE SECOND AXIS, added 2026-09-02.

 The permission profile answers what EXISTS. The strictness mode answers what
 it COSTS, and `orion-mode` sets it. Every level below is derived under the
 mode in force and then raised, per capability, to a FLOOR no mode may lower:
 changing what Orion may do, reaching a person who is not Nick, and anything he
 cannot undo. `guarded` is the mode this file was written against and is the
 identity -- with it, this output is what it always was.
*/

import { basename } from "node:path";

/*
 The tier derivation, the plugin loader and the allowlist canonicaliser live in
 `lib/orion-plugin.mjs` because `orion-selfdoc` needs exactly the same answers.
 It used to keep its own hand-copied copy of them, that copy went stale, and
 TOOLS.md started telling Orion that self-modification was switched off while
 this file was correctly reporting it as NOTIFY. One derivation, two readers.
*/
import {
  HOME,
  PATHS as P,
  collectCommands,
  deployDrift,
  loadPlugin,
  readJson,
  tierAvailability,
} from "./lib/orion-plugin.mjs";

const LEVELS = ["AUTO", "NOTIFY", "APPROVAL", "NEVER"];
const worst = (a, b) => (LEVELS.indexOf(a) >= LEVELS.indexOf(b) ? a : b);

function die(message, cause) {
  console.error(`orion-authority: ${message}${cause ? `\n  ${cause}` : ""}`);
  process.exit(1);
}

const loadJson = (path, what) =>
  readJson(path, what).catch((error) => die(error.message));

/* --------------------------------------------------- the ladder, catalogue */

/*
 One ladder, four rules, first match wins. Every clause names the live field it
 read, so `check` can print the derivation instead of an assertion.

 R2's last clause is the subtle one. A write whose policy carries a fixed
 `subdirectory` lands in a folder Orion owns even when the root is the Desktop
 (`Orion Controlled Test Workspace/...`), so it is his space, not Nick's. A
 write with a runtime `rootArgument` could land anywhere mutable, so it is
 treated as Nick's.
*/
function classifyAction(name, definition, availability) {
  const tier = availability.get(definition.capabilityTier);
  const execution = definition.execution;

  if (!tier.available) {
    const because = tier.unresolved
      ? `capability tier '${tier.tier}' has no recognisable config flag in the installed plugin, so it is treated as off`
      : !tier.configOn && !tier.profileOn
        ? `config flag ${tier.flag} is not true and profile does not allow tier '${tier.tier}'`
        : !tier.configOn
          ? `config flag ${tier.flag} is not true in openclaw.json`
          : `permission profile does not allow capability tier '${tier.tier}'`;
    return { level: "NEVER", rule: "R0 unreachable", because };
  }
  if (definition.approvalRequired) {
    return {
      level: "APPROVAL",
      rule: "R1 gate demands approval",
      because:
        "the catalog sets approvalRequired, so the validator refuses it until a PERSON has granted it — a ticket like A-7F3K, answered with `approve A-7F3K` or `orion-approve A-7F3K`. Orion cannot satisfy this himself; supplying the hash stopped being enough on 2026-09-02",
    };
  }
  if (definition.reversible === false) {
    return {
      level: "NOTIFY",
      rule: "R2 irreversible",
      because: "the catalog marks it reversible: false — Orion cannot undo it, so Nick has to hear about it",
    };
  }
  if (definition.risk === "high" || definition.risk === "critical") {
    return {
      level: "NOTIFY",
      rule: "R2 blast radius",
      because: `risk is '${definition.risk}' — reversible, but too large to happen silently`,
    };
  }
  const runtimeRoot = Boolean(execution.rootArgument);
  const nicksSpace = execution.root === "desktop" && !execution.subdirectory;
  const writes = !["list_directory", "path_metadata", "read_text", "self_source", "simulate"].includes(
    execution.kind,
  );
  if (writes && (runtimeRoot || nicksSpace)) {
    return {
      level: "NOTIFY",
      rule: "R2 Nick's space",
      because: runtimeRoot
        ? `the root is chosen at call time (${execution.rootArgument}), so this can land in Nick's own files`
        : "it writes into the Desktop itself rather than a folder Orion owns",
    };
  }
  return {
    level: "AUTO",
    rule: "R3 default",
    because:
      execution.kind === "simulate"
        ? "simulated only — it changes nothing at all"
        : `reversible, ${definition.risk} risk, confined to reads or to state Orion owns`,
  };
}

/* ------------------------------------------------------- the ladder, shell */

/*
 Wrapper scripts carry no metadata, so their effects are read out of their own
 source. Each signal is a regex plus the line that matched it, so `check` shows
 evidence rather than an opinion — and if a script is edited to stop doing the
 dangerous thing, its level moves on the next run.
*/
const WRITE_CALL = /\b(?:append|write)File(?:Sync)?\s*\(|>>\s*['"]/;
const SIGNALS = [
  { id: "write_call", re: WRITE_CALL },
  { id: "root_workspace", re: /\.openclaw\/workspace/ },
  { id: "root_orion", re: /\.openclaw\/orion-controlled/ },
  {
    id: "external_delete",
    klass: "irreversible_external",
    re: /delete_calendar_event|delete_reminder|\bgit\s+push\b|\brm\s+-[A-Za-z]*[rf]|\bunlink(?:Sync)?\s*\(/,
    why: "it removes a record that lives outside Orion's own state, and he has no inverse to run",
  },
  {
    id: "outbound_message",
    klass: "irreversible_external",
    re: /-X\s*POST|["']POST["']|webhook/i,
    why: "it delivers a message off this machine, and a sent message cannot be unsent",
  },
  {
    id: "external_create",
    klass: "external_write",
    re: /create_calendar_event|create_reminder/,
    why: "it writes a record into an account Nick reads outside Orion",
  },
  {
    id: "remote_readonly",
    klass: "remote_read",
    re: /--readonly|--gmail-no-send/,
    why: "it reaches a connected account with the read-only flags hard-wired into the call",
  },
  {
    id: "user_file_write",
    klass: "user_write",
    requires: ["write_call", "root_workspace"],
    why: "it writes files Nick reads directly, including memory loaded into every session",
  },
  {
    id: "orion_state_write",
    klass: "orion_state",
    requires: ["write_call", "root_orion"],
    why: "it writes only Orion's own state directory",
  },
];
const CLASS_LEVEL = {
  irreversible_external: "APPROVAL",
  external_write: "NOTIFY",
  user_write: "NOTIFY",
  remote_read: "AUTO",
  orion_state: "AUTO",
};

/*
 The floor for a wrapper script, which is a shorter table than the one for
 actions because a script carries no metadata to derive from.

 Two entries, and the second is the interesting one. `unclassified` is where a
 command lands when it is on the allowlist and nobody has written down what it
 does; `classifyShell` sends it to APPROVAL deliberately, so that adding an
 allowlist entry cannot quietly grant silent execution. A strictness mode that
 could relax THAT would undo the failing-closed, which is the one property a
 fail-closed default has. So it is a floor, in every mode.

 An `irreversible_external` command floors at NOTIFY rather than APPROVAL, to
 match the action-side rule: Orion may do the thing he cannot undo, he may not
 do it quietly. `git push` to Nick's own repository under `sovereign` is the
 case this is sized for; the outbound-message and delete signals land in the
 same class and get the same answer, which is why the mode is a delegation with
 an end rather than a permanent state.
*/
const SHELL_FLOOR = {
  irreversible_external: "NOTIFY",
  unclassified: "APPROVAL",
};

/*
 Whether this row only reads. Used by `contained`, which is the one mode that
 adds friction: reads stay free, and everything else asks. A mode nobody can
 bear to switch on protects nothing.
*/
const shellReads = (row) =>
  row.rule === "R3 default" && (!row.signals || row.signals.length === 0) && !row.escapeHatch;

function shellWithMode(row, mode) {
  if (row.level === "NEVER") return row;
  const klass = row.rule === "fail closed"
    ? "unclassified"
    : (row.signals ?? []).reduce(
        (worstKlass, signal) =>
          LEVELS.indexOf(CLASS_LEVEL[signal.klass]) > LEVELS.indexOf(CLASS_LEVEL[worstKlass] ?? "AUTO")
            ? signal.klass
            : worstKlass,
        null,
      );
  const floor = (klass && SHELL_FLOOR[klass]) ?? "AUTO";
  const relaxed =
    mode === "guarded"
      ? row.level
      : mode === "contained"
        ? (shellReads(row) ? "AUTO" : "APPROVAL")
        : mode === "sovereign"
          ? "AUTO"
          // `open` clears announcements and keeps gates -- see MODE_RULES in
          // the plugin's strictness.ts for why the two upper rungs were given
          // different jobs rather than different amounts of the same one.
          : row.level === "APPROVAL"
            ? "APPROVAL"
            : "AUTO";
  const level = worst(relaxed, floor);
  if (level === row.level) return row;
  return {
    ...row,
    level,
    baseLevel: row.level,
    rule: level === floor && floor !== relaxed ? `floor (${klass})` : `${mode} mode`,
    because:
      level === floor && floor !== relaxed
        ? `${mode} would have made this ${relaxed}, but ${klass === "unclassified"
            ? "nothing here says what it does, and failing closed is not something a delegation may undo"
            : "it cannot be undone outside Orion's own state"}`
        : `${row.because}; the ${mode} delegation moved it from ${row.level}`,
  };
}

/*
 A line that DEFINES a regular expression is not a line that DOES anything. The
 signals above are matched against raw source text, so the block declaring them
 matched itself, and this file scanned as though it performed every effect it
 knows how to look for. Any script that stores a pattern rather than running it
 fell into the same trap. Pattern declarations are skipped; calls are not.

 This does not make the scan clairvoyant: an English sentence inside a string
 literal that happens to contain a signal word still reads as evidence, which is
 why `orion-authority` classifies itself above AUTO. Fail closed is the right
 direction for that, so it stands.
*/
const PATTERN_DECLARATION = /^\s*(?:(?:const|let|var)\s+)?[\w$]+\s*[:=]\s*\/(?![/*])/;

function scanSource(source) {
  // Keep the real line numbers: `check` prints them as evidence, and evidence
  // pointing at the wrong line is worse than no evidence.
  const lines = source
    .split("\n")
    .map((text, index) => ({ text, line: index + 1 }))
    .filter(({ text }) => !PATTERN_DECLARATION.test(text));
  const hits = new Map();
  for (const signal of SIGNALS) {
    if (signal.requires) continue;
    const hit = lines.find(({ text }) => signal.re.test(text));
    if (hit) hits.set(signal.id, { line: hit.line, text: hit.text.trim().slice(0, 90) });
  }
  const found = [];
  for (const signal of SIGNALS) {
    if (!signal.klass) continue;
    const ok = signal.requires
      ? signal.requires.every((id) => hits.has(id))
      : hits.has(signal.id);
    if (!ok) continue;
    const evidence = hits.get(signal.requires ? signal.requires[0] : signal.id);
    found.push({ ...signal, evidence });
  }
  return found;
}

/*
 Sub-capabilities, where the script's own dispatch exposes them. This matters
 because the exec layer grants at SCRIPT granularity — one allowlist entry
 covers `orion-agenda today` and `orion-agenda remove` alike — so the level the
 machine can enforce is the worst case across the whole file, while the level
 Orion should actually follow is per subcommand. Both are reported; conflating
 them would either block a calendar read or silently permit a calendar delete.
*/
function subCapabilities(source) {
  const parts = source.split(/^\s*case "([a-z][a-z-]*)":/m);
  const subs = [];
  for (let index = 1; index < parts.length; index += 2) {
    const signals = scanSource(parts[index + 1] ?? "");
    const level = signals.reduce((acc, s) => worst(acc, CLASS_LEVEL[s.klass]), "AUTO");
    subs.push({ name: parts[index], level, signals });
  }
  return subs;
}

/*
 A bare command name on the allowlist carries no source to read and no
 arguments to inspect, so it gets a stated class — the one place in this file
 that is a table rather than a derivation, and it is fail-closed: a command
 that appears on the allowlist and is not in this table classifies as
 `unclassified` and lands at APPROVAL until someone looks at it.
*/
const BARE = {
  read: "ls cat head tail wc stat file du df tree rg egrep fgrep grep fd locate mdfind pwd which whoami date uname hostname sw_vers sort uniq cut tr column jq diff basename dirname".split(" "),
  // Read-ish, but each is also a way to run something else: `env CMD`,
  // `find -exec`, `git -c alias`. Calling them read-only would be a lie, and
  // calling them APPROVAL would make Orion ask before `git status`. So they
  // inherit the level of whatever they are being used to DO — see `check`.
  exec_vector: ["find", "env", "git"],
};

function classifyShell(command) {
  const { name, allowlisted, source } = command;
  if (!allowlisted) {
    return {
      level: "NEVER",
      rule: "R0 unreachable",
      because:
        "not on the exec allowlist for agent 'main', where ask is off and askFallback is deny — the call is refused, it does not prompt",
    };
  }
  if (source !== null && source !== undefined) {
    const signals = scanSource(source);
    const level = signals.reduce((acc, s) => worst(acc, CLASS_LEVEL[s.klass]), "AUTO");
    const subs = subCapabilities(source);
    return {
      level,
      rule: signals.length ? "R1/R2 from script source" : "R3 default",
      because: signals.length
        ? signals.map((s) => s.why).join("; ")
        : "nothing in its source writes outside Orion's state or leaves the machine",
      signals,
      subs: subs.filter((s) => s.level !== level).length ? subs : [],
      coarse: subs.length > 0,
    };
  }
  if (BARE.read.includes(name)) {
    return {
      level: "AUTO",
      rule: "R3 default",
      because: "read-only inspection; note the allowlist matches the NAME, so its arguments are unconstrained",
    };
  }
  if (BARE.exec_vector.includes(name)) {
    return {
      level: "AUTO",
      rule: "R3 default, escape hatch",
      escapeHatch: true,
      because:
        "reads at AUTO, but this entry can also launch other work (env CMD, find -exec, git push) — when used that way it takes the level of the effect, not of the command",
    };
  }
  return {
    level: "APPROVAL",
    rule: "fail closed",
    because: "on the allowlist but not classified here, so it gets the most friction until it is",
  };
}

/* ------------------------------------------------------------ the full map */

async function buildMap(options) {
  const plugin = await loadPlugin().catch((error) => die(error.message));
  const configFile = await loadJson(options.config ?? P.config, "openclaw.json");
  const approvals = await loadJson(options.approvals ?? P.approvals, "exec-approvals.json");
  const state = await loadJson(options.state ?? P.state, "permission-state.json").catch(() => null);

  const config = configFile.plugins?.entries?.["orion-control"]?.config ?? {};
  const profile = options.profile ?? state?.profile ?? "restricted_read_only";
  if (!plugin.permissions.PERMISSION_PROFILES.includes(profile)) {
    die(`unknown permission profile '${profile}'`);
  }
  const availability = tierAvailability(plugin, config, profile);

  /*
   The strictness delegation, read live and applied to every row below.

   Read rather than assumed, and defaulting to `guarded` through every failure
   path in `resolveStrictness` -- a missing file, a corrupt one, or one naming
   a mode that does not exist all land on the default, never on something
   softer.
  */
  const strictness = plugin.strictness.resolveStrictness(options.state
    ? options.state.replace(/permission-state\.json$/, "strictness.json")
    : P.strictness);
  const mode = options.mode ?? strictness.mode;
  if (!plugin.strictness.STRICTNESS_MODES.includes(mode)) {
    die(`unknown strictness mode '${mode}'`);
  }

  /*
   Applying the mode is a SEPARATE step from deriving the base level, on
   purpose. `check` prints both -- what the catalog and profile say, and what
   the delegation made of it -- because "why can you do that without asking"
   has two different answers and conflating them would hide which one is in
   play.
  */
  const withMode = (row, definition) => {
    const leveled = plugin.strictness.levelForAction(
      row.name, definition, row.level, mode, strictness.state.except ?? {},
    );
    if (leveled.level === row.level) return row;
    return {
      ...row,
      level: leveled.level,
      baseLevel: row.level,
      rule: leveled.heldByFloor ? `floor (${leveled.floor.reason})` : `${mode} mode`,
      because: leveled.heldByFloor
        ? `${mode} would have made this ${leveled.relaxed}, but ${leveled.floor.because}`
        : `${row.because}; the ${mode} delegation moved it from ${row.level}`,
    };
  };

  const actions = Object.entries(plugin.catalog.ACTION_CATALOG).map(([name, definition]) =>
    withMode(
      {
        kind: "action",
        name,
        tier: definition.capabilityTier,
        risk: definition.risk,
        reversible: definition.reversible,
        enforcedBy: "plugin gate (mechanical)",
        ...classifyAction(name, definition, availability),
      },
      definition,
    ),
  );

  /*
   One row per real command, not per spelling. `exec-approvals.json` holds both
   `~/Desktop/ORION/scripts/orion-recall` and its absolute twin, and keying off
   the raw pattern string used to publish each script twice — once classified
   from its source, and once again at APPROVAL because a tilde is not a path
   anything can open, so the fail-closed branch caught it. The map then said
   orion-recall was simultaneously automatic and gated, and `explain` read that
   contradiction out loud. `collectCommands` collapses spellings onto the real
   file and reads the source once.
  */
  const agent = approvals.agents?.main ?? {};
  const commands = (await collectCommands(approvals, P.scripts)).map((command) =>
    shellWithMode({
      kind: "command",
      name: command.name,
      pattern: command.pattern,
      spellings: command.spellings,
      enforcedBy: "exec allowlist (allow/deny only)",
      ...classifyShell(command),
    }, mode),
  );

  return {
    profile,
    mode,
    modeSource: options.mode
      ? "--mode override"
      : strictness.expired
        ? `strictness.json (the ${strictness.state.mode} delegation expired)`
        : strictness.degraded
          ? `default (${strictness.degraded})`
          : "strictness.json",
    modeExpiresAt: strictness.expired ? null : (strictness.state.expiresAt ?? null),
    profileSource: options.profile ? "--profile override" : "permission-state.json",
    dist: plugin.dist,
    drift: await deployDrift(),
    exec: { security: agent.security, ask: agent.ask, askFallback: agent.askFallback },
    availability: [...availability.values()],
    capabilities: [...actions, ...commands].sort(
      (a, b) => LEVELS.indexOf(a.level) - LEVELS.indexOf(b.level) || a.name.localeCompare(b.name),
    ),
  };
}

/* -------------------------------------------------------------- rendering */

const banner = (map) => [
  `profile: ${map.profile}  (${map.profileSource})`,
  `mode:    ${map.mode}  (${map.modeSource})${map.modeExpiresAt ? ` until ${map.modeExpiresAt}` : ""}`,
  `catalog: ${map.dist.replace(HOME, "~")}`,
  `exec:    security=${map.exec.security} ask=${map.exec.ask} askFallback=${map.exec.askFallback}`,
  map.drift
    ? "WARNING: the built plugin on the Desktop differs from the installed one; this map describes what is INSTALLED."
    : null,
].filter(Boolean).join("\n");

function show(map) {
  console.log(`${banner(map)}\n`);
  for (const level of LEVELS) {
    const rows = map.capabilities.filter((c) => c.level === level);
    const label = level === "NEVER" ? "INTERNAL / OFF" : level;
    console.log(`${label}  (${rows.length})`);
    for (const row of rows) {
      const tag = row.kind === "action" ? row.tier : "shell";
      const flag = row.escapeHatch ? " [escape hatch]" : row.coarse ? " [coarse: see check]" : "";
      console.log(`  ${row.name.padEnd(30)} ${tag.padEnd(22)} ${row.rule}${flag}`);
    }
    console.log("");
  }
  const unresolved = map.availability.filter((t) => t.unresolved);
  if (unresolved.length) {
    console.log(`UNRESOLVED TIERS (failed closed to NEVER): ${unresolved.map((t) => t.tier).join(", ")}`);
  }
}

function check(map, query) {
  const found = map.capabilities.filter(
    (c) => c.name === query || c.pattern === query || c.name === basename(query),
  );
  if (!found.length) {
    console.error(`orion-authority: '${query}' is not a capability Orion has. Try: orion-authority show`);
    process.exit(2);
  }
  for (const row of found) {
    console.log(`${row.name}: ${row.level}`);
    console.log(`  kind        ${row.kind === "action" ? `catalog action, tier '${row.tier}'` : "shell command"}`);
    if (row.kind === "action") {
      console.log(`  metadata    risk=${row.risk} reversible=${row.reversible}`);
    }
    console.log(`  rule        ${row.rule}`);
    console.log(`  because     ${row.because}`);
    console.log(`  enforced by ${row.enforcedBy}`);
    for (const signal of row.signals ?? []) {
      const at = signal.evidence ? ` (line ${signal.evidence.line}: ${signal.evidence.text})` : "";
      console.log(`  evidence    ${signal.id}${at}`);
    }
    if (row.subs?.length) {
      console.log("  subcommands the exec layer CANNOT tell apart — Orion applies these himself:");
      for (const sub of row.subs) console.log(`    ${sub.name.padEnd(16)} ${sub.level}`);
    }
  }
}

function explain(map) {
  const by = (level) => map.capabilities.filter((c) => c.level === level);
  const names = (level, limit) => {
    const rows = by(level).map((c) => c.name);
    return rows.length > limit ? `${rows.slice(0, limit).join(", ")}, and ${rows.length - limit} more` : rows.join(", ");
  };
  console.log(`${banner(map)}\n`);
  console.log(
    `I have ${map.capabilities.length} capabilities. Without asking you I can do ${by("AUTO").length} of them — ` +
      `reading your Desktop, your home folder and my own source, searching your mail, recalling what you told me, ` +
      `browser tabs, music and volume, timers, my own voice tuning, and anything inside the folders I own. ` +
      `Examples: ${names("AUTO", 6)}.`,
  );
  console.log(
    `\nThere are ${by("NOTIFY").length} I will do and then tell you about, because I cannot undo them or they are ` +
      `big enough that you should hear it: ${names("NOTIFY", 8)}.`,
  );
  console.log(
    `\nThere are ${by("APPROVAL").length} I will not do until you say yes: ${names("APPROVAL", 8)}. ` +
      `Those either send something off this machine or delete something you own. ` +
      `When one stops, I give you an id like A-7F3K and you send "approve A-7F3K" — ` +
      `I cannot approve it myself, on purpose.`,
  );
  /*
   The mode, said out loud.

   Left out at first, which was the same mistake this whole file exists to
   stop: a spoken answer about his own authority that is missing half of what
   decides it. Nick sets the mode and Nick is the one asking, so the sentence
   has to name it and has to name the way back.
  */
  const held = map.capabilities.filter((row) => String(row.rule ?? "").startsWith("floor"));
  console.log(
    `\nThat is under the ${map.mode} setting${map.modeExpiresAt ? `, which runs out at ${map.modeExpiresAt}` : ""}. ` +
      (map.mode === "sovereign"
        ? `It is the most permissive one, so almost nothing stops me — except ${held.length} things no setting can free: changing what I am allowed to do, reaching somebody who is not you, and anything I cannot undo.`
        : `You can change how often I have to ask with orion-mode. Run "orion-mode --explain sovereign" to see exactly what that would free and what would still stop me.`),
  );
  const unavailable = by("NEVER");
  const unavailableActions = unavailable.filter((row) => row.kind === "action");
  const internalCommands = unavailable.filter((row) => row.kind === "command");
  if (internalCommands.length > 0) {
    console.log(
      `\nThere are also ${internalCommands.length} internal implementation commands I cannot call directly. ` +
        `That is not ${internalCommands.length} missing user features: their supported typed routes stay available and enforce verification and approval.`,
    );
  }
  if (unavailableActions.length > 0) {
    console.log(
      `\n${unavailableActions.length} user-facing actions are actually unavailable because their config switch or permission profile is off: ` +
        `${unavailableActions.slice(0, 8).map((row) => row.name).join(", ")}.`,
    );
  }
}

/* ------------------------------------------------------------------- main */

const argv = process.argv.slice(2);
const options = {};
const positional = [];
for (let index = 0; index < argv.length; index += 1) {
  const argument = argv[index];
  if (argument === "--json") options.json = true;
  else if (argument.startsWith("--")) {
    const value = argv[index + 1];
    if (value === undefined || value.startsWith("--")) die(`${argument} needs a value`);
    options[argument.slice(2)] = value;
    index += 1;
  } else positional.push(argument);
}

const [command = "show", target] = positional;
if (!["show", "check", "explain"].includes(command)) {
  die(`unknown command '${command}'. Usage: orion-authority show | check <capability> | explain`);
}
if (command === "check" && !target) die("check needs a capability name");

try {
  const map = await buildMap(options);
  if (options.json) {
    console.log(JSON.stringify(command === "check" ? map.capabilities.filter((c) => c.name === target) : map, null, 2));
  } else if (command === "show") show(map);
  else if (command === "check") check(map, target);
  else explain(map);
} catch (error) {
  die("failed to derive the authority map", error.stack ?? error.message);
}
