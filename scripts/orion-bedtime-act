#!/usr/bin/env node
/*
 orion-bedtime-act: the Mac half of the bedtime nudge, through OrionMacBridge.
   orion-bedtime-act quit-app <bundleId>   ask a DISTRACTION app to quit (allowlist only: games, browsers, Discord, TV)
   orion-bedtime-act lock-screen
   orion-bedtime-act dim | undim           lower the built-in display's brightness / put it back
 quit-app and lock-screen only run inside tonight's window: from the nudge in wake-plan.json (a plan Nick set) until
 the next alarm, or 09:00 if none. dim/undim run any time. Prints one JSON line built from the bridge's answer.
 ORION_MAC_BRIDGE overrides the binary and ORION_CONTROLLED_DIR the plan's folder; `--now <iso>` or ORION_NOW the clock
 (tests).
*/
import { spawn } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

const BRIDGE = process.env.ORION_MAC_BRIDGE
  || join(homedir(), "Desktop/ORION/native/OrionMacBridge/.build/release/orion-mac-bridge");
const argv = process.argv.slice(2);
const nowFlag = argv.indexOf("--now");
const nowText = nowFlag >= 0 ? argv.splice(nowFlag, 2)[1] : process.env.ORION_NOW;
const now = nowText ? new Date(nowText) : new Date();
const [command, arg] = argv;
const CONTROLLED = process.env.ORION_CONTROLLED_DIR || join(homedir(), ".openclaw/orion-controlled");

// Distraction apps only. Anything else (Atlas mid-lecture, editors, calls, recorders) is never quit from here.
// Keep in step with native/OrionMacBridge BedtimeActions.distractionApps.
const DISTRACTIONS = [
  /^com\.mojang\./, /^net\.minecraft\./, /^net\.java\.openjdk\.cmd$/, /^com\.curseforge\./, /^com\.overwolf\.curseforge/,
  /^com\.valvesoftware\.steam/, /^com\.epicgames\.launcher$/, /^net\.battle\.app$/, /^com\.blizzard\./,
  /^com\.roblox\./, /^com\.riotgames\./,
  /^com\.apple\.safari$/, /^com\.google\.chrome$/, /^company\.thebrowser\.browser$/, /^org\.mozilla\.firefox$/, /^com\.brave\.browser$/,
  /^com\.hnc\.discord$/, /^com\.apple\.tv$/,
];
const isDistraction = (id) => DISTRACTIONS.some((re) => re.test(id.toLowerCase()));

/** An app he asked to keep open at all times (game-prep.json: always / alwaysIds, written by `orion-apps game-prep keep add`) is never quit here. */
function keptOpen(bundleId) {
  let file;
  try { file = JSON.parse(readFileSync(join(CONTROLLED, "game-prep.json"), "utf8")); } catch { return false; }
  const id = bundleId.toLowerCase(), flat = id.replace(/[^a-z0-9]/g, "");
  const ids = Array.isArray(file?.alwaysIds) ? file.alwaysIds : [], names = Array.isArray(file?.always) ? file.always : [];
  return ids.some((x) => String(x).toLowerCase() === id)
    || names.some((n) => { const k = String(n).toLowerCase().replace(/[^a-z0-9]/g, ""); return k.length >= 4 && flat.includes(k); });
}

/** { start, end } of tonight's window from the plan, or { reason } when there is none. */
function tonightWindow() {
  let plan;
  try { plan = JSON.parse(readFileSync(join(CONTROLLED, "wake-plan.json"), "utf8")); } catch { return { reason: "There is no sleep plan to go by." }; }
  if (plan?.source !== "nick") return { reason: "There is no sleep plan of his to go by." };
  const nudges = (plan.bedtimes ?? []).map((b) => new Date(b?.nudgeAtIso)).filter((d) => !Number.isNaN(d.getTime()) && d <= now);
  if (!nudges.length) return { reason: "It is not bedtime yet." };
  const start = new Date(Math.max(...nudges.map((d) => d.getTime())));
  const alarm = (plan.alarms ?? []).filter((a) => a?.byNick === true).map((a) => new Date(a.iso)).filter((d) => d > start).sort((a, b) => a - b)[0];
  const nine = new Date(start); nine.setHours(9, 0, 0, 0); if (nine <= start) nine.setDate(nine.getDate() + 1);
  return { start, end: alarm ?? nine };
}
function requireWindow(what) {
  const w = tonightWindow();
  if (w.reason) fail(`${what} only runs in tonight's bedtime window. ${w.reason}`, 1);
  if (now >= w.end) fail(`${what} only runs in tonight's bedtime window, and that has ended.`, 1);
}

function fail(message, code = 2) {
  console.error(`orion-bedtime-act: ${message}`);
  process.exit(code);
}

const USAGE = "usage: orion-bedtime-act quit-app <bundleId> | lock-screen | dim | undim";
const plans = {
  "quit-app": () => {
    if (!arg || !/^[A-Za-z0-9][A-Za-z0-9._-]{1,200}$/.test(arg)) fail("quit-app needs a bundle id");
    if (!isDistraction(arg)) fail("that is not one of the distraction apps I quit at bedtime (games, browsers, Discord, TV).", 1);
    if (keptOpen(arg)) fail("you asked me to keep that app open at all times, so I am leaving it open.", 1);
    requireWindow("Quitting an app");
    return ["quit_app", { bundle_id: arg }];
  },
  "lock-screen": () => { requireWindow("Locking the screen"); return ["lock_screen", {}]; },
  dim: () => ["dim", {}],
  undim: () => ["undim", {}],
};
if (!plans[command]) fail(USAGE);
const [action, payload] = plans[command]();

if (!existsSync(BRIDGE)) fail("the OrionMacBridge release binary is missing -- build it with `swift build -c release` in native/OrionMacBridge", 1);

const stdout = await new Promise((resolve, reject) => {
  const child = spawn(BRIDGE, [], { stdio: ["pipe", "pipe", "pipe"] });
  let out = "";
  let err = "";
  const timer = setTimeout(() => child.kill("SIGKILL"), 15_000);
  child.stdout.on("data", (c) => (out += String(c)));
  child.stderr.on("data", (c) => (err += String(c)));
  child.on("error", reject);
  child.on("close", (code) => {
    clearTimeout(timer);
    code === 0 ? resolve(out) : reject(new Error(err.trim() || `bridge exited ${code}`));
  });
  child.stdin.end(`${JSON.stringify({ id: String(Date.now()), action, payload })}\n`);
}).catch((e) => fail(`bridge did not respond: ${String(e.message ?? e).slice(0, 240)}`, 1));

const line = String(stdout).split("\n").find((l) => l.trim().startsWith("{"));
if (!line) fail("bridge returned no JSON response", 1);
let parsed;
try { parsed = JSON.parse(line); } catch { fail("bridge returned malformed JSON", 1); }
if (!parsed.ok) fail(parsed.error || "bridge reported an unspecified failure", 1);
console.log(JSON.stringify({ action: command, ...(parsed.result ?? {}) }));
