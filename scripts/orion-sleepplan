#!/usr/bin/env node
// orion-sleepplan — Nick's sleep plan: when he gets up on each day, how long before class, and the nights he is let off
// the bedtime lockdown (W10-B, 2026-11-02: "im going to start waking up earlier and going to bed earlier").
//   orion-sleepplan show                                         the plan and the coming week, in words
//   orion-sleepplan set --days mon,wed,thu --wake 06:00 [--only] [--also tue,fri=09:00 …] [--rest 09:00] [--lead 180|off] [--sleep 8]
//                                                                 wake at 06:00 on those days (--only: other days lose theirs;
//                                                                 --rest: every other day wakes then); one write for all of it
//   orion-sleepplan unset --days tue,fri                           those days go back to the class rule / usual wake
//   orion-sleepplan lead 180 | lead off                            up at least 180 min before his first class (off: get-ready rule)
//   orion-sleepplan except --date tonight|YYYY-MM-DD --reason friends|party|bar|schoolwork [--until HH:MM]
//                                                                 a night he is out or working: no lockdown that evening
//   orion-sleepplan clear-except [--date tonight|YYYY-MM-DD]       take it back (no --date: every exception)
//   orion-sleepplan bedtime HH:MM|earlier|later [--tonight] [--json]   his bedtime (asleep-by cap); earlier = 30 min earlier, not before 22:00.
//                                                                 HH:MM is EXACT (no sleep-need cap): --tonight names it for this one night only, else every night
//   orion-sleepplan bedtime reset [--json]                         back to the normal bedtime: the exact standing one (bedFixed) and tonight's override are cleared
//   orion-sleepplan bedtime shift N [--tonight] [--json]           tonight's bedtime N minutes later (+) or earlier (-); the answer's `readback` is re-read from disk
//   orion-sleepplan refresh [--json]                               rewrite wake-plan.json from the stored plan + calendar (the nudge tick does this daily)
//   orion-sleepplan wake-on --date tomorrow|today|next|sat|YYYY-MM-DD --time HH:MM|off [--json]
//                                                                 ONE morning's alarm (beats the per-day plan and the class lead); off = none that morning
//   orion-sleepplan shift --minutes 20|-15 [--json]               the next alarm later (+) or earlier (-); refuses when none is ahead
//   orion-sleepplan alarms [--json]                               the alarms ahead, and whether the phone's receipt matches them
//   orion-sleepplan plan --json [--days … --wake … --only --rest …] [--lead N|off]   the coming week as data; the flags preview a change
//                                                                 without saving it
// Days: mon..sun, "weekdays", "weekends", "all", "gym" (the days his plan ties to the gym — set with --gym on set — else the
// calendar's Gym days when they are not every day, else gym days he set; unknown is an error naming it, so ORION asks). Every write also rewrites wake-plan.json (shape documented in
// scripts/lib/life/sleep-plan.mjs) for the Mac alarm and bedtime-nudge engine. During a sandboxed evaluation it reads and
// writes the eval copies (eval-life-config.json, eval-wake-plan.json), like scripts/lib/life/config.mjs, and the sandbox clock.
// Add --json to any write for a machine-readable answer. Exit 2: bad arguments, nothing saved; exit 3: refused (a reason
// that does not lift the lockdown), nothing saved.
import { CONFIG_FILE, DEFAULTS, loadConfig, setConfig, unsetConfig, setSleepPlan, sleepPlanOf, toMinute, WEEKDAYS } from "./lib/life/config.mjs";
import { clockNow, sandbox } from "./lib/life/bridge-path.mjs";
import { controlledDir, isolated } from "./lib/clock.mjs";
import { readFileSync, rmSync } from "node:fs";
import { join } from "node:path";
import { homedir } from "node:os";
import { napMinutesOf } from "./lib/life/naps.mjs";
import { acquireLock } from "./lib/reminders/store.mjs";
// Naps WHOOP saw (health-log days[date].napMinutes) credit that evening's bedtime (W20).
const napToday = (date) => { try { return napMinutesOf(JSON.parse(readFileSync(join(controlledDir(), "health-log.json"), "utf8")).days?.[date]); } catch { return 0; } };
import { addDays, eveningOf, hhmm, instant, parseDays, pruneOverrides, wakeDate, weekPlan, wakePlanDoc, withBedOverride, withException, withOverride, withWake, writeWakePlan } from "./lib/life/sleep-plan.mjs";

const args = process.argv.slice(2);
const [command = "show"] = args;
const flag = (name) => { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : undefined; };
const flags = (name) => args.flatMap((a, i) => (a === name && args[i + 1] !== undefined ? [args[i + 1]] : []));
const has = (name) => args.includes(name);
const json = has("--json");
const HHMM = /^([01]?\d|2[0-3]):([0-5]\d)$/;
const fail = (code, text) => { if (json) console.log(JSON.stringify({ ok: false, error: text })); else console.error(`NOTHING WAS SAVED: ${text}`); process.exit(code); };
const normTime = (raw) => { const m = HHMM.exec(String(raw ?? "")); return m ? `${m[1].padStart(2, "0")}:${m[2]}` : null; };

const now = clockNow();
const wakePlanName = `${sandbox() ? "eval-" : ""}wake-plan.json`;

async function blocksSource() {
  try {
    const { calendarEvents, toBlocks } = await import("./lib/life/live-day.mjs");
    const events = await calendarEvents();
    return { calendar: "ok", blocksOf: (d) => toBlocks(events, d) };
  } catch (error) {
    return { calendar: `unreadable: ${String(error?.message ?? error).slice(0, 100)}`, blocksOf: () => [] };
  }
}

const dateArg = (raw) => (!raw || raw === "tonight" || raw === "today" ? eveningOf(now) : /^\d{4}-\d{2}-\d{2}$/.test(raw) ? raw : null);

const leadOf = (raw) => {
  if (raw === "off") return null;
  const n = Number(raw);
  if (!Number.isInteger(n) || n < 15 || n > 360) throw new TypeError("lead must be 15..360 minutes, or off");
  return n;
};
/**
 "Gym days" (W10-B review): the weekdays with a Gym block on his calendar this coming week; else the gym days he set himself
 (anchors/gymDays saved in his config, not the every-day default). Unknown: an error that names it, so ORION asks which days.
*/
function gymDays(blocksOf, plan) {
  // 1. The days his own plan ties to the gym ("up at 6 mon wed thu for gym"): the most specific thing he said.
  if (Array.isArray(plan?.gymDays) && plan.gymDays.length) return WEEKDAYS.filter((d) => plan.gymDays.includes(d));
  // 2. The calendar's Gym days, only when they single some days out: a Gym block every day (the daily anchor) names no days.
  const seen = new Set();
  for (let i = 0; i < 7; i += 1) {
    const date = addDays(now.toLocaleDateString("en-CA"), i);
    if (blocksOf(date).some((b) => b.kind === "gym")) seen.add(WEEKDAYS[new Date(`${date}T12:00:00`).getDay()]);
  }
  if (seen.size && seen.size <= 5) return WEEKDAYS.filter((d) => seen.has(d));
  let saved = {};
  try { saved = JSON.parse(readFileSync(CONFIG_FILE, "utf8")); } catch { /* none saved */ }
  const own = Array.isArray(saved.anchors) || Array.isArray(saved.gymDays) ? loadConfig().anchors.filter((a) => a.kind === "gym").flatMap((a) => a.days) : [];
  const days = [...new Set(own)].map((d) => WEEKDAYS[d % 7]);
  return days.length && days.length < 7 ? WEEKDAYS.filter((d) => days.includes(d)) : [];
}
const daysOf = (raw, blocksOf, plan) => {
  const words = String(raw ?? "").toLowerCase().split(/[\s,]+/);
  const gym = words.includes("gym") ? gymDays(blocksOf, plan) : [];
  if (words.includes("gym") && !gym.length) throw new TypeError("gym days unknown: no Gym block this week and no gym days set");
  return parseDays(raw, gym);
};
const sleepOf = (raw) => { const n = Number(raw); if (!(n >= 5 && n <= 11)) throw new TypeError("--sleep must be 5..11 hours"); return n; };

/** The morning of the next alarm he has (plan or class), counting overrides; a RangeError when none is ahead. */
function nextAlarmDate(plan, blocksOf, config) {
  const ahead = weekPlan({ now, config: { ...config, sleepPlan: storable(plan, config.sleepPlan) }, blocksOf, wakeRequest: null, napMinutesOf: napToday }).find((d) => ["plan", "class"].includes(d.reason));
  if (!ahead) throw new RangeError("no alarm is set, so there is nothing to turn off");
  return ahead.date;
}

let changed = null;   // { date, time, from? } of a wake-on / shift, for the answer

/** The plan this command would leave, from the stored one. Throws TypeError on bad arguments, RangeError on a refusal. */
function nextPlan(plan, blocksOf, config) {
  if (command === "set" || command === "plan") {
    let next = plan;
    const named = [];
    if (flag("--days") !== undefined) {
      const wake = normTime(flag("--wake"));
      if (!wake) throw new TypeError("--wake must be HH:MM");
      const days = daysOf(flag("--days"), blocksOf, plan);
      next = withWake(next, days, wake, { only: has("--only") });
      if (has("--gym")) next = { ...next, gymDays: days };   // "6am mon wed thu for gym": these are his gym days
      named.push(...days);
    }
    for (const also of flags("--also")) {   // "tue,fri=09:00": more days with their own time, in the same write
      const [rawDays, rawWake] = also.split("=");
      const wake = normTime(rawWake);
      if (!wake) throw new TypeError("--also must be DAYS=HH:MM");
      const days = daysOf(rawDays, blocksOf, plan);
      next = withWake(next, days, wake);
      named.push(...days);
    }
    if (flag("--rest") !== undefined) {
      const rest = normTime(flag("--rest"));
      if (!rest) throw new TypeError("--rest must be HH:MM");
      next = withWake(next, WEEKDAYS.filter((d) => !named.includes(d)), rest);
    }
    if (flag("--lead") !== undefined) next = { ...next, firstClassLeadMin: leadOf(flag("--lead")) };
    if (flag("--sleep") !== undefined) next = { ...next, sleepHours: sleepOf(flag("--sleep")) };
    if (command === "set" && next === plan) throw new TypeError("set needs --days and --wake, --also, --rest, --lead or --sleep");
    return next;
  }
  if (command === "unset") {
    const days = daysOf(flag("--days"), blocksOf, plan);
    return { ...plan, byDay: Object.fromEntries(Object.entries(plan.byDay).filter(([d]) => !days.includes(d))) };
  }
  if (command === "wake-on") {
    const time = flag("--time") === "off" ? "off" : normTime(flag("--time"));
    if (!time) throw new TypeError("--time must be HH:MM or off");
    const date = flag("--date") === "next" ? nextAlarmDate(plan, blocksOf, config) : wakeDate(flag("--date"), now, time === "off" ? null : toMinute(time));
    if (!date) throw new TypeError("--date must be today, tomorrow, a weekday or YYYY-MM-DD");
    changed = { date, time };
    return withOverride(plan, date, time);
  }
  if (command === "shift") {
    const minutes = Number(flag("--minutes"));
    if (!Number.isInteger(minutes) || minutes === 0 || Math.abs(minutes) > 360) throw new TypeError("--minutes must be a whole number of minutes, 1 to 360, minus for earlier");
    const next = weekPlan({ now, config: { ...config, sleepPlan: storable(plan, config.sleepPlan) }, blocksOf, wakeRequest: null, napMinutesOf: napToday })[0];
    if (!next || !["plan", "class"].includes(next.reason)) throw new RangeError(`no alarm is set for ${next?.date ?? "the next morning"}, so there is nothing to move`);
    const minute = toMinute(next.wake) + minutes;
    if (minute < 0 || minute >= 1440) throw new RangeError("that would move the alarm out of its day");
    changed = { date: next.date, time: hhmm(minute), from: next.wake };
    return withOverride(plan, next.date, hhmm(minute));
  }
  if (command === "bedtime") return bedPlan(plan, blocksOf, config);
  if (command === "lead") return { ...plan, firstClassLeadMin: leadOf(args[1]) };
  if (command === "except") {
    const date = dateArg(flag("--date"));
    const reason = String(flag("--reason") ?? "").toLowerCase().trim();
    const until = flag("--until") === undefined ? null : normTime(flag("--until"));
    if (!date) throw new TypeError("--date must be tonight or YYYY-MM-DD");
    if (flag("--until") !== undefined && !until) throw new TypeError("--until must be HH:MM");
    if (!reason) throw new TypeError("--reason is required");
    if (!plan.legitReasons.includes(reason)) { const e = new RangeError(`"${reason}" does not lift the bedtime lockdown (only ${plan.legitReasons.join(", ")})`); throw e; }
    return withException(plan, { date, reason, until }, now);
  }
  if (command === "clear-except") {
    const raw = flag("--date");
    const date = raw === undefined ? null : dateArg(raw);
    if (raw !== undefined && !date) throw new TypeError("--date must be tonight or YYYY-MM-DD");
    return { ...plan, exceptions: date ? plan.exceptions.filter((e) => e.date !== date) : [] };
  }
  return plan;
}

/** What is stored, without the defaults filled in (so a later default change still applies). */
function storable(plan, saved) {
  const pruned = pruneOverrides(plan, eveningOf(now));
  const kept = Object.keys(pruned.overrides);
  const bedKept = Object.keys(pruned.bedOverrides ?? {});
  const out = { byDay: plan.byDay, ...(kept.length ? { overrides: pruned.overrides } : {}), ...(bedKept.length ? { bedOverrides: pruned.bedOverrides } : {}), ...(plan.bedFixed ? { bedFixed: true } : {}), ...(plan.bedFixed && plan.bedWas ? { bedWas: plan.bedWas } : {}), firstClassLeadMin: plan.firstClassLeadMin, nudgeBeforeMin: plan.nudgeBeforeMin,
    lockdownBelowHours: plan.lockdownBelowHours, legitReasons: plan.legitReasons, exceptions: plan.exceptions,
    ...(Array.isArray(plan.gymDays) && plan.gymDays.length ? { gymDays: plan.gymDays } : {}) };
  const sleepHours = flag("--sleep") !== undefined ? plan.sleepHours : saved?.sleepHours;
  return sleepHours !== undefined ? { ...out, sleepHours } : out;
}

const say = (d) => `${d.weekday[0].toUpperCase()}${d.weekday.slice(1)} ${d.date.slice(5)}: up ${d.wake}${d.firstClass ? ` (class ${d.firstClass.at})` : ""}, asleep by ${d.sleepBy} the night before`;

/** "bedtime earlier": 30 minutes before the current one, never before 22:00 (an earlier one is his to name). */
function earlierThan(current) {
  const base = toMinute(current) < 12 * 60 ? toMinute(current) + 1440 : toMinute(current);
  const m = Math.max(22 * 60, base - 30) % 1440;
  return `${String(Math.floor(m / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;
}

/** The bedtime this command leaves (config.bedtime, the cap night.mjs puts on asleep-by), or undefined for other commands and tonight-only changes. */
function nextBedtime(config) {
  if (command !== "bedtime") return undefined;
  if (bedChange) return bedChange.tonight ? undefined : bedChange.reset ? bedChange.restore : bedChange.time;   // a reset writes back only a bedtime he had before fixing one
  const raw = args[1];
  const t = raw === "earlier" ? earlierThan(config.bedtime) : normTime(raw);
  if (!t) throw new TypeError("bedtime takes HH:MM, earlier, later or shift N");
  return t;
}

/** The bedtime the config FILE holds (not the default the loader fills in), or undefined. */
const savedBedtime = () => { try { const v = JSON.parse(readFileSync(CONFIG_FILE, "utf8")).bedtime; return /^([01]\d|2[0-3]):[0-5]\d$/.test(v ?? "") ? v : undefined; } catch { return undefined; } };
let bedChange = null;   // { time, tonight, evening, was } of a bedtime command, for the plan and the answer
const mins = (hhmm_) => { const m = toMinute(hhmm_); return m < 12 * 60 ? m + 1440 : m; };
const clockOfMin = (m) => `${String(Math.floor((m % 1440) / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;

/**
 * Which evening "tonight" is (w20 r4). Between midnight and the morning the night in progress is still "tonight" while the bedtime asked for is ahead of
 * now ("bed at 2" at 01:30); a bedtime already gone by ("quarter to 12" at 04:30) is the COMING night. The writer, the pruning and the read-back all use it.
 */
function eveningFor(time) {
  const base = now.getHours() < 12 ? addDays(now.toLocaleDateString("en-CA"), -1) : now.toLocaleDateString("en-CA");
  return instant(base, mins(time)) > now ? base : addDays(base, 1);
}
/** The first planned night whose bedtime is still ahead (days are the coming mornings, so at 04:30 days[0] is a night that is over). */
const tonightDay = (days) => days.find((d) => instant(d.evening, mins(d.sleepBy)) > now) ?? days[0];

/** The plan and bedtime a `bedtime` command leaves. HH:MM / later / shift are exact; "earlier" keeps its old cap rule. */
function bedPlan(plan, blocksOf, config) {
  const first = tonightDay(weekPlan({ now, config: { ...config, sleepPlan: storable(plan, config.sleepPlan) }, blocksOf, wakeRequest: null }));
  const evening = first?.evening ?? eveningOf(now);
  const tonightBed = first ? first.sleepBy : config.bedtime;
  const tonight = has("--tonight");
  const raw = args[1];
  let time;
  if (raw === "later") time = clockOfMin(mins(tonightBed) + 30);
  else if (raw === "shift") {
    const n = Number(args[2]);
    if (!Number.isInteger(n) || n === 0 || Math.abs(n) > 360) throw new TypeError("bedtime shift takes a whole number of minutes, 1 to 360, minus for earlier");
    time = clockOfMin(mins(tonightBed) + n);
  } else if (raw === "reset") {
    // "go back to normal bedtime": the exact standing bedtime and tonight's override go, and the bedtime he had before he fixed one comes back,
    // so the computed bedtime (alarm and sleep need) is what is in force again.
    const { bedWas, ...rest } = plan;
    // Back to exactly what the file held before a bedtime was fixed: that time, or no bedtime key at all.
    bedChange = { time: bedWas ?? DEFAULTS.bedtime, tonight: false, evening, was: config.bedtime, reset: true, restore: bedWas, unset: !bedWas && plan.bedFixed === true };
    return { ...rest, bedFixed: false, bedOverrides: {} };
  } else if (raw === "earlier") return plan;   // the legacy cap rule, in nextBedtime
  else time = normTime(raw);
  if (!time) throw new TypeError("bedtime takes HH:MM, earlier, later or shift N");
  const m = mins(time);
  if (m < 20 * 60 || m > 1440 + 4 * 60) throw new RangeError("a bedtime has to be between 8 PM and 4 AM");
  const target = raw === "later" || raw === "shift" ? evening : eveningFor(time);
  bedChange = { time, tonight, evening: target, was: tonightBed };
  if (tonight) return withBedOverride(plan, target, time);
  // A standing bedtime supersedes a one-off for the night it names, so the read-back is what is in force. The bedtime he had is kept to go back to.
  const { [target]: _gone, [evening]: _also, ...overrides } = plan.bedOverrides ?? {};
  return { ...plan, bedFixed: true, bedOverrides: overrides, ...(plan.bedFixed ? (plan.bedWas ? { bedWas: plan.bedWas } : {}) : (savedBedtime() ? { bedWas: savedBedtime() } : {})) };
}

/** An older one-off request (orion-wake) for the same morning is removed: the plan holds that alarm now. Other mornings' requests stay. */
function dropRequestFor(date) {
  const file = join(controlledDir(), "wake-request.json");
  try { if (new Date(JSON.parse(readFileSync(file, "utf8")).at).toLocaleDateString("en-CA") === date) rmSync(file, { force: true }); } catch { /* none */ }
}

/** Whether the Mac's phone link wrote its status in the last 2 minutes (as scripts/orion-wake judges it). */
function linkFresh() {
  try {
    const at = Date.parse(JSON.parse(readFileSync(join(homedir(), "Library/Application Support/ORION Link/status.json"), "utf8")).writtenAt);
    return Number.isFinite(at) && Date.now() - at < 120_000;
  } catch { return false; }
}

/** The phone's last receipt (health-log.json phoneAlarms, written by the Mac link when the phone schedules): confirmed only when it holds exactly these alarms. */
function phoneReceipt(fires) {
  let got = null;
  try { got = JSON.parse(readFileSync(join(controlledDir(), "health-log.json"), "utf8")).phoneAlarms ?? null; } catch { /* no receipt */ }
  if (!got || !Array.isArray(got.fires)) return { state: "unknown", at: null };
  // Same set within 30 s each way (the phone's own tolerance when it matches alarms it already holds).
  const held = got.fires.map((f) => Date.parse(f));
  const near = (a, b) => Math.abs(a - b) < 30_000;
  const same = fires.length === held.length && fires.every((f) => held.some((h) => near(h, Date.parse(f)))) && held.every((h) => fires.some((f) => near(h, Date.parse(f))));
  return { state: same ? "confirmed" : "pending", at: got.at ?? null, holds: got.state ?? null };
}

function alarmsAnswer(days, config) {
  const alarms = wakePlanDoc({ now, days, config }).alarms;
  const brief = days.map((d) => ({ date: d.date, weekday: d.weekday, wake: d.wake, reason: d.reason, evening: d.evening, sleepBy: d.sleepBy }));
  return { ok: true, now: now.toISOString(), alarms, days: brief, phone: phoneReceipt(alarms.map((a) => a.iso)), link: { fresh: linkFresh() },
    next: days[0] ? { date: days[0].date, wake: days[0].wake, asked: alarms.some((a) => a.date === days[0].date), sleepBy: days[0].sleepBy, evening: days[0].evening } : null };
}

async function main() {
  const WRITES = new Set(["set", "unset", "lead", "except", "clear-except", "bedtime", "wake-on", "shift"]);
  const REFRESH = command === "refresh";   // rewrite wake-plan.json from the stored plan and the calendar; the stored plan is untouched
  if (!WRITES.has(command) && !REFRESH && !["show", "plan", "alarms"].includes(command)) fail(2, `unknown command ${command}. Commands: show, set, unset, lead, except, clear-except, wake-on, shift, alarms, plan, refresh`);
  const { calendar, blocksOf } = await blocksSource();   // the calendar is read before the lock: it can be slow, and it is not ours
  // One writer at a time over life-config.json and wake-plan.json (the same lock helper as reminders.json): the config is read AFTER the lock is
  // held, so two changes in a row each start from what the other wrote. process.exit (fail) releases it too.
  if (WRITES.has(command) || REFRESH) {
    const release = acquireLock(controlledDir(), { name: "sleepplan.lock", tries: Number(process.env.ORION_SLEEPPLAN_LOCK_TRIES) || 100 });
    if (!release) fail(1, "another change to your sleep plan is still running; try again");
    process.on("exit", release);
  }
  const config = loadConfig();
  const saved = config.sleepPlan;
  let plan; let bedtime;
  try { plan = nextPlan(sleepPlanOf(config), blocksOf, config); bedtime = nextBedtime(config); }
  catch (error) { fail(error instanceof RangeError ? 3 : 2, error.message); }
  const nextConfig = { ...config, sleepPlan: storable(plan, saved), ...(bedtime ? { bedtime } : bedChange?.unset ? { bedtime: DEFAULTS.bedtime } : {}) };
  const days = weekPlan({ now, config: nextConfig, blocksOf, wakeRequest: null, napMinutesOf: napToday });
  let file = null;
  if (WRITES.has(command) || REFRESH) {
    try {
      if (bedtime) setConfig("bedtime", bedtime, CONFIG_FILE);
      else if (bedChange?.unset) unsetConfig("bedtime", CONFIG_FILE);
      if (!REFRESH && (!bedtime || bedChange)) setSleepPlan(storable(plan, saved), CONFIG_FILE);
    } catch (error) { fail(2, error.message); }
    file = writeWakePlan(controlledDir(), wakePlanName, wakePlanDoc({ now, days, config: nextConfig }));
    // The plan now holds that morning's alarm; an older one-off request would win over it on the phone.
    if (changed && (!sandbox() || isolated())) dropRequestFor(changed.date);
  }
  if (command === "alarms") { console.log(JSON.stringify(alarmsAnswer(days, nextConfig), null, 2)); return; }
  const plain = sleepPlanOf(nextConfig);
  const readbackOf = () => {   // what the engine and the phone will use, re-read from the files just written
    const evening = bedChange?.evening ?? tonightDay(days)?.evening;
    let doc = null; try { doc = JSON.parse(readFileSync(join(controlledDir(), wakePlanName), "utf8")); } catch { /* unreadable */ }
    const b = doc?.bedtimes?.find((x) => x.date === evening);
    const day = days.find((d) => d.evening === evening);
    if (!b || !day) return null;
    const hours = Math.round(((Date.parse(day.wakeIso) - Date.parse(b.sleepByIso)) / 3600_000) * 100) / 100;
    return { evening, sleepBy: b.sleepBy, nudgeAt: b.nudgeAt, wake: day.wake, wakeDate: day.date, alarmAsked: !!doc.alarms?.some((a) => a.date === day.date), hours,
      lockdownBelowHours: doc.lockdownBelowHours ?? plain.lockdownBelowHours, standing: loadConfig().bedtime, tonightOnly: !!bedChange?.tonight, fixed: sleepPlanOf(loadConfig()).bedFixed };
  };
  if (json || command === "plan") {
    console.log(JSON.stringify({ ok: true, saved: WRITES.has(command), preview: command === "plan", calendar, now: now.toISOString(), plan: plain, bedtime: nextConfig.bedtime, ...(bedtime ? { was: config.bedtime } : {}), ...(bedChange ? { was: bedChange.was, tonight: bedChange.tonight, readback: readbackOf() } : {}), days, ...(file ? { wakePlan: wakePlanName } : {}), ...(changed ? { changed, ...(changed.time === "off" ? { dateOff: changed.date } : {}) } : {}) }, null, 2));
    return;
  }
  const head = WRITES.has(command) ? "Saved. " : "";
  const byDay = Object.entries(plain.byDay).map(([d, x]) => `${d} ${x.wake}`).join(", ") || "none";
  console.log(`${head}Sleep plan: wake ${byDay}; ${plain.firstClassLeadMin ? `up ${plain.firstClassLeadMin} min before the first class` : "get-ready rule before the first commitment"}; ${plain.sleepHours} h sleep; nudge ${plain.nudgeBeforeMin} min before bed; lockdown under ${plain.lockdownBelowHours} h.`);
  if (plain.exceptions.length) console.log(`Exceptions: ${plain.exceptions.map((e) => `${e.date} ${e.reason}${e.until ? ` till ${e.until}` : ""}`).join("; ")}.`);
  if (calendar !== "ok") console.log(`Calendar ${calendar}: class times are not counted.`);
  days.forEach((d) => console.log(say(d)));
}

main().catch((error) => { console.error(`orion-sleepplan failed: ${String(error?.message ?? error).slice(0, 200)}`); process.exit(1); });
