#!/bin/zsh
#
# ORION — teach it your voice, so it stops waking for the room.
#
# Records several samples of you saying "Orion", measures how much your own
# samples differ from each other, and sets the acceptance bar from that
# measurement rather than from a number someone invented. Your microphone, your
# room, your voice.
#
# Honest about what this buys: it filters the television, a podcast, and other
# people. It is not authentication — a recording of you defeats it. Push-to-talk
# is never gated by it, so a bad reading is an annoyance and not a lockout.
#
emulate -L zsh
set -u
setopt pipefail

# Resolve the repo, then CHECK it.
#
# `${0:A:h:h}` walks two directories up from this script, which is correct at
# ORION/scripts/orion-enroll-voice and wrong anywhere else. A copy of this file
# was put on the Desktop, so it resolved to $HOME and then tried to launch
# ~/scripts/orion_voiceid_daemon.py — a path that has never existed. The failure
# surfaced as a Python "No such file or directory" three steps later.
#
# The Desktop entry is a launcher now rather than a copy. This guard is the
# belt: an assumed layout that is never verified is just a delayed error message.
repo="${0:A:h:h}"
if [[ ! -f "$repo/scripts/orion_voiceid_daemon.py" ]]; then
  for candidate in "$HOME/Desktop/ORION" "$HOME/ORION" "$PWD"; do
    if [[ -f "$candidate/scripts/orion_voiceid_daemon.py" ]]; then
      repo="$candidate"
      break
    fi
  done
fi
if [[ ! -f "$repo/scripts/orion_voiceid_daemon.py" ]]; then
  print "  FAIL  cannot find the ORION scripts folder."
  print "        Looked in: $repo"
  print "        Run:  \$HOME/Desktop/ORION/scripts/orion-enroll-voice"
  print ""
  print "Press return to close."
  read -r _
  exit 1
fi
bold=$'\033[1m'; dim=$'\033[2m'; red=$'\033[31m'; grn=$'\033[32m'; yel=$'\033[33m'; off=$'\033[0m'
say()  { print "  $1"; }
ok()   { print "  ${grn}ok${off}    $1"; }
warn() { print "  ${yel}warn${off}  $1"; }
bad()  { print "  ${red}FAIL${off}  $1"; }

print "${bold}Teach Orion your voice${off}"

# Pick an interpreter PyTorch actually has wheels for.
#
# The default here was Homebrew's python3, which is currently 3.14 — too new for
# torch, so `pip install resemblyzer` succeeded and `import resemblyzer` failed.
# Telling the user to go and choose a different Python by hand was the wrong
# answer to a question the script can answer itself.
#
# 3.11–3.13 are the versions torch ships wheels for at the time of writing.
# ORION_VOICEID_PYTHON overrides all of this when that changes.
pick_python() {
  if [[ -n "${ORION_VOICEID_PYTHON:-}" ]]; then
    print "$ORION_VOICEID_PYTHON"
    return
  fi
  local candidate version
  for candidate in python3.12 python3.11 python3.13; do
    if command -v "$candidate" >/dev/null 2>&1; then
      print "$(command -v "$candidate")"
      return
    fi
  done
  # Nothing ideal installed. Fall back to the default and let the import check
  # below produce a real error rather than guessing here.
  candidate="$($repo/scripts/orion-python 2>/dev/null)"
  [[ -z "$candidate" ]] && candidate="${commands[python3]:-/usr/bin/python3}"
  print "$candidate"
}
py="$(pick_python)"
pyver="$("$py" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)"
say "using Python $pyver  ${dim}($py)${off}"
case "$pyver" in
  3.11|3.12|3.13) ;;
  *)
    print ""
    warn "PyTorch may not have wheels for Python $pyver"
    print "        If the install fails, this is why. Fix with:"
    print "          brew install python@3.12"
    print "        then run this again — it will pick 3.12 automatically."
    print ""
    ;;
esac

# ------------------------------------------------------------ dependency
#
# Installed into a virtual environment of Orion's own, NOT into whichever Python
# happens to be on PATH.
#
# The first version ran `pip install` against Homebrew's python and hit PEP 668
# ("externally-managed-environment"), then retried with --break-system-packages,
# which Homebrew itself warns "can result in a broken Homebrew installation".
# It worked, and it should not have been the plan: dumping PyTorch into a
# package manager's own site-packages to get a wake-word filter is a bad trade.
#
# A venv costs one directory and cannot damage anything outside itself.
venv="$HOME/.openclaw/venvs/voiceid"
vpy="$venv/bin/python3"

ensure_venv() {
  if [[ ! -x "$vpy" ]]; then
    say "creating a private environment for the speaker model"
    print "        ${dim}$venv${off}"
    if ! "$py" -m venv "$venv" >/dev/null 2>&1; then
      bad "could not create the virtual environment"
      print "        Tried:  $py -m venv $venv"
      exit 1
    fi
  fi
}

if [[ ! -x "$vpy" ]] || ! "$vpy" -c 'import resemblyzer, sounddevice' >/dev/null 2>&1; then
  print ""
  warn "the speaker model is not installed yet"
  print ""
  print "        There is deliberately no dependency-free alternative. One was"
  print "        written and tested, and it scored 0.996 for a DIFFERENT person"
  print "        against 0.999 for the enrolled one — it would have woken for"
  print "        almost anybody while looking like it worked."
  print ""
  print "  ${dim}This pulls in PyTorch: a few hundred MB, once, into Orion's own${off}"
  print "  ${dim}environment. Nothing outside that folder is touched, and nothing${off}"
  print "  ${dim}is uploaded — the model runs on this machine.${off}"
  print ""
  printf "  Install it now? [Y/n] "
  read -r answer
  case "$answer" in
    [Nn]*) print ""; say "Skipped. The wake word stays unfiltered."; exit 0 ;;
  esac
  ensure_venv
  print ""
  say "installing (this takes a few minutes)…"
  install_log="$(mktemp -t orion-voiceid-install)"
  # `setuptools<81`, and the upper bound is the entire point.
  #
  # resemblyzer -> webrtcvad -> `import pkg_resources`, which ships inside
  # setuptools. Two separate things broke this:
  #
  #   1. Python 3.12 stopped putting setuptools in new venvs at all, and
  #      webrtcvad's packaging never declared the dependency.
  #   2. setuptools 81 REMOVED pkg_resources. So `--upgrade setuptools` — the
  #      obvious fix for (1) — installs a version without the very module that
  #      was missing, and the error does not change at all.
  #
  # Pinning below 81 is what actually satisfies webrtcvad.
  if "$vpy" -m pip install --upgrade pip wheel >"$install_log" 2>&1 \
     && "$vpy" -m pip install "setuptools<81" >>"$install_log" 2>&1 \
     && "$vpy" -m pip install resemblyzer sounddevice >>"$install_log" 2>&1; then
    ok "installed"
    rm -f "$install_log"
  else
    print ""
    bad "the install did not succeed"
    print ""
    print "${dim}--- last 15 lines ---${off}"
    tail -15 "$install_log" | sed 's/^/  /'
    print ""
    print "  Full log: $install_log"
    exit 1
  fi
fi
# Verify the install actually took, and SHOW the error if not.
#
# Every check here used to end in `>/dev/null 2>&1`, so a package that installed
# but could not import looked identical to one that was simply missing — and the
# script cheerfully reinstalled it on every run while the daemon kept reporting
# no model. The reason was always there; it was being thrown away.
# One targeted repair before giving up: a venv built before setuptools was
# added to the install list is missing only that, and reinstalling several
# hundred MB of PyTorch to fix a 1 MB gap would be absurd.
if ! "$vpy" -c 'import resemblyzer' >/dev/null 2>&1; then
  # Capture, then match. NOT `python ... | grep`, because `setopt pipefail` is
  # on: python exits 1, so the whole pipeline reports failure even when grep
  # matched, and this repair silently never ran. It looked like the fix simply
  # had not worked.
  webrtc_error="$("$vpy" -c 'import webrtcvad' 2>&1 || true)"
  if [[ "$webrtc_error" == *pkg_resources* ]]; then
    say "installing setuptools<81 (webrtcvad needs pkg_resources, removed in 81)"
    "$vpy" -m pip install --quiet "setuptools<81" >/dev/null 2>&1
  fi
fi

if ! import_error="$("$vpy" -c 'import resemblyzer' 2>&1)"; then
  print ""
  bad "resemblyzer installed but cannot be imported"
  print ""
  print "${dim}--- the actual error ---${off}"
  print "$import_error" | tail -12 | sed 's/^/  /'
  print ""
  pyver="$("$vpy" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)"
  print "  This venv is Python ${bold}$pyver${off}."
  print ""
  if print "$import_error" | grep -q pkg_resources; then
    print "  Missing ${bold}pkg_resources${off}, which lives in setuptools."
    print "  Repair this venv with:"
    print ""
    print "    $vpy -m pip install 'setuptools<81'"
    print ""
    print "  ${dim}The version bound matters: setuptools 81 removed pkg_resources,${off}"
    print "  ${dim}so plain 'pip install setuptools' does not fix this.${off}"
    print ""
  elif [[ "$pyver" == "3.14" || "$pyver" == "3.15" ]]; then
    print "  PyTorch usually has no wheels for a Python this new, which is the"
    print "  most likely cause. Building the venv on an older Python fixes it."
    print ""
    for older in python3.12 python3.11 python3.13; do
      if command -v "$older" >/dev/null 2>&1; then
        print "  Found ${bold}$older${off}. To rebuild on it:"
        print ""
        print "    rm -rf $venv"
        print "    ORION_VOICEID_PYTHON=\$(command -v $older) $repo/scripts/orion-enroll-voice"
        print ""
        break
      fi
    done
    print "  If none is installed:  brew install python@3.12"
  fi
  print ""
  print "  Nothing is broken — the wake word answers anyone, as it did before."
  print ""
  print "Press return to close."
  read -r _
  exit 1
fi
ok "speaker model available"

# ----------------------------------------------------------------- daemon
sock="$HOME/.openclaw/orion-voiceid.sock"
mkdir -p "$HOME/.openclaw/logs"
vid_log="$HOME/.openclaw/logs/orion-voiceid.log"

# "Does it answer" is not the same question as "can it do the job".
#
# A daemon started by an earlier, failed run — under Homebrew's python, before
# the venv existed — answers pings perfectly well and has no speaker model at
# all. The old check saw a reply, decided all was well, and enrolment then died
# six recordings later with "resemblyzer is not installed", reported by a
# process that genuinely did not have it.
#
# So: ask whether it is USABLE, and replace it if it is not. This project has
# now hit "stale socket reports healthy" twice; the answer both times is to
# probe for capability rather than liveness.
daemon_usable() {
  "$vpy" -c "
import json,socket,sys
s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM); s.settimeout(3)
try:
    s.connect('$sock'); s.sendall(b'{\"op\":\"ping\"}\n')
    buf=b''
    while b'\n' not in buf:
        part=s.recv(65536)
        if not part: break
        buf+=part
    sys.exit(0 if json.loads(buf.split(b'\n')[0]).get('usable') else 1)
except Exception: sys.exit(1)
" >/dev/null 2>&1
}

if daemon_usable; then
  ok "voice daemon running with the speaker model"
else
  # Either nothing is listening, or something is listening that cannot help.
  # Both are fixed the same way.
  if pgrep -f orion_voiceid_daemon.py >/dev/null 2>&1; then
    say "replacing a voice daemon that has no speaker model"
    pkill -f orion_voiceid_daemon.py 2>/dev/null
    rm -f "$sock"
    sleep 1
  fi
  say "starting the voice daemon…"
  nohup "$vpy" "$repo/scripts/orion_voiceid_daemon.py" >>"$vid_log" 2>&1 &
  # Poll, do not sleep-and-hope.
  #
  # The previous version slept 3 seconds and then printed "voice daemon running"
  # unconditionally — outside the `if` that started it. Importing torch takes
  # far longer than that, so the socket did not exist yet, the script announced
  # success, and enrolment failed on the next line with a bare FileNotFoundError.
  # Reporting success without checking is the whole bug.
  ready=0
  for _ in {1..60}; do
    sleep 1
    if daemon_usable; then ready=1; break; fi
  done
  if (( ! ready )); then
    print ""
    bad "the voice daemon did not come up"
    print ""
    print "${dim}--- last 15 lines of $vid_log ---${off}"
    tail -15 "$vid_log" 2>/dev/null | sed 's/^/  /'
    print ""
    print "  The wake word keeps working; it just is not filtered."
    exit 1
  fi
  ok "voice daemon started with the speaker model"
fi

# --------------------------------------------------------------- recording
print ""
print "  You will say ${bold}\"Orion\"${off} six times."
print "  ${dim}Vary it a little — closer, further, quieter, how you'd say it mid-task.${off}"
print "  ${dim}Variety is what stops it rejecting you on an off day.${off}"
print ""

# Run as a FILE, not piped on stdin.
#
# `"$vpy" - "$sock" <<PYTHON` fed the program in through stdin, which meant the
# program *was* stdin — so the first `input()` returned EOF and enrolment died
# before asking for a single sample.
if "$vpy" "$repo/scripts/orion_enroll_voice.py" "$sock"; then
  enrolled=1
else
  enrolled=0
fi

print ""
# Checked, not assumed. Two earlier versions of this script printed a cheerful
# summary after the step above had already failed, which is how a broken
# enrolment looked like a working one twice in a row.
if (( enrolled )) && [[ -f "$HOME/.openclaw/orion-voiceid.json" ]]; then
  ok "enrolled — restart Orion so it picks up your voice"
else
  bad "enrolment did not complete — the wake word stays unfiltered"
  print "        Nothing is broken; Orion answers anyone, as before."
  print "        Try again, or send me the error above."
fi
print ""
print "  ${dim}Push-to-talk still works regardless of this. If the daemon stops,${off}"
print "  ${dim}the wake word goes back to answering anyone rather than nobody.${off}"
print ""
print "Press return to close."
read -r _
