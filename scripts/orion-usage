#!/usr/bin/env node
// Read-only model usage. Recorded gateway costs are not a provider invoice.
import { homedir } from 'node:os';
import { join } from 'node:path';
import { readFileSync } from 'node:fs';
import { readUsage, summarizeUsage, PRICES, priceSources } from './lib/usage/report.mjs';
const args = process.argv.slice(2), flag = name => args[args.indexOf(name) + 1];
if (args.includes('--help')) { console.log('orion-usage [--days 1..3650 | --all] [--json] — read-only retained gateway usage'); process.exit(0); }
const home = process.env.ORION_USAGE_HOME || homedir();
const days = args.includes('--all') ? null : args.includes('--days') ? Number(flag('--days')) : 30;
if (days != null && (!Number.isInteger(days) || days < 1 || days > 3650)) { console.error('--days must be 1–3650, or use --all'); process.exit(2); }
let budgets = null; try { budgets = JSON.parse(readFileSync(join(home, '.openclaw/orion-controlled/budgets.json'), 'utf8')); } catch {}
const { entries, unreadable } = readUsage(home);
const result = { generatedAt: new Date().toISOString(), timezone: 'Europe/London', windowDays: days, ...summarizeUsage(entries, { days }), unreadable, budgets, pricesPerMillionUsd: PRICES, priceSources, priceCheckedOn: '2026-10-02', notes: [
  'Recorded cost is the gateway estimate stored on each call, not an invoice or account balance.',
  'Current-rate equivalent reprices tokens at today’s standard USD rates with 5-minute cache writes. It is not historical spending; older discounts and 1-hour cache writes may differ.',
  'Zero-cost cloud calls have unknown billing coverage; they are not assumed free. Ollama has no per-token API charge; electricity and hardware are excluded.',
  'Claude/Codex subscriptions, other accounts, Deepgram/audio billing and calls missing from these retained logs are not included.',
  'Native inference-ledger is a separate legacy source and is not added: overlapping records would double count.',
  'Daily and task budgets are diagnostic ceilings, not a monthly dollar cap. Lane labels are inferred from retained session names.',
] };
if (args.includes('--json')) console.log(JSON.stringify(result, null, 2));
else {
  console.log(`ORION model usage — ${days == null ? 'all retained history' : days + ' calendar days'} (${result.timezone})`);
  console.log(`${result.totals.calls} calls · ${result.totals.totalTokens.toLocaleString()} tokens · $${result.totals.recordedCost.toFixed(4)} recorded gateway cost`);
  console.log(`$${result.totals.currentRateEquivalent.toFixed(4)} current-rate equivalent · ${result.totals.unpricedCloudCalls} unpriced cloud calls`);
  for (const [model, value] of Object.entries(result.byModel).sort((a,b) => b[1].recordedCost-a[1].recordedCost)) console.log(`${model}: ${value.calls} calls; in ${value.input}; out ${value.output}; cache read ${value.cacheRead}; cache write ${value.cacheWrite}; $${value.recordedCost.toFixed(4)} recorded`);
  for (const note of result.notes) console.log(note);
}
