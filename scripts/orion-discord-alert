#!/usr/bin/env node
/*
 * Send one short, opt-in Orion alert to the owner's private Discord channel.
 *
 * The webhook stays in ../.env, is never printed, and is never accepted as a
 * command argument.  `allowed_mentions` is explicitly disabled so a reminder
 * cannot accidentally ping people or roles.
 */
import { readFile } from "node:fs/promises";
import { refuseDuringEval } from "./lib/eval-mode.mjs";
import { spawn } from "node:child_process";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";

const root = dirname(dirname(fileURLToPath(import.meta.url)));
const envPath = process.env.ORION_ENV_PATH || join(root, ".env");
const message = process.argv.slice(2).join(" ").trim();
refuseDuringEval("the Discord alert");

if (!message) {
  console.error("Usage: orion-discord-alert <short alert message>");
  process.exit(2);
}
if (message.includes("\0") || Buffer.byteLength(message, "utf8") > 1500) {
  console.error("Discord alerts must be short plain text (1–1500 UTF-8 bytes).");
  process.exit(2);
}

const values = {};
for (const line of (await readFile(envPath, "utf8")).split(/\r?\n/)) {
  if (!line.startsWith("#") && line.includes("=")) {
    const [key, value] = line.split("=", 2);
    values[key.trim()] = value.trim().replace(/^['"]|['"]$/g, "");
  }
}

const webhook = values.ORION_DISCORD_WEBHOOK_URL;
if (values.ORION_DISCORD_NOTIFICATIONS !== "true" || !webhook) {
  console.error("Discord alerts are not enabled in Orion’s local settings.");
  process.exit(2);
}
if (!/^https:\/\/(?:discord\.com|discordapp\.com)\/api\/webhooks\/[^/]+\/[^/]+$/.test(webhook)) {
  console.error("Discord webhook setting is not valid.");
  process.exit(2);
}

// 4096 is Discord's SUPPRESS_NOTIFICATIONS: the message lands, the phone stays quiet.
const silent = process.env.ORION_DISCORD_SILENT === "1";
const payload = JSON.stringify({ content: message, allowed_mentions: { parse: [] }, ...(silent ? { flags: 4096 } : {}) });
const curl = spawn(
  "/usr/bin/curl",
  [
    "--fail-with-body", "--silent", "--show-error", "--request", "POST",
    "--header", "Content-Type: application/json",
    "--header", "User-Agent: Orion/1.0",
    "--data-binary", "@-", webhook,
  ],
  { stdio: ["pipe", "ignore", "pipe"] },
);

let error = "";
curl.stderr.on("data", (chunk) => { error += chunk; });
curl.stdin.end(payload);
curl.once("error", (cause) => {
  console.error(`Discord alert could not start: ${cause.message}`);
  process.exit(1);
});
curl.once("close", (code) => {
  if (code === 0) {
    console.log("Discord alert delivered.");
    return;
  }
  console.error(`Discord alert was not delivered${error ? `: ${error.slice(0, 240).trim()}` : "."}`);
  process.exit(1);
});
