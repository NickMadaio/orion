#!/usr/bin/env node
/*
 orion-reach — ORION starts the conversation (2026-10-07).

   orion-reach "<message>" [--kind reminder|warning|update|question|info|checkin]
               [--why "<what prompted it>"] [--urgent] [--silent] [--channel auto|phone|mac]
               [--loud] [--listen] [--dry-run] [--json]

 Every message lands in his ORION chat thread (phone and Mac), so he can answer
 normally, by typing or voice. How it reaches him (orion-presence):
   away from the Mac            → phone notification
   at the Mac, out (class…)     → hologram + silent chat bubble on the Mac
   at the Mac at home/headphones→ hologram, said aloud at a sensible volume
   his sleep window (quiet)     → held until morning; only --urgent with --urgent-kind
                                reminder|class (a reminder he set, a class he is about
                                to miss) gets through. Bedtime nags never do (2026-10-16).
 a focus session is running   → held and batched until it ends (same two exceptions).
 No repeats within 2 hours, at most 6 an hour. Never during an evaluation.
 Exit codes: 0 sent, held, or already said; 3 NOT SENT (rate cap); 4 delivery failed.
 --awake: the caller has proof he is up (the morning brief): quiet hours do not apply.
 --no-queue: if held, drop instead of queueing (bedtime nags are pointless in the morning).
 --drain-held: send everything held, merged, once it is neither quiet nor focus time.
 --loud: aloud at full volume (the morning briefing; the volume goes back after).
 --listen: after saying it aloud, listen a few seconds for an answer.
 --ask '<json>': this message is a question (contract C4); stored on the row and the outbox row. A held ask is
   dropped, never queued: the loop re-decides it with fresh facts.
 --reason break|end|wake: with --drain-held, why it is being released (the gate still decides).
 --valid-until ISO: after this the message is pointless; a held copy is dropped, not released.
 Delivery policy is one gate (lib/reach/gate.mjs, awareness spec 3.2): a break releases held messages, and the
 bubble always shows while speech needs him home or in headphones (3.4.4). Daily ceiling: dailyReachCeiling (20)
 counts proactive:/plan:/curiosity: messages, never a reminder he set or a class nudge (exit 3, reason ceiling).
*/
import { appendFileSync, readFileSync, existsSync, mkdirSync, statSync, rmSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import { randomUUID } from "node:crypto";
import { execFileSync } from "node:child_process";
import { allowed, chooseChannel, speakOnMac, countedToday } from "./lib/reach/route.mjs";
import { gate, resolveAwareness, audienceOf } from "./lib/reach/gate.mjs";
import { loadConfig } from "./lib/life/config.mjs";
import { localDate } from "./lib/life/live-day.mjs";
import { presence } from "./lib/reach/presence.mjs";
import { bypassesQuiet, isUrgentNotification, URGENT_KINDS } from "./lib/reach/quiet.mjs";
import { appendHeld, readHeld, clearHeld, mergeHeld, releaseHeldAlerts } from "./lib/reach/held.mjs";
import { withKind } from "./lib/curiosity/ask.mjs";
import { refuseDuringEval } from "./lib/eval-mode.mjs";

const args = process.argv.slice(2);
const flag = (n) => { const i = args.indexOf(n); return i >= 0 ? args[i + 1] : undefined; };
const VALUE_FLAGS = ["--kind", "--why", "--channel", "--urgent-kind", "--ask", "--reason", "--valid-until"];
const drain = args.includes("--drain-held");
const fail = (m, c = 2) => { console.error(m); process.exit(c); };

const DIR = process.env.ORION_CONTROLLED_DIR || join(homedir(), ".openclaw/orion-controlled");
const LOG = join(DIR, "outreach.jsonl");
const OUTBOX = join(DIR, "outreach-outbox.jsonl");
// Test seams (never set in production): a fixed clock, fixed Mac facts, a fake `open`.
const now = process.env.ORION_REACH_NOW ? new Date(process.env.ORION_REACH_NOW) : new Date();
const givenFacts = process.env.ORION_REACH_FACTS ? JSON.parse(process.env.ORION_REACH_FACTS) : null;
const OPEN = process.env.ORION_REACH_OPEN_BIN || "/usr/bin/open";

let text = args.find((a, i) => !a.startsWith("--") && !VALUE_FLAGS.includes(args[i - 1]));
let held = [];
// One drain at a time: the phase hook and the proactive backstop can both fire, and both would send the merged message.
if (drain) {
  const lock = join(DIR, "held.drain.lock");
  mkdirSync(DIR, { recursive: true });
  try { if (Date.now() - statSync(lock).mtimeMs > 60_000) rmSync(lock, { force: true }); } catch {}
  try { writeFileSync(lock, String(process.pid), { flag: "wx" }); } catch { console.log("Another drain is running."); process.exit(0); }
  process.on("exit", () => { try { rmSync(lock, { force: true }); } catch {} });
}
if (drain) {
  // Watcher alerts held for the phone (via "alerts-outbox") are not part of the merged message: they are released to the
  // alerts outbox when the gate allows (below), never cleared with the messages.
  held = readHeld(DIR).filter((e) => e.via !== "alerts-outbox");
  text = mergeHeld(held, { now: now.getTime() }).text;
  if (!text) {
    clearHeld(DIR, held);
    if (!readHeld(DIR).some((e) => e.via === "alerts-outbox")) { console.log("Nothing held worth saying."); process.exit(0); }
    text = "(held alerts)";   // only alerts are waiting: the gate below decides whether they go
  }
}
if (!text?.trim()) fail('usage: orion-reach "<message>" [--kind reminder|warning|update|question|info] [--why "…"] [--urgent [--urgent-kind reminder|class]] [--channel auto|phone|mac] [--dry-run]');
const kind = flag("--kind") ?? (drain ? "update" : "info");
if (!["reminder", "warning", "update", "question", "info", "morning", "checkin"].includes(kind)) fail("--kind must be reminder, warning, update, question, info, morning or checkin");
// The app's reminder service calls `--kind reminder --urgent` (AppState.swift) without --urgent-kind: that IS a reminder he set
// (review H2), so it is urgent kind "reminder". Any other bare --urgent is still not a bypass.
const urgentKind = flag("--urgent-kind") ?? (kind === "reminder" && args.includes("--urgent") ? "reminder" : null);
if (urgentKind && !URGENT_KINDS.includes(urgentKind)) fail(`--urgent-kind must be one of ${URGENT_KINDS.join(", ")}`);
let ask = null;
if (flag("--ask") !== undefined) {
  try { ask = JSON.parse(flag("--ask")); } catch { /* checked below */ }
  if (!ask || typeof ask !== "object" || Array.isArray(ask)) fail("--ask must be a JSON object");
  ask = withKind(ask);   // one ask contract for every reader (lib/curiosity/ask.mjs)
}
const validUntil = flag("--valid-until") ?? null;
if (validUntil && Number.isNaN(Date.parse(validUntil))) fail("--valid-until must be an ISO timestamp");
const drainReason = flag("--reason") ?? null;
if (drainReason && !["break", "end", "wake"].includes(drainReason)) fail("--reason must be break, end or wake");
const dry = args.includes("--dry-run");
if (!dry) refuseDuringEval("reaching Nick");

mkdirSync(DIR, { recursive: true });
const history = existsSync(LOG) ? readFileSync(LOG, "utf8").split("\n").flatMap((l) => { try { return [JSON.parse(l)]; } catch { return []; } }) : [];

const burst = allowed(text, history, { now: now.getTime() });
if (!burst.ok && burst.duplicate) { console.log(`Already said: ${burst.reason}.`); process.exit(0); }

const urgent = args.includes("--urgent");
const genuinelyUrgent = isUrgentNotification({ urgent, urgentKind });
const bypass = bypassesQuiet({ urgentKind });
// The daily ceiling is a runaway guard (3.4.3): the loop's own messages stop at it, dropped not held. A reminder he set
// and a class nudge are neither counted nor blocked.
const ceiling = Number(loadConfig().dailyReachCeiling ?? 20);
const ceilingHit = !bypass && /^(proactive|plan|curiosity):/.test(flag("--why") ?? "") && countedToday(history, localDate(now), localDate) >= ceiling;
if (ceilingHit) {
  if (!dry) { try { appendFileSync(LOG, `${JSON.stringify({ id: `reach-${now.getTime()}-ceiling`, at: now.toISOString(), text: text.trim(), kind, why: flag("--why") ?? null, channel: "hold", status: "dropped", reason: "ceiling" })}\n`); } catch {} }
  console.log(`NOT SENT: ceiling - already reached him ${ceiling} times today.`);
  process.exit(3);
}
// 2026-10-16: a refusal is not "said". Exit 3 so a caller (orion-proactive) does not mark its key done.
if (!burst.ok) { console.log(`NOT SENT: ${burst.reason}.`); process.exit(3); }

const here = await presence(now, { dir: DIR, facts: givenFacts });
// --awake: the caller has proof he is up (the morning brief runs on his wake signal), so quiet hours do not apply.
if (args.includes("--awake")) { here.quiet = false; here.lateAwake = false; }
const aw = resolveAwareness({ dir: DIR, now, env: process.env, legacy: here, probe: !dry });
if (args.includes("--awake") && aw.sleep.state !== "awake") aw.sleep = { state: "awake", source: "caller" };
let verdict = gate(aw, { kind, urgentKind, now });
// --awake is proof he is up and at hand (his wake signal), so a calendar "in class" does not hold the brief for hours.
if (args.includes("--awake") && verdict.heldFor === "class") verdict = { action: "deliver", reason: "he is up (the caller has proof); a class on the calendar does not hold it" };
const heard = audienceOf(aw);
const headphones = heard.macHeadphones ?? !!here.headphones;
const forced = flag("--channel");
// speech needs home or headphones (3.4.4); --loud (the morning brief) is meant aloud, so it asks for speech itself.
const facts = { ...here, quiet: false, atHome: heard.atHome, headphones,
  speakOnMac: args.includes("--loud") && kind === "morning" ? !here.lateAwake && heard.atHome !== false   // the brief is meant aloud, at home or where home is unknown
    : speakOnMac({ atHome: heard.atHome, headphones, lateAwake: here.lateAwake }) };
let decision = forced === "phone" ? { channel: "phone", reason: "asked for the phone" }
  : forced === "mac" ? chooseChannel({ ...facts, idleSeconds: 0, locked: false, displayAsleep: false }, { urgent, urgentKind })
  : chooseChannel(facts, { urgent, urgentKind });
// The gate: sleep, a focus session, the first 3 min of a pause, a class. Held means kept, until a break or the end.
if (verdict.action === "hold") decision = { channel: "hold", reason: verdict.reason, heldFor: verdict.heldFor };
if (args.includes("--silent") && decision.channel === "mac-voice") decision = { channel: "mac-bubble", reason: `${decision.reason}; silent was asked for` };
const id = `reach-${now.getTime()}-${randomUUID().slice(0, 6)}`;
const entry = { id, at: now.toISOString(), text: text.trim(), kind, why: flag("--why") ?? null, channel: decision.channel, reason: decision.reason, urgent, urgentKind, headphones,
  loud: args.includes("--loud") && !headphones, listen: args.includes("--listen"),
  ...(ask ? { ask, askId: ask.askId ?? id, category: ask.type ?? null } : {}), ...(validUntil ? { validUntil } : {}) };

if (dry) { console.log(args.includes("--json") ? JSON.stringify(entry) : `DRY RUN — would ${describe(entry)}`); process.exit(0); }

// Releasing the held queue while it is still quiet (or a session still runs): leave it, and leave no log row.
// Review M3: inside the sleep window the queue is released only when he is at the Mac, whatever a phone sample says.
if (drain && here.inWindow && !here.lateAwake && !bypass) decision = { channel: "hold", reason: "he is inside his sleep window" };
if (drain && decision.channel === "hold") { console.log(`Still held (${decision.reason}).`); process.exit(0); }
// Only watcher alerts were waiting: the gate said go, so they move to the phone's alerts outbox (their own path), nothing is merged.
if (drain && text === "(held alerts)") { releaseHeldAlerts(DIR); console.log("Sent — held alerts released to the phone."); process.exit(0); }
try {
  appendFileSync(LOG, `${JSON.stringify(entry)}\n`);
  if (decision.channel === "hold") {
    // Held means kept, not dropped (2026-10-16): queued, released once and merged.
    // An ask is stale by definition once held: dropped, and the loop asks again with fresh facts.
    if (!drain && !ask && !args.includes("--no-queue")) appendHeld(DIR, { id, at: entry.at, text: entry.text, kind, why: entry.why, heldFor: decision.heldFor ?? "quiet", ...(validUntil ? { validUntil } : {}) });
    // An ask is not kept (stale once held): say so with exit 3, so the loop neither records it nor backs off nor arms the reply link.
    if (ask && !drain) { console.log(`NOT SENT: held (${decision.reason}); an ask is not queued, the loop asks again with fresh facts.`); process.exit(3); }
    console.log(args.includes("--json") ? JSON.stringify(entry) : `Held — ${describe(entry)}`);
    process.exit(0);
  }
  // Mac channels need the ORION app; if it isn't running, the phone is the way.
  if (decision.channel.startsWith("mac")) {
    try { execFileSync(OPEN, ["-g", `orion://reach?id=${encodeURIComponent(id)}`], { timeout: 5000 }); }
    catch { entry.channel = "phone"; entry.reason = "the ORION app isn't running"; appendFileSync(LOG, `${JSON.stringify(entry)}\n`); }
  }
  // Into his chat thread everywhere; a phone notification only when that is how he is reached.
  // `urgent` reaches the phone only for a genuinely urgent kind (2026-10-16), so the app can make it time-sensitive.
  // timeSensitive lets iOS Announce read it into his AirPods, but only when the phone route is headphones.
  const phone = entry.channel === "phone";
  // An ask gets the phone's `orion.ask` category (a text-reply field) and its askId, which the link carries into the chat thread (WP5).
  appendFileSync(OUTBOX, `${JSON.stringify({ id, text: entry.text, kind, push: phone, urgent: genuinelyUrgent, timeSensitive: phone && heard.phoneHeadphones === true,
    ...(ask ? { ask, askId: entry.askId, category: "orion.ask" } : {}), ...(validUntil ? { validUntil } : {}) })}\n`);
  // A phone delivery also posts the same row on the Mac as a silent bubble, so it is there when he is back (3.4.4).
  // Its channel is not mac-voice, so the app shows it without speaking. Best effort: the app may not be running.
  if (phone) { try { execFileSync(OPEN, ["-g", `orion://reach?id=${encodeURIComponent(id)}`], { timeout: 5000 }); } catch { /* the push still reached him */ } }
} catch (error) {
  // 2026-10-16 audit, finding 6: a failed send used to print and exit 0 and the caller marked it said.
  // Recorded as failed (so it neither blocks a retry nor eats the hourly allowance) and exit 4.
  try { appendFileSync(LOG, `${JSON.stringify({ id, at: now.toISOString(), text: entry.text, kind, status: "failed", error: String(error?.message ?? error).slice(0, 200) })}\n`); } catch {}
  console.log(`NOT SENT: delivery failed (${String(error?.message ?? error).slice(0, 120)}).`);
  process.exit(4);
}
if (drain) { clearHeld(DIR, held); releaseHeldAlerts(DIR); }
console.log(args.includes("--json") ? JSON.stringify(entry) : `Sent — ${describe(entry)}`);

function describe(e) {
  return { phone: "his phone (notification + chat)", "mac-bubble": "the Mac, silent bubble", "mac-voice": "the Mac, aloud", hold: "held" }[e.channel] + ` (${e.reason}).`;
}
