#!/bin/bash
#
# Keep ORION's voice ID running. (2026-09-29)
#
#   ./scripts/orion-voiceid-install            install and start
#   ./scripts/orion-voiceid-install --status   is it running, and which copy
#   ./scripts/orion-voiceid-install --remove   stop and uninstall
#
# The voice-ID daemon (scripts/orion_voiceid_daemon.py) checks that the voice
# saying "Orion" is Nick's, from the enrollment in ~/.openclaw/orion-voiceid.json.
# It was only ever started by hand (orion-setup / orion-enroll-voice), so after
# a restart nothing brought it back: from 31 July the wake word answered any
# voice -- the TV, other people, and ORION's own replies through the speakers,
# which is how he ended up interrupting himself on 2026-09-29. Like the TTS
# daemon, launchd runs a COPY under ~/.openclaw/orion-voiceid (it cannot run
# code under ~/Desktop) and restarts it whenever it exits.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
INSTALL="$HOME/.openclaw/orion-voiceid"
PLIST="$HOME/Library/LaunchAgents/com.nickmadaio.orion.voiceid.plist"
LABEL="com.nickmadaio.orion.voiceid"
LOGDIR="$HOME/.openclaw/logs"
SOCKET="$HOME/.openclaw/orion-voiceid.sock"
DOMAIN="gui/$(id -u)"

fingerprint() { shasum -a 256 "$1" 2>/dev/null | cut -c1-12; }

if [ "${1:-}" = "--status" ]; then
  printf '  loaded     '; launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1 && echo yes || echo no
  printf '  socket     '; [ -S "$SOCKET" ] && echo "present ($SOCKET)" || echo "missing"
  echo "  installed  $INSTALL  [$(fingerprint "$INSTALL/orion_voiceid_daemon.py")]"
  echo "  repo       $HERE  [$(fingerprint "$HERE/orion_voiceid_daemon.py")]"
  [ "$(fingerprint "$INSTALL/orion_voiceid_daemon.py")" = "$(fingerprint "$HERE/orion_voiceid_daemon.py")" ] \
    || echo "  DRIFTED — the running copy is not the repo copy. Re-run this script."
  exit 0
fi

if [ "${1:-}" = "--remove" ]; then
  launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null
  rm -f "$PLIST"
  echo "  voice daemon stopped and uninstalled (copy left at $INSTALL)"
  exit 0
fi

PYTHON="$HOME/.openclaw/venvs/voiceid/bin/python"
if [ ! -x "$PYTHON" ]; then
  echo "  FAILED: the voice-ID Python environment is missing ($PYTHON); run ./scripts/orion-setup" >&2
  exit 1
fi

mkdir -p "$INSTALL" "$LOGDIR" "$(dirname "$PLIST")"
cp "$HERE/orion_voiceid_daemon.py" "$INSTALL/orion_voiceid_daemon.py"
chmod 600 "$INSTALL/orion_voiceid_daemon.py"

cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$PYTHON</string>
    <string>$INSTALL/orion_voiceid_daemon.py</string>
  </array>
  <key>WorkingDirectory</key><string>$INSTALL</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>$LOGDIR/orion-voiceid.log</string>
  <key>StandardErrorPath</key><string>$LOGDIR/orion-voiceid.log</string>
</dict>
</plist>
PLIST
chmod 644 "$PLIST"

# Same race orion-remote-install had: wait for the old job to be gone, retry
# the bootstrap, and fail loudly rather than print success over a dead voice.
launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null
# A stale socket from an old run would pass the socket check below instantly.
rm -f "$SOCKET"
for _ in $(seq 1 50); do launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1 || break; sleep 0.2; done
LOADED=no
for _ in 1 2 3 4 5; do
  if launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null; then LOADED=yes; break; fi
  launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1 && { LOADED=yes; break; }
  sleep 1
done
[ "$LOADED" = yes ] || { echo "  FAILED: launchd would not load $PLIST" >&2; exit 1; }

# The embedder loads once; give it time, then require the socket.
rm -f "$SOCKET" 2>/dev/null
for _ in $(seq 1 60); do [ -S "$SOCKET" ] && break; sleep 1; done
if [ -S "$SOCKET" ]; then
  echo "  ORION's voice ID is running, and launchd restarts it if it ever stops."
else
  echo "  FAILED: the daemon started but no socket appeared; see $LOGDIR/orion-voiceid.log" >&2
  exit 1
fi
