#!/bin/zsh
#
# ORION — one command that gets everything running.
#
# Build the app, sign it with a stable identity, install it, start the voice
# daemon, check the gateway, launch. Safe to re-run: nothing is done twice, and
# anything already correct is left alone.
#
# The point of this script is that a failure should tell you what to do next,
# not just that something went wrong.
#
emulate -L zsh
set -u
setopt pipefail

repo="${0:A:h:h}"
cd "$repo"

# Everything printed here also lands in a file, so a run that scrolled past can
# still be read afterwards — by you, or by me when you paste the path.
mkdir -p "$repo/data"
setup_log="$repo/data/last-setup.log"
if [[ -z "${ORION_SETUP_TEEING:-}" ]]; then
  export ORION_SETUP_TEEING=1
  # `script` keeps the output a TTY so colours and progress survive the tee.
  "$0" "$@" 2>&1 | tee "$setup_log"
  exit ${pipestatus[1]}
fi

bold=$'\033[1m'; dim=$'\033[2m'; red=$'\033[31m'; grn=$'\033[32m'; yel=$'\033[33m'; off=$'\033[0m'
step() { print ""; print "${bold}$1${off}"; }
ok()   { print "  ${grn}ok${off}    $1"; }
warn() { print "  ${yel}warn${off}  $1"; }
bad()  { print "  ${red}FAIL${off}  $1"; }

print "${bold}ORION setup${off}  ${dim}$repo${off}"

# ---------------------------------------------------------------- toolchain
step "1. Toolchain"
if ! command -v swift >/dev/null 2>&1; then
  bad "swift not found."
  print "        Install Xcode or the Command Line Tools:  xcode-select --install"
  exit 1
fi
ok "swift $(swift --version 2>/dev/null | head -1 | sed 's/.*version \([0-9.]*\).*/\1/')"

# ------------------------------------------------------------------ signing
step "2. Signing identity"
if [[ -n "$(security find-identity -v -p codesigning 2>/dev/null | grep 'Orion Local Signing' | tail -1)" ]]; then
  ok "stable identity present — permissions will survive rebuilds"
else
  warn "no stable identity yet"
  print "        Without one, macOS treats every rebuild as a NEW app: you get"
  print "        duplicate 'Orion' rows in Privacy settings and push-to-talk"
  print "        stops working after each build."
  print ""
  # Deliberately does NOT create one any more.
  #
  # The scripted route imports a certificate fine but cannot mark it TRUSTED,
  # and codesign refuses an untrusted identity. Running it repeatedly just
  # accumulated certificates that all report CSSMERR_TP_NOT_TRUSTED — seven of
  # them on this Mac before anyone noticed. Making the problem look busy is
  # worse than leaving it alone.
  existing="$(security find-identity -p codesigning 2>/dev/null \
              | grep -c 'Orion Local Signing')"
  if (( existing > 0 )); then
    print "        ${yel}${existing} \"Orion Local Signing\" certificate(s) exist but are"
    print "        NOT TRUSTED, which is why codesign will not use them.${off}"
    print ""
    print "        One manual step fixes it — trust must be granted by you,"
    print "        visibly, not by a script editing your keychain:"
    print ""
    print "          1. Keychain Access ▸ login ▸ My Certificates"
    print "          2. Double-click a \"Orion Local Signing\" certificate"
    print "          3. Expand the ▸ Trust section"
    print "          4. Set ${bold}Code Signing${off} to ${bold}Always Trust${off}"
    print "          5. Close the window, confirm with your login password"
    print "          6. Re-run this script"
  else
    print "        Create one: Keychain Access ▸ Certificate Assistant ▸"
    print "        Create a Certificate… (Self Signed Root, Code Signing),"
    print "        then set its Trust ▸ Code Signing to Always Trust."
  fi
  print ""
  print "        Until then Orion is ad-hoc signed. It runs fine; the only cost"
  print "        is re-granting Accessibility after each rebuild."
fi

# -------------------------------------------------------------------- build
step "3. Build Orion.app"

# Only rebuild when something actually changed.
#
# This matters far more than build time. While the app is ad-hoc signed, macOS
# identifies it by its cdhash, so EVERY rebuild is a new application to the
# privacy database — a fresh "Orion" row in Accessibility and a fresh prompt,
# with the previous grant orphaned. Rebuilding unconditionally on every launch
# meant re-granting Accessibility on every launch.
needs_build=0
built="native/Orion/.build/Orion.app/Contents/MacOS/Orion"
if [[ ! -x "$built" || ! -d /Applications/Orion.app ]]; then
  needs_build=1
elif [[ -n "$(find native/Orion/Sources native/Orion/Resources native/Orion/Package.swift \
                   -newer "$built" -print -quit 2>/dev/null)" ]]; then
  needs_build=1
elif [[ -n "$(security find-identity -v -p codesigning 2>/dev/null | grep 'Orion Local Signing' | tail -1)" ]]; then
  # A signing identity exists now. If the installed bundle is still ad-hoc it
  # predates the certificate, so it must be rebuilt and re-signed — otherwise
  # you create the certificate, nothing changes, and it looks like the
  # certificate did not help.
  if ! codesign -dvvv /Applications/Orion.app 2>&1 | grep -qi '^Authority='; then
    needs_build=1
    print "  ${dim}signing identity is new since this bundle was built — re-signing${off}"
  fi
fi

if (( ! needs_build )); then
  ok "unchanged since the last build — not rebuilding"
  print "        ${dim}(a rebuild would reset Accessibility while ad-hoc signed)${off}"
  print "        Force one with: touch native/Orion/Package.swift"
fi

build_log="$(mktemp -t orion-build)"
if (( ! needs_build )); then
  : > "$build_log"
elif (cd native/Orion && ./make_app_bundle.sh) > "$build_log" 2>&1; then
  ok "built and signed"
  grep -E '^Signed:' "$build_log" | sed 's/^/        /'
else
  bad "build failed"
  print ""
  print "${dim}--- compiler errors ---${off}"
  # Only the errors. A Swift build log is mostly noise and the errors are
  # what you need; warnings are not worth reading right now.
  grep -E 'error:' "$build_log" | head -40 | sed 's/^/  /'
  local_count=$(grep -c 'error:' "$build_log")
  print ""
  print "  ${red}${local_count} error(s).${off} Full log: $build_log"
  print ""
  print "  Send me that list and I'll fix them."
  exit 1
fi
rm -f "$build_log"

# ------------------------------------------------------------------ install
step "4. Install to /Applications"
# TCC keys on path as well as identity, so a stable home matters — and
# replacing the bundle is only worth doing when the bundle actually changed.
# Swapping an identical copy in still quits the running app for no reason.
if (( ! needs_build )) && [[ -d /Applications/Orion.app ]]; then
  ok "already installed and unchanged"
else
  if [[ -d /Applications/Orion.app ]]; then
    # Quit a running copy first or the copy silently half-succeeds.
    pkill -x Orion 2>/dev/null && sleep 1
    rm -rf /Applications/Orion.app
  fi
  if cp -R native/Orion/.build/Orion.app /Applications/ 2>/dev/null; then
    ok "/Applications/Orion.app"
    if [[ -n "$(security find-identity -v -p codesigning 2>/dev/null | grep 'Orion Local Signing' | tail -1)" ]]; then
      ok "stable signature retained — existing macOS permission grants should survive"
    else
      warn "new ad-hoc build — macOS may re-ask for Accessibility"
      print "        ./scripts/orion-permissions explains the one-time fix."
    fi
  else
    warn "could not write to /Applications — running from .build instead"
  fi
fi

# -------------------------------------------------------------------- voice
step "5. Voice daemon"
py="$(./scripts/orion-python 2>/dev/null)"
[[ -z "$py" ]] && py="${commands[python3]:-/usr/bin/python3}"

if "$py" -c 'import mlx_audio' >/dev/null 2>&1; then
  ok "mlx_audio available to $py"
else
  warn "$py cannot import mlx_audio"
  print "        The daemon still runs, but reloads the voice model on every"
  print "        chunk instead of keeping it warm — noticeably slower."
  print "        Fix:  $py -m pip install mlx-audio"
  print "        (Or set ELEVENLABS_API_KEY in .env and use the cloud voice.)"
fi

socket="$HOME/.openclaw/orion-tts.sock"

# A socket FILE existing is not the same as a daemon listening on it. An
# unclean exit leaves the file behind, and every "is it running?" check that
# only tests for the file then reports a healthy daemon that is not there.
# That is exactly what happened: the daemon took a SIGHUP when its Terminal
# window closed, the stale socket stayed, and voice silently stopped working.
# So: actually connect.
daemon_alive() {
  [[ -S "$socket" ]] || return 1
  "$py" - "$socket" <<'PY' >/dev/null 2>&1
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(3)
s.connect(sys.argv[1])
s.sendall(b'{"op":"ping"}\n')
sys.exit(0 if s.makefile("r").readline().strip() else 1)
PY
}

# A daemon that is alive but older than the code is worse than no daemon: it
# keeps serving from whatever it loaded at startup, so a fix you just made is
# invisible and you conclude the fix did not work. Restart when the source has
# moved on.
daemon_is_stale() {
  local pid started file_m
  pid="$(pgrep -f orion_tts_daemon.py 2>/dev/null | head -1)"
  [[ -n "$pid" ]] || return 1

  # `ps -o lstart=` gives e.g. "Thu Jul 30 18:44:18 2026"; turn it into epoch
  # seconds and compare against the daemon source's mtime.
  started="$(ps -o lstart= -p "$pid" 2>/dev/null)"
  [[ -n "$started" ]] || return 1
  started="$(date -j -f "%a %b %d %T %Y" "$started" +%s 2>/dev/null)"
  file_m="$(stat -f %m "$repo/scripts/orion_tts_daemon.py" 2>/dev/null)"
  [[ -n "$started" && -n "$file_m" ]] || return 1

  (( file_m > started ))
}

if daemon_alive && daemon_is_stale; then
  warn "running, but started before the current code — restarting it"
  launchctl unload "$HOME/Library/LaunchAgents/com.nickmadaio.orion.tts.plist" 2>/dev/null
  rm -f "$HOME/Library/LaunchAgents/com.nickmadaio.orion.tts.plist"
  pkill -f orion_tts_daemon.py 2>/dev/null
  sleep 1
  rm -f "$socket"
fi

if daemon_alive; then
  ok "already running and answering"
else
  if [[ -e "$socket" ]]; then
    warn "stale socket from a daemon that died — clearing it"
    rm -f "$socket"
  fi
  mkdir -p "$HOME/.openclaw/logs"

  # NOT launchd — at least not while the repo lives on the Desktop.
  #
  # `~/Desktop` is TCC-protected. A LaunchAgent runs without the Desktop
  # access that Terminal inherits, so it cannot even read `orion-python`:
  #
  #   shell-init: getcwd: cannot access parent directories: Operation not permitted
  #   /bin/zsh: can't open input file: …/ORION/scripts/orion-python
  #
  # KeepAlive then restarts it, forever, several times a second. A crash-loop
  # is worse than no daemon. It would also be unable to read `.env`, so the
  # ElevenLabs key would be invisible to it even if it did start.
  #
  # Any previously installed agent is unloaded here so an old install stops
  # spinning.
  plist_dst="$HOME/Library/LaunchAgents/com.nickmadaio.orion.tts.plist"
  if [[ -f "$plist_dst" ]]; then
    launchctl unload "$plist_dst" >/dev/null 2>&1
    rm -f "$plist_dst"
    warn "removed a LaunchAgent that could not read ~/Desktop (it was crash-looping)"
  fi

  # A detached child of this shell instead. `nohup` plus a closed stdin is
  # what makes it survive the Terminal window closing — the earlier SIGHUP
  # death was a missing </dev/null, not a missing launchd.
  export ORION_TTS_CLOUD_VOICE="${ORION_TTS_CLOUD_VOICE:-1}"
  export ORION_ENV_FILE="${ORION_ENV_FILE:-$repo/.env}"
  nohup "$py" scripts/orion_tts_daemon.py \
    >>"$HOME/.openclaw/logs/orion-tts.out.log" \
    2>>"$HOME/.openclaw/logs/orion-tts.err.log" </dev/null &
  disown
  for _ in {1..60}; do daemon_alive && break; sleep 0.25; done

  if daemon_alive; then
    ok "started (managed by launchd — survives this window closing)"
  else
    warn "did not come up — see ~/.openclaw/logs/orion-tts.err.log"
    print "        Orion still talks, using macOS system speech."
  fi
fi

# --------------------------------------------------------------- providers
step "6. Voice providers"
# If the keys are there, use them. The local MLX voice and Apple's on-device
# recogniser are the offline floor, not the target -- ElevenLabs and Deepgram
# are what the voice is supposed to sound and feel like. These are ordinary
# app preferences, so they can be set here; the keys themselves stay in .env
# and are never written anywhere else.
env_file="${ORION_ENV_FILE:-$repo/.env}"
have_key() {
  [[ -n "$(printenv "$1" 2>/dev/null)" ]] && return 0
  [[ -f "$env_file" ]] || return 1
  grep -qE "^[[:space:]]*$1[[:space:]]*=[[:space:]]*[^[:space:]#]" "$env_file"
}

if have_key ELEVENLABS_API_KEY; then
  defaults write com.nickmadaio.orion.app OrionTTSProvider -string elevenlabs 2>/dev/null
  ok "speaking with ElevenLabs (local MLX stays as the offline fallback)"
else
  defaults write com.nickmadaio.orion.app OrionTTSProvider -string local 2>/dev/null
  print "        no ELEVENLABS_API_KEY — using the local voice"
fi

if have_key DEEPGRAM_API_KEY; then
  defaults write com.nickmadaio.orion.app OrionSTTProvider -string deepgram 2>/dev/null
  ok "listening with Deepgram (Apple on-device stays as the offline fallback)"
else
  defaults write com.nickmadaio.orion.app OrionSTTProvider -string apple 2>/dev/null
  print "        no DEEPGRAM_API_KEY — using Apple's on-device recogniser"
fi

# ---------------------------------------------------------------- voice id
step "5b. Speaker verification"
# Optional, and its absence is not a failure: without it the wake word simply
# answers anyone, exactly as it always has. Lives in its own venv so PyTorch
# never lands in a Homebrew or system site-packages.
vid_venv="$HOME/.openclaw/venvs/voiceid"
vid_py="$vid_venv/bin/python3"
vid_sock="$HOME/.openclaw/orion-voiceid.sock"

vid_ping() {
  [[ -x "$vid_py" ]] || return 1
  "$vid_py" -c "
import socket,sys
s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM); s.settimeout(2)
try:
    s.connect('$vid_sock'); s.sendall(b'{\"op\":\"ping\"}\n')
    sys.exit(0 if s.recv(4096) else 1)
except Exception: sys.exit(1)" >/dev/null 2>&1
}

if [[ -x "$vid_py" ]] && "$vid_py" -c 'import resemblyzer' >/dev/null 2>&1; then
  if vid_ping; then
    ok "voice daemon running"
  else
    nohup "$vid_py" "$repo/scripts/orion_voiceid_daemon.py" \
      >> "$HOME/.openclaw/logs/orion-voiceid.log" 2>&1 &
    # Poll rather than sleep: loading the model takes far longer than any
    # fixed wait, and announcing success before the socket exists is how the
    # first version of this shipped a lie.
    vid_ready=0
    for _ in {1..40}; do
      sleep 1
      if vid_ping; then vid_ready=1; break; fi
    done
    if (( vid_ready )); then
      ok "voice daemon started"
    else
      warn "voice daemon did not come up — the wake word is unfiltered"
      print "        Log: ~/.openclaw/logs/orion-voiceid.log"
    fi
  fi
  if [[ -f "$HOME/.openclaw/orion-voiceid.json" ]]; then
    ok "your voice is enrolled — the wake word is filtered to you"
  else
    warn "no voice enrolled yet — the wake word answers anyone"
    print "        Run:  ./scripts/orion-enroll-voice"
  fi
else
  warn "speaker verification not set up — the wake word is unfiltered"
  print "        Optional. To enable:  ./scripts/orion-enroll-voice"
fi

# ------------------------------------------------------------- self-knowledge
step "6b. Self-knowledge"
# TOOLS.md is generated, never hand-written. It was wrong for days -- telling
# Orion he had no shell and no app control after both shipped -- and he believed
# it and said so out loud. Regenerating here means it cannot lag a deploy.
# `2>/dev/null` used to be here. It had to go: orion-selfdoc now exits non-zero
# and explains itself on stderr when it cannot resolve a capability tier, and
# discarding that turned the one loud failure in the generator back into the
# silent one it was written to replace. Exit 1 means TOOLS.md WAS written but
# something in it is a guess — a different thing from the generator not running.
selfdoc_node="$HOME/.openclaw/tools/node-v24.15.0/bin/node"
[[ -x "$selfdoc_node" ]] || selfdoc_node="node"
selfdoc_out="$("$selfdoc_node" "$repo/scripts/orion-selfdoc" 2>&1)"
selfdoc_status=$?
case $selfdoc_status in
  0) ok "TOOLS.md regenerated from the live catalog" ;;
  1) bad "TOOLS.md regenerated but a capability tier could not be resolved:"
     print "$selfdoc_out" | sed 's/^/        /'
     print "        Orion will describe that tier as switched off, which is a GUESS." ;;
  *) warn "could not regenerate TOOLS.md — Orion may describe himself wrongly"
     print "$selfdoc_out" | sed 's/^/        /' ;;
esac

# --------------------------------------------------------------- daily memory
step "6c. Daily memory"
daily_plist="$HOME/Library/LaunchAgents/com.nickmadaio.orion.daily.plist"
# OpenClaw owns the one nightly pipeline: summary, then memory index. The old
# 00:20 LaunchAgent ran the summary first and consumed/archive the ledger, so
# the 02:10 job always found “nothing” and only indexed. Two schedulers did not
# add reliability; they split one transaction across owners.
if [[ -f "$daily_plist" ]]; then
  launchctl unload "$daily_plist" >/dev/null 2>&1
  retired="$HOME/.openclaw/backups/orion-launchagents"
  mkdir -p "$retired"
  mv "$daily_plist" "$retired/com.nickmadaio.orion.daily.retired.plist"
  ok "retired the duplicate 00:20 LaunchAgent"
fi
if "$HOME/.openclaw/bin/openclaw" cron list --json 2>/dev/null \
    | grep -q '"name": "orion-daily-memory"'; then
  ok "one nightly memory pipeline scheduled in OpenClaw (summary + index)"
else
  warn "orion-daily-memory is missing from OpenClaw cron; nightly summary/index will not run"
fi

# ------------------------------------------------------------------ gateway
step "7. Gateway"
gw="$("$py" -c "
import json
try: print(json.load(open('$HOME/.openclaw/openclaw.json'))['gateway']['port'])
except Exception: print(18789)" 2>/dev/null)"
[[ -z "$gw" ]] && gw=18789

gw_alive() {
  "$py" -c "import socket,sys; s=socket.socket(); s.settimeout(0.6); sys.exit(min(1,s.connect_ex(('127.0.0.1',$gw))))" 2>/dev/null
}

# Is the running gateway older than the plugin it is supposed to be running?
#
# The gateway loads plugin code once, at start. So deploying a new build while
# it is up changes the files on disk and nothing else — and because the port
# still answers, every check here passes and this script prints green. You
# double-click, see "listening", and get the OLD behaviour with no hint why.
#
# That is the failure mode this whole project keeps re-learning: not a crash,
# a silent fallback that looks like success. So compare the two ages and say so.
plugin_is_newer_than_gateway() {
  local pid entry
  entry="$HOME/.openclaw/extensions/orion-control/dist/index.js"
  [[ -f "$entry" ]] || return 1
  pid="$(lsof -ti "tcp:$gw" -sTCP:LISTEN 2>/dev/null | head -1)"
  [[ -n "$pid" ]] || return 1
  # How long has the gateway been up, versus how long ago was the plugin built?
  # If the build is NEWER than the process, the running gateway predates it and
  # is serving stale code.
  #
  # `etimes` (age in whole seconds) is a GNU/procps keyword and does not exist
  # in BSD ps, so on macOS `ps -o etimes=` does not fail -- it prints its entire
  # list of valid keywords. That string was then interpolated straight into the
  # Python below, which turned the whole check into a SyntaxError on every run:
  #
  #   sys.exit(0 if age < %cpu%memacflagacflgargsblocked...
  #
  # The check therefore never once returned an answer, which is why a rebuilt
  # plugin could sit there un-served with setup reporting the gateway as fine.
  # BSD ps has `etime`, formatted [[dd-]hh:]mm:ss, so parse that instead.
  local up
  up="$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')"
  [[ -n "$up" ]] || return 1
  "$py" -c "
import os, sys, time

def seconds(text):
    days = 0
    if '-' in text:
        day_part, text = text.split('-', 1)
        days = int(day_part)
    parts = [int(piece) for piece in text.split(':')]
    while len(parts) < 3:
        parts.insert(0, 0)
    hours, minutes, secs = parts
    return days * 86400 + hours * 3600 + minutes * 60 + secs

age = time.time() - os.path.getmtime('$entry')
sys.exit(0 if age < seconds('$up') else 1)"
}

if gw_alive; then
  if plugin_is_newer_than_gateway; then
    warn "running an older build of orion-control — restarting so it loads"
    "$HOME/.openclaw/bin/openclaw" daemon stop >/dev/null 2>&1
    sleep 1
    "$HOME/.openclaw/bin/openclaw" daemon start >/dev/null 2>&1
    sleep 3
    if gw_alive; then
      ok "restarted on 127.0.0.1:$gw with the current plugin"
    else
      bad "gateway did not come back after restart"
      print "        Try by hand:  ~/.openclaw/bin/openclaw daemon start"
    fi
  else
    ok "listening on 127.0.0.1:$gw"
  fi
else
  warn "not running — starting it"
  "$HOME/.openclaw/bin/openclaw" daemon start >/dev/null 2>&1
  sleep 3
  if gw_alive; then
    ok "started"
  else
    bad "gateway will not start — Orion cannot think without it"
    print "        Try by hand:  ~/.openclaw/bin/openclaw daemon start"
  fi
fi

# ------------------------------------------------------------------- launch
step "8. Launch"
app="/Applications/Orion.app"
[[ -d "$app" ]] || app="$repo/native/Orion/.build/Orion.app"
open "$app" && ok "launched — look for the Orion icon in your menu bar"

# -------------------------------------------------------------------- using
cat <<'USING'

────────────────────────────────────────────────────────────
  HOW TO USE IT

  Hold Right Option      talk (works in any app)
  Click the menu bar     text window, cursor ready to type
  Right-click menu bar   status, preferences, quit
  Escape                 stop Orion mid-sentence

  Say "Orion" to summon it hands-free — off by default,
  turn it on in Preferences ▸ Voice.

  FIRST RUN needs three permissions:
    Accessibility        System Settings ▸ Privacy & Security
                         (required for Right Option to work at all)
    Microphone           prompted on first press
    Speech Recognition   prompted on first press

  If you see MORE THAN ONE "Orion" in Accessibility, remove
  them all with (−), then relaunch and grant the one it asks for.

  Something wrong?   ./scripts/orion-doctor
────────────────────────────────────────────────────────────

USING
