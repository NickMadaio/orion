#!/usr/bin/env node

import { homedir } from "node:os";
import { join } from "node:path";
import { loadAttentionQueue, openItems } from "./lib/attention/store.mjs";
import { scoreAttentionItem } from "./lib/attention/score.mjs";

const DEFAULT_FILE = join(homedir(), ".openclaw", "orion-controlled", "attention.json");

function parseArgs(argv) {
  const args = argv.slice(2);
  const result = { command: null, json: false, file: null, id: null };

  let i = 0;
  while (i < args.length) {
    const arg = args[i];
    if (arg === "--json") {
      result.json = true;
    } else if (arg === "--file") {
      i++;
      if (i >= args.length) {
        process.stderr.write("--file requires a path argument\n");
        process.exit(2);
      }
      result.file = args[i];
    } else if (!result.command) {
      result.command = arg;
    } else if (result.command === "show" && !result.id) {
      result.id = arg;
    } else {
      process.stderr.write(`unknown argument: ${arg}\n`);
      process.exit(2);
    }
    i++;
  }

  return result;
}

function usage() {
  return "Usage: orion-attention list [--json] [--file PATH]\n       orion-attention show <id> [--file PATH]";
}

async function runList(file, jsonFlag) {
  let queue;
  try {
    queue = await loadAttentionQueue(file);
  } catch (err) {
    process.stderr.write(`cannot read attention queue: ${err.message}\n`);
    process.exit(1);
  }

  const now = Date.now();
  const items = openItems(queue, now);

  if (items.length === 0) {
    process.stdout.write("No attention items.\n");
    process.exit(0);
  }

  const scored = items.map((item) => {
    const result = scoreAttentionItem(item);
    return { item, score: result.score };
  });

  // Sort by score desc (null last), then by id asc
  scored.sort((a, b) => {
    if (a.score === null && b.score === null) return a.item.id.localeCompare(b.item.id);
    if (a.score === null) return 1;
    if (b.score === null) return -1;
    if (b.score !== a.score) return b.score - a.score;
    return a.item.id.localeCompare(b.item.id);
  });

  if (jsonFlag) {
    const rows = scored.map(({ item, score }) => ({
      id: item.id,
      title: item.title,
      source: item.source,
      score,
      state: item.state,
    }));
    process.stdout.write(JSON.stringify(rows, null, 2) + "\n");
    process.exit(0);
  }

  for (const { item, score } of scored) {
    const scoreStr = score === null ? " —  " : score.toFixed(2);
    process.stdout.write(`  ${scoreStr}  ${item.title}  (${item.source})\n`);
  }
  process.exit(0);
}

async function runShow(id, file) {
  if (!id) {
    process.stderr.write("show requires an id argument\n");
    process.exit(2);
  }

  let queue;
  try {
    queue = await loadAttentionQueue(file);
  } catch (err) {
    process.stderr.write(`cannot read attention queue: ${err.message}\n`);
    process.exit(1);
  }

  const entry = queue.items.find((e) => e.id === id);
  if (!entry) {
    process.stderr.write(`no attention item ${id}\n`);
    process.exit(1);
  }

  process.stdout.write(JSON.stringify(entry, null, 2) + "\n");
  process.exit(0);
}

async function main() {
  const parsed = parseArgs(process.argv);
  const file = parsed.file || DEFAULT_FILE;

  if (!parsed.command) {
    process.stderr.write(usage() + "\n");
    process.exit(2);
  }

  if (parsed.command === "list") {
    await runList(file, parsed.json);
  } else if (parsed.command === "show") {
    await runShow(parsed.id, file);
  } else {
    process.stderr.write(`unknown command: ${parsed.command}\n`);
    process.stderr.write(usage() + "\n");
    process.exit(2);
  }
}

main();
