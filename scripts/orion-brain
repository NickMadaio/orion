#!/usr/bin/env node
/*
 orion-brain — ORION's way into his brain (Basic Memory over the Obsidian vault
 ~/Documents/orionBrain), allowlisted like orion-recall (2026-10-05).

 OpenClaw's embedded runner does not receive MCP servers, so the brain's MCP
 tools never reached ORION; this wraps Basic Memory's own CLI instead.

   orion-brain search "<words>"                 notes and facts that match
   orion-brain read "<note title>"              one note
   orion-brain context "<note title>"           a note plus the notes linked to it
   orion-brain learn "<note title>" "<category>" "<fact>"
        add what he told you to a note's "## Learned" section (the note is
        created, linked to [[Nick]], if it does not exist yet)
   orion-brain recent                            what changed in the last week
   orion-brain forget "<words>"                 saved entries matching the words, as JSON (nothing changes)
   orion-brain forget --apply <id>...           archive those entries (reversible) and say which went
   orion-brain forget --restore <id>...         put archived entries back where they were
   orion-brain links "<thing>"                  what it is linked to: graph edges + the vault's relations, as JSON
   orion-brain profile                          his standing facts (classes, gym, side project, home, priorities), as JSON
   orion-brain canvas-courses                    current Canvas courses, honouring Nick's exclusions
   orion-brain canvas-refresh <id> <course note> [--apply]
        preview/refresh source facts in an existing course and assessment notes

 Canvas refresh replaces only its marked source section and Canvas properties,
 with conflict checks and local backups. Other commands append or read.
*/
import { execFileSync, execFile } from "node:child_process";
import { promisify } from "node:util";
import { bmArgs } from "./lib/brain/bm.mjs";
import { brainSearch } from "./lib/brain/search.mjs";
import { loadGraph } from "./lib/brain/graph-search.mjs";
import { archiveEntries, findEntries, restoreEntries } from "./lib/brain/forget.mjs";
import { linksFor, readVault } from "./lib/brain/links.mjs";
import { loadProfile } from "./lib/brain/profile.mjs";
import { join } from "node:path";
import { homedir } from "node:os";
import { fileURLToPath } from "node:url";
import { dirname } from "node:path";
import { loadCourseVault, applyCourseRefresh } from "./lib/connect/course-vault.mjs";
import { planCourseRefresh, excludedCourses, previewCourseRefresh } from "./lib/connect/course-notes.mjs";
import { canvasId } from "./lib/connect/canvas.mjs";

const BM = join(homedir(), ".local/bin/basic-memory");
const [command, ...rest] = process.argv.slice(2);
const fail = (m, code = 2) => { console.error(m); process.exit(code); };
const bm = (args) => execFileSync(BM, args, { encoding: "utf8", timeout: 60000, maxBuffer: 8 << 20 });
const RANKED_BUDGET_MS = 2200; // a lookup must return in under 3 s
const rankedSearch = async (q) => {
  const { stdout } = await promisify(execFile)(BM, bmArgs.search(q), { encoding: "utf8", timeout: RANKED_BUDGET_MS, maxBuffer: 8 << 20 });
  return (JSON.parse(stdout).results ?? []).map((r) => ({ title: r.title, file_path: r.file_path, excerpt: r.matched_chunk ?? r.content ?? "" }));
};
const clean = (s, max) => String(s ?? "").replace(/[\u0000-\u001f]/g, " ").trim().slice(0, max);
// REV2 BRAIN: a note title is a name, never an option ("--help", "-rf") or a path ("../x", "a/b") for basic-memory to act on.
const badTitle = (t) => /^-/.test(t) || /[/\\]/.test(t) || /\.\./.test(t);
// Seams (tests and replays): the vault, the workspace and the controlled dir.
const dirs = () => ({
  vaultDir: process.env.ORION_BRAIN_VAULT || join(homedir(), "Documents/orionBrain"),
  workspaceDir: process.env.ORION_WORKSPACE_DIR || join(homedir(), ".openclaw/workspace"),
  controlledDir: process.env.ORION_CONTROLLED_DIR || join(homedir(), ".openclaw/orion-controlled"),
});
const ID = /^[0-9a-f]{10}$/;

try {
  if (command === "canvas-courses" || command === "canvas-refresh") {
    const vault = join(homedir(), 'Documents/orionBrain');
    const loaded = loadCourseVault(vault);
    const connector = join(dirname(fileURLToPath(import.meta.url)), 'orion-connect');
    const readCanvas = args => JSON.parse(execFileSync(process.execPath, [connector, ...args], {encoding:'utf8', timeout:180000, maxBuffer:8<<20}));
    if (command === 'canvas-courses') {
      if (rest.length) fail('usage: orion-brain canvas-courses');
      const result = readCanvas(['canvas-courses']);
      if (result.status !== 'available') fail('Canvas courses unavailable; no current-course list', 1);
      const excluded = excludedCourses(loaded.schoolNote);
      console.log(JSON.stringify({ ...result, data:result.data.filter(c => !excluded.has(String(c.id))), excluded_course_ids:[...excluded], exclusion_source:'Northeastern University London note (Nick-confirmed)' }, null, 2));
    } else {
      if (rest.length < 2 || rest.length > 3 || (rest[2] !== undefined && rest[2] !== '--apply')) fail('usage: orion-brain canvas-refresh <course_id> <existing course note> [--apply]');
      const courseId = canvasId(rest[0]);
      if (excludedCourses(loaded.schoolNote).has(courseId)) fail('This course is excluded by Nick; Canvas was not queried', 1);
      const snapshot = readCanvas(['canvas-course', courseId]);
      const plan = planCourseRefresh(snapshot, rest[1], loaded.notes, loaded.schoolNote);
      if (rest[2] === '--apply') {
        const result = applyCourseRefresh(vault, plan, join(homedir(), '.openclaw/orion-controlled/canvas-backups'), loaded.schoolNote);
        let indexing;
        try {
          // Direct-file readback is not index proof. Request one local full-text
          // pass for this project so Basic Memory can read the new source facts.
          // A failure does not undo verified files or pretend the index is fresh.
          execFileSync(BM, ['reindex','--project','orion','--search'], {encoding:'utf8',timeout:60000,maxBuffer:2<<20,stdio:['ignore','pipe','pipe']});
          indexing = {status:'fulltext_refreshed', semantic_index:'OpenClaw embeddings/search freshness not independently verified'};
        } catch {
          indexing = {status:'pending', message:'Files verified and backed up; Basic Memory full-text indexing failed or timed out. Read the direct files or retry indexing before using cached facts.'};
        }
        console.log(JSON.stringify({ status:'applied', course_note:plan.course_note, retrieved_at:plan.retrieved_at, ...result, indexing }, null, 2));
      } else {
        console.log(JSON.stringify({ status:'preview', course_note:plan.course_note, retrieved_at:plan.retrieved_at, files:previewCourseRefresh(plan), instruction:'Use --apply when Nick requested this course import/refresh.' }, null, 2));
      }
    }
  } else if (command === "search") {
    const q = clean(rest.join(" "), 200); if (!q) fail('usage: orion-brain search "<words>"');
    const controlled = process.env.ORION_CONTROLLED_DIR || join(homedir(), ".openclaw/orion-controlled");
    const vaultDir = process.env.ORION_BRAIN_VAULT || join(homedir(), "Documents/orionBrain");
    console.log(await brainSearch(q, { graph: loadGraph(controlled), vaultDir, ranked: rankedSearch }));
  } else if (command === "read" || command === "context") {
    const title = clean(rest[0], 120); if (!title) fail(`usage: orion-brain ${command} "<note title>"`);
    if (badTitle(title)) fail(`orion-brain: "${title}" is not a note title (no leading "-", "/" or ".."); nothing was read.`);
    process.stdout.write(command === "read" ? bm(bmArgs.read(title)) : bm(bmArgs.context(title)));
  } else if (command === "learn") {
    const [rawTitle, rawCategory, ...fact] = rest;
    const title = clean(rawTitle, 80); const category = clean(rawCategory, 30).toLowerCase().replace(/[^a-z -]/g, "");
    const text = clean(fact.join(" "), 400);
    if (!title || !category || !text) fail('usage: orion-brain learn "<note title>" "<category>" "<fact>"');
    if (badTitle(title)) fail(`orion-brain: "${title}" is not a note title (no leading "-", "/" or ".."); nothing was saved.`);
    const line = `- [${category}] ${text} (${new Date().toISOString().slice(0, 10)})`;
    let existing = null;
    try { existing = bm(bmArgs.read(title)); } catch { /* new note */ }
    if (!existing || /not found/i.test(existing)) {
      bm(bmArgs.write({ title, directory: "20 Areas/Learned", noteType: "note", content: `## Learned\n${line}\n\n## Relations\n- about [[Nick]]\n` }));
      console.log(`New note "${title}" (linked to Nick) with: ${line}`);
    } else {
      if (!/^## Learned/m.test(existing)) bm(bmArgs.append(title, "\n## Learned\n"));
      bm(bmArgs.append(title, `${line}\n`));
      console.log(`Added to "${title}": ${line}`);
    }
  } else if (command === "forget") {
    const [flag, ...ids] = rest;
    if (flag === "--apply" || flag === "--restore") {
      if (!ids.length || !ids.every((id) => ID.test(id))) fail(`usage: orion-brain forget ${flag} <id>... (ids from orion-brain forget "<words>")`);
      console.log(JSON.stringify(flag === "--apply" ? archiveEntries(dirs(), ids) : restoreEntries(dirs(), ids)));
    } else {
      const q = clean(rest.join(" "), 200); if (!q || /^-/.test(q)) fail('usage: orion-brain forget "<words>"');
      console.log(JSON.stringify({ query: q, matches: findEntries(dirs(), q) }));
    }
  } else if (command === "links") {
    const q = clean(rest.join(" "), 120); if (!q || /^-/.test(q)) fail('usage: orion-brain links "<thing>"');
    const d = dirs();
    console.log(JSON.stringify(linksFor(q, { notes: readVault(d.vaultDir), graph: loadGraph(d.controlledDir) })));
  } else if (command === "profile") {
    if (rest.length) fail("usage: orion-brain profile");
    console.log(JSON.stringify(loadProfile(dirs())));
  } else if (command === "recent") {
    process.stdout.write(bm(bmArgs.recent()));
  } else {
    fail("usage: orion-brain search|read|context|learn|recent|forget|links|profile|canvas-courses|canvas-refresh (see the header)");
  }
} catch (e) {
  fail(`orion-brain: ${String(e.stderr || e.message).slice(0, 300)}`, 1);
}
