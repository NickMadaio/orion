#!/usr/bin/env node
/*
 orion-tasks — his to-dos with due dates, spread across his days (2026-10-06).

 A to-do lives on his Orion Reminders list: its due date is when it must be done,
 its notes say how to spread it ("2 hours a day until it's due", "two 2-hour
 blocks, Tuesday and Thursday", "four 1-hour blocks this week") and its priority
 (high/medium/low) says how much it matters. ORION books the sessions; when the
 due date, the spread or the priority changes, the sessions are re-planned.

   orion-tasks list                                         to-dos, due dates, spreads, booked sessions
   orion-tasks add "<title>" [--due <when>] [--spread "<how>"] [--priority high|medium|low]
   orion-tasks set "<task>" [--due <when>|--no-due] [--spread "<how>"] [--priority …] [--title "<new>"]
   orion-tasks done "<task>"                                tick ONE to-do off (exact title, else the one that has his words)
   orion-tasks plan ["<task>"] [--days 7] [--dry-run]       (re)book the sessions for the next days
   orion-tasks sweep                                        take finished to-dos' sessions off (orion-watch, every tick)
   orion-tasks sub "<task>" add "<subtask>" | set "<subtask>" <percent> | remove "<subtask>"
        subtasks ("complete cert courses" → its 3 courses, each with a % done). Only the
        parent is scheduled; the subtasks track progress.
   <when>: YYYY-MM-DD, today, tomorrow, or a weekday (the next one).

 Sessions are ordinary ORION blocks named after the to-do, booked with
 orion-reschedule (so every day rule, the travel walls and undo apply); its
 importance comes from the priority and how close the due date is.
*/
import { spawnSync } from "node:child_process";
import { readFileSync, writeFileSync, renameSync, mkdirSync } from "node:fs";
import { homedir } from "node:os";
import { join, dirname } from "node:path";
import { fileURLToPath } from "node:url";
import { bridgeRequest, clockNow } from "./lib/life/bridge-path.mjs";
import { calendarEvents, toBlocks, localDate } from "./lib/life/live-day.mjs";
import { loadConfig } from "./lib/life/config.mjs";
import { parseSpread, planSessions, taskImportance, waitsFor } from "./lib/life/task-spread.mjs";
import { parseTodos } from "./lib/life/todo-parse.mjs";
import { parseTaskNotes, formatTaskNotes, progressOf } from "./lib/life/task-notes.mjs";

const HERE = dirname(fileURLToPath(import.meta.url));
const args = process.argv.slice(2);
const flag = (n) => { const i = args.indexOf(n); return i >= 0 ? args[i + 1] : undefined; };
const VALUED = ["--due", "--spread", "--priority", "--title", "--days"];
const positional = args.filter((a, i) => !a.startsWith("--") && !VALUED.includes(args[i - 1]));
// Unknown options fail loudly: "--at 11:00" was ignored and a timed reminder became a to-do booked into
// his evening (2026-10-13). A time-of-day reminder is the alarm_set action, not a to-do.
const KNOWN_OPTIONS = new Set([...VALUED, "--dry-run", "--no-due", "--date", "--plan"]);
const unknownOption = args.find((a) => a.startsWith("--") && !KNOWN_OPTIONS.has(a));
if (unknownOption) {
  console.error(`NOTHING WAS CHANGED: ${unknownOption} is not an option of orion-tasks (options: ${[...KNOWN_OPTIONS].join(" ")}).${unknownOption === "--at" ? " For a reminder at a time of day use the alarm_set action." : ""}`);
  process.exit(2);
}
const [command, name] = positional;
const dry = args.includes("--dry-run");
const fail = (m, code = 2) => { console.error(m); process.exit(code); };
const config = loadConfig();
const now = clockNow();
const today = localDate(now);
const addDays = (date, n) => { const d = new Date(`${date}T12:00:00`); d.setDate(d.getDate() + n); return localDate(d); };
const words = (t) => String(t).toLowerCase().replace(/[^a-z0-9 ]/g, " ").split(/\s+/).filter((w) => w.length >= 3);
const same = (a, b) => { const x = words(a), y = words(b); return x.length > 0 && x.every((w) => y.includes(w)); };

function dueFrom(text) {
  if (!text) return undefined;
  const t = text.trim().toLowerCase();
  if (/^\d{4}-\d{2}-\d{2}$/.test(t)) return t;
  if (t === "today") return today;
  if (t === "tomorrow") return addDays(today, 1);
  const days = ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"];
  const i = days.findIndex((d) => d.startsWith(t.slice(0, 3)));
  if (i >= 0) return addDays(today, ((i - new Date(`${today}T12:00:00`).getDay() + 7) % 7) || 7);
  fail(`orion-tasks: "${text}" is not a date (YYYY-MM-DD, today, tomorrow or a weekday)`);
}
const endOfDay = (date) => new Date(`${date}T23:59:00`).toISOString();

async function tasks() {
  const r = await bridgeRequest("list_incomplete_reminders", { list: config.todoList });
  return JSON.parse(r.reminders_json ?? "[]").map((t) => ({ ...t, dueDate: t.due ? localDate(new Date(t.due)) : null }));
}
function find(list, wanted) {
  const hits = list.filter((t) => same(wanted, t.title));
  if (!hits.length) fail(`orion-tasks: no to-do called "${wanted}" on ${config.todoList}. To-dos: ${list.map((t) => t.title).join(", ") || "none"}`, 1);
  return hits[0];
}
// "Mark the oats one done" (live sweep, 2026-10-15): the prompts offered `done`, it did not exist, and
// the reply said it was done anyway. Exact title first, else the to-dos that have all his words; two
// or more is a question for him, never a guess (the same rule as orion-agenda-change task-done).
const FILLER = new Set(["the", "one", "thing", "that", "this", "task", "todo", "and", "off", "for", "with"]);
// Two-letter words count ("ds lab" is not "cs lab"), and every word he said must be in the title (review, 2026-10-16).
const words2 = (t) => String(t).toLowerCase().replace(/[^a-z0-9 ]/g, " ").split(/\s+/).filter((w) => w.length >= 2);
const hasAll = (said, title) => said.length > 0 && said.every((w) => words2(title).includes(w));
function pickOne(list, wanted) {
  const said = words2(wanted).filter((w) => !FILLER.has(w));
  const norm = (t) => String(t).toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();   // keeps "cs" vs "ds"
  const exact = list.filter((t) => norm(t.title) === norm(wanted));
  const hits = exact.length ? exact : list.filter((t) => hasAll(said, t.title));
  if (!hits.length) fail(`NOTHING WAS CHANGED: no to-do called "${wanted}" on ${config.todoList}. To-dos: ${list.map((t) => t.title).join(", ") || "none"}`, 1);
  if (hits.length > 1) fail(`NOTHING WAS CHANGED: more than one to-do matches "${wanted}": ${hits.map((t) => `"${t.title}"`).join(", ")} — ask him which`, 1);
  return hits[0];
}
/** The spread to plan from: his notes, else (with a due date) the to-do's own estimate as a total. */
function spreadOf(task) {
  const fromNotes = parseSpread(parseTaskNotes(task.notes).spread);
  if (fromNotes) return fromNotes;
  if (!task.dueDate) return null;
  let minutes = 60;
  try { const parsed = parseTodos(task.title, { now: { date: today, minute: 0 } }).tasks; if (parsed.length === 1) minutes = parsed[0].minutes; } catch { /* default */ }
  return { kind: "total", minutes };
}
// The to-dos ORION has booked sessions for (2026-10-13). Reminders only lists the open ones, so
// without this a ticked-off to-do kept its sessions: his finished cert courses stayed booked.
const LEDGER = process.env.ORION_TASK_LEDGER || join(homedir(), ".openclaw/orion-controlled/task-sessions.json");
const readLedger = () => { try { return JSON.parse(readFileSync(LEDGER, "utf8")).titles ?? []; } catch { return []; } };
function writeLedger(titles) {
  if (dry) return;
  mkdirSync(dirname(LEDGER), { recursive: true });
  writeFileSync(`${LEDGER}.tmp`, JSON.stringify({ titles: [...new Set(titles)] }, null, 2));
  renameSync(`${LEDGER}.tmp`, LEDGER);
}

/** Sessions of booked to-dos that are no longer open come off the next two weeks (what happened stays). */
async function sweep(open) {
  const booked = readLedger();
  const finished = booked.filter((title) => !open.some((t) => same(title, t.title) || same(t.title, title)));
  if (!finished.length) return [];
  const events = await calendarEvents();
  const report = [];
  for (const title of finished) {
    const dates = Array.from({ length: 14 }, (_, i) => addDays(today, i))
      .filter((date) => toBlocks(events, date).some((b) => b.source === "orion" && same(title, b.title)));
    for (const date of dates) if (!dry) reschedule("drop", title, "--date", date);
    report.push(`${title} is done — ${dates.length ? `${dry ? "would remove" : "removed"} its sessions on ${dates.join(", ")}` : "nothing of it was booked"}`);
  }
  writeLedger(booked.filter((title) => !finished.includes(title)));
  return report;
}

const reschedule = (...a) => spawnSync(process.execPath, [join(HERE, "orion-reschedule"), ...a], { encoding: "utf8" });

/** Book (or re-book) the sessions of these to-dos for the next `days` days. */
async function plan(list, days, open = list) {
  const events = await calendarEvents();
  const horizon = Array.from({ length: days }, (_, i) => addDays(today, i));
  const perDate = new Map(horizon.map((d) => [d, { book: [], drop: [] }]));
  const report = [];
  for (const task of list) {
    // "Only schedule this once X is complete": nothing until X is ticked off;
    // sessions already booked for it come off (2026-10-06).
    const blocker = waitsFor(task.notes, open.filter((t) => t.title !== task.title).map((t) => t.title));
    if (blocker) {
      for (const date of horizon) if (toBlocks(events, date).some((b) => b.source === "orion" && same(task.title, b.title))) perDate.get(date).drop.push(task.title);
      report.push(`${task.title}: waiting until "${blocker}" is done — not scheduled`);
      continue;
    }
    const spread = spreadOf(task);
    if (!spread) { report.push(`${task.title}: no due date and no spread in its notes — not planned (add one with orion-tasks set)`); continue; }
    const sessions = planSessions(spread, { today, due: task.dueDate }).filter((s) => perDate.has(s.date));
    const importance = taskImportance(task, today);
    for (const date of horizon) {
      const nowMinute = now.getHours() * 60 + now.getMinutes();
      const mine = toBlocks(events, date).filter((b) => b.source === "orion" && same(task.title, b.title));
      // Today's session already started or happened: today is done for this to-do.
      if (date === today && mine.some((b) => b.start < nowMinute)) continue;
      const want = sessions.find((s) => s.date === date)?.minutes ?? 0;
      const have = mine.filter((b) => date > today || b.end > nowMinute);
      const haveMinutes = have.reduce((s, b) => s + b.end - b.start, 0);
      if (want && haveMinutes !== want) perDate.get(date).book.push(`${task.title}, ${want}${importance === 0 ? ", must" : importance === 2 ? ", optional" : ""}`);
      if (!want && have.length) perDate.get(date).drop.push(task.title);
    }
    report.push(`${task.title}: ${sessions.map((s) => `${s.date} ${s.minutes} min`).join(", ") || "nothing in the next days"}${task.dueDate ? ` (due ${task.dueDate})` : ""}`);
  }
  const booking = [...perDate.values()].some((d) => d.book.length);
  if (booking) writeLedger([...readLedger(), ...list.filter((t) => [...perDate.values()].some((d) => d.book.some((p) => p.startsWith(`${t.title}, `)))).map((t) => t.title)]);
  for (const [date, { book, drop }] of perDate) {
    if (drop.length) {
      const r = dry ? null : reschedule("drop", ...drop, "--date", date);
      report.push(`${date}: ${dry ? "would remove" : "removed"} ${drop.join(", ")}${r && r.status ? ` (${r.stdout.trim().split("\n")[0]})` : ""}`);
    }
    if (book.length) {
      const r = reschedule("day", "--date", date, ...book.flatMap((p) => ["--plan", p]), ...(dry ? ["--dry-run"] : []));
      report.push(`${date}:\n${(r.stdout + r.stderr).trim().split("\n").map((l) => `  ${l}`).join("\n")}`);
    }
  }
  return report;
}

try {
  if (command === "list") {
    const list = await tasks();
    if (!list.length) { console.log(`Nothing on ${config.todoList}.`); process.exit(0); }
    const events = await calendarEvents();
    for (const t of list) {
      const booked = Array.from({ length: 7 }, (_, i) => addDays(today, i)).flatMap((d) => toBlocks(events, d)
        .filter((b) => b.source === "orion" && same(t.title, b.title)).map((b) => `${d.slice(5)} ${b.end - b.start} min`));
      const n = parseTaskNotes(t.notes);
      const blocker = waitsFor(t.notes, list.filter((x) => x.title !== t.title).map((x) => x.title));
      const progress = progressOf(n.subtasks);
      console.log(`- ${t.title}${t.dueDate ? ` · due ${t.dueDate}` : ""}${t.priority ? ` · ${t.priority}` : ""}${n.spread ? ` · "${n.spread}"` : ""}${progress !== null ? ` · ${progress}% overall` : ""}${blocker ? ` · waits for "${blocker}"` : ""}${booked.length ? ` · booked: ${booked.join(", ")}` : ""}`);
      for (const sub of n.subtasks) console.log(`    ${sub.done ? "✓" : "·"} ${sub.title} — ${sub.percent}%`);
    }
  } else if (command === "add") {
    if (!name) fail('usage: orion-tasks add "<title>" [--due <when>] [--spread "<how>"] [--priority high|medium|low]');
    const due = dueFrom(flag("--due")); const spread = flag("--spread"); const priority = flag("--priority");
    if (spread && !parseSpread(spread)) console.log(`(note: "${spread}" was saved, but it does not say how to spread the work — e.g. "2 hours a day" or "two 2-hour blocks, Tuesday and Thursday")`);
    if (!dry) await bridgeRequest("create_reminder", { title: name, list: config.todoList, ...(due ? { due_at: endOfDay(due) } : {}), ...(spread ? { notes: spread } : {}), ...(priority ? { priority } : {}) });
    console.log(`${dry ? "Would add" : "Added"} "${name}" to ${config.todoList}${due ? `, due ${due}` : ""}${priority ? `, ${priority} priority` : ""}.`);
    if (due || spread) for (const l of await plan([{ title: name, dueDate: due ?? null, notes: spread, priority }], Number(flag("--days") ?? 7))) console.log(l);
  } else if (command === "set") {
    if (!name) fail('usage: orion-tasks set "<task>" [--due <when>|--no-due] [--spread "<how>"] [--priority …] [--title "<new>"]');
    const task = find(await tasks(), name);
    const change = {};
    if (args.includes("--no-due")) change.due_at = "";
    else if (flag("--due")) change.due_at = endOfDay(dueFrom(flag("--due")));
    if (flag("--spread") !== undefined) change.notes = formatTaskNotes({ ...parseTaskNotes(task.notes), spread: flag("--spread") });
    if (flag("--priority")) change.priority = flag("--priority");
    if (flag("--title")) change.title = flag("--title");
    if (!Object.keys(change).length) fail("orion-tasks set: nothing to change");
    if (!dry) await bridgeRequest("update_reminder", { identifier: task.identifier, ...change });
    const updated = { ...task, ...(change.title ? { title: change.title } : {}), ...(change.notes !== undefined ? { notes: change.notes } : {}),
      ...(change.priority ? { priority: change.priority } : {}), ...(change.due_at !== undefined ? { dueDate: change.due_at ? localDate(new Date(change.due_at)) : null } : {}) };
    console.log(`${dry ? "Would change" : "Changed"} "${task.title}": ${Object.entries(change).map(([k, v]) => `${k.replace("_at", "")} → ${v || "none"}`).join(", ")}.`);
    // A renamed to-do's old sessions go; the new ones are booked under the new name.
    if (change.title && !dry) for (let i = 0; i < 7; i += 1) reschedule("drop", task.title, "--date", addDays(today, i));
    for (const l of await plan([updated], Number(flag("--days") ?? 7))) console.log(l);
  } else if (command === "done") {
    if (!name) fail('usage: orion-tasks done "<task>"');
    const task = pickOne(await tasks(), name);
    if (!dry) {
      await bridgeRequest("complete_reminder", { identifier: task.identifier });
      if ((await tasks()).some((t) => t.identifier === task.identifier)) fail(`NOTHING WAS CHANGED: "${task.title}" is still open after ticking it off.`, 1);
    }
    // Its booked sessions come off on orion-watch's next sweep.
    console.log(`${dry ? "Would change" : "Changed"} "${task.title}": done (ticked off ${config.todoList}).`);
  } else if (command === "sub") {
    const [, , action, subName, value] = positional;
    if (!name || !["add", "set", "remove"].includes(action) || !subName) fail('usage: orion-tasks sub "<task>" add "<subtask>" | set "<subtask>" <percent> | remove "<subtask>"');
    const task = find(await tasks(), name);
    const notes = parseTaskNotes(task.notes);
    const at = notes.subtasks.findIndex((s) => same(subName, s.title));
    let subtasks = notes.subtasks;
    if (action === "add") {
      if (at >= 0) fail(`"${notes.subtasks[at].title}" is already a subtask of ${task.title}`, 1);
      subtasks = [...subtasks, { title: subName.trim(), percent: Number(value ?? 0) || 0 }];
    } else {
      if (at < 0) fail(`${task.title} has no subtask "${subName}". Subtasks: ${notes.subtasks.map((s) => s.title).join(", ") || "none"}`, 1);
      if (action === "remove") subtasks = subtasks.filter((_, i) => i !== at);
      else {
        const percent = Number(String(value ?? "").replace("%", ""));
        if (!Number.isFinite(percent) || percent < 0 || percent > 100) fail("percent must be 0..100");
        subtasks = subtasks.map((s, i) => (i === at ? { ...s, percent: Math.round(percent) } : s));
      }
    }
    const text = formatTaskNotes({ ...notes, subtasks });
    if (!dry) await bridgeRequest("update_reminder", { identifier: task.identifier, notes: text });
    const progress = progressOf(subtasks);
    console.log(`${dry ? "Would update" : "Updated"} ${task.title}: ${subtasks.map((s) => `${s.title} ${s.percent}%`).join(", ") || "no subtasks"}${progress !== null ? ` — ${progress}% overall` : ""}.`);
  } else if (command === "sweep") {
    if (!readLedger().length) process.exit(0);
    for (const l of await sweep(await tasks())) console.log(l);
  } else if (command === "plan") {
    const list = await tasks();
    if (!name) for (const l of await sweep(list)) console.log(l);
    const openTitles = list.map((t) => t.title);
    const chosen = name ? [find(list, name)] : list.filter((t) => t.dueDate || parseSpread(parseTaskNotes(t.notes).spread) || waitsFor(t.notes, openTitles.filter((x) => x !== t.title)));
    if (!chosen.length) { console.log("No to-do has a due date or a spread yet; nothing to plan."); process.exit(0); }
    for (const l of await plan(chosen, Number(flag("--days") ?? 7), list)) console.log(l);
  } else {
    fail("usage: orion-tasks list|add|set|done|sub|plan|sweep (see the header)");
  }
} catch (e) {
  fail(`orion-tasks: ${e.message}`, 1);
}
