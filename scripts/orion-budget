#!/usr/bin/env node
/*
 PHASE 67 — what Orion is spending, and the ceilings that stop a runaway.

 ## Where the numbers come from, and where they do not

 OpenClaw already writes a usage record on every model call into
 `~/.openclaw/agents/main/sessions/*.jsonl`: input, output, cacheRead,
 cacheWrite, totalTokens, and a `cost` object. This reads those. It counts
 nothing itself and estimates nothing it can measure.

 Gateway cost records have mixed coverage: some calls carry nonzero costs,
 others carry zero. Zero does not establish that a call was free or billed
 through a subscription. This legacy ceiling checker keeps recordedCost and
 rate-table estimatedCost separate; use orion-usage for per-model costs and
 explicit missing-price coverage.

 The rate table is in `budgets.json` and is meant to be edited. It ships with
 the rates left at zero rather than with numbers made up here: a wrong price
 stated confidently would be the same failure one layer down.

 ## Tool calls and duration come from a different file

 The usage records carry TOKENS. They do not carry tool calls or how long
 anything took -- and I said so once as if that ended the matter, which was
 wrong: both are sitting in the task ledger. Every `orion_task_run` writes a
 record with its steps and with `createdAt`/`completedAt`, so tool calls are a
 count of steps and duration is a subtraction. `--tasks` reads that.

 ## Per-task tokens, and the honest way to attribute them

 The usage log has no task id on it, so tokens genuinely cannot be attributed
 to a run the way steps can. What CAN be done is attribution by time window:
 a task ran from A to B, and these model calls happened between A and B.

 That is an estimate and is labelled one everywhere it appears, because it is
 wrong in a specific way worth naming: a model call that happened while a task
 was running was not necessarily FOR that task, and two overlapping runs both
 claim the same calls. It is still the right thing to show -- a run that
 overlapped two million tokens is worth looking at whoever spent them -- but it
 is a pointer, not an invoice.

 ## Runaway loops

 Already handled, in a better place than a budget: the plugin refuses a third
 identical tool call inside one run and resets at run end. A budget is the
 backstop for the case that gets past it -- many DIFFERENT calls, which look
 like progress until you count them.

   orion-budget                today against the ceilings
   orion-budget --days 7       the week
   orion-budget --tasks        per-run tool calls, duration, and overlapped tokens
   orion-budget --check        silent unless something is over; exits 1 if so
   orion-budget --json
*/

import { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

const SESSIONS = join(homedir(), ".openclaw/agents/main/sessions");
const LEDGER = join(homedir(), ".openclaw/orion-controlled/task-ledger.jsonl");
const ARCHIVE = join(homedir(), ".openclaw/agents/main/sessions-archive");
const BUDGETS = join(homedir(), ".openclaw/orion-controlled/budgets.json");

/*
 Ceilings, not targets. Set from a week of real measurement rather than from
 what felt round: the machine did ~1.9M tokens across 78 calls in the sessions
 on disk when this was written, so a daily ceiling of 5M and 400 calls is
 roughly three times normal — high enough never to fire on an ordinary day,
 low enough that a loop hits it within the hour.

 `rates` ship at ZERO on purpose. See the header: made-up prices stated
 confidently are the failure this file is trying not to commit.
*/
const DEFAULTS = {
  daily: { totalTokens: 5_000_000, modelCalls: 400 },
  // A single task graph is capped at 32 steps by the validator, so a run with
  // more tool calls than this has retried its way there. `seconds` is the
  // wall-clock ceiling past which a run is worth looking at rather than one it
  // is stopped at -- nothing here kills anything.
  perTask: { toolCalls: 40, seconds: 600 },
  automation: { modelCallsPerDay: 60 },
  remoteSession: { modelCallsPerDay: 120 },
  rates: {
    note: "Dollars per million tokens. Left at zero until Nick fills them in — see the header on why nothing here invents a price.",
    perMillion: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
  },
};

const argv = process.argv.slice(2);
const wantsJson = argv.includes("--json");
const wantsTasks = argv.includes("--tasks");
const checkOnly = argv.includes("--check");
const daysAt = argv.indexOf("--days");
const days = daysAt >= 0 ? Math.min(Math.max(Number(argv[daysAt + 1]) || 1, 1), 90) : 1;

function budgets() {
  if (!existsSync(BUDGETS)) {
    mkdirSync(join(homedir(), ".openclaw/orion-controlled"), { recursive: true });
    writeFileSync(BUDGETS, JSON.stringify(DEFAULTS, null, 2) + "\n", { mode: 0o600 });
    return DEFAULTS;
  }
  try {
    // Merged over the defaults rather than replacing them: a budgets file that
    // is missing a key must fall back to a ceiling, never to no ceiling.
    const stored = JSON.parse(readFileSync(BUDGETS, "utf8"));
    return {
      daily: { ...DEFAULTS.daily, ...(stored.daily ?? {}) },
      perTask: { ...DEFAULTS.perTask, ...(stored.perTask ?? {}) },
      automation: { ...DEFAULTS.automation, ...(stored.automation ?? {}) },
      remoteSession: { ...DEFAULTS.remoteSession, ...(stored.remoteSession ?? {}) },
      rates: { ...DEFAULTS.rates, ...(stored.rates ?? {}) },
    };
  } catch {
    console.error("orion-budget: budgets.json is unreadable — using the built-in ceilings.");
    return DEFAULTS;
  }
}

/** Local civil date. `toISOString` is UTC and rolls over mid-evening here. */
const civil = (ms) => new Date(ms).toLocaleDateString("en-CA");

function collect(sinceMs) {
  const perDay = new Map();
  const models = new Map();
  let unparseable = 0;
  for (const directory of [SESSIONS, ARCHIVE]) {
    if (!existsSync(directory)) continue;
    for (const name of readdirSync(directory).filter((f) => f.endsWith(".jsonl"))) {
      const file = join(directory, name);
      let text;
      try {
        text = readFileSync(file, "utf8");
      } catch {
        unparseable += 1;
        continue;
      }
      for (const line of text.split("\n")) {
        // Cheap prefilter: most lines in a session log are not usage records,
        // and JSON.parse on all of them is the difference between instant and
        // several seconds on a machine with months of history.
        if (!line.includes('"usage"')) continue;
        let entry;
        try {
          entry = JSON.parse(line);
        } catch {
          unparseable += 1;
          continue;
        }
        const usage = entry?.message?.usage;
        if (!usage || typeof usage !== "object") continue;
        const at = Date.parse(entry.timestamp ?? "");
        if (!Number.isFinite(at) || at < sinceMs) continue;
        const key = civil(at);
        const day = perDay.get(key) ?? {
          modelCalls: 0, input: 0, output: 0, cacheRead: 0, cacheWrite: 0,
          totalTokens: 0, recordedCost: 0,
        };
        day.modelCalls += 1;
        for (const field of ["input", "output", "cacheRead", "cacheWrite", "totalTokens"]) {
          if (typeof usage[field] === "number") day[field] += usage[field];
        }
        if (typeof usage.cost?.total === "number") day.recordedCost += usage.cost.total;
        perDay.set(key, day);
        const model = entry?.message?.model ?? "unknown";
        models.set(model, (models.get(model) ?? 0) + 1);
      }
    }
  }
  return { perDay, models, unparseable };
}

/*
 Every model call as (timestamp, tokens), for the per-task overlap estimate.
 Collected separately from `collect` because that one aggregates by day and
 throws the timestamps away, and re-deriving them there would make the daily
 path pay for a feature it does not use.
*/
function callTimeline(sinceMs) {
  const out = [];
  for (const directory of [SESSIONS, ARCHIVE]) {
    if (!existsSync(directory)) continue;
    for (const name of readdirSync(directory).filter((f) => f.endsWith(".jsonl"))) {
      let text;
      try {
        text = readFileSync(join(directory, name), "utf8");
      } catch {
        continue;
      }
      for (const line of text.split("\n")) {
        if (!line.includes('"usage"')) continue;
        let entry;
        try {
          entry = JSON.parse(line);
        } catch {
          continue;
        }
        const usage = entry?.message?.usage;
        const at = Date.parse(entry?.timestamp ?? "");
        if (!usage || !Number.isFinite(at) || at < sinceMs) continue;
        out.push({ at, tokens: typeof usage.totalTokens === "number" ? usage.totalTokens : 0 });
      }
    }
  }
  return out;
}

const config = budgets();
const since = Date.now() - days * 86_400_000;
const { perDay, models, unparseable } = collect(since);

const estimate = (day) => {
  const rate = config.rates.perMillion ?? {};
  return (
    (day.input / 1e6) * (rate.input ?? 0) +
    (day.output / 1e6) * (rate.output ?? 0) +
    (day.cacheRead / 1e6) * (rate.cacheRead ?? 0) +
    (day.cacheWrite / 1e6) * (rate.cacheWrite ?? 0)
  );
};

const rows = [...perDay.entries()].sort(([a], [b]) => a.localeCompare(b));
const breaches = rows.flatMap(([date, day]) => {
  const over = [];
  if (day.totalTokens > config.daily.totalTokens) {
    over.push(`${date}: ${day.totalTokens.toLocaleString()} tokens is over the ${config.daily.totalTokens.toLocaleString()} ceiling`);
  }
  if (day.modelCalls > config.daily.modelCalls) {
    over.push(`${date}: ${day.modelCalls} model calls is over the ${config.daily.modelCalls} ceiling`);
  }
  return over;
});

/*
 PHASE 67's other two fields, read from the ledger rather than from the usage
 log. Tool calls are a count of steps; duration is a subtraction. Both were
 always available and I recorded them as absent once, which was reading one
 file and concluding about two.
*/
function tasks(sinceMs) {
  if (!existsSync(LEDGER)) return [];
  let text;
  try {
    text = readFileSync(LEDGER, "utf8");
  } catch {
    return [];
  }
  const out = [];
  for (const line of text.split("\n")) {
    if (!line.trim()) continue;
    let record;
    try {
      record = JSON.parse(line);
    } catch {
      // A half-written final line is the normal shape of a crash on an
      // append-only file, not a reason to report no tasks at all.
      continue;
    }
    const started = Date.parse(record.createdAt ?? "");
    if (!Number.isFinite(started) || started < sinceMs) continue;
    const ended = Date.parse(record.completedAt ?? record.createdAt ?? "");
    out.push({
      taskId: record.taskId,
      goal: record.goal ?? "",
      status: record.status ?? "unknown",
      toolCalls: Array.isArray(record.steps) ? record.steps.length : 0,
      // Attempts, not steps: a step that retried twice is three tool calls.
      attempts: Array.isArray(record.steps)
        ? record.steps.reduce((sum, step) => sum + (step.attempts ?? 1), 0)
        : 0,
      startedAt: started,
      seconds: Number.isFinite(ended) ? Math.max(0, Math.round((ended - started) / 1000)) : null,
    });
  }
  return out;
}

/*
 Tokens overlapping a run's window. An ESTIMATE, and wrong in a specific way:
 a call that happened while a task ran was not necessarily FOR that task, and
 two overlapping runs both claim the same calls. Shown because a run that
 overlapped two million tokens is worth looking at whoever spent them.
*/
function overlapTokens(task, calls) {
  if (task.seconds === null) return null;
  const from = task.startedAt;
  const to = from + task.seconds * 1000;
  let tokens = 0;
  let count = 0;
  for (const call of calls) {
    if (call.at >= from && call.at <= to) {
      tokens += call.tokens;
      count += 1;
    }
  }
  return { tokens, count };
}

if (wantsTasks) {
  const rows = tasks(since);
  const calls = callTimeline(since);
  console.log("");
  if (rows.length === 0) {
    console.log(`  no task runs in the last ${days} day(s).`);
    console.log("");
    process.exit(0);
  }
  console.log(`  ${rows.length} run(s) in the last ${days} day(s)`);
  console.log("");
  for (const task of rows.slice(-40)) {
    const overlap = overlapTokens(task, calls);
    const flags = [
      task.attempts > config.perTask.toolCalls ? `OVER ${config.perTask.toolCalls} calls` : "",
      task.seconds !== null && task.seconds > config.perTask.seconds
        ? `OVER ${config.perTask.seconds}s`
        : "",
    ].filter(Boolean).join(", ");
    console.log(
      `  ${task.taskId.padEnd(24)} ${String(task.attempts).padStart(3)} calls  ` +
        `${String(task.seconds ?? "?").padStart(5)}s  ${task.status.padEnd(14)}` +
        (overlap ? ` ~${overlap.tokens.toLocaleString()} tok overlapped` : "") +
        (flags ? `  [${flags}]` : ""),
    );
    console.log(`    ${task.goal.slice(0, 90)}`);
  }
  console.log("");
  console.log(`  per-task ceilings: ${config.perTask.toolCalls} tool calls, ${config.perTask.seconds}s`);
  console.log("  Overlapped tokens are an ESTIMATE by time window — the usage log carries no");
  console.log("  task id, so a call that happened during a run was not necessarily for it,");
  console.log("  and two overlapping runs both claim the same calls. A pointer, not an invoice.");
  console.log("");
  process.exit(0);
}

if (wantsJson) {
  console.log(JSON.stringify({
    windowDays: days,
    budgets: config,
    days: Object.fromEntries(rows.map(([d, v]) => [d, { ...v, estimatedCost: estimate(v) }])),
    models: Object.fromEntries(models),
    breaches,
    // Named rather than implied. A caller that reads `estimatedCost` must be
    // able to see that nothing measured it.
    costIsEstimated: true,
    ratesAreSet: Object.values(config.rates.perMillion ?? {}).some((v) => v > 0),
    unreadableLines: unparseable,
  }, null, 2));
  process.exit(breaches.length ? 1 : 0);
}

// Per-task ceilings join the daily ones, so `--check` in cron catches a single
// runaway run as well as a runaway day. A loop that burns its budget inside one
// task never shows up in a daily total until the day is over.
for (const task of tasks(since)) {
  if (task.attempts > config.perTask.toolCalls) {
    breaches.push(`${task.taskId}: ${task.attempts} tool calls is over the ${config.perTask.toolCalls} ceiling`);
  }
  if (task.seconds !== null && task.seconds > config.perTask.seconds) {
    breaches.push(`${task.taskId}: ${task.seconds}s is over the ${config.perTask.seconds}s ceiling`);
  }
}

if (checkOnly) {
  // Silence is the normal outcome, so this can go straight into cron without
  // becoming the car alarm orion-cron-deliver exists to prevent.
  for (const breach of breaches) console.log(`over budget — ${breach}`);
  process.exit(breaches.length ? 1 : 0);
}

const ratesSet = Object.values(config.rates.perMillion ?? {}).some((v) => v > 0);
console.log("");
console.log(`  last ${days} day(s), ${rows.length} with activity`);
console.log("");
for (const [date, day] of rows) {
  const cost = ratesSet ? `  ~$${estimate(day).toFixed(2)} (estimated)` : "";
  console.log(`  ${date}  ${String(day.modelCalls).padStart(4)} calls  ${day.totalTokens.toLocaleString().padStart(12)} tokens${cost}`);
}
console.log("");
console.log(`  ceilings: ${config.daily.totalTokens.toLocaleString()} tokens/day, ${config.daily.modelCalls} calls/day`);
if (breaches.length) {
  console.log("");
  for (const breach of breaches) console.log(`  OVER — ${breach}`);
} else {
  console.log("  nothing over budget.");
}
console.log("");
console.log("  models used:");
for (const [model, count] of [...models.entries()].sort((a, b) => b[1] - a[1])) {
  console.log(`    ${String(count).padStart(5)}  ${model}`);
}
if (!ratesSet) {
  console.log("");
  console.log("  Rate-table estimates unavailable: budgets.json rates are zero.");
  console.log("  Use orion-usage for recorded costs, current model rates and missing-price coverage.");
}
if (unparseable > 0) {
  console.log("");
  console.log(`  ${unparseable} line(s) could not be read. Reported rather than absorbed:`);
  console.log("  an undercount that looks like an underspend is the wrong way to be wrong.");
}
console.log("");
process.exit(0);
