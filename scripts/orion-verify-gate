#!/bin/zsh
#
# ORION — restart the gateway and prove the permission gate is actually in the
# path, using Nick's own test.
#
# Context: the "coding" tool profile was handing the model `exec`, `process`,
# `code_execution`, `write`, `edit` and `apply_patch`. It created a Desktop
# folder through `exec` and the audit ledger stayed empty — the gate was not
# bypassed so much as simply not used, because a shortcut existed.
#
# `group:runtime` and `group:fs` are now denied. This restarts the gateway so
# that takes effect, then checks two things that matter more than whether the
# task "worked":
#
#   1. the shell tools are actually gone
#   2. the work that DID happen left a ledger entry
#
# A pass here means the architecture is load-bearing again.
#
emulate -L zsh
set -u

repo="${0:A:h:h}"
cd "$repo"
mkdir -p data
out="$repo/data/gate-verify.log"
: > "$out"

bin="${ORION_OPENCLAW_BIN:-$HOME/.openclaw/bin/openclaw}"
ledger="$HOME/.openclaw/orion-controlled/task-ledger.jsonl"
[[ -f "$ledger" ]] || ledger="$(ls -t "$HOME/.openclaw/orion-controlled/"*.jsonl 2>/dev/null | head -1)"

say()   { print -- "$@" | tee -a "$out"; }
reply() {
  "$bin" agent --session-key orion-gate-verify --message "$1" --json --timeout 120 2>&1 \
  | python3 -c '
import json,sys,re
raw=re.sub(r"\x1b\[[0-9;]*[A-Za-z]","",sys.stdin.read())
try:
    d=json.loads(raw[raw.index("{"):]); r=d.get("result",d)
    print("\n".join(p.get("text","") for p in r.get("payloads",[])))
except Exception as e:
    print("unparseable:",e); print(raw[:600])
'
}

say "ORION gate verification — $(date)"

say ""
say "=== restarting the gateway so the tool policy applies ==="
"$bin" daemon restart >/dev/null 2>&1
for _ in {1..40}; do
  python3 -c "import socket,sys;s=socket.socket();s.settimeout(0.6);sys.exit(min(1,s.connect_ex(('127.0.0.1',18789))))" 2>/dev/null && break
  sleep 0.5
done
say "  gateway back up"
sleep 2

say ""
say "=== 1. are the shell tools gone? ==="
reply "List the exact names of every tool you can call directly. Just names, one per line." | tee -a "$out"

before=0
[[ -f "$ledger" ]] && before=$(wc -l < "$ledger" | tr -d ' ')
say ""
say "  ledger entries before the test: $before"

say ""
say "=== 2. Nick's test, verbatim ==="
reply "make a folder called awesome on my Desktop, and in that folder put a text file called orion.txt that says \"Orion is awesome\". Use orion_task_run — find it with tool_search if it is not in your direct tool list. If anything fails, quote the raw error verbatim." | tee -a "$out"

after=0
[[ -f "$ledger" ]] && after=$(wc -l < "$ledger" | tr -d ' ')
say ""
say "  ledger entries after the test:  $after"

say ""
say "=== 3. the verdict ==="
if [[ -d "$HOME/Desktop/awesome" ]]; then
  say "  folder exists:        yes"
  [[ -f "$HOME/Desktop/awesome/orion.txt" ]] \
    && say "  file exists:          yes — \"$(cat "$HOME/Desktop/awesome/orion.txt" 2>/dev/null)\"" \
    || say "  file exists:          NO"
else
  say "  folder exists:        NO"
fi

if (( after > before )); then
  say "  went through the gate: YES — $(( after - before )) new ledger entr(y/ies)"
  say ""
  say "  newest ledger entry:"
  tail -1 "$ledger" | python3 -c '
import json,sys
d=json.loads(sys.stdin.read())
for k in ("status","goal","taskId"):
    if k in d: print(f"    {k}: {d[k]}")
for s in (d.get("steps") or [])[:4]:
    print(f"    step {s.get(\"id\",\"?\")}: {s.get(\"action\",\"?\")} -> {s.get(\"status\",\"?\")}")
' 2>/dev/null | tee -a "$out"
else
  say "  went through the gate: NO — ledger did not grow"
  say "  If the folder exists anyway, something is still bypassing the gate."
  say "  That is the finding that matters, not whether the task succeeded."
fi

say ""
say "Done. Full log: $out"
