#!/usr/bin/env python3
"""orion-code — Orion writes his own code, offline, on the local model.

Nick is on a flight. The point of this file is that nothing here needs the
network: the model is Ollama on loopback, the tests are local, and git is local.
Turn off the wifi and it still works.

WHY WHOLE FILES AND NOT DIFFS

The obvious design is to ask the model for a unified diff and `git apply` it.
It was tried first and it fails constantly at this size: a 27B model produces
diffs with wrong line numbers, wrong context, and hunks that overlap. Every one
of those is a silent no-op or a mangled file. Asking for the COMPLETE file back
costs more tokens and has one failure mode instead of five — either the file
parses or it does not, and the check catches it either way.

WHAT BOUNDS IT

  * a git worktree, so the working tree Nick left behind is never touched;
  * `scripts/lib/orion-selfdev-policy.mjs`, which loads the INSTALLED plugin's
    forbidden-surface table -- the model cannot edit its own gate, and cannot
    widen what it may edit without a human deploying first;
  * a check command that must pass before anything is committed;
  * a hard iteration and wall-clock budget;
  * it NEVER pushes and NEVER installs. It commits to a branch in a worktree and
    stops. Landing the work is a human's decision on the ground.

USAGE

  orion-code run "<task>" --file <path> [--check "<cmd>"] [--iterations N]
  orion-code queue                     work through the queue file, in order
  orion-code status                    what the worktree holds
  orion-code add "<task>" --file <path>  append one task to the queue
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
CONTROLLED = Path.home() / ".openclaw/orion-controlled"
WORKTREE = CONTROLLED / "selfdev-worktree"
QUEUE = CONTROLLED / "selfdev-queue.json"
LOG = CONTROLLED / "selfdev-log.jsonl"
POLICY = REPO / "scripts/lib/orion-selfdev-policy.mjs"
OLLAMA = "http://127.0.0.1:11434/api/generate"

# Measured 2026-09-07 on this Mac, /api/generate, an identical TypeScript task:
#   qwen3.6:27b think=false  48-61s   correct
#   gpt-oss:20b              58s      correct, 3110 thinking tokens first
#   qwen3:30b                198s     correct, 14999 thinking tokens first
# All three are capable. The 27b is chosen because it is the only one that does
# not pay a thinking tax, and over a long run that is the whole difference: a
# hundred edits is 80 minutes at 48s and 5.5 hours at 198s. It also carries the
# same 262144-token context as the 30b, which is what a long project needs.
#: gpt-oss:20b, and the reason is throughput rather than cleverness.
#:
#: Measured from Ollama's own server log on this M5 Pro: gpt-oss:20b generates
#: at ~30 tokens/second, qwen3.6:27b at 5.2. Nearly six times, because MXFP4 is
#: natively accelerated on Apple silicon and Q4_K_M is not -- a hardware fact,
#: not a claim about which model is smarter. Over seven hours that is the
#: difference between roughly twenty tasks and roughly a hundred, and it means
#: this one can afford to THINK and still finish faster than the 27b not
#: thinking. Both wrote correct code for the same real task; the 27b's regex was
#: slightly more careful and it took 392s to the 20b's 106s.
MODEL = os.environ.get("ORION_CODER_MODEL", "gpt-oss:20b")
#: Reasoning on by default. `ORION_CODER_THINK=0` turns it off for a task that
#: is genuinely mechanical and where the wait is not worth it.
THINK = os.environ.get("ORION_CODER_THINK", "1") != "0"
#: Sampled once at start-up and passed into every prompt, so the model is never
#: told to "look it up" on a plane. Re-sampled per task by `flight`.
CONNECTED: bool | None = None
#: `npm test`, not `npx tsc --noEmit`.
#:
#: The first agentic cycle passed a typecheck by adding a well-documented,
#: correctly-typed function that nothing calls, and committed it as progress. A
#: typecheck cannot tell a change that works from a change that merely compiles,
#: so it is the wrong bar for an unattended loop: it rewards dead code.
DEFAULT_CHECK = "npm test"


def online() -> bool:
    """One TCP connect to a public resolver. Not a ping, not a DNS lookup.

    A plane's captive portal answers DNS and refuses everything else, so a
    lookup-based check reports online at 35,000 feet and then every model call
    fails one at a time. Connecting to 1.1.1.1:443 and getting a socket is the
    only answer that means what it says.
    """
    import socket
    try:
        with socket.create_connection(("1.1.1.1", 443), timeout=2.5):
            return True
    except OSError:
        return False


def say(message: str) -> None:
    print(message, flush=True)


def run(command: list[str] | str, cwd: Path, timeout: int = 900) -> tuple[int, str]:
    shell = isinstance(command, str)
    try:
        done = subprocess.run(
            command, cwd=cwd, shell=shell, capture_output=True, text=True, timeout=timeout
        )
    except subprocess.TimeoutExpired:
        return 124, f"timed out after {timeout}s"
    return done.returncode, (done.stdout + done.stderr)


def policy_allows(relative_path: str) -> tuple[bool, str]:
    code, out = run(["node", str(POLICY), "check", relative_path], cwd=REPO, timeout=60)
    return code == 0, out.strip()


def ensure_worktree() -> Path:
    """One long-lived worktree on its own branch. Nick's tree is never touched."""
    if (WORKTREE / ".git").exists():
        return WORKTREE
    WORKTREE.parent.mkdir(parents=True, exist_ok=True)
    branch = "orion-selfdev"
    code, out = run(["git", "worktree", "add", "-B", branch, str(WORKTREE), "HEAD"], cwd=REPO)
    if code != 0:
        say(f"could not create the worktree:\n{out}")
        sys.exit(1)
    link_dependencies()
    say(f"worktree at {WORKTREE} on branch {branch}")
    return WORKTREE


def link_dependencies() -> None:
    """A fresh worktree has no node_modules, so every check exits 127.

    The first real run of this file failed exactly that way: `npm test` returned
    127 -- command not found -- and the model was handed "command not found" as
    if it were a compiler error and asked to fix its code. It cannot; there was
    nothing wrong with the code. A check that cannot run must never be reported
    to the model as a check that failed.

    Symlinked rather than installed: `npm ci` here would take minutes on every
    fresh worktree and would need the network, which on a flight there is not.
    """
    for package in ("openclaw-plugins/orion-control",):
        source = REPO / package / "node_modules"
        target = WORKTREE / package / "node_modules"
        if source.exists() and not target.exists():
            target.parent.mkdir(parents=True, exist_ok=True)
            target.symlink_to(source)


def ask_model(prompt: str, timeout: int = 1800) -> tuple[str, float, dict]:
    body = {
        "model": MODEL,
        "prompt": prompt,
        "stream": False,
        # Thinking is ON, and the budget is large enough to afford it.
        #
        # It was off first, for a bad reason: with num_predict at 900 these
        # models spend the whole allowance reasoning and return an EMPTY
        # response, which reads as "the model failed" and is really "the budget
        # was too small". Raising the ceiling fixes it and thinking becomes what
        # it should be -- Nick's call, and the right one: this loop runs
        # unattended on tasks with many interacting parts, where being wrong
        # quietly costs far more than being slow.
        "think": THINK,
        "options": {
            "temperature": 0.2,
            "num_predict": 16000,
            # Ollama loads this model at 32768 by default, not the 262144 it
            # supports, and silently truncates the front of the prompt when a
            # long file plus a long thinking trace goes past it. On a long
            # project that means the model stops being able to see the top of
            # the file it is editing -- which is exactly where the imports and
            # the header comment explaining the rules live. Stated explicitly.
            "num_ctx": int(os.environ.get("ORION_CODER_CTX", "65536")),
        },
    }
    request = urllib.request.Request(
        OLLAMA, data=json.dumps(body).encode(), headers={"Content-Type": "application/json"}
    )
    started = time.time()
    with urllib.request.urlopen(request, timeout=timeout) as response:
        payload = json.load(response)
    # The thinking and the stop reason come back too. Without them a failure in
    # an unattended run reads only as "no code block", which is the symptom and
    # never the cause -- the causes are different and need different fixes:
    # the budget was spent thinking, the model answered in prose, or it stopped
    # early. `num_predict` covers thinking AND response together.
    return (
        payload.get("response", "") or "",
        time.time() - started,
        {
            "thinking": len(payload.get("thinking") or ""),
            "done_reason": payload.get("done_reason"),
            "eval_count": payload.get("eval_count"),
        },
    )


CODE_BLOCK = re.compile(r"```(?:[a-zA-Z0-9+.-]*)\n(.*?)```", re.S)


#: Shapes that mean "this is source, not prose about source".
LOOKS_LIKE_SOURCE = re.compile(
    r"^\s*(?:import |export |const |function |class |/\*|//|#!|from |def |@)", re.M
)


def extract_file(reply: str) -> str | None:
    """The complete file: from the first fenced block, or from a bare answer.

    Fences are what the prompt asks for and what usually comes back. But a model
    that has just spent four thousand tokens thinking sometimes answers with the
    file and no fence at all, and throwing that away costs a whole attempt --
    minutes, on a run measured in hours. So an unfenced reply is accepted when it
    plainly IS source: it starts with an import, an export, a comment or a
    declaration. Prose about the code does not match, which is the point.
    """
    match = CODE_BLOCK.search(reply)
    if match and match.group(1).strip():
        return match.group(1)
    stripped = reply.strip()
    if stripped and LOOKS_LIKE_SOURCE.match(stripped) and len(stripped) > 200:
        return stripped + "\n"
    return None


def build_prompt(task: str, relative_path: str, current: str, failure: str | None,
                 connected: bool | None = None) -> str:
    where = (
        "You are running on Nick's Mac. There is NO network: you cannot fetch a page, "
        "check a package version, or look anything up. Work only from what is in front "
        "of you, and if a task genuinely needs the internet, say so in a comment and do "
        "the part that does not."
        if connected is False
        else "You are running on Nick's Mac with a working network."
    )
    parts = [
        "You are editing one file in a TypeScript/Python repository.",
        where,
        f"TASK: {task}",
        f"FILE: {relative_path}",
        "",
        "Return the COMPLETE new contents of that file in a single fenced code block.",
        "Do not return a diff. Do not abbreviate with ellipses or comments like",
        "'rest unchanged' — anything you leave out will be deleted. No prose outside",
        "the block.",
        "",
        "CURRENT CONTENTS:",
        "```",
        current,
        "```",
    ]
    if failure:
        parts += [
            "",
            "Your previous attempt did not pass. Fix exactly this and change nothing else:",
            "```",
            failure[-3000:],
            "```",
        ]
    return "\n".join(parts)


def candidate_files(task: str, limit: int = 40) -> list[str]:
    """Files this task might mean, ranked, without asking a model anything.

    Cheap first: the words in the task are searched across the repository with
    ripgrep, and the files with the most distinct hits win. It is crude and it
    is nearly always right, because a task about exec routing says "exec" and
    "routing" and there is exactly one file full of both.
    """
    words = [w for w in re.findall(r"[A-Za-z_][A-Za-z0-9_]{3,}", task) if w.lower() not in STOPWORDS]
    if not words:
        return []
    scores: dict[str, int] = {}
    for word in words[:12]:
        # ripgrep if it is here, plain grep if it is not. `rg` is not installed
        # on this Mac and a search tool that only works on some machines is a
        # search tool that fails on the one that matters.
        if RIPGREP:
            command = ["rg", "--files-with-matches", "--no-messages", "-i",
                       "--glob", "!node_modules", "--glob", "!.build", "--glob", "!dist",
                       "--glob", "*.ts", "--glob", "*.py", "--glob", "*.swift",
                       "--glob", "*.mjs", word, "."]
        else:
            command = ["grep", "-rIl", "-i", "--exclude-dir=node_modules",
                       "--exclude-dir=.build", "--exclude-dir=dist", "--exclude-dir=.git",
                       # `builds/` holds dated copies of previous releases. Without
                       # this the search happily proposes editing a file inside
                       # builds/backup-20260814-001531/, which is a museum piece.
                       "--exclude-dir=builds", "--exclude-dir=archive",
                       "--include=*.ts", "--include=*.py", "--include=*.swift",
                       "--include=*.mjs", word, "."]
        code, out = run(command, cwd=REPO, timeout=90)
        if code not in (0, 1):
            continue
        for line in out.splitlines():
            path = line.strip().lstrip("./")
            if path and not path.endswith(".test.ts"):
                scores[path] = scores.get(path, 0) + 1
    # The FILENAME is the strongest signal there is and content alone ignores it.
    # A task about "exec routing" belongs in `exec-routing.ts`, and without this
    # a large file that happens to mention every word -- index.ts, AppState.swift
    # -- outranks the one actually named after the subject.
    lowered = [w.lower() for w in words]
    for path in list(scores):
        stem = Path(path).stem.lower().replace("-", " ").replace("_", " ")
        scores[path] += 3 * sum(1 for w in lowered if w in stem)
    # A path nobody would edit should not win on word count either.
    for path in list(scores):
        marked = f"/{path}"
        # `claude/worktrees/*` are other agents' checkouts of this same repo.
        # Editing one is editing a copy nobody reads, and the edit looks like it
        # worked right up until the moment someone looks for it.
        if any(bad in marked for bad in ("/builds/", "/archive/", "/worktrees/", "/selfdev-worktree/")):
            del scores[path]
    ranked = sorted(scores.items(), key=lambda kv: (-kv[1], len(kv[0])))
    return [path for path, _ in ranked[:limit]]


RIPGREP = shutil.which("rg") is not None

STOPWORDS = {
    "that", "this", "with", "from", "into", "make", "made", "them", "then", "than",
    "when", "what", "which", "should", "would", "could", "there", "their", "have",
    "keep", "kept", "each", "every", "also", "just", "like", "only", "same", "some",
    "more", "most", "other", "return", "returns", "function", "file", "code", "add",
    "adds", "added", "using", "used", "does", "done", "were", "been", "being",
}


def choose_file(task: str) -> str | None:
    """Ask the local model to pick one file from the shortlist.

    The shortlist is built by ripgrep first rather than handing the model a
    directory listing: a model asked to choose from 900 paths picks a plausible
    one, and a plausible wrong file is the most expensive answer available --
    it edits something real that nobody asked about.
    """
    candidates = candidate_files(task)
    if not candidates:
        return None
    if len(candidates) == 1:
        return candidates[0]
    listing = "\n".join(f"{i + 1}. {p}" for i, p in enumerate(candidates))
    prompt = (
        "Pick the ONE file that this task should edit.\n\n"
        f"TASK: {task}\n\nCANDIDATES:\n{listing}\n\n"
        "Answer with the number alone. Nothing else."
    )
    try:
        reply, _, _ = ask_model(prompt, timeout=600)
    except Exception:
        return candidates[0]
    match = re.search(r"\b(\d{1,2})\b", reply)
    if not match:
        return candidates[0]
    index = int(match.group(1)) - 1
    return candidates[index] if 0 <= index < len(candidates) else candidates[0]


def orphan_exports(tree: Path, relative_path: str, before: str, after: str) -> list[str]:
    """Exported names the edit ADDED that nothing anywhere else refers to.

    This exists because of what the first autonomous cycle actually did. Asked to
    stop typed actions reaching the shell, it added
    `export function isTypedActionOrSubcommand(...)`, wrote a correct doc comment
    for it, and called it from nowhere. It compiled, so the check passed, so it
    was committed as progress. It was not progress; it was a function.

    A model optimising for "make the check green" will find the cheapest way, and
    adding unreferenced code is the cheapest way there is. So the check is no
    longer only "does it build" but "is the thing you added actually reached".
    """
    names = re.compile(r"^export\s+(?:async\s+)?(?:function|const|class)\s+([A-Za-z_]\w*)", re.M)
    added = set(names.findall(after)) - set(names.findall(before))
    if not added:
        return []
    orphans = []
    for name in sorted(added):
        code, out = run(
            ["grep", "-rIl", "--exclude-dir=node_modules", "--exclude-dir=.build",
             "--exclude-dir=dist", "--exclude-dir=.git", "--include=*.ts", name, "."],
            cwd=tree, timeout=90,
        )
        referencing = {
            line.strip().lstrip("./") for line in out.splitlines() if line.strip()
        } - {relative_path}
        if not referencing:
            orphans.append(name)
    return orphans


def log(record: dict) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    record["at"] = time.strftime("%Y-%m-%dT%H:%M:%S")
    with LOG.open("a") as handle:
        handle.write(json.dumps(record) + "\n")


def do_task(task: str, relative_path: str | None, check: str, iterations: int, budget_s: int) -> bool:
    if not relative_path:
        say("  no file given — choosing one")
        relative_path = choose_file(task)
        if not relative_path:
            say("  could not work out which file this task means")
            log({"task": task, "file": None, "outcome": "no_file"})
            return False
        say(f"  chose {relative_path}")
    allowed, message = policy_allows(relative_path)
    if not allowed:
        say(f"REFUSED  {message}")
        log({"task": task, "file": relative_path, "outcome": "refused", "why": message})
        return False

    tree = ensure_worktree()
    target = tree / relative_path
    if not target.exists():
        say(f"no such file in the worktree: {relative_path}")
        return False

    original = target.read_text()
    check_cwd = tree / "openclaw-plugins/orion-control" if relative_path.startswith(
        "openclaw-plugins/orion-control"
    ) else tree

    failure: str | None = None
    started = time.time()
    for attempt in range(1, iterations + 1):
        if time.time() - started > budget_s:
            say(f"budget of {budget_s}s spent; stopping")
            break
        say(f"  attempt {attempt}/{iterations} — asking {MODEL}…")
        try:
            reply, elapsed, meta = ask_model(
                build_prompt(task, relative_path, target.read_text(), failure, CONNECTED)
            )
        except Exception as error:  # noqa: BLE001 — offline is a normal state here
            say(f"  the local model did not answer: {error}")
            break
        body = extract_file(reply)
        if body is None:
            failure = (
                "You returned no usable file. Return the COMPLETE file contents in one "
                "fenced code block, and put your reasoning before it, not inside it."
            )
            say(f"  nothing usable after {elapsed:.0f}s — reply {len(reply)} chars, "
                f"thinking {meta['thinking']} chars, stopped because "
                f"{meta['done_reason']!r}")
            log({"task": task, "file": relative_path, "outcome": "no_usable_reply",
                 "reply_chars": len(reply), **meta})
            continue
        target.write_text(body)
        say(f"  wrote {len(body)} chars after {elapsed:.0f}s; running: {check}")
        code, out = run(check, cwd=check_cwd)
        if code == 127 or "command not found" in out or "ENOENT" in out:
            # The environment is broken, not the code. Handing this back as if
            # it were a compiler error asks the model to fix something it did
            # not break, and it will happily rewrite the file trying.
            say(f"  the check could not RUN (exit {code}) — this is the harness, not the code")
            target.write_text(original)
            log({"task": task, "file": relative_path, "outcome": "check_unrunnable", "detail": out[:400]})
            return False
        if code == 0:
            orphans = orphan_exports(tree, relative_path, original, body)
            if orphans:
                failure = (
                    f"The check passed, but you added {', '.join(orphans)} and nothing "
                    "anywhere calls it. Adding unreferenced code is not doing the task. "
                    "Either wire it into the code path it belongs in, or change the "
                    "existing function instead of adding a new one beside it."
                )
                say(f"  passed the check but added dead code: {', '.join(orphans)}")
                continue
            run(["git", "add", relative_path], cwd=tree)
            run(
                ["git", "commit", "-q", "-m",
                 f"selfdev: {task}\n\nWritten by {MODEL} offline, {attempt} attempt(s).\n"
                 f"Check that had to pass: {check}\n"],
                cwd=tree,
            )
            say(f"  PASSED and checkpointed after {attempt} attempt(s)")
            log({"task": task, "file": relative_path, "outcome": "passed", "attempts": attempt})
            return True
        failure = out
        say(f"  check failed ({code}); feeding the error back")

    target.write_text(original)
    say("  gave up; the file is back as it was")
    log({"task": task, "file": relative_path, "outcome": "failed", "attempts": iterations})
    return False


REPORT = CONTROLLED / "selfdev-report.md"
ATTEMPTS = CONTROLLED / "selfdev-attempts.json"


# ---------------------------------------------------------------------------
# "What's next?" -- asked of the repository, not of a list someone typed.
#
# A queue runs out. This does not: it surveys the places this project already
# records unfinished work, and the loop only stops when every one of them comes
# back empty. On 2026-09-07 that was 44 unmet phase requirements, a 567-line
# NICK-TODO, and 8 findings from orion-learn -- so "nothing left" is a real
# verdict rather than a queue that happened to end.
# ---------------------------------------------------------------------------

def survey_backlog() -> list[dict]:
    """Everything this repository currently says is unfinished, with provenance."""
    items: list[dict] = []

    # 1. Phase requirements. The richest source and the most specific: each one
    #    is a named id somebody wrote down as the condition for a phase closing.
    try:
        gates = json.loads((REPO / "planning/v2/PHASE_GATES.json").read_text())
        for number, phase in gates.get("phases", {}).items():
            for requirement in phase.get("requirements", []):
                if requirement.get("status") != "passed":
                    items.append({
                        "id": f"phase:{number}:{requirement['id']}",
                        "source": f"phase {number} ({phase.get('name')})",
                        "title": requirement["id"].replace("_", " "),
                        "weight": 3,
                    })
    except Exception:
        pass

    # 2. What Orion's own session history says he keeps getting wrong.
    code, out = run([str(REPO / "scripts/orion-learn")], cwd=REPO, timeout=300)
    if code == 0:
        for line in out.splitlines():
            match = re.match(r"\s+(P\d+)\s+\[\s*(\w+)\s*\]\s+(.+)", line)
            if match:
                items.append({
                    "id": f"learn:{match.group(1)}",
                    "source": f"orion-learn {match.group(1)} ({match.group(2)})",
                    "title": match.group(3).strip(),
                    "weight": 4 if match.group(2) == "high" else 2,
                })

    # 3. Markers left in the source by whoever was there last.
    marker = ["grep", "-rIn", "--exclude-dir=node_modules", "--exclude-dir=.build",
              "--exclude-dir=dist", "--exclude-dir=builds", "--exclude-dir=.git",
              "--exclude-dir=archive", "--include=*.ts", "--include=*.py",
              "--include=*.swift", "-E", r"\b(TODO|FIXME|XXX)\b", "."]
    code, out = run(marker, cwd=REPO, timeout=120)
    if code == 0:
        for line in out.splitlines()[:40]:
            path, _, rest = line.partition(":")
            items.append({
                "id": f"marker:{line[:90]}",
                "source": f"a marker in {path.lstrip('./')}",
                "title": rest.split(":", 1)[-1].strip()[:120],
                "file": path.lstrip("./"),
                "weight": 1,
            })
    return items


def attempt_history() -> dict:
    try:
        return json.loads(ATTEMPTS.read_text())
    except Exception:
        return {}


def record_attempt(item_id: str, outcome: str) -> None:
    history = attempt_history()
    entry = history.get(item_id, {"tries": 0})
    entry["tries"] = entry.get("tries", 0) + 1
    entry["last"] = outcome
    history[item_id] = entry
    ATTEMPTS.parent.mkdir(parents=True, exist_ok=True)
    ATTEMPTS.write_text(json.dumps(history, indent=2))


def choose_next(items: list[dict]) -> dict | None:
    """Pick the next piece of work, and turn it into something concrete.

    Two attempts per item, then it is left alone. An agent that keeps returning
    to the thing it cannot do is the retry loop that cost this project 11.8M
    tokens, wearing a longer time horizon.
    """
    history = attempt_history()
    fresh = [i for i in items if history.get(i["id"], {}).get("tries", 0) < 2]
    if not fresh:
        return None
    fresh.sort(key=lambda i: -i["weight"])
    shortlist = fresh[:12]
    listing = "\n".join(
        f"{n + 1}. [{i['source']}] {i['title']}" for n, i in enumerate(shortlist)
    )
    prompt = (
        "You are choosing the next piece of work on a codebase, on your own, with "
        "nobody to ask.\n\nUnfinished work this repository currently records:\n"
        f"{listing}\n\n"
        "Pick the ONE that a single-file code change could genuinely advance. Prefer "
        "something concrete over something that needs a person, a device, or a "
        "decision. Answer in exactly two lines:\n"
        "NUMBER: <the number>\n"
        "TASK: <one sentence saying what to change, specific enough to act on>"
    )
    try:
        reply, _, _ = ask_model(prompt, timeout=1200)
    except Exception as error:
        say(f"  could not choose: {error}")
        return None
    number = re.search(r"NUMBER:\s*(\d{1,2})", reply)
    task = re.search(r"TASK:\s*(.+)", reply)
    if not number or not task:
        return None
    index = int(number.group(1)) - 1
    if not (0 <= index < len(shortlist)):
        return None
    chosen = dict(shortlist[index])
    chosen["task"] = task.group(1).strip()
    return chosen


def agentic_loop(hours: float, iterations: int) -> int:
    """Work until the repository stops having anything to say.

    The stopping condition is the point of this: not an empty queue, but a
    survey that comes back with nothing unattempted. Everything else is a
    consequence of that -- the attempt ledger exists so "unattempted" is a real
    filter, and the survey is re-run every cycle because finishing one thing
    changes what the others are.
    """
    global CONNECTED
    deadline = time.time() + hours * 3600
    tree = ensure_worktree()
    before = run(["git", "rev-parse", "HEAD"], cwd=tree)[1].strip()
    say(f"loop: up to {hours:.1f}h, model {MODEL}, thinking {'on' if THINK else 'off'}")
    results: list[dict] = []

    while time.time() < deadline:
        CONNECTED = online()
        items = survey_backlog()
        chosen = choose_next(items)
        if chosen is None:
            say("nothing left that has not been tried twice — stopping because there is "
                "genuinely nothing, not because a list ended")
            break
        remaining = deadline - time.time()
        say(f"[{len(results) + 1}] ({'online' if CONNECTED else 'OFFLINE'}, "
            f"{remaining / 3600:.1f}h left) {chosen['source']}")
        say(f"    {chosen['task'][:110]}")
        started = time.time()
        try:
            passed = do_task(chosen["task"], chosen.get("file"), DEFAULT_CHECK,
                             iterations, int(min(5400, max(remaining - 60, 120))))
            outcome = "passed" if passed else "failed"
            detail = ""
        except Exception as error:  # noqa: BLE001 — nothing may end the loop
            outcome, detail = "crashed", f"{type(error).__name__}: {error}"
            say(f"  crashed, continuing: {detail}")
        record_attempt(chosen["id"], outcome)
        results.append({
            "task": chosen["task"], "file": chosen.get("file") or "(chosen)",
            "outcome": outcome, "minutes": round((time.time() - started) / 60, 1),
            "online": CONNECTED, "detail": detail, "source": chosen["source"],
        })
        write_report(results, before, tree, deadline)

    write_report(results, before, tree, deadline)
    say(f"loop over. report: {REPORT}")
    return 0


def flight(hours: float, iterations: int) -> int:
    """Work the queue for `hours`, survive everything, and leave a report.

    Nothing in here may raise. A seven-hour unattended run that dies in hour one
    on a single bad task is worth less than one that logs the failure and keeps
    going, and Nick cannot intervene at 35,000 feet. So every task is wrapped,
    and the report is rewritten after EVERY task rather than at the end -- if the
    machine sleeps or the battery goes, what happened up to that point survives.
    """
    global CONNECTED
    deadline = time.time() + hours * 3600
    tree = ensure_worktree()
    before = run(["git", "rev-parse", "HEAD"], cwd=tree)[1].strip()
    items = json.loads(QUEUE.read_text()) if QUEUE.exists() else []
    if not items:
        say("nothing queued — add tasks with: orion-code add \"<task>\" --file <path>")
        return 1

    say(f"flight: {len(items)} task(s), {hours:.1f}h, model {MODEL}, thinking {'on' if THINK else 'off'}")
    results: list[dict] = []
    index = 0
    while time.time() < deadline and index < len(items):
        item = items[index]
        index += 1
        CONNECTED = online()
        remaining = deadline - time.time()
        say(f"[{index}/{len(items)}] ({'online' if CONNECTED else 'OFFLINE'}, "
            f"{remaining/3600:.1f}h left) {item['task'][:80]}")
        started = time.time()
        try:
            passed = do_task(
                item["task"], item["file"], item.get("check", DEFAULT_CHECK),
                item.get("iterations", iterations),
                int(min(item.get("budget", 5400), max(remaining - 60, 120))),
            )
            outcome = "passed" if passed else "failed"
            detail = ""
        except Exception as error:  # noqa: BLE001 — nothing may end the flight
            outcome, detail = "crashed", f"{type(error).__name__}: {error}"
            say(f"  task crashed, continuing: {detail}")
        results.append({
            "task": item["task"], "file": item["file"], "outcome": outcome,
            "minutes": round((time.time() - started) / 60, 1),
            "online": CONNECTED, "detail": detail,
        })
        write_report(results, before, tree, deadline)

    write_report(results, before, tree, deadline)
    say(f"flight over. report: {REPORT}")
    return 0


def write_report(results: list[dict], before: str, tree: Path, deadline: float) -> None:
    passed = [r for r in results if r["outcome"] == "passed"]
    commits = run(["git", "log", "--oneline", f"{before}..HEAD"], cwd=tree)[1].strip()
    lines = [
        "# Orion self-development — flight report",
        "",
        f"Model **{MODEL}**, thinking **{'on' if THINK else 'off'}**. "
        f"{len(passed)} of {len(results)} attempted task(s) passed their check and were "
        f"committed to the `orion-selfdev` branch in `{tree}`.",
        "",
        "**Nothing here is installed and nothing is pushed.** Every change is a commit on a "
        "branch in a worktree; landing it is a decision for the ground.",
        "",
        "| # | task | file | outcome | minutes | network |",
        "| - | ---- | ---- | ------- | ------: | ------- |",
    ]
    for i, r in enumerate(results, 1):
        mark = {"passed": "passed", "failed": "did not pass", "crashed": "crashed"}[r["outcome"]]
        lines.append(
            f"| {i} | {r['task'][:70]} | `{r['file']}` | {mark} | {r['minutes']} | "
            f"{'online' if r['online'] else 'offline'} |"
        )
    failures = [r for r in results if r["outcome"] != "passed"]
    if failures:
        lines += ["", "## What did not work, and what it looked like", ""]
        for r in failures:
            lines.append(f"- **{r['task'][:90]}** (`{r['file']}`) — {r['outcome']}"
                         + (f": {r['detail'][:200]}" if r["detail"] else
                            ": the check never went green inside its attempts"))
    lines += ["", "## Commits on the branch", "", "```", commits or "(none)", "```", ""]
    REPORT.parent.mkdir(parents=True, exist_ok=True)
    REPORT.write_text("\n".join(lines))


def main() -> int:
    parser = argparse.ArgumentParser(prog="orion-code")
    sub = parser.add_subparsers(dest="command", required=True)

    for name in ("run", "add"):
        p = sub.add_parser(name)
        p.add_argument("task")
        p.add_argument("--file", default=None)
        p.add_argument("--check", default=DEFAULT_CHECK)
        p.add_argument("--iterations", type=int, default=4)
        p.add_argument("--budget", type=int, default=7200)

    sub.add_parser("queue")
    sub.add_parser("status")
    f = sub.add_parser("flight")
    f.add_argument("--hours", type=float, default=7.0)
    f.add_argument("--iterations", type=int, default=3)
    lp = sub.add_parser("loop")
    lp.add_argument("--hours", type=float, default=7.0)
    lp.add_argument("--iterations", type=int, default=3)
    args = parser.parse_args()

    if args.command == "add":
        QUEUE.parent.mkdir(parents=True, exist_ok=True)
        items = json.loads(QUEUE.read_text()) if QUEUE.exists() else []
        # `file` may be null. It is resolved when the task RUNS, not when it is
        # queued: on a plane the repository will have moved on by the time a
        # task near the end of the queue comes up, and a path chosen hours
        # earlier can easily be the wrong one by then.
        items.append({"task": args.task, "file": args.file, "check": args.check,
                      "iterations": args.iterations, "budget": args.budget})
        QUEUE.write_text(json.dumps(items, indent=2))
        say(f"queued ({len(items)} waiting)")
        return 0

    if args.command == "run":
        return 0 if do_task(args.task, args.file, args.check, args.iterations, args.budget) else 1

    if args.command == "queue":
        if not QUEUE.exists():
            say("nothing queued")
            return 0
        items = json.loads(QUEUE.read_text())
        done, failed = 0, 0
        for index, item in enumerate(items, 1):
            say(f"[{index}/{len(items)}] {item['task']}")
            if do_task(item["task"], item["file"], item.get("check", DEFAULT_CHECK),
                       item.get("iterations", 4), item.get("budget", 1800)):
                done += 1
            else:
                failed += 1
        say(f"queue finished: {done} passed, {failed} failed")
        # The queue is kept, not consumed: what failed is the interesting part
        # and Nick should see it on landing rather than find an empty file.
        return 0 if failed == 0 else 1

    if args.command == "flight":
        return flight(args.hours, args.iterations)

    if args.command == "loop":
        return agentic_loop(args.hours, args.iterations)

    if args.command == "status":
        if not (WORKTREE / ".git").exists():
            say("no worktree yet")
            return 0
        code, out = run(["git", "log", "--oneline", "-15"], cwd=WORKTREE)
        say(f"worktree {WORKTREE}\n{out}")
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
