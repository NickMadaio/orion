#!/bin/zsh
#
# ORION — diagnose the whole stack in one command.
#
# Written after a failure that took log archaeology to find: the TTS daemon was
# running and answering, but under a Python without `mlx_audio`, so it had
# quietly degraded to reloading the model on every chunk. Everything "worked".
# It was just slow, for a reason nothing surfaced.
#
# The rule here: report what is ACTUALLY true at runtime, not what is
# configured. Configuration lies; a live probe does not.
#
emulate -L zsh
set -u
setopt pipefail

live_agent=0
for arg in "$@"; do
  case "$arg" in
    --live-agent) live_agent=1 ;;
    -h|--help)
      print "usage: ${0:t} [--live-agent]"
      print "       --live-agent also runs one paid end-to-end model turn"
      exit 0
      ;;
    *)
      print -u2 "unknown option: $arg"
      print -u2 "usage: ${0:t} [--live-agent]"
      exit 2
      ;;
  esac
done

repo="${0:A:h:h}"
socket="${ORION_TTS_SOCKET:-$HOME/.openclaw/orion-tts.sock}"
config="$HOME/.openclaw/openclaw.json"
openclaw_bin="${ORION_OPENCLAW_BIN:-$HOME/.openclaw/bin/openclaw}"
env_file="${ORION_ENV_FILE:-$repo/.env}"
app_domain="com.nickmadaio.orion.app"
app_paths=(/Applications/Orion.app "$repo/native/Orion/.build/Orion.app")

fail=0
py="$("$repo/scripts/orion-python" 2>/dev/null)"
[[ -z "$py" ]] && py="${commands[python3]:-/usr/bin/python3}"

ok()   { print "  \033[32mok\033[0m    $1" }
warn() { print "  \033[33mwarn\033[0m  $1"; }
# Neutral. For things that are off but were never meant to be on -- an unset
# optional key is not a problem, and colouring it yellow trains the eye to
# ignore the yellow that matters.
note() { print "  ----  $1"; }
bad()  { print "  \033[31mFAIL\033[0m  $1"; fail=1; }

print ""
print "ORION doctor"
print ""

# --- python / MLX ---------------------------------------------------------
print "voice engine"
if [[ -x "$py" ]]; then
  ver="$("$py" -c 'import sys;print("%d.%d.%d"%sys.version_info[:3])' 2>/dev/null)"
  if "$py" -c 'import mlx_audio' >/dev/null 2>&1; then
    ok "python $ver at $py can import mlx_audio"
    ok "engine will be mlx-warm (model loaded once, stays resident)"
  else
    bad "python $ver at $py CANNOT import mlx_audio"
    print "        The daemon still runs, but degrades to the mlx-cli engine,"
    print "        which reloads the 250M model on every chunk. That is the"
    print "        exact cold-start cost the warm daemon exists to remove."
    print "        Fix:  $py -m pip install mlx-audio"
    print "        Or point ORION_TTS_PYTHON at the interpreter that has it."
    print "        Diagnose: ./scripts/orion-python --why"
  fi
else
  bad "no usable python3 found"
fi

# --- TTS daemon -----------------------------------------------------------
print ""
print "tts daemon"
if [[ -S "$socket" ]]; then
  reply="$("$py" - "$socket" <<'PY' 2>/dev/null
import json, socket, sys
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(3)
    s.connect(sys.argv[1])
    s.sendall(b'{"op":"status"}\n')
    print(s.makefile("r").readline().strip())
except Exception as exc:
    print(json.dumps({"error": str(exc)}))
PY
)"
  if [[ -n "$reply" ]]; then
    engine="$(print -r -- "$reply" | "$py" -c 'import json,sys;print(json.load(sys.stdin).get("engine","?"))' 2>/dev/null)"
    # The engine that ACTUALLY served last, which is the only one worth
    # trusting. It differs from `engine` exactly when something degraded.
    active="$(print -r -- "$reply" | "$py" -c 'import json,sys;print(json.load(sys.stdin).get("active_engine","") or "")' 2>/dev/null)"
    case "$engine" in
      mlx-warm) ok "responding, engine=mlx-warm" ;;
      elevenlabs) ok "responding, engine=elevenlabs (cloud voice)" ;;
      mlx-cli|mlx-generate-fn)
        bad "responding, but engine=$engine — reloads the model per chunk"
        print "        This is the slow path. See 'voice engine' above." ;;
      say) warn "responding, but engine=say — MLX unavailable, quality degraded" ;;
      *)   warn "responding, engine=$engine" ;;
    esac
    if [[ -n "$active" && "$active" != "$engine" ]]; then
      warn "but the last reply was actually spoken by: $active"
      print "        The configured voice fell back. The reason is in the log:"
      print "        tail -50 ~/.openclaw/logs/orion-tts.log"
    fi
  else
    bad "STALE SOCKET — the file is there but nothing is listening"
    print "        A daemon died without cleaning up. Every check that only"
    print "        looks for the file will tell you voice is fine while it is"
    print "        silently falling back to system speech."
    print "        Fix:  rm -f '$socket' && ./scripts/orion-setup"
  fi
else
  warn "not running (no socket at $socket)"
  print "        Start it:  ./scripts/orion-interface"
  print "        Or load:   launchctl load -w ~/Library/LaunchAgents/com.nickmadaio.orion.tts.plist"
fi

# --- voice providers ------------------------------------------------------
#
# Presence only, never the value. A key must never be printed, logged or shown
# by anything in this repo -- least of all by the tool you run when something
# is already going wrong.
print ""
print "voice providers"

# Where a credential actually lives. Order must match every consumer's own
# lookup -- environment, then Keychain, then .env -- or this reports a key
# "missing" that the app and the TTS daemon are reading happily. A diagnostic
# that is wrong about a working system is worse than no diagnostic.
keychain_item_for() {
  case "$1" in
    ELEVENLABS_API_KEY) print "ORION ElevenLabs" ;;
    DEEPGRAM_API_KEY)   print "ORION Deepgram" ;;
    *) return 1 ;;
  esac
}

key_source() {
  local name="$1"
  if [[ -n "$(printenv "$name" 2>/dev/null)" ]]; then
    print "environment"
    return 0
  fi
  local item
  if item="$(keychain_item_for "$name")"; then
    # Presence only, never the value: -w would print the secret.
    if /usr/bin/security find-generic-password -a openclaw -s "$item" \
         >/dev/null 2>&1; then
      print "login Keychain: $item"
      return 0
    fi
  fi
  [[ -f "$env_file" ]] || return 1
  local found
  found="$("$py" - "$env_file" "$name" <<'DOCTOR_PY' 2>/dev/null
import sys
name = sys.argv[2]
try:
    for line in open(sys.argv[1], encoding="utf-8"):
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        if key.strip() == name and value.strip().strip('"').strip("'"):
            print("yes")
            break
except OSError:
    pass
DOCTOR_PY
)"
  [[ "$found" == "yes" ]] || return 1
  print "$env_file"
}

if [[ -n "${reply:-}" ]]; then
  providers="$(print -r -- "$reply" | "$py" -c 'import json,sys
d = json.load(sys.stdin).get("providers", {})
print(d.get("tts_configured", "?"))
print(d.get("tts_default", "?"))
print(d.get("tts_active", "?"))
print("yes" if d.get("elevenlabs_available") else "no")' 2>/dev/null)"
  if [[ -n "$providers" ]]; then
    tts_pref="$(print -r -- "$providers" | sed -n 1p)"
    tts_default="$(print -r -- "$providers" | sed -n 2p)"
    tts_active="$(print -r -- "$providers" | sed -n 3p)"
    cloud_built="$(print -r -- "$providers" | sed -n 4p)"
    ok "tts: configured=$tts_pref  resolved=$tts_default  serving=$tts_active"
    if [[ "$tts_default" == "elevenlabs" && "$tts_active" != "elevenlabs" ]]; then
      warn "ElevenLabs is selected but $tts_active is serving — it fell back"
      print "        Why: tail -50 ~/.openclaw/logs/orion-tts.log"
    fi
    if [[ "$tts_default" == "local" && "$cloud_built" == "yes" ]]; then
      print "        An ElevenLabs key is present but not selected."
      print "        Turn it on in Orion ▸ Preferences ▸ Voice, or set"
      print "        ORION_TTS_CLOUD_VOICE=1 in the LaunchAgent plist."
    fi
  fi
else
  warn "tts provider unknown — the daemon did not answer a status probe"
fi

if src="$(key_source ELEVENLABS_API_KEY)"; then
  ok "ELEVENLABS_API_KEY present (from $src)"
else
  note "ELEVENLABS_API_KEY not set — the local MLX voice is the only voice"
  print "        Put it in $env_file, which is gitignored. Never in openclaw.json."
fi

# The STT choice lives in the app's own defaults: the app is what opens the
# microphone, so the app is what owns that preference.
stt_pref="$(defaults read "$app_domain" OrionSTTProvider 2>/dev/null)"
[[ -z "$stt_pref" ]] && stt_pref="apple (default)"
ok "stt: configured=$stt_pref"
if src="$(key_source DEEPGRAM_API_KEY)"; then
  ok "DEEPGRAM_API_KEY present (from $src)"
  if [[ "$stt_pref" != "deepgram" ]]; then
    print "        Present but not selected — Orion ▸ Preferences ▸ Voice ▸ Listening."
  fi
else
  if [[ "$stt_pref" == "deepgram" ]]; then
    bad "Deepgram is selected but has no key — every utterance falls back to Apple"
    print "        Put DEEPGRAM_API_KEY in $env_file, or switch back to Apple."
  else
    note "DEEPGRAM_API_KEY not set — Apple on-device dictation is the only ear"
  fi
fi
print "        Orion shows the ear ACTUALLY serving in the panel and the menu;"
print "        this line is only what it was asked to use."

# --- gateway --------------------------------------------------------------
print ""
print "gateway"
gw_port="$("$py" - "$config" <<'PY' 2>/dev/null
import json, sys
try: print(json.load(open(sys.argv[1]))["gateway"]["port"])
except Exception: print(18789)
PY
)"
[[ -z "$gw_port" ]] && gw_port=18789
if "$py" -c "import socket,sys; s=socket.socket(); s.settimeout(0.6); sys.exit(min(1, s.connect_ex(('127.0.0.1',$gw_port))))" 2>/dev/null; then
  ok "listening on 127.0.0.1:$gw_port"
  if (( live_agent )) && [[ -x "$openclaw_bin" ]]; then
    if "$openclaw_bin" agent --session-key orion-doctor --message "reply with the single word: ok" \
        --json --timeout 45 >/dev/null 2>&1; then
      ok "completed a live agent turn"
    else
      bad "gateway is listening but an agent turn failed"
      print "        Try:  $openclaw_bin agent --session-key t --message hi --json"
    fi
  elif [[ -x "$openclaw_bin" ]]; then
    note "paid agent turn skipped (use --live-agent for end-to-end verification)"
  fi
else
  bad "nothing listening on 127.0.0.1:$gw_port"
  print "        Start it:  $openclaw_bin daemon start"
fi

# --- Orion.app ------------------------------------------------------------
print ""
print "Orion.app"
found=""
for candidate in $app_paths; do
  [[ -d "$candidate" ]] && { found="$candidate"; break }
done
if [[ -z "$found" ]]; then
  warn "not built — cd native/Orion && ./make_app_bundle.sh"
else
  ok "bundle at $found"
  # One `-v` omits Authority for this local certificate even though the bundle
  # has a stable certificate-leaf designated requirement. Detailed inspection
  # prints it; using the shallow form falsely diagnosed a good signature as
  # ad-hoc and told Nick to recreate a certificate he already had.
  signature="$(codesign -dvvv "$found" 2>&1)"
  ident="$(print -r -- "$signature" | grep -i '^Identifier=' | head -1)"
  auth="$(print -r -- "$signature" | grep -i '^Authority=' | head -1)"
  [[ -n "$ident" ]] && print "        ${ident}"
  if [[ -z "$auth" ]]; then
    warn "ad-hoc signed — macOS assigns a NEW identity on every rebuild"
    print "        That is why duplicate 'Orion' rows appear in Privacy settings,"
    print "        and why push-to-talk stops working after a rebuild: the"
    print "        permission is attached to the previous build, not this one."
    print "        Fix once:  ./scripts/orion-sign-setup"
  else
    ok "signed with a stable identity — ${auth#Authority=}"
  fi
  if [[ "$found" != /Applications/* ]]; then
    warn "running from .build — TCC also keys on path; install to /Applications"
    print "        cp -R '$found' /Applications/"
  fi
  running=$(pgrep -x Orion >/dev/null 2>&1 && print yes || print no)
  [[ "$running" == yes ]] && ok "process is running" || warn "not currently running"
fi

# --- permissions ----------------------------------------------------------
print ""
print "permissions (grant these yourself — System Settings owns them, not this script)"
print "        Accessibility        needed for global Right-Option push-to-talk"
print "        Microphone           prompted on first press"
print "        Speech Recognition   prompted on first press"
print "        Open: System Settings -> Privacy & Security"
print "        If you see TWO 'Orion' rows, remove BOTH with the (-) button,"
print "        then relaunch Orion and re-add the one it prompts for."

print ""
if (( fail )); then
  print "  \033[31msomething above is broken — start at the first FAIL\033[0m"
else
  print "  \033[32mall clear\033[0m"
fi
print ""
exit $fail
