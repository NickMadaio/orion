#!/usr/bin/env node
/*
 orion-food-estimate — calories and macros for a meal from his words and/or photos, by the local vision model (2026-11-02).

   orion-food-estimate --text "<what he ate>" [--image <path>]... [--meal breakfast|lunch|dinner|snack] [--log] [--offer] [--json]
   orion-food-estimate --entry <FOOD-or-meal id|latest> [--offer] [--json]   estimate a meal already in the log (0 kcal) by its title
   orion-food-estimate --revise "<his correction>" [--pick "<words>"] [--json]                 re-estimate the offered meal ("it was a small one")
   orion-food-estimate log-pending [--pick "<words>"] [--json]              log the offered estimate (yes to "Log it?"); with several
                                                                            waiting and no --pick it asks which ("the burger", "both")
   orion-food-estimate pending [--json]                                     the offers waiting on a yes, if any
   orion-food-estimate discard [--pick "<words>"] [--json]                  drop the offer he named, or the only one (no to "Log it?"); several and no name: asks
   orion-food-estimate undo <id> [--json]                                   remove an entry this tool wrote, or put a filled meal back
   orion-food-estimate inbox [--json]                                       estimate new food-inbox photos and offer each (lib/food/inbox.mjs)

 Nick (2026-11-02): "when tracking calories i can give a description or pictures of my food and Local AIs can try to come up
 with a somewhat accurate assessment of the macros." The resident qwen3.5:9b (vision) names and sizes each item in grams with
 its assumptions; the answer is schema-checked, kcal is held to 4p+4c+9f within 15%, and items that match the built-in table
 (lib/food/nutrition-table.json) take the table's per-gram numbers. Prints one line, e.g.
   ~650 kcal · 45P 70C 18F (chicken rice bowl, ~400 g; guessed the oil)
 --log appends it to health-log.json's nutritionLog (source "estimate", confidence, photo, a FOOD- id for undo); --offer
 leaves it in food-pending.json for a "yes". Nothing is written during an evaluation. ORION_CONTROLLED_DIR and
 ORION_HEALTH_LOG redirect the state; ORION_OLLAMA_URL the model. Exit 0 ok, 1 failed (one plain sentence), 2 usage.
*/
import { spawnSync } from "node:child_process";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { clockNow } from "./lib/clock.mjs";
import { estimateMeal } from "./lib/food/estimate.mjs";
import { readImages } from "./lib/food/ollama.mjs";
import { latestUncounted, logEstimate, undoEntry, healthLogPath } from "./lib/food/log.mjs";
import { claimPending, clearPending, livePending, loggedLine, loggedOffer, openOffers, restorePending, offerLine, pickOffers, readPending, writePending } from "./lib/food/pending.mjs";
import { runInbox } from "./lib/food/inbox.mjs";
import { readFileSync } from "node:fs";

const here = dirname(fileURLToPath(import.meta.url));
const argv = process.argv.slice(2);
const json = argv.includes("--json");
const USAGE = 'usage: orion-food-estimate --text "<meal>" [--image <path>]... [--meal lunch] [--log] [--offer] [--json] | --entry <id|latest> | --revise "<correction>" | log-pending | pending | discard | undo <FOOD-id> | inbox';
const all = (name) => argv.flatMap((a, i) => (a === name && argv[i + 1] !== undefined ? [argv[i + 1]] : []));
const one = (name) => all(name).at(-1);
const now = clockNow();
const MEALS = ["breakfast", "brunch", "lunch", "dinner", "supper", "snack"];

function finish(result, line) {
  console.log(json ? JSON.stringify(result) : line);
  process.exit(result.ok ? 0 : 1);
}
const usage = () => { console.error(USAGE); process.exit(2); };
const failLine = (error) => `Couldn't estimate that: ${error}.`;
const EVAL_NOTE = "not kept: I am in an evaluation run, so a yes will not log it";
/** What the JSON says about an offer: its id and line, or that an evaluation kept it from being saved. */
const offerJson = (offer) => ({ id: offer.id, text: offer.offerText, ...(offer.saved === false ? { note: EVAL_NOTE } : {}) });

async function estimateCommand() {
  const text = one("--text") ?? "";
  const paths = all("--image").map((p) => resolve(p));
  const meal = one("--meal");
  if (meal && !MEALS.includes(meal.toLowerCase())) usage();
  if (!text.trim() && !paths.length) usage();
  if (text.length > 600) usage();
  let images;
  try { images = readImages(paths); } catch (error) { finish({ ok: false, error: error.message }, failLine(error.message)); }
  const out = await estimateMeal({ text, images, imagePaths: paths });
  if (!out.ok) finish(out, failLine(out.error));
  const result = { ok: true, summary: out.summary, estimate: out.estimate, ms: out.ms };
  if (argv.includes("--log")) {
    const logged = logEstimate(out.estimate, { meal, at: now, now });
    result.logged = logged.ok ? { id: logged.entry.id, day: logged.day, dayCalories: logged.dayCalories, undo: `orion-food-estimate undo ${logged.entry.id}` } : { error: logged.error };
    return finish(result, logged.ok ? `${out.summary}. Logged (${logged.dayCalories} kcal today; undo: orion-food-estimate undo ${logged.entry.id}).` : `${out.summary}. ${logged.error}`);
  }
  if (argv.includes("--offer")) {
    const offer = writePending({ via: "chat", offerText: offerLine(out.summary), summary: out.summary, estimate: out.estimate, ...(meal ? { meal } : {}), ...(text ? { text } : {}), ...(paths.length ? { photos: paths } : {}) }, { now });
    result.offer = offerJson(offer);
  }
  return finish(result, out.summary);
}

async function entryCommand(which) {
  let entry;
  if (which === "latest") entry = latestUncounted({ now });
  else {
    try { entry = Object.values(JSON.parse(readFileSync(healthLogPath(), "utf8")).nutritionLog ?? {}).flat().find((e) => e?.id === which) ?? null; } catch { entry = null; }
  }
  if (!entry) finish({ ok: false, error: "no meal without calories logged in the last few hours" }, "There's no recent meal without calories to estimate.");
  if (!entry.title || /^(?:breakfast|lunch|dinner|snack|meal)$/i.test(entry.title)) finish({ ok: false, error: "the logged meal has no description", entry: { id: entry.id, meal: entry.meal } }, `Your ${String(entry.meal ?? "meal").toLowerCase()} has no description, so I can't size it. What did you have?`);
  const text = [entry.title, entry.notes].filter(Boolean).join(", ");
  const out = await estimateMeal({ text });
  if (!out.ok) finish(out, failLine(out.error));
  const result = { ok: true, summary: out.summary, estimate: out.estimate, ms: out.ms, entry: { id: entry.id, title: entry.title, meal: entry.meal } };
  if (argv.includes("--offer")) {
    const offer = writePending({ via: "chat", offerText: `${out.summary}. Add those numbers to your ${String(entry.meal ?? "meal").toLowerCase()}?`, summary: out.summary, estimate: out.estimate, text, target: { entryId: entry.id }, ...(entry.meal ? { meal: entry.meal } : {}) }, { now });
    result.offer = offerJson(offer);
  }
  return finish(result, out.summary);
}

async function reviseCommand(correction) {
  const live = livePending({ now });
  if (!live.length) finish({ ok: false, error: "no estimate is waiting to be corrected" }, "There's no estimate waiting, so there's nothing to correct. Tell me what you ate.");
  if (!correction.trim() || correction.length > 300) usage();
  const logged = one("--pick") === undefined ? loggedOffer(live) : null;
  const pending = logged ?? whichOffer(live, one("--pick"), "correct");
  let images = [];
  try { images = readImages(pending.photos ?? []); } catch { images = []; }
  const out = await estimateMeal({ text: pending.text ?? "", images, imagePaths: pending.photos ?? [], correction, previous: pending.summary });
  if (!out.ok) finish(out, failLine(out.error));
  if (pending.logged) return reviseLogged(pending, out, correction);
  const question = pending.target ? `Add those numbers to your ${pending.meal ? pending.meal.toLowerCase() : "meal"}?` : "Log it?";
  const offer = writePending({ ...pending, offerText: `${out.summary}. ${question}`, summary: out.summary, estimate: out.estimate,
    text: [pending.text, `(${correction})`].filter(Boolean).join(" ") }, { now, replaces: pending.id });
  return finish({ ok: true, summary: out.summary, estimate: out.estimate, ms: out.ms, offer: offerJson(offer) }, out.summary);
}

/** A correction to a photo already logged: the same entry is rewritten in place, and the offer stays open for the next fix. */
function reviseLogged(pending, out, correction) {
  const at = pending.eatenAt ? new Date(pending.eatenAt) : now;
  const logged = logEstimate(out.estimate, { meal: pending.meal, at, now, target: { entryId: pending.logged.id, replace: true } });
  if (!logged.ok || !logged.filled) {
    clearPending({ ids: [pending.id], now });
    finish({ ok: false, error: logged.error ?? "that entry is no longer in the health log" }, "That one's no longer in your log (it was taken off), so I changed nothing. Tell me what you ate if you want it logged.");
  }
  const offerText = loggedLine(logged.entry, out.estimate, "Updated");
  const offer = writePending({ ...pending, offerText, summary: out.summary, estimate: out.estimate, text: [pending.text, `(${correction})`].filter(Boolean).join(" ") }, { now, replaces: pending.id });
  return finish({ ok: true, summary: out.summary, estimate: out.estimate, ms: out.ms, offer: offerJson(offer),
    logged: { id: logged.entry.id, day: logged.day, filled: true, dayCalories: logged.dayCalories, undo: `orion-food-estimate undo ${logged.entry.id}` }, entry: logged.entry }, offerText);
}

const kcalOf = (offer) => Math.round(offer.estimate?.totals?.kcal ?? 0);
const listOf = (xs) => (xs.length <= 1 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs.at(-1)}`);

/** The one offer his words refer to: --pick names it, or it is the only one waiting. Several and no clear name: asks, and exits. */
function whichOffer(live, pick, verb) {
  const chosen = pick !== undefined ? pickOffers(live, pick) : live;
  if (chosen.length === 1) return chosen[0];
  const named = live.map((o) => `the ${o.name} (~${kcalOf(o)} kcal)`);
  const say = pick !== undefined && !chosen.length
    ? `I couldn't tell which one you meant. Waiting: ${listOf(named)}. Which one should I ${verb}?`
    : `You have ${live.length} estimates waiting: ${listOf(named)}. Which one should I ${verb}?`;
  return finish({ ok: true, discarded: 0, choose: live.map((o) => ({ id: o.id, name: o.name, kcal: kcalOf(o) })), say }, say);
}

/** no to "Log it?": drops the offer he named, the only one waiting, or "all of them"; with several and no name, asks. */
function discardCommand() {
  const everything = livePending({ now });
  if (!everything.length) finish({ ok: true, discarded: 0 }, "No estimate was waiting.");
  const open = openOffers(everything);
  const live = open.length ? open : everything;   // a no answers the open question; with none, it is the "Fix anything?" no
  const keep = one("--pick") === undefined && !open.length ? loggedOffer(everything) : null;
  if (keep) {   // "no" to "Fix anything?": nothing to fix, it stays logged
    clearPending({ ids: [keep.id], now });
    finish({ ok: true, discarded: 1, kept: true, say: "Okay, it stays logged." }, "Okay, it stays logged.");
  }
  const pick = one("--pick");
  const chosen = pick !== undefined && /\b(?:both|all|every|everything)\b/i.test(pick) ? live : [whichOffer(live, pick, "drop")];
  clearPending({ ids: chosen.map((o) => o.id), now });
  finish({ ok: true, discarded: chosen.length }, "Okay, not logged.");
}

/** Logs one offer; the result or a failure sentence. */
function logOne(offer) {
  const at = offer.eatenAt ? new Date(offer.eatenAt) : now;
  return logEstimate(offer.estimate, { meal: offer.meal, at, now, ...(offer.target ? { target: offer.target } : {}) });
}

/** yes to "Log it?". One offer waiting: logged and named. Several and no --pick: listed and asked. --pick: the ones he named. */
function logPendingCommand() {
  const everything = livePending({ now });
  const open = openOffers(everything);
  const live = open.length ? open : everything;   // a yes answers the open question; with none, it is the "Fix anything?" yes
  if (!live.length) finish({ ok: false, error: "no estimate is waiting to be logged" }, "There's no estimate waiting to log.");
  const keep = one("--pick") === undefined && !open.length ? loggedOffer(everything) : null;
  if (keep) {   // "yes" to "Fix anything?": it is already logged; nothing is added
    clearPending({ ids: [keep.id], now });
    const say = `It's already logged (~${kcalOf(keep)} kcal).`;
    finish({ ok: true, kept: true, say }, say);
  }
  const pick = one("--pick");
  const chosen = pick !== undefined ? pickOffers(live, pick) : live.length === 1 ? live : [];
  if (!chosen.length) {
    const named = live.map((o) => `the ${o.name} (~${kcalOf(o)} kcal)`);
    const say = pick !== undefined
      ? `I couldn't tell which one you meant. Waiting: ${listOf(named)}. Say which, or "all of them".`
      : `You have ${live.length} estimates waiting: ${listOf(named)}. Which should I log? Say "the ${live[0].name.split(/[ ,]/)[0]}", or "all of them".`;
    finish({ ok: true, choose: live.map((o) => ({ id: o.id, name: o.name, kcal: kcalOf(o) })), say }, say);
  }
  // Claim first: the offer leaves the file under the lock, so a second yes (the other process) finds nothing and cannot log it again.
  const claimed = claimPending(chosen.map((o) => o.id), { now });
  if (!claimed.length) finish({ ok: false, error: "no estimate is waiting to be logged" }, "There's no estimate waiting to log.");
  const done = [];
  for (const [i, offer] of claimed.entries()) {
    let logged;
    try { logged = logOne(offer); } catch (error) { logged = { ok: false, error: String(error?.message ?? error) }; }
    if (!logged.ok) {
      restorePending(claimed.slice(i), { now });   // the failed one and the rest wait for another yes
      if (done.length) break;
      finish(logged, logged.error);
    }
    done.push({ offer, logged });
  }
  const last = done.at(-1).logged;
  const e = last.entry;
  const say = done.length === 1
    ? `${last.filled ? "Updated" : "Logged"} the ${done[0].offer.name}, ~${e.calories} kcal (${e.meal.toLowerCase()} · ${e.protein}P ${e.carbohydrates}C ${e.fat}F). ${last.dayCalories} kcal today.`
    : `Logged ${listOf(done.map(({ offer, logged }) => `the ${offer.name} (~${logged.entry.calories} kcal)`))}. ${last.dayCalories} kcal today.`;
  return finish({ ok: true, say, logged: { id: e.id, ids: done.map((d) => d.logged.entry.id), day: last.day, filled: last.filled, dayCalories: last.dayCalories, undo: `orion-food-estimate undo ${e.id}` },
    entry: e, summary: done[0].offer.summary }, say);
}

function notifier() {
  const bin = process.env.ORION_REACH_BIN || join(here, "orion-reach");
  return (text, why) => {
    const r = spawnSync(process.execPath, [bin, text, "--kind", "question", "--why", why], { encoding: "utf8", timeout: 30_000, env: process.env });
    return { ok: r.status === 0 };
  };
}

const [command] = argv;
if (command === "log-pending") logPendingCommand();
else if (command === "discard") discardCommand();
else if (command === "pending") { const live = livePending({ now }); const p = live.at(-1) ?? null; finish({ ok: true, pending: p, offers: live }, p ? live.map((o) => o.offerText).join("\n") : "No estimate is waiting."); }
else if (command === "undo") {
  const r = undoEntry(argv[1], { now });
  if (r.ok) clearPending({ ids: livePending({ now }).filter((o) => o.logged?.id === argv[1]).map((o) => o.id), now });
  const line = !r.ok ? r.error : r.restored ? `Put ${r.entry.title} back as it was (${r.entry.calories} kcal). ${r.dayCalories} kcal on ${r.day}.` : `Removed ${r.removed.title} (${r.removed.calories} kcal). ${r.dayCalories} kcal on ${r.day}.`;
  finish(r, line);
} else if (command === "inbox") {
  const r = await runInbox({ now, notify: notifier() });
  finish({ ok: true, ...r }, r.ran ? `${r.items.length} food photo(s) estimated.` : `Inbox not run: ${r.why}.`);
} else if (one("--revise") !== undefined) await reviseCommand(one("--revise"));
else if (one("--entry") !== undefined) await entryCommand(one("--entry"));
else if (command && !command.startsWith("--")) usage();
else await estimateCommand();
