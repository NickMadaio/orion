<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.nickmadaio.orion.phone.night</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nickmadaio.orion.phone</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>orion</string>
			</array>
		</dict>
	</array>
	<key>NSAlarmKitUsageDescription</key>
	<string>ORION sets your wake-up alarm from your first class so you're up in time.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
		<!-- location: lets a geofence or significant-change wake finish a fresh fix and the upload that
		     follows it while the app is in the background, so wake and place signals reach the Mac in
		     minutes (the app only uses region monitoring and significant changes, not continuous tracking). -->
		<string>location</string>
	</array>
</dict>
</plist>
