#!/usr/bin/env node
// orion-checkin — ORION coming back to check (2026-09-29). Closes the loop:
// "I'm starving, let me eat first" → ORION gives 25 minutes, then comes back:
// "Okay, you ate. Now we're starting." Ignored, it escalates; started, it goes
// quiet and checks the work is still going; done or cancelled, it stops.
//
//   orion-checkin add <minutes> "<what>" [--because "<reason>"]   schedule a check-in
//       [--by orion --block <blockId> [--window HH:MM-HH:MM]]      a plan loop (awareness C9): 5 alerts at most, sent
//                                                                  through orion-reach; on give-up or cancel the day is re-weighed
//       [--day YYYY-MM-DD --start <min> --end <min>]               the block's own day and window (minutes after midnight): the loop is
//                                                                  dropped once the block is over or the day has changed, and its "it's been N min"
//                                                                  counts from that start. [--tier protected] for a must block (the gym).
//   orion-checkin started|done [id]                                 he began / finished
//   orion-checkin started "<what>"                                  he began something with no check-in
//   orion-checkin defer <minutes> [id] [--because "<reason>"]       a real pause
//   orion-checkin cancel [id] [--because "<reason>"]                 plans changed — no scolding
//   orion-checkin close "<what>"                                      he finished that thing ("Done early"): every open check-in and
//                                                                  not-started loop about it is closed as done, so ORION stops nudging
//   orion-checkin list                                               what is pending
//   orion-checkin tick [--json]                                      advance due loops; print alerts
//
// The loop itself is scripts/lib/life/follow-through.mjs. `tick` is run by the
// phone link on the Mac every 30 s; each alert it prints becomes a notification
// on Nick's iPhone. [id] defaults to the most recent open check-in.
import { readFileSync, writeFileSync, renameSync, mkdirSync } from "node:fs";
import { join, dirname } from "node:path";
import { homedir } from "node:os";
import { randomBytes } from "node:crypto";
import { startLoop, step } from "./lib/life/follow-through.mjs";
import { classifyDeferral } from "./lib/life/deferral.mjs";
import { recordOutcome, loadPatterns, lateHabit } from "./lib/life/history.mjs";
import { calendarEvents, toBlocks, localDate } from "./lib/life/live-day.mjs";
import { inClass, realClasses } from "./lib/life/class-reminders.mjs";
import { classify } from "./lib/life/live-day.mjs";
import { gate, resolveAwareness } from "./lib/reach/gate.mjs";
import { spawnSync } from "node:child_process";
import { isClassAttendanceCheckin } from "./lib/life/checkin-class.mjs";
import { windowOf, validUntilOf, elapsedSince, staleReason } from "./lib/reach/block-window.mjs";
import { inWakeGrace } from "./lib/awareness/wake.mjs";
import { loadConfig } from "./lib/life/config.mjs";

import { evalMode, EVAL_MARKER } from "./lib/eval-mode.mjs";
const evaluating = evalMode();
const FILE = evaluating ? join(dirname(EVAL_MARKER), "eval-checkins.json") : process.env.ORION_CHECKIN_FILE || join(homedir(), ".openclaw/orion-controlled/checkins.json");
const MAX_ALERTS = 8;
const PLAN_MAX_ALERTS = 5;   // a plan loop is ORION's own; it stops sooner than one he set (spec 3.4.3)
const HERE = import.meta.dirname;
const CONTROLLED = process.env.ORION_CONTROLLED_DIR || join(homedir(), ".openclaw/orion-controlled");
// Test seam: ORION_CHECKIN_NOW is the clock (never set in production).
const NOW_MS = process.env.ORION_CHECKIN_NOW ? Date.parse(process.env.ORION_CHECKIN_NOW) : Date.now();
const nowMinute = () => Math.floor(NOW_MS / 60000);
const MAX_DROPS = 3, DROP_COOLDOWN_MIN = 30;
const load = () => { try { return JSON.parse(readFileSync(FILE, "utf8")); } catch { return { checkins: [] }; } };
const save = (state) => {
  mkdirSync(dirname(FILE), { recursive: true });
  const tmp = `${FILE}.${randomBytes(4).toString("hex")}.tmp`;
  writeFileSync(tmp, JSON.stringify(state, null, 2), { mode: 0o600 }); renameSync(tmp, FILE);
};
const args = process.argv.slice(2);
const flag = (name) => { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : undefined; };
const positional = args.filter((a, i) => !a.startsWith("--") && !(i > 0 && args[i - 1].startsWith("--")));
const [command, ...rest] = positional;
const fail = (msg, code = 2) => { console.error(msg); process.exit(code); };
/** "I'm starving" → "you ate": what he'll have done when ORION comes back. */
function returning(because) {
  const t = String(because ?? "").toLowerCase();
  if (!t) return null;
  if (/eat|hungry|starv|food|lunch|dinner|breakfast|snack/.test(t)) return "you ate";
  if (/shower/.test(t)) return "you showered";
  if (/call/.test(t)) return "the call's done";
  if (/bathroom|toilet/.test(t)) return "you're back";
  if (/laundry/.test(t)) return "laundry's sorted";
  return "break's over";
}
const open = (c) => !["done", "cancelled", "given_up"].includes(c.loop.phase);

function pick(state, id) {
  const list = state.checkins.filter(open);
  const found = id ? list.find((c) => c.id === id) : list[list.length - 1];
  if (!found) fail(id ? `no open check-in ${id}` : "no open check-in", 1);
  return found;
}

/** What ORION says when a check-in comes due, by level. Plain, not motivational. */
export function message(c, now) {
  // from the block's own start today when it is known (2026-10-19: "508 min" counted from yesterday's start)
  const late = elapsedSince(c.blockWindow, now * 60000) ?? Math.max(0, now - c.dueAt);
  const w = c.what;
  const W = w.charAt(0).toUpperCase() + w.slice(1);
  if (c.loop.level <= 1 && c.returning) return `You asked me to check back about ${w}. Ready to start?`;
  const habit = lateHabit(loadPatterns(), classify(w));
  switch (c.loop.level) {
    case 1: return `Time to start: ${w}.${habit ? ` ${habit}` : ""}`;
    case 2: return `${W} — still not started. Start now; just the first five minutes.`;
    case 3: return `It's been ${late} min. ${W}, now. Phone down.`;
    default: return `You've been avoiding ${w} for ${late} min. Get up. We're doing it now.`;
  }
}

/** A plan loop that ends without the block happening re-weighs the day (C11). Best effort: WP6's CLI may be absent. */
function displace(c, why) {
  if (evaluating) return;
  try { spawnSync(process.env.ORION_RESCHEDULE_BIN || join(HERE, "orion-reschedule"), ["displace", c.what, "--why", why], { encoding: "utf8", timeout: 30_000, env: process.env }); } catch { /* the next tick of the day review still lists the slip */ }
}

/** A plan alert goes through orion-reach (gate, the bubble/voice rule and the budgets apply), not the phone's alerts outbox. */
/** @returns { reached, dropped }: reached only when orion-reach actually delivered it (sent, or already said); dropped when a budget,
 *  the ceiling or an earlier drop's cooldown stopped it (not to be tried every tick); a hold, refusal or failure is neither. */
function sendPlan(c, level, text) {
  const ask = { type: "mismatch", blockId: c.block, title: c.what, window: c.blockWindow ?? null, level };
  const until = validUntilOf(c.blockWindow);   // a rung is pointless once the block is over
  try {
    const r = spawnSync(process.env.ORION_REACH_BIN || join(HERE, "orion-reach"), [text, "--kind", "checkin", "--why", `plan: ${c.block}`, "--ask", JSON.stringify(ask),
      ...(c.tier === "protected" ? ["--tier", "protected"] : []), ...(until ? ["--valid-until", until] : [])], { encoding: "utf8", timeout: 30_000, env: process.env });
    const out = String(r.stdout ?? "").trimStart();
    return { reached: r.status === 0 && /^(Sent|Already said)/.test(out), dropped: r.status === 3 && /^NOT SENT: (ceiling|budget|blank-budget|dropped|expired)/.test(out) };
  } catch { return { reached: false, dropped: false }; }
}

const state = load();
const now = nowMinute();

switch (command) {
  case "add": {
    const minutes = Number(rest[0]); const what = rest.slice(1).join(" ").trim();
    if (!Number.isInteger(minutes) || minutes < 0 || minutes > 720 || !what || what.length > 120) fail('usage: orion-checkin add <0-720 minutes> "<what>"');
    // A block that was moved and re-entered gets a new calendar id: the same title on the same day is the same block, and
    // does not start a second not-started loop.
    const today = new Date(NOW_MS).toLocaleDateString("en-CA");
    if (flag("--block") && state.checkins.some((x) => x.block && x.what === what && x.loop?.phase !== "cancelled"
        && new Date(x.createdAt).toLocaleDateString("en-CA") === today)) {
      console.log(`Already following "${what}" today.`); break;
    }
    const id = `ci-${randomBytes(3).toString("hex")}`;
    const because = flag("--because");
    const c = { id, what, dueAt: now + minutes, createdAt: new Date(NOW_MS).toISOString(), alerts: 0, by: flag("--by") === "orion" ? "orion" : "nick",
                ...(flag("--block") ? { block: String(flag("--block")).slice(0, 80), window: flag("--window") ?? null,
                    blockWindow: windowOf({ date: flag("--day"), start: flag("--start"), end: flag("--end") }),
                    ...(flag("--tier") === "protected" ? { tier: "protected" } : {}) } : {}),
                returning: because && classifyDeferral(because).kind === "pause" ? returning(because) : null,
                loop: startLoop({ id, start: now + minutes }, now) };
    state.checkins = [...state.checkins.filter(open), c].slice(-20);
    save(state);
    const at = new Date((now + minutes) * 60000).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
    console.log(`Check-in ${id}: I'll come back at ${at} (${minutes} min) about "${what}" on Nick's iPhone, and keep at it until he starts.`);
    break;
  }
  case "started": case "done": {
    // "Starting the slides now" with nothing open: begin a quiet "still going?" loop.
    const openOnes = state.checkins.filter(open);
    if (command === "started" && !openOnes.some((c) => c.id === rest[0]) && (rest.length > 0 && !/^ci-/.test(rest[0]) || openOnes.length === 0)) {
      const what = rest.join(" ").trim() || "what you started";
      const id = `ci-${randomBytes(3).toString("hex")}`;
      const loop = step(startLoop({ id, start: now }, now), { type: "started" }, now);
      state.checkins = [...openOnes, { id, what, dueAt: now, createdAt: new Date(NOW_MS).toISOString(), alerts: 0, returning: null, loop }].slice(-20);
      save(state);
      console.log(`Noted: ${what} started. I'll check in ~25 min that it's still going.`);
      break;
    }
    const c = pick(state, rest[0]);
    // Planned vs actual: the first time he starts it is the sample that counts.
    if (command === "started" && c.loop.phase !== "active" && c.dueAt) !evaluating && recordOutcome({ what: c.what, plannedAt: c.dueAt * 60000, actualAt: now * 60000 });
    c.loop = step(c.loop, { type: command }, now);
    save(state);
    console.log(command === "started" ? `Noted: ${c.what} started. I'll check in ~25 min that it's still going.` : `Done: ${c.what}. Check-in closed.`);
    break;
  }
  case "defer": {
    const minutes = Number(rest[0]); const c = pick(state, rest[1]);
    if (!Number.isInteger(minutes) || minutes < 1) fail("usage: orion-checkin defer <minutes> [id] [--because \"reason\"]");
    const because = flag("--because") ?? "";
    const verdict = classifyDeferral(because);
    // "10 more min" tapped on the phone: the first one is a real snooze; a
    // second in a row is putting it off, and the loop gets firmer.
    const snooze = args.includes("--snooze") && c.loop.deferrals === 0;
    const legitimate = snooze || verdict.kind === "pause" || verdict.kind === "change";
    c.loop = step(c.loop, { type: "defer", minutes, legitimate }, now);
    if (legitimate) c.returning = returning(because);
    save(state);
    console.log(c.loop.phase === "deferred"
      ? `Fair — back in ${Math.max(5, Math.min(45, minutes))} min about ${c.what}.`
      : `That reads as putting it off (${verdict.kind}). Not deferring — the check-in stays on and gets firmer.`);
    break;
  }
  case "close": {
    // "Done early": he said he finished <what>. Close every open loop about it (a plan loop, a not-started nudge, an active
    // "still going?" check). Done, not cancelled: nothing is re-weighed and nobody is scolded. Never an error when none is open.
    const what = rest.join(" ").trim();
    if (!what) fail('usage: orion-checkin close "<what>"');
    const words = (t) => String(t).toLowerCase().replace(/[^a-z0-9 ]/g, " ").split(/\s+/).filter((w) => w.length >= 2);
    const said = words(what);
    const about = (c) => { const x = words(c.what); const [short, long] = x.length <= said.length ? [x, said] : [said, x]; return short.length > 0 && short.every((w) => long.includes(w)); };
    const hit = state.checkins.filter((c) => open(c) && about(c));
    for (const c of hit) c.loop = step(c.loop, { type: "done" }, now);
    if (hit.length) save(state);
    console.log(hit.length ? `Closed ${hit.length} check-in${hit.length > 1 ? "s" : ""} about ${what}.` : `No open check-in about ${what}.`);
    break;
  }
  case "cancel": {
    const c = pick(state, rest[0]);
    c.loop = step(c.loop, { type: "cancelled", reason: flag("--because") ?? "" }, now);
    save(state);
    if (c.block) displace(c, "cancel");
    console.log(`Cancelled: ${c.what}. Plans changed; no follow-up.`);
    break;
  }
  case "list": {
    const list = state.checkins.filter(open);
    if (!list.length) { console.log("No open check-ins."); break; }
    for (const c of list) {
      const at = c.loop.nextCheckAt ? new Date(c.loop.nextCheckAt * 60000).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" }) : "—";
      console.log(`${c.id} — ${c.what} — ${c.loop.phase}, level ${c.loop.level}, next check ${at}`);
    }
    break;
  }
  case "tick": {
    if (evaluating) { console.log(args.includes("--json") ? "[]" : "No live notifications during evaluation."); break; }
    // One gate for every sender (awareness 3.2): a check-in HE set counts as a reminder and fires through focus and class;
    // one ORION generated waits for a break. Quiet hours hold both (G10). A held check-in is not stepped, so its level does
    // not climb while he cannot act, and it is due again at the first tick after the gate opens.
    const aw = resolveAwareness({ dir: CONTROLLED, now: NOW_MS, env: process.env });
    const held = (c) => gate(aw, { kind: "checkin", urgentKind: c.by !== "orion" && aw.sleep?.state !== "asleep" ? "reminder" : null, now: NOW_MS }).action === "hold";
    const alerts = [];
    let duringClass = false, classes = [];
    try { const blocks = toBlocks(await calendarEvents(), localDate(new Date(NOW_MS))); classes = realClasses(blocks); duringClass = inClass(blocks, new Date(NOW_MS).getHours()*60+new Date(NOW_MS).getMinutes()); } catch { /* No attendance claim from unavailable calendar. */ }
    // Just after he wakes ORION does not scold: its own plan nudges wait (leave and class reminders are not loops, they still go).
    const grace = inWakeGrace({ dir: CONTROLLED, now: new Date(NOW_MS), minutes: Number(loadConfig().wakeGraceMinutes ?? 30) });
    for (const c of state.checkins.filter(open)) {
      // A nudge is about one block on one day: once the block is over, or it is a new day, drop it silently. Never send a
      // not-started nudge for a block that ended hours ago, never into the next day (2026-10-19 audit).
      if (c.block) {
        const stale = staleReason({ window: c.blockWindow, createdAt: c.createdAt }, NOW_MS);
        if (stale) { c.loop = { ...c.loop, phase: "given_up", nextCheckAt: null, history: [...(c.loop.history ?? []), { at: now, event: "expired", phase: "given_up" }] }; c.expired = stale; continue; }
        if (c.retryAfter && now < c.retryAfter) continue;   // dropped by a budget a moment ago: not every tick
        if (grace && c.by === "orion") continue;
      }
      // A calendar class is self-timed; lack of a Started/Done tap isn't
      // evidence of avoidance. Ordinary start nags wait until class is over.
      // 2026-10-16 audit, finding 12: the old rule was a regex on course words (its \b were literal backspace bytes, so it
      // matched nothing on this install, and where it did match it would have cancelled "start studying for macro" and
      // "finish the DS lab write-up"). Now: only a check-in about going to one of today's real class events.
      if (isClassAttendanceCheckin(c.what, classes)) {
        c.loop = step(c.loop, {type: "cancelled"}, now); continue;
      }
      if (duringClass) continue;
      if (held(c)) continue;
      const before = c.loop;
      const after = step(before, { type: "tick" }, now);
      if (after === before) {
        // An active block: confirm it is still going once, then leave him alone.
        if (before.phase === "active" && before.nextCheckAt !== null && now >= before.nextCheckAt) {
          c.loop = { ...before, nextCheckAt: null };
          alerts.push({ id: c.id, level: 0, text: `Checking in on ${c.what}. How is it going?` });
        }
        continue;
      }
      c.loop = after;
      if (c.block) {
        // Only an alert that reached him counts, and a loop only gives up (and re-weighs the day) after one did.
        const finalStep = c.alerts + 1 >= PLAN_MAX_ALERTS;
        const sent = sendPlan(c, finalStep ? 5 : after.level, finalStep ? `I'll stop pinging about ${c.what} - I've moved what I could.` : message(c, now));
        if (sent.dropped) {
          // Dropped by a budget or the ceiling: recorded on the loop with a cooldown (doubling), and given up after a few. Not a retry every tick.
          c.drops = (c.drops ?? 0) + 1;
          c.loop = c.drops >= MAX_DROPS ? { ...before, phase: "given_up", nextCheckAt: null } : before;
          c.retryAfter = now + DROP_COOLDOWN_MIN * 2 ** (c.drops - 1);
          continue;
        }
        if (!sent.reached) { c.loop = before; continue; }   // held, refused or failed: nothing counted, the same step is tried next tick
        c.drops = 0; c.retryAfter = null;
        c.alerts += 1;
        c.returning = null;
        if (finalStep) {
          !evaluating && recordOutcome({ what: c.what, plannedAt: c.dueAt * 60000, actualAt: null });
          c.loop = { ...after, phase: "given_up", nextCheckAt: null };
          displace(c, "gave-up");
        }
        continue;
      }
      c.alerts += 1;
      if (c.alerts > MAX_ALERTS) {
        !evaluating && recordOutcome({ what: c.what, plannedAt: c.dueAt * 60000, actualAt: null });
        c.loop = { ...after, phase: "given_up", nextCheckAt: null }; alerts.push({ id: c.id, level: 4, text: `I'll stop pinging about ${c.what}. Tell me when you want to pick it back up.` }); continue; }
      alerts.push({ id: c.id, level: after.level, text: message(c, now) });
      c.returning = null;
    }
    save(state);
    if (args.includes("--json")) console.log(JSON.stringify(alerts));
    else for (const a of alerts) console.log(`[${a.id}] ${a.text}`);
    break;
  }
  default:
    fail('usage: orion-checkin add|started|done|defer|cancel|close|list|tick  (see the header of this file)');
}
