#!/usr/bin/env node
// orion-phone-time — his phone's Screen Time lock, from the Mac (2026-10-01).
//   orion-phone-time status                          locked or not, until when, and why (as the phone last said)
//   orion-phone-time grant <minutes|HH:MM> --because "<his reason>"   unlock until then; it re-locks by itself
//   orion-phone-time revoke                          end extra time now (the lock returns at the next check)
// Nick asked ORION "can you pretty please unblock my apps just until 12:45" and
// ORION answered that nothing was locked: the lock lives on the phone and the
// Mac could not see it. The phone now reports its state before every message,
// and a grant travels back through the phone link (screen-grant.json).
// A grant is at most 60 minutes: extra time, never switching the lock off.
import { readFileSync, writeFileSync, renameSync, mkdirSync, rmSync } from "node:fs";
import { join } from "node:path";
import { homedir } from "node:os";
import { randomUUID } from "node:crypto";

const CONTROLLED = process.env.ORION_CONTROLLED_DIR || join(homedir(), ".openclaw/orion-controlled");
const HEALTH = process.env.ORION_HEALTH_LOG || join(CONTROLLED, "health-log.json");
const GRANT = join(CONTROLLED, "screen-grant.json");
const MAX_MINUTES = 60;
const read = (file) => { try { return JSON.parse(readFileSync(file, "utf8")); } catch { return null; } };
const fail = (message, code = 2) => { console.error(message); process.exit(code); };
const clock = (date) => date.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
const now = process.env.ORION_NOW ? new Date(process.env.ORION_NOW) : new Date();
const args = process.argv.slice(2);
const flag = (name) => { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : undefined; };
const [command, amount] = args.filter((a, i) => !a.startsWith("--") && args[i - 1] !== "--because");

function describe() {
  const state = read(HEALTH)?.phoneScreen;
  const grant = read(GRANT);
  const grantUntil = grant?.until ? new Date(grant.until) : null;
  if (!state) return "Unknown: his phone has not reported its Screen Time lock yet (it reports before every message he sends from ORION).";
  const at = new Date(state.at);
  const age = Math.round((now - at) / 60000);
  const as = `as of ${clock(at)}${age > 30 ? ` (${age} min ago)` : ""}`;
  const extra = grantUntil && grantUntil > now ? ` Extra time granted until ${clock(grantUntil)}${grant.because ? ` (${grant.because})` : ""}.` : "";
  if (state.graceUntil && new Date(state.graceUntil) > now) {
    return `UNLOCKED on extra time until ${clock(new Date(state.graceUntil))}, then it locks again${state.until ? ` until ${clock(new Date(state.until))}` : ""} — ${as}.`;
  }
  if (state.locked && state.until && new Date(state.until) > now) {
    const why = { night: "past bedtime", work: "during a planned work block", checkin: "an ignored check-in" }[state.why] ?? "focus lock";
    return `LOCKED: his distracting apps are locked until ${clock(new Date(state.until))} (${why}) — ${as}.${extra}`;
  }
  return `Not locked — ${as}.${extra}`;
}

if (!command || command === "status") {
  console.log(describe());
} else if (command === "grant") {
  const because = (flag("--because") ?? "").trim();
  if (!because) fail('usage: orion-phone-time grant <minutes|HH:MM> --because "<his reason>"');
  let until;
  if (/^\d{1,3}$/.test(amount ?? "")) until = new Date(now.getTime() + Number(amount) * 60000);
  else if (/^\d{1,2}:\d{2}$/.test(amount ?? "")) {
    const [h, m] = amount.split(":").map(Number);
    until = new Date(now); until.setHours(h, m, 0, 0);
    if (until <= now) until = new Date(until.getTime() + 86400000);
  } else fail('usage: orion-phone-time grant <minutes|HH:MM> --because "<his reason>"');
  const minutes = Math.round((until - now) / 60000);
  if (minutes < 1) fail("that time has already passed", 1);
  if (minutes > MAX_MINUTES) fail(`NOT GRANTED: ${minutes} minutes is more than ${MAX_MINUTES}. Extra time is at most an hour; offer that, or tell him to turn Focus lock off himself in ORION on the phone.`, 1);
  mkdirSync(CONTROLLED, { recursive: true });
  writeFileSync(`${GRANT}.tmp`, JSON.stringify({ id: randomUUID(), until: until.toISOString(), because: because.slice(0, 120), setAt: now.toISOString() }, null, 2));
  renameSync(`${GRANT}.tmp`, GRANT);
  // Honest about delivery (2026-10-01: ORION said "Done — you're unlocked" to a
  // phone whose ORION was too old to act on a grant, and nothing unlocked).
  const reported = read(HEALTH)?.phoneScreen;
  if (!reported) {
    console.log(`SENT, NOT CONFIRMED: extra time until ${clock(until)} is on its way, but his phone has never reported its lock, so its ORION may be too old to act on it. Tell him it is sent, not done: if his apps are still locked in a minute, the ORION update on his phone is what is missing (install it from the Mac). Do not say he is unlocked.`);
  } else {
    console.log(`Sent to his phone: apps unlock until ${clock(until)} (${minutes} min), then lock again by themselves. It lands within seconds while ORION is open on the phone, otherwise when the phone next checks in; \`status\` shows UNLOCKED once the phone confirms.`);
  }
} else if (command === "revoke") {
  rmSync(GRANT, { force: true });
  console.log("Extra time withdrawn. The lock comes back when his phone next checks in, or when the granted time runs out.");
} else {
  fail("usage: orion-phone-time status | grant <minutes|HH:MM> --because \"<why>\" | revoke");
}
