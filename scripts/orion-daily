#!/usr/bin/env node
/*
 End-of-day pass over the ledger.

 Orion already writes an append-only ledger of every action, and OpenClaw
 already expects `memory/YYYY-MM-DD.md` in the workspace. This joins the two: it
 reads the day's ledger rows, writes a short summary where the runtime will
 actually load it, and compresses the raw rows once summarised.

 Deliberately NOT a model call. A summariser that needs the gateway up, a model
 warm and a network reachable is a summariser that silently stops running some
 evening and leaves a hole in the record nobody notices for a month. This reads
 structured rows and counts them. It is dumber and it will still be working in a
 year.

   orion-daily              summarise yesterday, compress its raw rows
   orion-daily 2026-07-30   a specific day
   orion-daily --today      today so far, no compression
*/

import { createGzip } from "node:zlib";
import { createReadStream, createWriteStream, existsSync } from "node:fs";
import { appendFile, mkdir, readFile, writeFile } from "node:fs/promises";
import { homedir } from "node:os";
import { join } from "node:path";
import { pipeline } from "node:stream/promises";

const OPENCLAW = join(homedir(), ".openclaw");
const LEDGER = join(OPENCLAW, "orion-controlled/task-ledger.jsonl");
const MEMORY = join(OPENCLAW, "workspace/memory");
const ARCHIVE = join(OPENCLAW, "orion-controlled/archive");

/*
 Days are LOCAL days, not UTC days.

 toISOString() is UTC, so east of Greenwich-minus-nothing it rolls over before
 midnight where Nick actually is: at 22:30 in New York it already says tomorrow.
 A summariser that runs in the evening -- which is the only sensible time to run
 one -- would file every day's memory under the wrong date, and the runtime
 loads "today and yesterday" by name. en-CA gives YYYY-MM-DD in the host's own
 timezone, so this also follows him to London instead of needing an edit.
*/
function localDay(offsetDays = 0) {
  const at = new Date(Date.now() - offsetDays * 86400000);
  return at.toLocaleDateString("en-CA");
}

const argument = process.argv[2];
// The nightly run also re-learns his weekly routines from history (code only, no model; a failure never stops the summary).
if (!argument) { try { (await import("node:child_process")).spawnSync(process.execPath, [join(import.meta.dirname, "orion-patterns"), "learn", "--calendar"], { stdio: "inherit", timeout: 120_000 }); } catch {} }
const today = argument === "--today";
const day = argument && !today ? argument : localDay(today ? 0 : 1);

// `createdAt` is a UTC instant; `day` is a local calendar day. Comparing them
// as strings is the same off-by-one as above, one layer down -- an action taken
// at 22:30 in New York is stamped tomorrow in UTC and would be filed a day late.
function dayOf(row) {
  const at = new Date(row.createdAt ?? 0);
  return Number.isNaN(at.getTime()) ? "" : at.toLocaleDateString("en-CA");
}

async function ledgerRows() {
  if (!existsSync(LEDGER)) return [];
  const text = await readFile(LEDGER, "utf8");
  const rows = [];
  for (const line of text.split("\n")) {
    if (!line.trim()) continue;
    try {
      const row = JSON.parse(line);
      if (dayOf(row) === day) rows.push(row);
    } catch {
      /* a torn final line is not worth failing the day over */
    }
  }
  return rows;
}

const rows = await ledgerRows();
if (rows.length === 0) {
  console.log(`${day}: nothing in the ledger, no summary written`);
  process.exit(0);
}

// What happened, counted rather than narrated.
const actions = new Map();
const failures = [];
let verified = 0;
let rejected = 0;

for (const row of rows) {
  for (const step of row.steps ?? []) {
    const name =
      (row.graph?.steps ?? []).find((s) => s.id === step.stepId)?.action ??
      step.stepId;
    actions.set(name, (actions.get(name) ?? 0) + 1);
    if (step.status === "verified") verified++;
    else failures.push(`${name}: ${step.error ?? step.status}`);
  }
  if (row.validation?.status === "rejected") {
    rejected++;
    const codes = [
      ...new Set((row.validation.issues ?? []).map((i) => i.code)),
    ];
    failures.push(`${row.goal ?? "(no goal)"} — refused: ${codes.join(", ")}`);
  }
}

const ranked = [...actions].sort((a, b) => b[1] - a[1]);
const lines = [
  `${rows.length} request${rows.length === 1 ? "" : "s"}, ${verified} action${verified === 1 ? "" : "s"} verified${rejected > 0 ? `, ${rejected} refused` : ""}.`,
  "",
];

if (ranked.length > 0) {
  lines.push("## What was done", "");
  for (const [name, count] of ranked.slice(0, 12)) {
    lines.push(`- ${name} ×${count}`);
  }
  lines.push("");
}

// Goals are the only free text kept. They are Orion's own one-line description
// of what was asked, which is the part worth recalling weeks later -- the
// arguments and hashes are not.
const goals = [...new Set(rows.map((r) => r.goal).filter(Boolean))];
if (goals.length > 0) {
  lines.push("## Asked for", "");
  for (const goal of goals.slice(0, 25)) lines.push(`- ${goal}`);
  lines.push("");
}

if (failures.length > 0) {
  // Kept deliberately. A day's summary that records only successes is how a
  // recurring failure stays invisible for weeks.
  lines.push("## Did not work", "");
  for (const failure of [...new Set(failures)].slice(0, 15)) {
    lines.push(`- ${failure}`);
  }
  lines.push("");
}

/*
 The ledger is only half of a day. It records the Mac actions Orion took; it
 records nothing Nick SAID, nothing Orion learned, and no decision either of
 them made. Those arrive the other way -- AGENTS.md tells Orion to write what
 he is told into this very file.

 So this script must never own the whole file. It owns one delimited block and
 nothing else. Everything outside the markers is somebody's memory and is
 copied through untouched. The previous version called writeFile() on the whole
 path, which meant every run silently destroyed anything Orion had journalled
 that day -- the one instruction for capturing what Nick says wrote to a file
 this script overwrote.
*/
const BEGIN = "<!-- orion-daily:begin — generated from the action ledger; edits inside this block are overwritten -->";
const END = "<!-- orion-daily:end -->";

const block = [BEGIN, "", ...lines, END].join("\n");

function spliceBlock(existing, day) {
  const start = existing.indexOf(BEGIN);
  const finish = existing.indexOf(END);

  if (start !== -1 && finish !== -1 && finish > start) {
    return existing.slice(0, start) + block + existing.slice(finish + END.length);
  }
  if (existing.trim()) {
    // A file Orion already wrote into, from before this block existed. Keep
    // every word of it and put the generated summary underneath.
    return `${existing.trimEnd()}\n\n${block}\n`;
  }
  return `# ${day}\n\n${block}\n`;
}

await mkdir(MEMORY, { recursive: true });
const target = join(MEMORY, `${day}.md`);
const existing = existsSync(target) ? await readFile(target, "utf8") : "";
const preserved = existing.replace(BEGIN, "").replace(END, "").trim().length > 0;

await writeFile(target, spliceBlock(existing, day));
console.log(
  `${day}: ${rows.length} requests -> ${target}${preserved ? " (existing notes preserved)" : ""}`,
);

if (today) process.exit(0);

// Compress the raw rows for the day, then drop them from the live ledger.
// The summary is what gets recalled; the rows are kept in case a specific
// action ever has to be reconstructed exactly.
await mkdir(ARCHIVE, { recursive: true });
const archive = join(ARCHIVE, `ledger-${day}.jsonl.gz`);
if (!existsSync(archive)) {
  const raw = join(ARCHIVE, `.ledger-${day}.tmp`);
  await writeFile(raw, rows.map((r) => JSON.stringify(r)).join("\n") + "\n");
  await pipeline(createReadStream(raw), createGzip(), createWriteStream(archive));
  const { unlink } = await import("node:fs/promises");
  await unlink(raw);

  const text = await readFile(LEDGER, "utf8");
  const kept = text.split("\n").filter((line) => {
    if (!line.trim()) return false;
    try {
      // Same local-day rule as the reader. A substring match on the raw JSON
      // would drop the wrong rows now that `day` is local rather than UTC --
      // and dropping the wrong rows here deletes them from the live ledger.
      return dayOf(JSON.parse(line)) !== day;
    } catch {
      return true; // keep anything unparseable rather than silently losing it
    }
  });
  await writeFile(LEDGER, kept.join("\n") + "\n");
  console.log(`  archived ${rows.length} rows -> ${archive}`);
}
