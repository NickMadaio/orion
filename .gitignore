# Secrets — never commit
.env
.env.*
!.env.example

# Node — 439MB of plugin dependencies. `npm ci` restores them.
# dist/ IS tracked: it is what gets deployed to ~/.openclaw/extensions.
node_modules/

# Python
.venv/
__pycache__/
*.py[cod]

# Swift build artifacts (~266MB)
.build/
*.dSYM/

# Vendored runtime — reinstall Ollama from ollama.com instead of committing it (~561MB)
archive/orion-ui-prototype/runtime/

# Local runtime state — machine-specific, contains conversation history
data/orion.db
data/*.log
data/computer_sandbox/
data/computer_controls/
orion/data/

# macOS
.DS_Store

# Built from Resources/Orion.iconset by make_app_bundle.sh
native/Orion/Resources/Orion.icns
data/icon-preview.png

# Local build outputs
.builds/
_gitlocks/
_to_delete/

# Claude Code local permissions — machine-specific
.claude/settings.local.json
