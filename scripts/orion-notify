#!/usr/bin/env node
/*
 Orion's outbound voice while Nick is away.

 The whole problem with an assistant that can report progress is that it will.
 A notifier wired to tool calls produces forty messages an hour, Nick mutes it,
 and then the one message that mattered -- the blocked one -- arrives muted.
 So this deliberately has NO general "send" verb. There are exactly five events
 a long mission is allowed to emit, and they are the argv verb itself:

   started    the mission is now running and he should know it exists
   milestone  a real chunk landed; no action needed
   decision   Orion chose something he might have chosen differently
   blocked    stopped, needs an answer, and is the ONLY thing that can wake him
   complete   done, with the outcome

 Anything that is not one of those five exits 2 without sending. That is the
 noise control -- not a filter on the text, a filter on the vocabulary.

 Two more suppressors, because five event types per mission is still too many
 when three missions run at once:

 1. Rate limits per mission and globally. A milestone that arrives twenty
    seconds after the last one is not a milestone, it is narration.
 2. Quiet hours 23:00-08:00. Non-urgent traffic is DEFERRED, not dropped --
    it lands in a queue that `flush` delivers as one digest in the morning.
    Dropping would make the notifier lie about what happened overnight.

 `blocked` and `--urgent` bypass both. Waking someone is the correct behaviour
 exactly when the alternative is a mission sitting dead until morning.

   orion-notify started   site-rebuild "Starting the rebuild. ~2h."
   orion-notify milestone site-rebuild "Core UI and persistence work."
   orion-notify blocked   site-rebuild "Need the API key." --approval "use staging key"
   orion-notify flush
   orion-notify status
   ... add --dry-run to render and record without sending anything.
*/

import { execFile } from "node:child_process";
import { existsSync } from "node:fs";
import { readFile, writeFile, rename, mkdir, open, rm, stat } from "node:fs/promises";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { promisify } from "node:util";
import { randomBytes } from "node:crypto";
import { gate, resolveAwareness } from "./lib/reach/gate.mjs";

const run = promisify(execFile);

const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
const STATE = join(homedir(), ".openclaw/orion-controlled/remote.json");
const OPENCLAW = join(homedir(), ".openclaw/bin/openclaw");
const CONFIG = join(homedir(), ".openclaw/openclaw.json");
const DISCORD = process.env.ORION_DISCORD_ALERT_BIN || join(ROOT, "scripts/orion-discord-alert");
// 2026-10-16: when Discord is unreachable (DNS failures all of 10-15), the phone is the fallback channel.
const REACH = process.env.ORION_REACH_BIN || join(ROOT, "scripts/orion-reach");
// A queued retry older than this is stale ("Starts in 1h 58m" is no longer true): dropped, and said so.
const RETRY_MAX_AGE_MS = 3 * 3_600_000;

const EVENTS = {
  started: { label: "MISSION STARTED", minGapMs: 0 },
  milestone: { label: "MILESTONE REACHED", minGapMs: 20 * 60_000 },
  decision: { label: "IMPORTANT DECISION MADE", minGapMs: 10 * 60_000 },
  blocked: { label: "BLOCKED - INPUT REQUIRED", minGapMs: 0 },
  complete: { label: "MISSION COMPLETE", minGapMs: 0 },
};

// `blocked` is exempt from every suppressor. It is the only event whose whole
// purpose is to interrupt, and a rate-limited plea for input is just a hang.
const ALWAYS_DELIVER = new Set(["blocked"]);
const GLOBAL_HOURLY_CAP = 6;
const DEDUPE_MS = 30 * 60_000;
const QUIET_FROM = 23;
const QUIET_UNTIL = 8;

const MISSION_RE = /^[a-z0-9][a-z0-9-]{0,39}$/;

function fail(message, code = 2) {
  console.error(`orion-notify: ${message}`);
  process.exit(code);
}

/* ---------- state (atomic, immutable) ---------- */

async function readState() {
  if (!existsSync(STATE)) return { missions: {}, pending: {}, notify: { sent: [], deferred: [], retry: [] } };
  try {
    const parsed = JSON.parse(await readFile(STATE, "utf8"));
    return {
      missions: parsed.missions ?? {},
      pending: parsed.pending ?? {},
      notify: { sent: parsed.notify?.sent ?? [], deferred: parsed.notify?.deferred ?? [], retry: parsed.notify?.retry ?? [] },
    };
  } catch {
    // A corrupt state file must not mean "Orion goes silent". Losing the rate
    // limiter is survivable; losing the ability to say BLOCKED is not.
    console.error("orion-notify: state unreadable, continuing with an empty history");
    return { missions: {}, pending: {}, notify: { sent: [], deferred: [], retry: [] } };
  }
}

/*
 `remote.json` has two writers: this file and `orion-remote`, and once both run
 from cron they will overlap.

 The atomic rename below only guarantees the file is never left half-written. It
 does nothing about the actual hazard, which is a LOST UPDATE: both processes
 read the same state, each edits its own corner, and whoever renames last erases
 the other's change. The symptom would be an approval quietly un-resolving, or a
 rate-limit history rolling back so a suppressed alert fires twice.

 So the whole read-modify-write happens under the same lockfile `orion-remote`
 takes, and the state is re-read INSIDE the lock — a copy fetched before the
 lock was held is exactly the stale copy that causes the bug. Callers pass an
 updater rather than a finished object for that reason.
*/
async function withStateLock(fn) {
  const lock = `${STATE}.lock`;
  await mkdir(dirname(STATE), { recursive: true });

  for (let attempt = 0; attempt < 60; attempt++) {
    try {
      await (await open(lock, "wx")).close();
      try {
        return await fn();
      } finally {
        await rm(lock, { force: true });
      }
    } catch (error) {
      if (error?.code !== "EEXIST") throw error;
      // A process killed mid-write must not lock Nick out of his own alerts.
      const age = await stat(lock)
        .then((s) => Date.now() - s.mtimeMs)
        .catch(() => Infinity);
      if (age > 15_000) await rm(lock, { force: true });
      await new Promise((resolve) => setTimeout(resolve, 100));
    }
  }
  throw new Error("remote.json stayed locked for six seconds");
}

async function writeState(update) {
  return withStateLock(async () => {
    const fresh = await readState();
    const next = typeof update === "function" ? update(fresh) : update;

    const tmp = `${STATE}.tmp-${randomBytes(4).toString("hex")}`;
    await writeFile(tmp, JSON.stringify(next, null, 2));
    await rename(tmp, STATE); // atomic, so a crash never truncates state
    return next;
  });
}

/* ---------- input validation ---------- */

function cleanText(raw, limit) {
  const text = String(raw ?? "").replace(/\s+/g, " ").trim();
  if (!text) return null;
  // Control characters are refused outright: they are never meaningful in a
  // status line and are the classic way to smuggle terminal escapes.
  if (/[\u0000-\u001f\u007f]/.test(text)) return null;
  if (Buffer.byteLength(text, "utf8") > limit) return null;
  return text;
}

function parseArgs(argv) {
  const flags = {};
  const positional = [];
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (!arg.startsWith("--")) {
      positional.push(arg);
      continue;
    }
    const key = arg.slice(2);
    if (["dry-run", "urgent", "force"].includes(key)) {
      flags[key] = true;
      continue;
    }
    const value = argv[i + 1];
    if (value === undefined || value.startsWith("--")) fail(`--${key} needs a value`);
    flags[key] = value;
    i += 1;
  }
  return { flags, positional };
}

/* ---------- rendering ---------- */

function render({ event, missionId, message, approvalId, approval }) {
  const head = `Orion | ${EVENTS[event].label} | ${missionId}`;
  const body = [head, message];
  if (event === "blocked" && approvalId) {
    body.push(`Waiting on: ${approval}`);
    body.push(`Reply "approve ${approvalId}" or "deny ${approvalId}".`);
  } else if (event !== "complete" && event !== "blocked") {
    body.push("No action needed.");
  }
  return body.join("\n");
}

/* ---------- transport ---------- */

// Channel-agnostic on purpose. The moment a real OpenClaw channel exists this
// starts using it with no edit here; until then the existing one-way Discord
// webhook carries the traffic. Nothing in this file knows a secret.
async function resolveTransport(flags) {
  const channel = flags.channel ?? process.env.ORION_NOTIFY_CHANNEL;
  const target = flags.target ?? process.env.ORION_NOTIFY_TARGET;
  if (channel && target) return { kind: "openclaw", channel, target };

  try {
    const config = JSON.parse(await readFile(CONFIG, "utf8"));
    for (const [name, entry] of Object.entries(config.channels ?? {})) {
      if (entry?.enabled === false) continue;
      const to = entry?.defaultTo ?? entry?.accounts?.default?.defaultTo;
      if (to) return { kind: "openclaw", channel: name, target: to };
    }
  } catch {
    // No readable config is not fatal; it just means no native channel.
  }
  return { kind: "discord" };
}

async function deliver(transport, text, dryRun, { urgentReminder = false } = {}) {
  if (dryRun) {
    const where = transport.kind === "openclaw"
      ? `openclaw:${transport.channel} -> ${transport.target}`
      : "discord-webhook";
    console.log(`--- DRY RUN (${where}) ---\n${text}\n--- END ---`);
    return { delivered: false, dryRun: true };
  }
  try {
    if (transport.kind === "openclaw") {
      await run(OPENCLAW, [
        "message", "send",
        "--channel", transport.channel,
        "--target", transport.target,
        "--message", text,
      ], { timeout: 30_000 });
    } else {
      await run(DISCORD, [text], { timeout: 30_000 });
    }
    return { delivered: true };
  } catch (error) {
    // Never let a transport failure kill the caller's mission. Report it, try the
    // phone, and if that fails too say so (exit non-zero, queued for a retry).
    const reason = error instanceof Error ? error.message : String(error);
    console.error(`orion-notify: delivery failed: ${reason.slice(0, 200)}`);
    try {
      await run(REACH, [text.slice(0, 900), "--channel", "phone", "--kind", "update", "--why", `orion-notify fallback: ${transport.kind} failed`,
        // Only a genuine mission "blocked" with an approval waiting is urgent on the phone (review H3, re-review N2). Standing
        // heads-ups and a plain --urgent carry no urgent kind, so orion-reach holds them in quiet hours.
        ...(urgentReminder ? ["--urgent", "--urgent-kind", "reminder"] : [])], { timeout: 30_000 });
      console.error("orion-notify: sent through the phone instead");
      return { delivered: true, via: "phone" };
    } catch (fallback) {
      console.error(`orion-notify: the phone fallback failed too: ${String(fallback?.message ?? fallback).slice(0, 120)}`);
      return { delivered: false, error: true };
    }
  }
}

/*
 Retries (review M4, 2026-10-16). They run ONLY from `flush`, which is gated (quiet hours, focus session, the hourly cap),
 at most MAX_RETRIES_PER_RUN per run, with exponential backoff per entry. Selection and the attempt bump happen inside
 the state lock (a concurrent flush cannot pick the same entries), and each delivery is written the moment it happens, so a
 flush killed at its timeout never re-delivers what already went out.
*/
const MAX_RETRIES_PER_RUN = 3;
const MAX_ATTEMPTS = 6;
const RETRY_BUDGET_MS = 40_000;
const RELATIVE_TEXT = /\b(starts? in|leave in|in \d+\s*(m|min|minutes|h|hours?)\b)/i;   // "Starts in 1h 58m" is false soon after
const RELATIVE_MAX_AGE_MS = 20 * 60_000;
const retryKey = (r) => `${r.missionId}|${r.at}|${r.message}`;
const maxAge = (r) => (RELATIVE_TEXT.test(r.message) ? RELATIVE_MAX_AGE_MS : RETRY_MAX_AGE_MS);
const backoffMs = (attempts) => Math.min(60, 5 * 2 ** Math.max(0, attempts - 1)) * 60_000;

async function retryPending(transport) {
  const started = Date.now();
  const claimed = [];
  await writeState((fresh) => {
    const hourly = fresh.notify.sent.filter((e) => at - e.at < 3_600_000).length;
    let room = Math.max(0, GLOBAL_HOURLY_CAP - hourly);
    const keep = [];
    for (const r of fresh.notify.retry) {
      if (at - r.at > maxAge(r)) { console.error(`orion-notify: dropped a stale retry (${Math.round((at - r.at) / 60000)} min old): ${r.message.slice(0, 80)}`); continue; }
      if ((r.attempts ?? 0) >= MAX_ATTEMPTS) { console.error(`orion-notify: gave up on a retry after ${MAX_ATTEMPTS} attempts: ${r.message.slice(0, 80)}`); continue; }
      const due = at >= (r.nextAt ?? r.at);
      if (due && claimed.length < MAX_RETRIES_PER_RUN && room > 0) {
        const bumped = { ...r, attempts: (r.attempts ?? 0) + 1, nextAt: at + backoffMs((r.attempts ?? 0) + 1) };
        claimed.push(bumped); keep.push(bumped); room -= 1;
      } else keep.push(r);
    }
    return { ...fresh, notify: { ...fresh.notify, retry: keep } };
  });
  if (claimed.length === 0 || Date.now() - started > RETRY_BUDGET_MS) return;
  // One push per flush, however many retries are due (re-review): a 5-minute tick must not send three separate messages.
  const text = claimed.length === 1 ? (claimed[0].text ?? claimed[0].message)
    : [`Orion | ${claimed.length} UPDATES THAT DID NOT GO OUT`, ...claimed.map((r) => `- ${r.missionId}: ${r.message}`)].join("\n");
  const result = await deliver(transport, text, false, { urgentReminder: claimed.some((r) => r.urgentReminder) });
  if (!result.delivered) return;
  await writeState((fresh) => ({ ...fresh, notify: { ...fresh.notify,
    retry: fresh.notify.retry.filter((x) => !claimed.some((r) => retryKey(r) === retryKey(x))),
    sent: [...fresh.notify.sent, ...claimed.map((r) => ({ event: r.event, missionId: r.missionId, message: r.message, at, ...(result.via ? { via: result.via } : {}) }))].filter((e) => at - e.at < 24 * 3_600_000) } }));
}

/* ---------- suppression ---------- */

// The fixed 23:00-08:00 is only the fallback for when his sleep is unknown (awareness 3.1); otherwise `sleep.state` decides.
const inQuietHours = (now) => {
  const hour = now.getHours();
  return hour >= QUIET_FROM || hour < QUIET_UNTIL;
};

/** The one delivery gate (awareness 3.2) for an update that is neither a reminder he set nor a class. */
function notifyGate({ probe = true } = {}) {
  const dir = process.env.ORION_CONTROLLED_DIR || dirname(STATE);
  const aw = resolveAwareness({ dir, now, env: process.env, legacy: { quiet: inQuietHours(now) }, probe });
  return gate(aw, { kind: "info", now });
}

function suppressionReason(state, { event, missionId, message, at }) {
  const sent = state.notify.sent;
  const duplicate = sent.find(
    (entry) => entry.event === event && entry.missionId === missionId
      && entry.message === message && at - entry.at < DEDUPE_MS,
  );
  if (duplicate) return "duplicate of a message sent in the last 30 min";

  const gap = EVENTS[event].minGapMs;
  if (gap > 0) {
    const last = sent.filter((e) => e.missionId === missionId && e.event === event).at(-1);
    if (last && at - last.at < gap) {
      return `rate limit: ${event} for ${missionId} was sent ${Math.round((at - last.at) / 60000)} min ago`;
    }
  }

  const lastHour = sent.filter((entry) => at - entry.at < 3_600_000).length;
  if (lastHour >= GLOBAL_HOURLY_CAP) return `rate limit: ${lastHour} messages already sent this hour`;
  return null;
}

/* ---------- commands ---------- */

const { flags, positional } = parseArgs(process.argv.slice(2));
const [command, ...rest] = positional;
const now = flags.now ? new Date(flags.now) : new Date();
if (Number.isNaN(now.getTime())) fail("--now must be an ISO timestamp");
const at = now.getTime();
const dryRun = flags["dry-run"] === true;

if (command === "status") {
  const state = await readState();
  const recent = state.notify.sent.filter((entry) => at - entry.at < 3_600_000);
  console.log(`sent in the last hour: ${recent.length}/${GLOBAL_HOURLY_CAP}`);
  console.log(`deferred (quiet hours): ${state.notify.deferred.length}`);
  console.log(`quiet hours right now: ${inQuietHours(now) ? "yes" : "no"}`);
  for (const [id, mission] of Object.entries(state.missions)) {
    console.log(`- ${id}: ${mission.status}${mission.priority ? ` (${mission.priority})` : ""}`);
  }
  for (const [id, item] of Object.entries(state.pending)) {
    if (item.status === "pending") console.log(`- pending approval ${id}: ${item.request}`);
  }
  process.exit(0);
}

if (command === "flush") {
  // Held updates are released when it is neither quiet nor focus time (2026-10-16): orion-proactive's tick calls this.
  if (!dryRun) {   // --force no longer bypasses: a forced flush used to skip quiet hours, the focus hold and the cap (review M4)
    const verdict = notifyGate();
    if (verdict.action === "hold") { console.log(verdict.heldFor === "quiet" ? "quiet hours: not flushing" : `${verdict.heldFor === "focus" ? "focus session running" : verdict.reason}: not flushing`); process.exit(0); }
  }
  if (!dryRun) await retryPending(await resolveTransport(flags));
  const state = await readState();
  if (state.notify.deferred.length === 0) {
    console.log("nothing deferred");
    process.exit(0);
  }
  const digest = [
    `Orion | HELD UPDATES | ${state.notify.deferred.length} update(s)`,
    ...state.notify.deferred.map((entry) => `- [${EVENTS[entry.event].label}] ${entry.missionId}: ${entry.message}`),
  ].join("\n");
  const transport = await resolveTransport(flags);
  const result = await deliver(transport, digest, dryRun);
  if (!dryRun && result.delivered) {
    await writeState((fresh) => ({ ...fresh, notify: { ...fresh.notify, deferred: [] } }));
  }
  process.exit(result.error ? 1 : 0);
}

if (!command || !(command in EVENTS)) {
  fail(`unknown event "${command ?? ""}". Allowed: ${Object.keys(EVENTS).join(", ")}, flush, status`);
}

const missionId = rest[0];
if (!missionId || !MISSION_RE.test(missionId)) {
  fail("mission id must be 1-40 chars of a-z, 0-9 and hyphen");
}
const message = cleanText(rest.slice(1).join(" "), 1200);
if (!message) fail("message must be 1-1200 bytes of printable text");

const approval = flags.approval ? cleanText(flags.approval, 200) : null;
if (flags.approval && !approval) fail("--approval must be 1-200 bytes of printable text");
if (approval && command !== "blocked") fail("--approval only makes sense on a blocked event");

const state = await readState();

// A blocked event with --approval mints exactly one pending item with its own
// id. That id is the ONLY thing a remote `approve` can name -- which is what
// stops an inbound message from ever being a blanket authorisation.
const approvalId = approval ? `ap-${randomBytes(4).toString("hex")}` : null;

const text = render({ event: command, missionId, message, approvalId, approval });

const forced = ALWAYS_DELIVER.has(command) || flags.urgent === true;
// `blocked` (and --urgent) still wants a human and goes through; everything else obeys the gate: sleep, focus, a short pause, class.
const verdict = forced || dryRun ? { action: "deliver" } : notifyGate();
const quiet = verdict.action === "hold" && verdict.heldFor === "quiet";
const focusHeld = verdict.action === "hold" && !quiet;
const suppressed = forced ? null : suppressionReason(state, { event: command, missionId, message, at });

const mission = state.missions[missionId] ?? { priority: "normal", history: [] };
const statusFor = { started: "running", complete: "complete", blocked: "blocked" }[command] ?? mission.status ?? "running";

const nextMissions = {
  ...state.missions,
  [missionId]: {
    ...mission,
    status: statusFor,
    lastEvent: command,
    lastEventAt: new Date(at).toISOString(),
  },
};
const nextPending = approvalId
  ? { ...state.pending, [approvalId]: { missionId, request: approval, status: "pending", createdAt: new Date(at).toISOString() } }
  : state.pending;

if (quiet || focusHeld) {
  // Apply only THIS mission's delta onto the freshly-read state. Replacing the
  // whole `missions` map with one built from a stale read is how a concurrent
  // orion-remote edit to a different mission would silently vanish.
  await writeState((fresh) => ({
    ...fresh,
    missions: { ...fresh.missions, [missionId]: nextMissions[missionId] },
    pending: approvalId ? { ...fresh.pending, [approvalId]: nextPending[approvalId] } : fresh.pending,
    notify: { ...fresh.notify, deferred: [...fresh.notify.deferred, { event: command, missionId, message, at }] },
  }));
  console.log(focusHeld ? `deferred (${verdict.heldFor === "class" ? "in class" : "focus session running"}) - will go out with the next flush` : `deferred (quiet hours ${QUIET_FROM}:00-0${QUIET_UNTIL}:00) - will go out with the next flush`);
  process.exit(0);
}

if (suppressed) {
  await writeState((fresh) => ({ ...fresh, missions: nextMissions, pending: nextPending }));
  console.log(`suppressed: ${suppressed}`);
  process.exit(0);
}

const transport = await resolveTransport(flags);
const urgentReminder = command === "blocked" && !!approvalId;
const result = await deliver(transport, text, dryRun, { urgentReminder });

await writeState((fresh) => ({
  ...fresh,
  missions: { ...fresh.missions, [missionId]: nextMissions[missionId] },
  pending: approvalId ? { ...fresh.pending, [approvalId]: nextPending[approvalId] } : fresh.pending,
  notify: {
    ...fresh.notify,
    /*
     A dry run is CHECKED against the rate limit but does not consume it.

     It used to consume it, on the reasoning that a rehearsal should behave
     exactly like the real thing. That reasoning conflates two different jobs:
     showing what the limiter would do, and spending the budget it guards.
     Keeping both meant a single pass over the five event types burned most of
     the hourly cap, so the next genuinely important "BLOCKED — INPUT REQUIRED"
     went to nobody. A test that silences real alarms is not a safe test.

     The suppression check above still runs for dry runs, so a rehearsal still
     tells you honestly that it would have been throttled.
    */
    // 2026-10-16 audit, finding 6: only a DELIVERED message is recorded as sent. A failure used to
    // consume the 30 min dedupe window and the hourly cap and then vanish; now it waits in `retry`.
    sent: dryRun || !result.delivered
      ? fresh.notify.sent
      : [...fresh.notify.sent, { event: command, missionId, message, at, ...(result.via ? { via: result.via } : {}) }].filter(
          (e) => at - e.at < 24 * 3_600_000,
        ),
    retry: !dryRun && !result.delivered
      ? [...fresh.notify.retry, { event: command, missionId, message, text, at, attempts: 0, nextAt: at, ...(urgentReminder ? { urgentReminder: true } : {}) }].slice(-20)
      : fresh.notify.retry,
  },
}));

if (approvalId) console.log(`pending approval id: ${approvalId}`);
if (result.delivered) console.log(`sent (${result.via ?? transport.kind})`);
else if (!dryRun) console.log("NOT SENT: delivery failed; queued for a retry");
process.exit(result.error ? 1 : 0);
