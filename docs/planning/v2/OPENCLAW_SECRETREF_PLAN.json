{
  "version": 1,
  "protocolVersion": 1,
  "providerUpserts": {
    "orion_anthropic_keychain": {
      "source": "exec",
      "command": "/usr/bin/security",
      "args": [
        "find-generic-password",
        "-w",
        "-s",
        "ORION OpenClaw Anthropic",
        "-a",
        "openclaw"
      ],
      "jsonOnly": false,
      "allowInsecurePath": true,
      "timeoutMs": 5000,
      "maxOutputBytes": 16384
    },
    "orion_gateway_keychain": {
      "source": "exec",
      "command": "/usr/bin/security",
      "args": [
        "find-generic-password",
        "-w",
        "-s",
        "ORION OpenClaw Gateway",
        "-a",
        "openclaw"
      ],
      "jsonOnly": false,
      "allowInsecurePath": true,
      "timeoutMs": 5000,
      "maxOutputBytes": 16384
    },
    "orion_ollama_keychain": {
      "source": "exec",
      "command": "/usr/bin/security",
      "args": [
        "find-generic-password",
        "-w",
        "-s",
        "ORION OpenClaw Ollama",
        "-a",
        "openclaw"
      ],
      "jsonOnly": false,
      "allowInsecurePath": true,
      "timeoutMs": 5000,
      "maxOutputBytes": 16384
    }
  },
  "targets": [
    {
      "type": "gateway.auth.token",
      "path": "gateway.auth.token",
      "pathSegments": [
        "gateway",
        "auth",
        "token"
      ],
      "ref": {
        "source": "exec",
        "provider": "orion_gateway_keychain",
        "id": "value"
      }
    },
    {
      "type": "models.providers.apiKey",
      "path": "models.providers.anthropic.apiKey",
      "pathSegments": [
        "models",
        "providers",
        "anthropic",
        "apiKey"
      ],
      "providerId": "anthropic",
      "ref": {
        "source": "exec",
        "provider": "orion_anthropic_keychain",
        "id": "value"
      }
    },
    {
      "type": "auth-profiles.token.token",
      "path": "profiles.ollama:local.token",
      "pathSegments": [
        "profiles",
        "ollama:local",
        "token"
      ],
      "agentId": "main",
      "ref": {
        "source": "exec",
        "provider": "orion_ollama_keychain",
        "id": "value"
      }
    }
  ],
  "options": {
    "scrubEnv": true,
    "scrubAuthProfilesForProviderTargets": true,
    "scrubLegacyAuthJson": true
  }
}
