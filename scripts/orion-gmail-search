#!/usr/bin/env node
/*
 Search Gmail read-only, returning up to five sanitized matching threads.
 The query is passed as data to gog, never interpreted by a shell.
 */
import { readFile } from "node:fs/promises";
import { spawn } from "node:child_process";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";

const query = process.argv.slice(2).join(" ").trim();
if (!query) {
  console.error("Provide a Gmail search query, such as from:school.edu or subject:(exam schedule).");
  process.exit(2);
}

const root = dirname(dirname(fileURLToPath(import.meta.url)));
const values = {};
for (const line of (await readFile(join(root, ".env"), "utf8")).split(/\r?\n/)) {
  if (!line.startsWith("#") && line.includes("=")) {
    const [key, value] = line.split("=", 2);
    values[key.trim()] = value.trim().replace(/^['"]|['"]$/g, "");
  }
}
if (!values.GOG_KEYRING_PASSWORD) {
  console.error("Orion’s Gmail vault password is not available in local configuration.");
  process.exit(2);
}

const environment = {
  ...process.env,
  GOG_KEYRING_BACKEND: "file",
  GOG_KEYRING_PASSWORD: values.GOG_KEYRING_PASSWORD,
};
const account = "nmadaio08@gmail.com";

function run(args) {
  return new Promise((resolve, reject) => {
    const child = spawn("gog", args, { env: environment, stdio: ["ignore", "pipe", "pipe"] });
    let stdout = "";
    let stderr = "";
    child.stdout.on("data", (chunk) => { stdout += chunk; });
    child.stderr.on("data", (chunk) => { stderr += chunk; });
    child.once("error", reject);
    child.once("close", (code) => {
      if (code === 0) resolve(stdout);
      else reject(new Error(stderr.trim() || `gog exited ${code}`));
    });
  });
}

try {
  const search = JSON.parse(await run([
    "gmail", "search", query, "--max", "5", "--account", account,
    "--readonly", "--gmail-no-send", "--json",
  ]));
  const threadIds = (search.threads ?? []).map((thread) => thread?.id).filter(Boolean).slice(0, 5);
  if (threadIds.length === 0) {
    console.log(JSON.stringify({ threads: [], message: "No matching email found." }));
    process.exit(0);
  }
  const threads = [];
  for (const threadId of threadIds) {
    threads.push(JSON.parse(await run([
      "gmail", "thread", "get", threadId, "--account", account,
      "--sanitize-content", "--readonly", "--gmail-no-send", "--json",
    ])));
  }
  process.stdout.write(JSON.stringify({ query, threads }));
} catch (error) {
  console.error(error instanceof Error ? error.message : String(error));
  process.exit(1);
}
