#!/usr/bin/env node
// orion-reschedule — move Nick's day around what actually happened (2026-09-29).
//   orion-reschedule late <minutes> [--why "<what happened>"]         he's running late: lose the time from now
//   orion-reschedule busy HH:MM-HH:MM [--why "<what>"]                something took that time
//   orion-reschedule overrun <minutes> [--what "<class>"] [--date …]   a class runs over (any day); the trip home moves too
//   orion-reschedule now "<title>, <min>" ["<title>, <min>" …] [--at HH:MM]   what he is doing right now ("eating, then a
//        break"): booked from now (or when he started), everything not yet done slides after it in order
//   orion-reschedule add "<title>" <minutes> [--at HH:MM | --after "<event>"] [--fixed] [--before HH:MM] [--date YYYY-MM-DD]
//   orion-reschedule fill [--date YYYY-MM-DD]                         fill the blanks once his real plans are known
//   orion-reschedule day --plan "<title>, <min>, HH:MM, fixed" [--plan …] [--fill]
//        everything he just told you, in ONE call: his plans go in first, then the blanks are filled
//        around them (use this instead of several adds + fill — run in parallel they collide)
//        add --replace when he explicitly says to redo/rebuild the whole schedule: every
//        future non-class/deadline block is replaced in the same reversible transaction
//        add --rebuild to keep the tasks but lay the remaining day out again, must-haves first;
//        day also falls back to this automatically when an incremental change cannot fit
//   orion-reschedule day --todos [--date YYYY-MM-DD] [--until HH:MM] [--fill]   (--until: "until around 8 PM")          plan the day from his to-do list (the Orion
//        Reminders list): one movable block per to-do, real titles, estimates from todo-parse
//   orion-reschedule tidy [--date YYYY-MM-DD]                         "fix my schedule": separate overlaps, space blocks out
//   orion-reschedule clear [--date YYYY-MM-DD]                        clear future movable blocks
//   orion-reschedule drop "<title>" ["<title>" …] [--date YYYY-MM-DD]   or  drop --after "<title>" (everything planned after it)  remove the named movable blocks
//        ("get rid of studying and the Orion stuff"); classes and plans with people are never dropped
//   A time he states is kept exactly ("nap 90 at 13:00"): ORION's own blocks move out of its way.
//   Untimed plans follow the timed plan listed before them, and "gym after soccer" / "resume
//   before soccer" are read from the title. Restating a block replaces it; it is never duplicated.
//   orion-reschedule extend "<title>" --until HH:MM | <minutes> [--then "<title>"]   "the lab is taking longer, extend it to 3, nap after": that
//        block (even one that already ended) runs longer; everything after it slides; low-priority blocks shrink to fit
//   orion-reschedule resize "<title>" <minutes>                       "make the YouTube block smaller": its new length
//   orion-reschedule rename "<old title>" "<new title>"               "replace apply somewhere with YouTube": same slot, new thing
//   orion-reschedule move "<title>" --to HH:MM                        "move study to 4": same length, the rest cascades
//        also --after "<block>" (starts after it), --until HH:MM or --before "<block>" [--gap N] (where it ends; changes its length):
//        "directly after CS lab, ending 20 before DS" = move "X" --after "CS lab" --before "DS" --gap 20 — one call, no arithmetic
//   orion-reschedule swap "<title>" "<title>"                         "swap study and the side project" (any lengths)
//   orion-reschedule early [block|out-of-class] [--now HH:MM] [--check] [--dry-run] [--date YYYY-MM-DD]
//        finished early: shorten what is under way (or clip a class that just ended), pull the rest of the day forward
//   orion-reschedule skip "<class or plan>" [--date YYYY-MM-DD]   he is not going to it: just that occurrence comes
//        off his calendar (no approval; undo puts it back). A class never moves unless he says so — this is him saying so.
//   orion-reschedule undo                                             put the last change back
//   add --dry-run to any of them to see the plan without touching the calendar.
// Only movable things move (study, gym, games, rest, groceries, chores, side
// projects, meals alone, anything ORION planned). Classes, deadlines and plans
// with people never do. Every change is written to Apple Calendar and can be undone.
import { calendarEvents, toBlocks, localDate, classify, isSocial, movable as movableTitle } from "./lib/life/live-day.mjs";
import { replan } from "./lib/life/replan.mjs";
import { freeGaps } from "./lib/life/gaps.mjs";
import { checkDay } from "./lib/life/day-check.mjs";
import { fillDay } from "./lib/life/fill-day.mjs";
import { loadConfig, toMinute } from "./lib/life/config.mjs";
import { applyPlan, undoLast, bridge, clean, iso, recordUndo } from "./lib/life/calendar-write.mjs";
import { addSkip } from "./lib/life/skips.mjs";
import { ramp } from "./lib/life/deadline-ramp.mjs";
import { parsePlans } from "./lib/life/plan-parse.mjs";
import { parseTodos } from "./lib/life/todo-parse.mjs";
import { parseSpread, minutesIn, waitsFor } from "./lib/life/task-spread.mjs";
import { parseTaskNotes } from "./lib/life/task-notes.mjs";
import { commuteWalls } from "./lib/life/commute.mjs";
import { homeFrom, preferredStart } from "./lib/life/sensible-time.mjs";
import { bedOn, readWakeRequest } from "./lib/life/night.mjs";
import { loadPatterns } from "./lib/life/history.mjs";
import { withMinimums, shrinkPlan, applyShrink } from "./lib/life/lengths.mjs";
import { clockNow } from "./lib/life/bridge-path.mjs";
import { pinBlocks } from "./lib/life/pins.mjs";
import { minimumFor } from "./lib/life/lengths.mjs";
import { earlyContext, finishEarly } from "./lib/life/early.mjs";
import { breakFor, shortBlock, extendWithin } from "./lib/life/freed-time.mjs";

const args = process.argv.slice(2);
const flag = (name) => { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : undefined; };
const positional = args.filter((a, i) => !a.startsWith("--") && !(i > 0 && ["--why", "--at", "--before", "--date", "--plan", "--say", "--until", "--then", "--to", "--after", "--by", "--now", "--gap", "--minutes"].includes(args[i - 1])));
const planArgs = args.flatMap((a, i) => (a === "--plan" && args[i + 1] ? [args[i + 1]] : []));
const [command, ...restRaw] = positional;
// An option this tool does not have is an error, never silently ignored
// (2026-10-06: ORION passed "--until 20:00" when it did not exist; the evening
// was planned to 21:29 and he told Nick things "didn't fit by 8 PM").
const KNOWN = new Set(["--after", "--again", "--at", "--before", "--by", "--check", "--date", "--dry-run", "--fill", "--fixed", "--gap", "--minutes", "--now", "--plan",
  "--replace", "--say", "--then", "--to", "--todos", "--until", "--what", "--why"]);
const unknown = args.filter((a) => a.startsWith("--") && !KNOWN.has(a));
if (unknown.length) {
  console.error(`NOTHING WAS CHANGED: orion-reschedule has no ${unknown.join(", ")} option. Options: ${[...KNOWN].join(" ")}. See the header for which command takes which.`);
  process.exit(2);
}
/*
 One command per call, and only its own options (2026-10-07). ORION sent
 `drop "send internship applications" move "Study" --by 30`: drop took "move"
 and "Study" as more titles to remove, ignored --by, and ORION reported both
 changes as done. Refuse the whole call instead of doing part of it.
*/
const COMMANDS = new Set(["add", "busy", "clear", "day", "drop", "early", "extend", "fill", "late", "minimums", "move", "now",
  "overrun", "rename", "resize", "skip", "swap", "tidy", "undo"]);
const glued = restRaw.find((w) => COMMANDS.has(String(w).toLowerCase()));
if (COMMANDS.has(command) && glued) {
  console.error(`NOTHING WAS CHANGED: one command per call — "${glued}" is a separate command. Run \`${command} …\` and then \`${glued} …\` as two calls, one after the other.`);
  process.exit(2);
}
const OWN_OPTIONS = {
  drop: ["--after", "--date", "--dry-run"],
  resize: ["--date", "--dry-run"],
  swap: ["--date", "--dry-run"],
  rename: ["--date", "--dry-run"],
  skip: ["--date", "--dry-run"],
  move: ["--to", "--by", "--after", "--before", "--gap", "--until", "--date", "--dry-run"],
  extend: ["--until", "--then", "--date", "--dry-run"],
};
const foreign = OWN_OPTIONS[command] ? args.filter((a) => a.startsWith("--") && !OWN_OPTIONS[command].includes(a)) : [];
if (foreign.length) {
  console.error(`NOTHING WAS CHANGED: ${command} does not take ${foreign.join(", ")} (it takes ${OWN_OPTIONS[command].join(" ")}). If he asked for two changes, run them as two calls.`);
  process.exit(2);
}
// A bare date is a date (2026-09-30 eval: "day 2026-10-01 --plan …" without --date
// wrote tomorrow's soccer onto today, at a time already over).
const DAY_WORD = /^(\d{4}-\d{2}-\d{2}|today|tomorrow)$/i;
const dateWord = restRaw.find((a) => DAY_WORD.test(a));
const rest = restRaw.filter((a) => !DAY_WORD.test(a));
const dry = args.includes("--dry-run");
const fail = (m, code = 2) => { console.error(m); process.exit(code); };
const hhmm = (m) => `${String(Math.floor((m % 1440) / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;
const minute = (t) => { const m = /^([01]?\d|2[0-3]):([0-5]\d)$/.exec(t ?? ""); return m ? Number(m[1]) * 60 + Number(m[2]) : null; };

/*
 The day as it will be once this change is written, checked against the day
 rules (day-check) BEFORE anything reaches his calendar, and again after, read
 back from the calendar itself. A plan that would overlap is never written.
 (2026-10-01: overlaps kept coming back one case at a time.)
*/
function projectDay(dayBlocks, { moves = [], created = [], removed = [] }) {
  const gone = new Set(removed.map((b) => b.id));
  const moved = new Map(moves.map((m) => [m.id, m]));
  return [...dayBlocks.filter((b) => !gone.has(b.id)).map((b) => {
    const m = moved.get(b.id);
    return m ? { ...b, start: m.to, end: Number.isInteger(m.toEnd) ? m.toEnd : m.to + (b.end - b.start) } : b;
  }),
    ...created.map((c) => ({ ...c, source: "orion", fixed: c.fixed === true }))];
}
function refuseIfBroken(day, from, label) {
  const check = checkDay(day, { from });
  if (check.ok) return;
  console.log(`NOTHING WAS CHANGED: ${label} would break the day rules — ${check.problems.slice(0, 3).join("; ")}. Tell him what clashes and ask which to move; do not retry the same call.`);
  process.exit(1);
}
async function verifyWritten(date, from) {
  try {
    const written = toBlocks(await calendarEvents(), date);
    const check = checkDay(written, { from });
    if (!check.ok) console.log(`WARNING: his calendar now has an overlap — ${check.problems.slice(0, 2).join("; ")}. Tell him.`);
  } catch { /* a failed read-back is not a failed write */ }
}

// One change at a time: two runs started together would each plan from the
// same old calendar and write on top of each other (found in a scenario run).
import { mkdirSync as mkLock, rmSync as rmLock, statSync as statLock } from "node:fs";
import { join as joinPath } from "node:path";
import { homedir as home } from "node:os";
const LOCK = joinPath(home(), ".openclaw/orion-controlled/reschedule.lock");
if (!dry) {
  const deadline = Date.now() + 30000;
  for (;;) {
    try { mkLock(LOCK); break; } catch {
      try { if (Date.now() - statLock(LOCK).mtimeMs > 60000) rmLock(LOCK, { recursive: true, force: true }); } catch {}
      if (Date.now() > deadline) fail("another change to his day is still running; try again", 1);
      await new Promise((r) => setTimeout(r, 200));
    }
  }
  process.on("exit", () => { try { rmLock(LOCK, { recursive: true, force: true }); } catch {} });
}

if (command === "undo") {
  const done = await undoLast().catch((e) => fail(`orion-reschedule: ${e.message}`, 1));
  console.log(done.length ? `Undone: ${done.join("; ")}.` : "Nothing to undo.");
  process.exit(0);
}

const config = loadConfig();
// The real clock, or the moment a test (ORION_RESCHEDULE_NOW) or a schedule evaluation replays.
const nowDate = clockNow();
/*
 --say "<his own words>" (2026-09-30): the plan parser (tighten-orion/plan-parse)
 reads the titles, dates, times and lengths out of what Nick said, so the model
 no longer composes "--plan" lines and forgets "--date" for tomorrow. Items for
 another day are reported, not dropped.
*/
const sayText = flag("--say");
const said = sayText ? parsePlans(sayText, { date: localDate(nowDate), minute: nowDate.getHours() * 60 + nowDate.getMinutes(), weekday: nowDate.getDay() }) : [];
const wordDate = !dateWord ? null : /^today$/i.test(dateWord) ? localDate(nowDate)
  : /^tomorrow$/i.test(dateWord) ? localDate(new Date(nowDate.getTime() + 86400000)) : dateWord;
// --date also takes today / tomorrow / a weekday (the 9B wrote "--date tomorrow" and got "Invalid time value", 2026-10-11).
const dayWord = (word) => {
  if (!word || /^\d{4}-\d{2}-\d{2}$/.test(word)) return word;
  if (/^today$/i.test(word)) return localDate(nowDate);
  if (/^tomorrow$/i.test(word)) return localDate(new Date(nowDate.getTime() + 86400000));
  const days = ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"];
  const target = days.findIndex((d) => d.startsWith(word.toLowerCase().slice(0, 3)));
  if (target < 0) fail(`orion-reschedule: --date takes YYYY-MM-DD, today, tomorrow or a weekday, not "${word}"; nothing was changed`, 2);
  const ahead = ((target - nowDate.getDay()) + 7) % 7 || 7;
  return localDate(new Date(nowDate.getTime() + ahead * 86400000));
};
const date = dayWord(flag("--date")) ?? wordDate ?? said[0]?.date ?? localDate(nowDate);
if (date < localDate(nowDate)) fail(`orion-reschedule: ${date} is in the past; nothing was changed`, 1);
const otherDays = said.filter((p) => p.date !== date);
const dayName = new Date(`${date}T12:00:00`).toLocaleDateString("en-US", { weekday: "long" });
// Today's share of the study each assessment still needs (deadline-ramp). Only
// assessments: the deadline feed also carries public holidays ("Study for
// Halloween" was one dry run away, 2026-09-30).
function studyPlanFor(deadlines) {
  const assessments = deadlines.filter((e) => /\b(quiz|exam|midterm|final|test|due|submission|presentation|essay|assignment|coursework)\b/i.test(e.title));
  const rampDay = ramp(assessments.map((e, i) => ({ id: e.identifier ?? `d${i}`, title: e.title.replace(/^DUE \d\d:\d\d — /, ""),
    date: localDate(new Date(e.start)) })), { today: date }).find((d) => d.date === date);
  return rampDay ? rampDay.items.map((it) => ({ title: it.title, minutes: it.minutes })) : [];
}
const today = date === localDate(nowDate);
const nowMinute = today ? nowDate.getHours() * 60 + nowDate.getMinutes() : 0;
// Plan from when he actually gets up, once his history says so (3+ mornings).
const patterns = loadPatterns();
const wakeMinute = patterns?.wake?.median != null ? patterns.wake.median : toMinute(config.usualWake);
const events = await calendarEvents().catch((e) => fail(`orion-reschedule: ${e.message}`, 1));
const blocks = pinBlocks(toBlocks(events, date), date);
// The day ends at the "asleep by" line his phone alarm is set from (night.mjs),
// so wind-down, the last thing planned, ends exactly on it (2026-09-30).
const asleepBy = bedOn(date, { blocksOf: (d) => toBlocks(events, d), config, wakeRequest: await readWakeRequest() });
// "Plan things until around 8 PM": --until HH:MM ends the planning window there
// (for extend, --until is the block's new end instead).
// extend and move read --until as the END of the block they change, not the day's window.
const untilMinute = ["extend", "move"].includes(command) ? null : minute(flag("--until"));
if (flag("--until") !== undefined && !["extend", "move"].includes(command) && untilMinute === null) fail("--until must be HH:MM (24-hour), e.g. --until 20:00", 2);
const window = { start: Math.max(wakeMinute - 60, 360), end: Math.min(1440, asleepBy, untilMinute ?? 1440) };
const blocked = []; let add = [];
// Words keep five letters ("studying" ~ "study"), but a word with a digit is a code and stays whole:
// cut to five, CS2101 and CS2100 were both "cs210" (2026-10-11).
const sameThingEarly = (a, b) => { const w = (t) => clean(t).split(/\s+/).map((x) => x.toLowerCase().replace(/[^a-z0-9]/g, "")).map((x) => (/\d/.test(x) ? x : x.slice(0, 5))).filter((x) => x.length >= 3);
  const x = w(a), y = w(b); return x.length > 0 && x.every((q) => y.includes(q)); };
/*
 How closely a title is the thing he named (2026-10-07). sameThingEarly drops
 words under three letters, so "CS lab" was just "lab" and matched the CS2100
 Lab class before the CS lab block: move refused, and skip deleted the class.
 3 = the same title; 2 = the same words both ways; 1 = his words are in it.
*/
const closeness = (name, title) => {
  const norm = (t) => clean(t).toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
  if (norm(name) === norm(title)) return 3;
  if (!sameThingEarly(name, title)) return 0;
  return sameThingEarly(title, name) ? 2 : 1;
};
const closest = (name, list) => {
  const ranked = list.map((b) => ({ b, rank: closeness(name, b.title) })).filter((x) => x.rank > 0);
  const top = Math.max(0, ...ranked.map((x) => x.rank));
  return ranked.filter((x) => x.rank === top).map((x) => x.b);
};
// Untimed plans wait until he is home and prefer their natural time of day
// (sensible-time). Times he states, and "before X" that ends before he is home,
// are left alone.
const backHome = homeFrom(blocks, { commuteMinutes: config.commuteMinutes, wake: wakeMinute });

/*
 One block changes shape (extend, resize) and the rest of the day follows it
 (2026-10-01): "extend DS lab to 3" became three retyped days, the lab booked at
 a time already past, then a SECOND lab at 17:25. Now the block itself changes,
 later blocks cascade after it, and when the day overflows the low-priority
 blocks give up time (lengths.mjs) before anything is dropped.
*/
/** pins: [{ block, start, end }] — blocks he placed; everything else cascades around them. */
function shapeAndCascade(pins) {
  const pinned = pins.map((p) => ({ ...p.block, start: p.start, end: p.end, fixed: true }));
  const pinnedIds = new Set(pins.map((p) => p.block.id));
  const others = blocks.filter((b) => !pinnedIds.has(b.id));
  const latestEnd = Math.max(...pins.map((p) => p.end));
  const opts = { now: nowMinute, window, blocked: [], soft: commuteWalls(others, config), add: [], rebuild: true,
    buffer: config.bufferMinutes, keepFree: 0 };
  let day = [...others, ...pinned];
  let result = replan(day, opts);
  let shrunk = [];
  if (result.unplaced.length && config.autoShrink !== false) {
    const deficit = result.unplaced.reduce((sum, u) => sum + (u.minutes ?? 0) + config.bufferMinutes, 0);
    // Not yet started, or overrun by a pinned block (the side project "under way" while he was still in the lab).
    const open = others.filter((b) => b.start >= nowMinute || (b.end > nowMinute && b.start < latestEnd));
    const plan = shrinkPlan(open, deficit, { now: 0, minimums: config.minimums });
    if (plan.length) {
      const shrunkDay = applyShrink([...others, ...pinned], plan, { now: nowMinute });
      const second = replan(shrunkDay, opts);
      if (second.unplaced.length < result.unplaced.length) { result = second; shrunk = plan; day = shrunkDay; }
    }
  }
  return { result, shrunk, day };
}
function lengthMoves(result, shrunk, dayAfter) {
  // Shrinking pulls later blocks forward too. Compare the final layout with the
  // original calendar, rather than only with the intermediate shrunken plan.
  const before = new Map(blocks.map(b => [b.id, b]));
  return result.blocks.filter(b => before.has(b.id) && (b.start !== before.get(b.id).start || b.end !== before.get(b.id).end))
    .map(b => ({ id: b.id, title: b.title, from: before.get(b.id).start, to: b.start, toEnd: b.end }));
}
async function writeShape(label, pins, firstLines, persist = true) {
  const past = pins.find((p) => p.start !== p.block.start && p.start < nowMinute && today);
  if (past) fail(`NOTHING WAS CHANGED: ${past.block.title} cannot start at ${hhmm(past.start)}; it is already ${hhmm(nowMinute)}`, 1);
  const { result, shrunk, day } = shapeAndCascade(pins);
  const byId = new Map(blocks.map((b) => [b.id, b]));
  const pinnedIds = new Set(pins.map((p) => p.block.id));
  const pinMoves = pins.filter((p) => p.start !== p.block.start || p.end !== p.block.end)
    .map((p) => ({ id: p.block.id, title: p.block.title, from: p.block.start, to: p.start, toEnd: p.end }));
  const moves = [...pinMoves, ...lengthMoves(result, shrunk, day).filter((m) => !pinnedIds.has(m.id))];
  const removed = result.unplaced.map((u) => byId.get(u.id)).filter(Boolean);
  refuseIfBroken(projectDay(blocks, { moves, created: [], removed }), nowMinute, label);
  if (!dry) await applyPlan({ date, moves, created: [], removed, blocksById: byId, pinIds: persist ? pins.map(p => p.block.calendarId) : [] }).catch((e) => fail(`orion-reschedule: ${e.message}`, 1));
  if (!dry) await verifyWritten(date, nowMinute);
  console.log(`${dry ? "Would change" : "Changed"} ${dayName} ${date}:`);
  for (const line of firstLines) console.log(`  ${line}`);
  for (const x of shrunk) console.log(`  SHRUNK to fit: ${x.title} ${x.from} → ${x.to} min (low priority; tell him)`);
  for (const m of moves.slice(pinMoves.length)) if (m.to !== m.from) console.log(`  moved ${m.title}: ${hhmm(m.from)} → ${hhmm(m.to)}`);
  for (const u of result.unplaced) console.log(`  NOT BOOKED: ${u.title} (${u.minutes} min) no longer fits on ${dayName} (nothing low-priority could give up enough time) — ask him whether to drop it, shrink something he names, or move it to another day`);
  if (!dry) console.log('Written to his calendar. "orion-reschedule undo" puts it back.');
  process.exit(0);
}
/** The block he means: the one under way, else the latest that already happened today, else the next one. */
function findBlock(name, { allowPast = true } = {}) {
  const matches = closest(name, blocks);
  return matches.find((b) => b.start <= nowMinute && b.end > nowMinute)
    ?? (allowPast ? matches.filter((b) => b.end <= nowMinute).sort((a, b) => b.end - a.end)[0] : undefined)
    ?? matches.filter((b) => b.start > nowMinute).sort((a, b) => a.start - b.start)[0];
}
const notFound = (name) => fail(`NOTHING WAS CHANGED: no block called "${name}" on ${dayName}. Blocks today: ${blocks.map((b) => `${b.title} ${hhmm(b.start)}–${hhmm(b.end)}`).join(", ") || "none"}.`, 1);
const sensible = (items) => items.map((item) => {
  if (Number.isInteger(item.at)) return item;
  const floorAt = Number.isInteger(item.before) && item.before - item.minutes < backHome ? null : backHome;
  return { ...item, ...(floorAt !== null ? { after: Math.max(item.after ?? 0, floorAt) } : {}),
    prefer: item.sequence ? Math.max(item.after ?? 0, /\bdinner\b/i.test(item.title) ? 18 * 60 + 30 : 0) : Math.max(item.after ?? 0, preferredStart(item, floorAt ?? 0)) };
});

if (command === "late") {
  const n = Number(rest[0]); if (!Number.isInteger(n) || n < 5 || n > 600) fail("usage: orion-reschedule late <minutes>");
  blocked.push({ start: nowMinute, end: nowMinute + n, title: flag("--why") ?? "running late" });
} else if (command === "overrun") {
  // "Lecture's going 20 min over": that class ends later, and so does the trip
  // home after it. Works for any day (late only works from now).
  const n = Number(rest[0]); if (!Number.isInteger(n) || n < 5 || n > 240) fail('usage: orion-reschedule overrun <minutes> [--what "<class>"]');
  const what = flag("--what");
  const fixedToday = blocks.filter((b) => b.fixed && (what ? sameThingEarly(what, b.title) : b.kind === "class"));
  const target = what ? fixedToday[0]
    : fixedToday.find((b) => b.start <= nowMinute && b.end > nowMinute) ?? fixedToday.find((b) => b.end > nowMinute);
  if (!target) fail(`orion-reschedule: no ${what ? `"${what}"` : "class"} left on ${dayName} to run over`, 1);
  blocked.push({ start: target.end, end: target.end + n + (target.kind === "class" ? config.commuteMinutes : 0), title: `${target.title} running over` });
} else if (command === "busy") {
  const [a, b] = String(rest[0] ?? "").split("-").map(minute);
  if (a === null || b === null || b <= a) fail("usage: orion-reschedule busy HH:MM-HH:MM");
  blocked.push({ start: a, end: b, title: flag("--why") ?? "busy" });
} else if (command === "add") {
  // Also accept the --plan shape, add "reading, 30" (ORION wrote it that way, 2026-09-30).
  const packed = /^(.*?),\s*(\d+)\s*(?:min(?:ute)?s?)?$/i.exec(rest[0] ?? "");
  const title = clean(packed && rest[1] === undefined ? packed[1] : rest[0] ?? "");
  // `--minutes 120` and `--after "<event>"` are how ORION reaches for it (2026-10-08:
  // three tries to add "gym and laundry" after the lecture); both are accepted.
  const n = Number(packed && rest[1] === undefined ? packed[2] : rest[1] ?? flag("--minutes"));
  if (!title || !Number.isInteger(n) || n < 5 || n > 720) fail('usage: orion-reschedule add "<title>" <minutes> [--at HH:MM | --after "<event>"] [--fixed] [--before HH:MM]');
  const afterTitle = flag("--after");
  const anchor = afterTitle ? blocks.find((b) => sameThingEarly(afterTitle, b.title) || sameThingEarly(b.title, afterTitle)) : null;
  if (afterTitle && !anchor) fail(`NOTHING WAS CHANGED: no "${afterTitle}" on ${date} to put it after.`, 2);
  const at = anchor ? anchor.end : minute(flag("--at")); const before = minute(flag("--before"));
  const fixed = args.includes("--fixed") || isSocial(title);
  if (fixed && at === null) fail("a fixed plan needs --at HH:MM");
  add.push({ title, kind: classify(title), minutes: n, ...(at !== null ? { at } : {}), ...(before !== null ? { before } : {}), fixed });
} else if (command === "now") {
  /*
   "I only just got home. I'm going to eat now, so put my break now and rearrange
   my schedule" (2026-10-01 10:28). ORION retyped the whole day with invented
   times: nothing went in now, the lab stayed during lunch, dinner moved EARLIER.
   This is the command for it: what he is doing now goes in from now (or --at,
   when he started), back to back; everything movable that has not happened yet
   slides after it in its own order; whatever still has room keeps its time.
  */
  const items = rest.map((raw) => {
    const m = /^(.*?),\s*(\d{1,3})\s*(?:min(?:ute)?s?)?$/i.exec(raw.trim());
    if (!m || !clean(m[1]) || Number(m[2]) < 5 || Number(m[2]) > 240) fail(`bad item "${raw}" (want "<title>, <minutes>")`);
    return { title: clean(m[1]), minutes: Number(m[2]) };
  });
  if (!items.length) fail('usage: orion-reschedule now "<title>, <minutes>" ["<title>, <minutes>" …] [--at HH:MM]');
  if (planArgs.length) fail('NOTHING WAS CHANGED: now takes only what he is doing now ("title, minutes" items), not --plan. Book those with now, then plan the rest with: day --todos [--until HH:MM]', 2);
  const startAt = minute(flag("--at")) ?? nowMinute;
  if (today && (startAt > nowMinute + 30 || startAt < nowMinute - 240)) fail("--at must be when he started: within the last 4 hours, or now", 2);
  let cursor = startAt;
  const created = items.map((item, i) => {
    const block = { id: `now-${i}`, title: item.title, kind: classify(item.title), date, start: cursor, end: cursor + item.minutes, fixed: false, source: "orion" };
    cursor += item.minutes; return block;
  });
  // "Put my break now": a later block with the same name moves to now; it is not doubled.
  const replaced = blocks.filter((b) => !b.fixed && b.end > startAt && items.some((i) => sameThingEarly(i.title, b.title) && sameThingEarly(b.title, i.title)));
  const replacedIds = new Set(replaced.map((b) => b.id));
  const busyUntil = Math.max(cursor, today ? nowMinute : startAt);
  // A movable block already under way when he got in did not happen (DS lab was
  // booked 11:00; he got home 11:28): it slides too, so the floor starts at it.
  const remaining = blocks.filter((b) => !replacedIds.has(b.id));
  const floorAt = Math.min(startAt, ...remaining.filter((b) => !b.fixed && b.start < startAt && b.end > startAt).map((b) => b.start));
  // He is home: no commute guess. Fixed things (classes, people) stay walls.
  const result = replan(remaining, { now: floorAt, window: { ...window, start: Math.min(window.start, floorAt) }, buffer: config.bufferMinutes, keepFree: config.freeMinutesKept,
    blocked: [{ start: floorAt, end: busyUntil, title: items.map((i) => i.title).join(" and ") }], add: [], rebuild: true });
  const byId = new Map(blocks.map((b) => [b.id, b]));
  const removed = [...replaced, ...result.unplaced.map((u) => byId.get(u.id)).filter(Boolean)];
  refuseIfBroken(projectDay(blocks, { moves: result.moves, created, removed }), floorAt, "this rearrangement");
  if (!dry) await applyPlan({ date, moves: result.moves, created, removed, blocksById: byId, pinCreated: created.map(c => c.id) }).catch((e) => fail(`orion-reschedule: ${e.message}`, 1));
  if (!dry) await verifyWritten(date, floorAt);
  console.log(`${dry ? "Would change" : "Changed"} ${dayName} ${date}:`);
  for (const c of created) console.log(`  now: ${c.title} ${hhmm(c.start)}–${hhmm(c.end)}`);
  for (const r of replaced) console.log(`  (the ${r.title} that was at ${hhmm(r.start)} is this one)`);
  for (const m of result.moves) console.log(`  moved ${m.title}: ${hhmm(m.from)} → ${hhmm(m.to)}`);
  for (const u of result.unplaced) console.log(`  NOT BOOKED: ${u.title} (${u.minutes} min) no longer fits on ${dayName} — ask whether to drop it or move it to another day`);
  if (!result.moves.length) console.log("  nothing else had to move");
  if (!dry) console.log('Written to his calendar. "orion-reschedule undo" puts it back.');
  process.exit(0);
} else if (command === "extend") {
  const name = rest[0]; const until = minute(flag("--until")); const more = Number(rest[1]);
  if (!name || (until === null && !(Number.isInteger(more) && more >= 5 && more <= 480))) fail('usage: orion-reschedule extend "<title>" --until HH:MM | <minutes>');
  const target = findBlock(name) ?? notFound(name);
  if (target.fixed && !target.pinned) fail(`"${target.title}" is a class: use overrun <minutes> --what "${target.title}"`, 2);
  const end = until ?? Math.max(target.end, nowMinute) + more;
  if (end <= target.start || end > 1440) fail(`NOTHING WAS CHANGED: ${target.title} starts at ${hhmm(target.start)}, so it cannot end at ${hhmm(end)}`, 1);
  // 2026-10-07: ORION read "extend 70" as "make it 70 minutes long" twice.
  const clash = until === null && blocks.find((b) => b.id !== target.id && b.fixed && b.start < end && b.end > target.end);
  if (clash) fail(`NOTHING WAS CHANGED: extend ADDS ${more} minutes to the end (${hhmm(target.start)}–${hhmm(end)}), which runs into ${clash.title} at ${hhmm(clash.start)}. To set when it ends use extend "${target.title}" --until HH:MM, or move "${target.title}" --to HH:MM --until HH:MM (or --before "${clash.title}" --gap N).`, 1);
  const thenName = flag("--then");
  const next = thenName ? (blocks.find((b) => b.id !== target.id && (!b.fixed || b.pinned) && b.end > nowMinute && sameThingEarly(thenName, b.title)) ?? notFound(thenName)) : null;
  // "I'll take my nap after": the block he names goes straight after this one.
  const pins = [{ block: target, start: target.start, end },
    ...(next ? [{ block: next, start: end + config.bufferMinutes, end: end + config.bufferMinutes + (next.end - next.start) }] : [])];
  await writeShape("extending it", pins, [`${target.title} now runs ${hhmm(target.start)}–${hhmm(end)} (was until ${hhmm(target.end)})${next ? `; ${next.title} straight after, ${hhmm(pins[1].start)}–${hhmm(pins[1].end)}` : ""}`]);
} else if (command === "resize") {
  const name = rest[0]; const n = Number(rest[1]);
  if (!name || !Number.isInteger(n) || n < 5 || n > 480) fail('usage: orion-reschedule resize "<title>" <minutes>');
  const target = findBlock(name, { allowPast: false }) ?? notFound(name);
  if (target.fixed && !target.pinned) fail(`NOTHING WAS CHANGED: "${target.title}" is one of his own calendar events (a class or a plan with people); ORION can skip it (skip) but does not move or resize it — a repeating event would change the wrong day`, 1);
  await writeShape("resizing it", [{ block: target, start: target.start, end: target.start + n }], [`${target.title} is now ${n} min: ${hhmm(target.start)}–${hhmm(target.start + n)} (was ${target.end - target.start} min)`]);
} else if (command === "move") {
  // "Move study to 4": same length, new start; the rest cascades around it.
  const name = rest[0];
  if (!name) fail('usage: orion-reschedule move "<title>" --to HH:MM | --by <minutes>');
  const target = findBlock(name, { allowPast: false }) ?? notFound(name);
  if (target.fixed && !target.pinned) fail(`NOTHING WAS CHANGED: "${target.title}" is one of his own calendar events (a class or a plan with people); ORION can skip it (skip) but does not move or resize it — a repeating event would change the wrong day`, 1);
  /*
   2026-10-07: "start organize safari directly after CS lab, ending 20 minutes
   before the DS assessment" took two messages and four failed calls because
   ORION did the arithmetic. Anchors do it here, in one call:
     --to HH:MM | --by N | --after "<block>"      where it starts
     --until HH:MM | --before "<block>" [--gap N] where it ends (default: same length)
  */
  const anchor = (n) => closest(n, blocks.filter((b) => b.id !== target.id)).sort((a, b) => a.start - b.start)
    .find((b) => b.end > nowMinute) ?? notFound(n);
  const gapText = flag("--gap");
  const gap = gapText === undefined ? config.bufferMinutes : /^\d{1,3}$/.test(gapText) ? Number(gapText) : fail("--gap must be minutes, e.g. --gap 20");
  const length = target.end - target.start;
  const by = flag("--by");
  const after = flag("--after") !== undefined ? anchor(flag("--after")) : null;
  const before = flag("--before") !== undefined ? anchor(flag("--before")) : null;
  const untilEnd = flag("--until") !== undefined ? minute(flag("--until")) : undefined;
  if (untilEnd === null) fail("--until must be HH:MM (24-hour), e.g. --until 14:40");
  const end0 = untilEnd ?? (before ? before.start - gap : null);
  const start = by !== undefined ? (/^-?\d+$/.test(by) ? target.start + Number(by) : null)
    : flag("--to") !== undefined ? minute(flag("--to"))
    : after ? after.end + config.bufferMinutes
    : end0 !== null ? end0 - length : null;
  if (start === null) fail('usage: orion-reschedule move "<title>" --to HH:MM | --by <minutes> | --after "<block>"  [--until HH:MM | --before "<block>" [--gap N]]');
  const end = end0 ?? start + length;
  if (start < 0 || end > 1440 || end - start < 5) fail(`NOTHING WAS CHANGED: ${target.title} would run ${hhmm(start)}–${hhmm(end)}, which is not a real block`, 1);
  const lengthNote = end - start === length ? "" : ` (now ${end - start} min, was ${length})`;
  await writeShape("moving it", [{ block: target, start, end }], [`${target.title} moved: ${hhmm(target.start)} → ${hhmm(start)}–${hhmm(end)}${lengthNote}`]);
} else if (command === "swap") {
  /*
   "Swap study and the side project": the later one takes the earlier one's start,
   the earlier one ends where the later one ended, and anything between them
   slides by the difference in length (uneven swaps keep the span the same).
  */
  const [x, y] = rest;
  if (!x || !y) fail('usage: orion-reschedule swap "<title>" "<title>"');
  const one = findBlock(x, { allowPast: false }) ?? notFound(x);
  const two = findBlock(y, { allowPast: false }) ?? notFound(y);
  if (one.id === two.id) fail(`NOTHING WAS CHANGED: "${x}" and "${y}" are the same block`, 1);
  const fixedOne = [one, two].find((b) => b.fixed && !b.pinned);
  if (fixedOne) fail(`NOTHING WAS CHANGED: "${fixedOne.title}" is one of his own calendar events (a class or a plan with people); ORION can skip it (skip) but does not move or resize it — a repeating event would change the wrong day`, 1);
  const [early, late] = one.start <= two.start ? [one, two] : [two, one];
  if (early.start < nowMinute && today) fail(`NOTHING WAS CHANGED: ${early.title} has already started; swap only things that have not`, 1);
  const lateLen = late.end - late.start; const earlyLen = early.end - early.start;
  const pins = [{ block: late, start: early.start, end: early.start + lateLen },
    { block: early, start: Math.max(late.end - earlyLen, early.start + lateLen + config.bufferMinutes), end: Math.max(late.end, early.start + lateLen + config.bufferMinutes + earlyLen) }];
  await writeShape("swapping them", pins, [`${late.title} now ${hhmm(pins[0].start)}–${hhmm(pins[0].end)}`, `${early.title} now ${hhmm(pins[1].start)}–${hhmm(pins[1].end)}`]);
} else if (command === "minimums") {
  const targets = blocks.filter(b => (!b.fixed || b.pinned) && b.start >= nowMinute && minimumFor(b.title, config.minimums) > b.end - b.start);
  if (!targets.length) { console.log("Today already meets his saved minimums."); process.exit(0); }
  await writeShape("applying minimums", targets.map(block => ({ block, start: block.start, end: block.start + minimumFor(block.title, config.minimums) })), targets.map(b => `${b.title} raised to ${minimumFor(b.title, config.minimums)} min (saved minimum)`), false);
} else if (command === "skip") {
  /*
   "I'm skipping Marketing, work on ORION instead" (2026-10-06). drop refused
   classes, so ORION reached for the generic calendar delete, which needs his
   approval and, on a repeating class, removed the series' FIRST occurrence.
   This removes just that day's occurrence and records an undo. A read-only class
   calendar cannot be changed, so then the occurrence is skipped in ORION's own
   planning instead (lib/life/skips.mjs) and every view of his day leaves it out.
  */
  const name = rest[0];
  if (!name) fail('usage: orion-reschedule skip "<class or plan>" [--date YYYY-MM-DD]');
  // A movable block that IS what he named means he did not mean a class.
  const nearest = closest(name, blocks.filter((b) => b.end > nowMinute));
  const loose = nearest.find((b) => !b.fixed);
  if (loose) fail(`NOTHING WAS CHANGED: "${loose.title}" is one of ORION's movable blocks, not a class — skip is only for classes and plans with people. Use move/resize/drop "${loose.title}". Classes today stay as they are.`, 1);
  const target = nearest.filter((b) => b.fixed).sort((a, b) => a.start - b.start)[0];
  if (!target) fail(`NOTHING WAS CHANGED: no class or fixed plan called "${name}" left on ${dayName}. Fixed today: ${blocks.filter((b) => b.fixed).map((b) => `${b.title} ${hhmm(b.start)}`).join(", ") || "none"}.`, 1);
  const start = iso(date, target.start); const end = iso(date, target.end);
  if (dry) { console.log(`Would skip ${target.title} ${hhmm(target.start)}–${hhmm(target.end)} on ${dayName}.`); process.exit(0); }
  let how;
  try {
    await bridge("delete_calendar_event", { identifier: target.calendarId, start });
    recordUndo([{ op: "delete", title: target.title, start, end }]);
    how = "removed from his calendar";
  } catch (e) {
    if (!/read-only/i.test(String(e.message))) fail(`orion-reschedule: ${e.message}`, 1);
    addSkip(target.title, start);
    recordUndo([{ op: "unskip", title: target.title, start }]);
    how = "skipped in ORION's planning (that calendar is read-only, so it still shows in Apple Calendar)";
  }
  console.log(`Changed ${dayName} ${date}:\n  skipped ${target.title} ${hhmm(target.start)}–${hhmm(target.end)} — ${how}. That time is free now.`);
  console.log('Written. "orion-reschedule undo" puts it back.');
  process.exit(0);
} else if (command === "rename") {
  const [from, to] = rest;
  if (!from || !clean(to ?? "")) fail('usage: orion-reschedule rename "<old title>" "<new title>"');
  const target = findBlock(from, { allowPast: false }) ?? notFound(from);
  if (target.fixed && !target.pinned) fail(`NOTHING WAS CHANGED: "${target.title}" is one of his own calendar events (a class or a plan with people); ORION can skip it (skip) but does not move or resize it — a repeating event would change the wrong day`, 1);
  const existing = blocks.find(b => b.id !== target.id && sameThingEarly(to, b.title) && sameThingEarly(b.title, to));
  if (existing) {
    if (existing.fixed && !existing.pinned) fail("NOTHING WAS CHANGED: replacement is a fixed commitment", 1);
    // Reuse the existing identity and length; remove the replaced task before cascading.
    const i = blocks.indexOf(target); blocks.splice(i, 1);
    const shape = shapeAndCascade([{ block: existing, start: target.start, end: target.start + existing.end - existing.start }]);
    blocks.splice(i, 0, target);
    const moves = [{ id: existing.id, from: existing.start, to: target.start, toEnd: target.start + existing.end - existing.start }, ...lengthMoves(shape.result, shape.shrunk, shape.day).filter(m => m.id !== existing.id)];
    const byId = new Map(blocks.map(b => [b.id, b]));
    const removed = [target, ...shape.result.unplaced.map(u => byId.get(u.id)).filter(Boolean)];
    refuseIfBroken(projectDay(blocks, { moves, removed }), nowMinute, "replacing it");
    if (!dry) await applyPlan({ date, moves, removed, created: [], blocksById: byId, pinIds: [existing.calendarId] });
    console.log(`${dry ? "Would move" : "Moved"} existing ${existing.title} to ${hhmm(target.start)}; removed ${target.title}; kept one copy.`);
    for (const u of shape.result.unplaced) console.log(`NOT BOOKED: ${u.title} — ask whether to drop it or move it to another day`);
    process.exit(0);
  }
  const created = [{ id: "renamed", title: clean(to), kind: classify(clean(to)), date, start: target.start, end: target.end, fixed: false, source: "orion" }];
  const byId = new Map(blocks.map((b) => [b.id, b]));
  refuseIfBroken(projectDay(blocks, { moves: [], created, removed: [target] }), nowMinute, "renaming it");
  if (!dry) await applyPlan({ date, moves: [], created, removed: [target], blocksById: byId }).catch((e) => fail(`orion-reschedule: ${e.message}`, 1));
  console.log(`${dry ? "Would change" : "Changed"} ${dayName} ${date}:\n  ${target.title} ${hhmm(target.start)}–${hhmm(target.end)} is now "${clean(to)}" (same time)`);
  if (!dry) console.log('Written to his calendar. "orion-reschedule undo" puts it back.');
  process.exit(0);
} else if (command === "day" && args.includes("--todos")) {
  // "Plan my day from my to-do list" (2026-10-01): read the list itself, one
  // block per to-do with its real title. ORION used to paste the list into --say,
  // where "review CS lect 2" became 2 PM, four to-dos became one block, the rest
  // were dropped, and Hairspray came along from Groceries.
  const reminders = await bridge("list_incomplete_reminders", { list: config.todoList })
    .then((r) => JSON.parse(r.reminders_json ?? "[]")).catch((e) => fail(`orion-reschedule: could not read ${config.todoList}: ${e.message}`, 1));
  const onCalendar = blocks.filter((b) => b.end > nowMinute);
  const skipped = [];
  for (const r of reminders) {
    const title = clean(r.title ?? "");
    if (!title) continue;
    const dueDate = r.due ? localDate(new Date(r.due)) : null;
    if (dueDate && dueDate > date) { skipped.push(`${title} (due ${dueDate})`); continue; }
    // A to-do with a spread in its notes is orion-tasks's to plan, session by session.
    const blocker = waitsFor(r.notes, reminders.filter((x) => x !== r).map((x) => clean(x.title ?? "")));
    if (blocker) { skipped.push(`${title} (waits until "${blocker}" is done)`); continue; }
    if (parseSpread(parseTaskNotes(r.notes).spread)) { skipped.push(`${title} (spread across days by orion-tasks)`); continue; }
    if (onCalendar.some((b) => sameThingEarly(title, b.title))) { skipped.push(`${title} (already on the calendar)`); continue; }
    let estimate = { minutes: 45, optional: false };
    // A length in the to-do itself wins ("do 20 minutes of marketing work" is 20, not 45).
    const stated = minutesIn(title);
    if (stated) estimate = { ...estimate, minutes: stated };
    try {
      const tasks = parseTodos(title, { now: { date, minute: nowMinute } }).tasks;
      estimate = { minutes: stated ?? (tasks.length === 1 ? tasks[0].minutes : 45), optional: tasks.some((t) => t.optional) };
    } catch { /* keep the default */ }
    // A to-do is work he does, never a class or a deadline ("DS lab" is homework).
    const todoKind = ["class", "deadline"].includes(classify(title)) ? "study" : classify(title);
    add.push({ title, kind: todoKind, minutes: estimate.minutes,
      importance: estimate.optional ? 2 : dueDate && dueDate <= date ? 0 : 1, fixed: false });
  }
  // Keep time genuinely free (config.freeMinutesKept), as fill does: due first,
  // then his list order; what does not fit is named, not crammed in.
  const home = homeFrom(blocks, { commuteMinutes: config.commuteMinutes, wake: wakeMinute });
  let budget = freeGaps(blocks, { start: Math.max(home, nowMinute, window.start), end: window.end }, { minimum: 15 })
    .reduce((sum, g) => sum + g.end - g.start, 0) - config.freeMinutesKept;
  const ordered = [...add].sort((a, b) => a.importance - b.importance);
  const kept = []; const noRoom = [];
  for (const item of ordered) { if (item.minutes <= budget) { kept.push(item); budget -= item.minutes; } else noRoom.push(item.title); }
  add = kept;   // overdue and due-today first, so they get the earliest time
  if (noRoom.length) skipped.push(...noRoom.map((t) => `${t} (no room today)`));
  if (!add.length && !planArgs.length) { console.log(`NOTHING TO PLAN: no open to-do fits on ${dayName}${skipped.length ? ` (left out: ${skipped.join(", ")})` : ""}.`); process.exit(0); }
  if (skipped.length) console.log(`Left out: ${skipped.join(", ")}.`);
} else if (command === "day") {
  if (!planArgs.length && !said.length && !args.includes("--fill")) fail('usage: orion-reschedule day --say "<his words>" [--fill] [--replace]  (or --plan "<title>, <min>, HH:MM, fixed" …)');
  for (const p of said.filter((item) => item.date === date)) {
    const title = clean(p.title);
    const fixed = p.fixed && p.start !== null;
    add.push({ title, kind: classify(title), minutes: p.minutes, importance: p.importance,
      ...(p.start !== null ? { at: p.start } : {}), fixed });
  }

} else if (command === "drop") {
  if (!rest.length && !flag("--after")) fail('usage: orion-reschedule drop "<title>" ["<title>" …] | drop --after "<title>"');
} else if (command === "tidy") {
  // "Fix my schedule": nothing added; the day rules applied to the day as it is
  // (overlaps separated, ORION's blocks spaced out, free time kept).
} else if (command === "clear") {
  // The generic calendar-delete action is deliberately approval-gated. This is
  // different: it only removes the day's future movable planning blocks, records
  // every event for undo, and never touches classes, deadlines or plans with people.
} else if (command === "fill") {
  const deadlines = await bridge("list_deadlines", {}).then((r) => JSON.parse(r.events_json ?? "[]")).catch(() => []);
  const dayMs = 86400000; const base = new Date(`${date}T00:00:00`).getTime();
  const soon = deadlines.filter((e) => /quiz|exam|test|due|submission/i.test(e.title))
    .map((e) => ({ title: e.title.replace(/^DUE \d\d:\d\d — /, ""), daysAway: Math.floor((new Date(e.start).getTime() - base) / dayMs) }));
  const weekday = ((new Date(`${date}T12:00:00`).getDay() + 6) % 7) + 1;
  add.push(...sensible(fillDay(blocks, { now: nowMinute, window, weekday, config, deadlines: soon, studyPlan: studyPlanFor(deadlines) })));
  if (!add.length) { console.log("Nothing to add: the day already has what it needs, and the rest stays free."); process.exit(0); }
} else if (command === "early") {
  const modeArg = rest[0];
  const nowFlag = minute(flag("--now"));
  const checkMode = args.includes("--check");

  // Resolve "now": --now flag, or ORION_RESCHEDULE_NOW env, or real clock
  let effectiveNow;
  if (nowFlag !== null) {
    effectiveNow = nowFlag;
  } else {
    effectiveNow = today ? nowMinute : 0;
  }

  // --check: print context JSON and exit
  if (checkMode) {
    const ctx = earlyContext(blocks, { now: effectiveNow, commuteMinutes: config.commuteMinutes });
    console.log(JSON.stringify(ctx));
    process.exit(0);
  }

  // Determine mode
  let mode;
  if (modeArg) {
    if (!["block", "out-of-class"].includes(modeArg)) {
      fail(`usage: orion-reschedule early [block|out-of-class]`, 2);
    }
    mode = modeArg;
  } else {
    // No mode given: infer from context
    const ctx = earlyContext(blocks, { now: effectiveNow, commuteMinutes: config.commuteMinutes });
    if (ctx.kind === "after-class") {
      mode = "out-of-class";
    } else if (ctx.kind === "block") {
      mode = "block";
    } else {
      console.log("Nothing is under way to finish.");
      process.exit(1);
    }
  }

  // Call finishEarly
  // Finished something early (not just class): the freed time goes to a break if
  // he has just worked an hour or more, then to whatever later is short of time,
  // and the rest pulls the day forward (2026-10-06).
  const underWay = mode === "block" ? blocks.find((b) => !b.fixed && b.start <= effectiveNow && b.end > effectiveNow) : null;
  const breakSlot = underWay ? breakFor({ day: blocks, finished: underWay, now: effectiveNow, freed: underWay.end - effectiveNow }) : null;
  const breakBlock = breakSlot ? { id: "early-break", title: "Break", kind: "rest", date, ...breakSlot, fixed: true, source: "orion" } : null;
  let plan;
  try {
    plan = finishEarly(breakBlock ? [...blocks, breakBlock] : blocks, { now: effectiveNow, mode, commuteMinutes: config.commuteMinutes, buffer: config.bufferMinutes, dayEnd: window.end });
  } catch (e) {
    fail(`orion-reschedule: ${e.message}`, 1);
  }

  // Build moves for applyPlan
  const moves = plan.moves.map((m) => ({ id: m.id, title: m.title, from: m.from, to: m.to }));
  const shortened = plan.shortened;

  // Build dayWithClip for judging: blocks with clipped class end set to now, and shortened block end set to now
  let dayWithClip = [...blocks];
  if (plan.clipped) {
    dayWithClip = dayWithClip.map((b) => b.id === plan.clipped.id ? { ...b, end: effectiveNow } : b);
  }
  if (shortened) {
    dayWithClip = dayWithClip.map((b) => b.id === shortened.id ? { ...b, end: effectiveNow } : b);
  }

  // Add the shortened block as a move if it exists
  if (shortened) {
    moves.push({ id: shortened.id, title: shortened.title, from: blocks.find((b) => b.id === shortened.id).start, to: blocks.find((b) => b.id === shortened.id).start, toEnd: effectiveNow });
  }

  // Persist the actual class end, not just the in-memory planning clip.
  if (plan.clipped) {
    const cls = blocks.find(b => b.id === plan.clipped.id);
    moves.push({ id: cls.id, title: cls.title, from: cls.start, to: cls.start, toEnd: effectiveNow });
  }
  // Time still free after the break: give it to something that was short.
  const created = breakBlock ? [{ ...breakBlock, fixed: false }] : [];
  let gave = null;
  if (underWay) {
    const freedLeft = underWay.end - effectiveNow - (breakBlock ? breakBlock.end - breakBlock.start : 0);
    const projected = [...projectDay(dayWithClip, { moves }).filter((b) => b.id !== "early-break"), ...(breakBlock ? [breakBlock] : [])];
    const short = freedLeft >= 10 ? shortBlock(projected, { now: effectiveNow, minimums: config.minimums }) : null;
    if (short) {
      const ext = extendWithin(projected, short.block, Math.min(short.deficit, freedLeft), { buffer: config.bufferMinutes, dayEnd: window.end });
      if (ext.by > 0) {
        gave = { title: short.block.title, by: ext.by };
        for (const b of ext.day) {
          const was = projected.find((x) => x.id === b.id);
          if (!was || b.id === "early-break" || (was.start === b.start && was.end === b.end)) continue;
          const original = blocks.find((x) => x.id === b.id);
          const i = moves.findIndex((m) => m.id === b.id);
          const move = { id: b.id, title: b.title, from: original.start, to: b.start, ...(b.end - b.start !== original.end - original.start ? { toEnd: b.end } : {}) };
          if (i >= 0) moves[i] = move; else moves.push(move);
        }
      }
    }
  }

  // Judge first
  refuseIfBroken(projectDay(dayWithClip, { moves, created }), effectiveNow, "finishing early");

  if (!dry) {
    const byId = new Map(blocks.map((b) => [b.id, b]));
    await applyPlan({ date, moves, created, removed: [], blocksById: byId }).catch((e) => fail(`orion-reschedule: ${e.message}`, 1));
    await verifyWritten(date, effectiveNow);
  }

  // Output
  console.log(`${dry ? "Would change" : "Changed"} ${dayName} ${date}:`);
  if (plan.clipped) console.log(`  left ${plan.clipped.title} at ${hhmm(effectiveNow)}; class shortened`);
  if (shortened) {
    console.log(`  finished ${shortened.title} at ${hhmm(effectiveNow)}`);
  }
  if (breakBlock) console.log(`  added a break ${hhmm(breakBlock.start)}–${hhmm(breakBlock.end)} (he had worked ${effectiveNow - underWay.start} min)`);
  if (gave) console.log(`  gave ${gave.title} ${gave.by} more min (it was short of time)`);
  const realMoves = moves.filter((m) => !shortened || m.id !== shortened.id);
  for (const m of realMoves) {
    if (m.to !== m.from) console.log(`  moved ${m.title}: ${hhmm(m.from)} → ${hhmm(m.to)}`);
  }
  if (!realMoves.some((m) => m.to !== m.from)) {
    console.log("  nothing else had to move");
  }
  if (!dry) console.log('Written to his calendar. "orion-reschedule undo" puts it back.');
  process.exit(0);
} else {
  fail("usage: orion-reschedule late|busy|overrun|now|extend|resize|move|swap|skip|rename|early|add|day|drop|tidy|clear|fill|undo  (see the header)");
}

if (command === "day") {
  for (const raw of planArgs) {
    // Commas, not "|": ORION's exec router reads a pipe as a shell operator and refuses the call.
    const parts = raw.split(",").map((x) => x.trim()).filter(Boolean);
    const fx = parts.some((p) => /^fixed$/i.test(p)) ? "fixed" : "";
    const importance = parts.some((p) => /^(must|high|important)$/i.test(p)) ? 0
      : parts.some((p) => /^(optional|low)$/i.test(p)) ? 2 : args.includes("--todos") ? 0 : 1;
    const at = parts.find((p) => /^\d{1,2}:\d{2}$/.test(p)) ?? null;
    const m = (parts.find((p, i) => i > 0 && /^\d+\s*(min(ute)?s?)?$/i.test(p)) ?? "").replace(/\D/g, "");
    const t = parts[0];
    const title = clean(t ?? ""); const n = Number(m); const when = minute(at);
    if (!title || !Number.isInteger(n) || n < 5 || n > 720) fail(`bad --plan "${raw}" (want "<title>, <minutes>, HH:MM, fixed")`);
    // Nick's rule: plans with people (and classes) stay put; what he does alone can move,
    // even if the caller said "fixed" (a scenario run pinned "clean" over his meal prep).
    const fixed = isSocial(title) || (fx === "fixed" && !movableTitle(title));
    if (fixed && when === null) fail(`"${title}" is a fixed plan and needs a time`);
    add.push({ title, kind: classify(title), minutes: n, importance, ...(when !== null ? { at: when } : {}), fixed });
  }
}

// A time already over today is never booked: it almost always means he was
// talking about another day, and ORION forgot --date.
/*
 A plan for something that already happened today, or at a time already gone, is
 never booked somewhere else on its own (2026-10-01: "DS lab, 120, 13:00" at
 14:22 became a SECOND DS lab at 17:25). Say what to use instead.
*/
if (today && (command === "day" || command === "add") && !args.includes("--again")) {
  for (const item of add) {
    const earlier = blocks.find((b) => b.start < nowMinute && sameThingEarly(item.title, b.title) && sameThingEarly(b.title, item.title));
    const startsPast = Number.isInteger(item.at) && item.at < nowMinute && item.at + item.minutes > nowMinute;
    if (earlier && (startsPast || earlier.end <= nowMinute)) {
      console.log(`NOTHING WAS CHANGED: ${earlier.title} is already on today's calendar (${hhmm(earlier.start)}–${hhmm(earlier.end)}). If it is running long: orion-reschedule extend "${earlier.title}" --until HH:MM. If he wants a second session later, add --again.`);
      process.exit(1);
    }
    if (startsPast) {
      console.log(`NOTHING WAS CHANGED: ${item.title} at ${hhmm(item.at)} has already started (it is ${hhmm(nowMinute)}). If he is doing it now: orion-reschedule now "${item.title}, ${item.at + item.minutes - nowMinute}". Never re-run with a later time he did not say.`);
      process.exit(1);
    }
  }
}
// His minimums ("naps at least 75 minutes, always": orion-life min nap 75).
const raised = [];
add = withMinimums(add, config.minimums).map((item) => { if (item.raisedFrom) raised.push(`${item.title} ${item.raisedFrom} → ${item.minutes} min (his minimum)`); return item; });
const alreadyOver = add.filter((item) => today && Number.isInteger(item.at) && item.at + item.minutes <= nowMinute);
add = add.filter((item) => !alreadyOver.includes(item));
if (alreadyOver.length && !add.length && !["drop", "clear", "fill"].includes(command)) {
  console.log(`NOTHING WAS BOOKED: ${alreadyOver.map((item) => `${item.title} at ${hhmm(item.at)}`).join(", ")} ${alreadyOver.length === 1 ? "is" : "are"} already over today (${dayName} ${date}). If he meant another day, run again with --date YYYY-MM-DD.`);
  process.exit(1);
}
// "gym after soccer", "resume work before soccer": the anchor is another plan he
// named or something already on the calendar (2026-09-30: gym landed at 1 PM).
const stem = (w) => w.toLowerCase().replace(/[^a-z0-9]/g, "").slice(0, 5);
const words = (t) => clean(t).split(/\s+/).map(stem).filter((w) => w.length >= 3);
const sameThing = (a, b) => { const x = words(a), y = words(b); return x.length > 0 && x.every((w) => y.includes(w)); };
if (command === "day" || command === "add") {
  let lastEnd = null;
  add = add.map((item) => {
    let next = { ...item };
    const rel = /^(.*?)\s+(after|before)\s+(.+)$/i.exec(item.title);
    if (rel) {
      const anchorName = rel[3];
      const anchor = [...blocks.map((b) => ({ title: b.title, start: b.start, end: b.end })),
        ...add.filter((a) => Number.isInteger(a.at)).map((a) => ({ title: a.title, start: a.at, end: a.at + a.minutes }))]
        .find((x) => sameThing(anchorName, x.title));
      if (anchor) {
        const title = clean(rel[1]);
        next = { ...next, title, kind: classify(title),
          ...(rel[2].toLowerCase() === "after" ? { after: anchor.end } : { before: anchor.start }) };
      }
    }
    // Untimed plans follow the timed one he listed before them.
    // …and keep following it, so "after soccer dinner and gym" stays dinner, then gym.
    if (!Number.isInteger(next.at) && !Number.isInteger(next.after) && lastEnd !== null) next = { ...next, after: lastEnd, sequence: true };
    else if (Number.isInteger(next.at)) lastEnd = next.at + next.minutes;
    else if (rel && Number.isInteger(next.after)) lastEnd = next.after;
    if (Number.isInteger(next.at)) lastEnd = next.at + next.minutes;
    else if (Number.isInteger(next.after)) lastEnd = next.after + next.minutes;
    return next;
  });
}
const droppable = (list, from) => list.filter((block) => block.end > from && (!block.fixed || block.pinned) && block.kind !== "class" && block.kind !== "deadline"
  && rest.some((name) => sameThing(name, block.title)));
if (command === "day" || command === "add") add = sensible(add);
// "Delete everything after finishing the resume": every planned block that
// starts after that one ends (classes and plans with people stay), 2026-10-06.
const afterAnchor = command === "drop" && flag("--after")
  ? (blocks.filter((b) => sameThingEarly(flag("--after"), b.title)).sort((a, b) => a.start - b.start)[0]
    ?? fail(`NOTHING WAS DROPPED: no block called "${flag("--after")}" on ${dayName}`, 1))
  : null;
let dropped = command === "drop"
  ? (afterAnchor
    ? blocks.filter((b) => b.start >= afterAnchor.end && (!b.fixed || b.pinned) && b.kind !== "class" && b.kind !== "deadline")
    : droppable(blocks, nowMinute))
  : [];
// "get rid of the resume work tomorrow" arrived twice without --date (2026-09-30
// eval). With no date given and nothing today, look at tomorrow before refusing.
if (command === "drop" && !dropped.length && !flag("--date")) {
  const next = new Date(nowDate.getTime() + 86400000);
  const tomorrowBlocks = toBlocks(events, localDate(next));
  const there = droppable(tomorrowBlocks, 0);
  if (there.length) {
    if (!dry) await applyPlan({ date: localDate(next), moves: [], created: [], removed: there, blocksById: new Map() })
      .catch((e) => fail(`orion-reschedule: ${e.message}`, 1));
    const tomorrowName = next.toLocaleDateString("en-US", { weekday: "long" });
    console.log(`Changed ${tomorrowName} ${localDate(next)} (nothing matched today, so tomorrow):`);
    console.log(`  cleared ${there.length} prior schedule block${there.length === 1 ? "" : "s"}: ${there.map((b) => b.title).join(", ")}`);
    console.log('Written to his calendar. "orion-reschedule undo" puts it back.');
    process.exit(0);
  }
}
if (command === "drop" && !dropped.length) {
  console.log(`NOTHING WAS DROPPED on ${dayName}: no movable block matches (a class or a plan with people? he is not going: use skip "<it>") ${rest.map((r) => `"${r}"`).join(", ")}. Movable blocks today: ${blocks.filter((b) => !b.fixed && b.end > nowMinute).map((b) => b.title).join(", ") || "none"}.`);
  process.exit(1);
}
const replaceDay = command === "day" && args.includes("--replace");
const clearMovable = command === "clear";
const normalizedTitle = (title) => clean(title).toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
// Repeating a fixed plan already at that exact time means "keep it", not
// "create another copy". This was the source of the duplicate soccer events.
const alreadyFixed = []; const keptIds = new Set();
add = add.filter((item) => {
  if (!item.fixed || !Number.isInteger(item.at)) return true;
  const same = blocks.find((block) => block.fixed
    && normalizedTitle(block.title) === normalizedTitle(item.title)
    && block.start === item.at && block.end === item.at + item.minutes);
  if (same) { alreadyFixed.push(item.title); keptIds.add(same.id); }
  return !same;
});
// Restating a block replaces the old copy ("Dinner" twice on the calendar, 2026-09-30).
const restated = (command === "day" || command === "add")
  ? blocks.filter((block) => (!block.fixed || block.pinned) && block.end > nowMinute && add.some((item) => sameThing(item.title, block.title) && sameThing(block.title, item.title)))
  : [];
let removed = replaceDay || clearMovable
  ? blocks.filter((block) => block.end > nowMinute
      && block.kind !== "class" && block.kind !== "deadline" && !keptIds.has(block.id)
      && (replaceDay || !block.fixed))
  : [...dropped, ...restated];
const removedIds = new Set(removed.map((block) => block.id));
const planningBlocks = blocks.filter((block) => !removedIds.has(block.id));

// Two fixed plans at the same time is his call, not ours: say so.
const fixedNew = add.filter((a) => a.fixed && Number.isInteger(a.at));
const clashes = fixedNew.flatMap((a, i) => [...fixedNew.slice(i + 1), ...planningBlocks.filter((b) => b.fixed)]
  .filter((b) => (b.at ?? b.start) < a.at + a.minutes && a.at < (b.at ?? b.start) + (b.minutes ?? (b.end - b.start)))
  .map((b) => `${a.title} overlaps ${b.title}`));
// Travel to and from campus is not free time (a nap landed at 12:30, the minute class ended).
// A guess, though: a time he states ("I get back at 2") is placed over it.
// Plans added in this same call count too (soccer + "dinner after soccer" in one message).
const soft = commuteWalls([...planningBlocks, ...add.filter((a) => a.fixed && Number.isInteger(a.at))
  .map((a) => ({ title: a.title, kind: a.kind, start: a.at, end: a.at + a.minutes, fixed: true }))], config);
// Lost time (running late, a class running over, something came up) slides what
// follows back in order; one block is never flung to the evening while the rest
// stay put (2026-09-30: internship apps 11:00 → 20:45 for a 20-minute overrun).
// Always lay the remaining day out as a cascade (2026-10-01): in time order,
// each block at its own time or just after the one before plus the gap, past
// anything fixed. Blocks with room keep their time; nothing is flung to a far gap
// (the incremental mode evicted one block at a time — dinner went to 22:33).
let rebuilt = !replaceDay;
const shrunkLines = [];
let result = replan(planningBlocks, { now: nowMinute, window, blocked, soft, add, rebuild: rebuilt , buffer: config.bufferMinutes, keepFree: config.freeMinutesKept });
// Normal changes are incremental. If that cannot fit something, retry the
// whole remaining movable day before bothering Nick: fixed commitments stay as
// walls, then must-haves, ordinary work and optional fillers are laid down.
if (command === "day" && !replaceDay && !rebuilt && result.unplaced.length) {
  rebuilt = true;
}
if (rebuilt) {
  // Lay the remaining movable day out again. Blocks already on their way out
  // (dropped, restated, replaced) stay out; anything that no longer fits is
  // removed and reported as NOT BOOKED, never left overlapping.
  const goneIds = new Set(removed.map((block) => block.id));
  const rebuildBlocks = blocks.filter((block) => !goneIds.has(block.id));
  result = replan(rebuildBlocks, { now: nowMinute, window, blocked, soft, add, rebuild: true , buffer: config.bufferMinutes, keepFree: config.freeMinutesKept });
  // The day overflows: low-priority blocks give up time before any is dropped.
  if (result.unplaced.length && config.autoShrink !== false) {
    const deficit = result.unplaced.reduce((sum, u) => sum + (u.minutes ?? 0) + config.bufferMinutes, 0);
    // Never a block already under way (it starts now or earlier).
    const plan = shrinkPlan(rebuildBlocks.filter((b) => b.start > nowMinute), deficit, { now: nowMinute + 1, minimums: config.minimums });
    if (plan.length) {
      const shrunkDay = applyShrink(rebuildBlocks, plan, { now: nowMinute });
      const second = replan(shrunkDay, { now: nowMinute, window, blocked, soft, add, rebuild: true, buffer: config.bufferMinutes, keepFree: config.freeMinutesKept });
      if (second.unplaced.length < result.unplaced.length) {
        result = { ...second, moves: lengthMoves(second, plan, shrunkDay) };
        shrunkLines.push(...plan.map((x) => `SHRUNK to fit: ${x.title} ${x.from} → ${x.to} min (low priority; tell him)`));
      }
    }
  }
  const byExistingId = new Map(rebuildBlocks.map((block) => [block.id, block]));
  removed = [...removed, ...result.unplaced.map((item) => byExistingId.get(item.id)).filter(Boolean)];
}
if (command === "day" && args.includes("--fill")) {
  // His plans are now in place; fill around them without moving any of them.
  const deadlines = await bridge("list_deadlines", {}).then((r) => JSON.parse(r.events_json ?? "[]")).catch(() => []);
  const base = new Date(`${date}T00:00:00`).getTime();
  const soon = deadlines.filter((e) => /quiz|exam|test|due|submission/i.test(e.title))
    .map((e) => ({ title: e.title.replace(/^DUE \d\d:\d\d — /, ""), daysAway: Math.floor((new Date(e.start).getTime() - base) / 86400000) }));
  const weekday = ((new Date(`${date}T12:00:00`).getDay() + 6) % 7) + 1;
  // Today's share of the study each deadline still needs (deadline-ramp).
  const asks = sensible(fillDay(result.blocks, { now: nowMinute, window, weekday, config, deadlines: soon, studyPlan: studyPlanFor(deadlines) }));
  const second = replan(result.blocks.map((b) => ({ ...b, id: `kept-${b.id}`, fixed: true })), { now: nowMinute, window, soft, add: asks , buffer: config.bufferMinutes, keepFree: config.freeMinutesKept });
  result = { ...result, created: [...result.created, ...second.created], unplaced: [...result.unplaced, ...second.unplaced] };
}
const byId = new Map(blocks.map((b) => [b.id, b]));
const lines = [
  ...(rebuilt ? ["rebuilt the remaining day from fixed commitments and must-haves first"] : []),
  ...(alreadyFixed.length ? [`kept already-scheduled fixed plan${alreadyFixed.length === 1 ? "" : "s"}: ${alreadyFixed.join(", ")}`] : []),
  ...(removed.length ? [`cleared ${removed.length} prior schedule block${removed.length === 1 ? "" : "s"}: ${removed.map((b) => b.title).join(", ")}`] : []),
  ...(replaceDay ? (() => { const gone = removed.filter((b) => !add.some((a) => sameThing(a.title, b.title) || sameThing(b.title, a.title)));
    return gone.length ? [`DROPPED (he did not mention them, so they are gone — tell him by name): ${gone.map((b) => b.title).join(", ")}`] : []; })() : []),
  ...shrunkLines, ...raised,
  ...result.moves.filter((m) => m.to !== m.from).map((m) => `moved ${m.title}: ${hhmm(m.from)} → ${hhmm(m.to)}`),
  ...alreadyOver.map((item) => `NOT BOOKED: ${item.title} at ${hhmm(item.at)} is already over today — if he meant another day, run again with --date YYYY-MM-DD`),
  ...(result.shifted ?? []).map((x) => `SHIFTED: ${x.title} could not go at ${hhmm(x.from)} (${x.because === "it was already past" ? "that time has passed" : `${x.because} is there`}) — booked ${hhmm(x.to)} instead; tell him`),
  ...result.created.map((c) => `${c.fixed ? "added (fixed)" : "planned"} ${c.title}: ${hhmm(c.start)}–${hhmm(c.end)}`),
  ...result.unplaced.map((u) => u.importance === 0
    ? `MUST-HAVE NOT BOOKED: ${u.title} (${u.minutes} min) did not fit on ${dayName}`
    : u.importance === 2
      ? `SKIPPED OPTIONAL: ${u.title} (${u.minutes} min) did not fit on ${dayName}`
      : `NOT BOOKED: ${u.title} (${u.minutes} min) did not fit on ${dayName} — ask whether to drop it or put it on another day (--date YYYY-MM-DD)`),
  ...clashes.map((c) => `CLASH: ${c} — ask him which one is right`),
];
if (!lines.length) { console.log("Nothing needed to move."); process.exit(0); }
const missingMustHaves = result.unplaced.filter((item) => item.importance === 0);
if (missingMustHaves.length) {
  console.log(`NOTHING WAS CHANGED: must-haves could not fit: ${missingMustHaves.map((item) => item.title).join(", ")}.`);
  for (const l of lines) console.log(`  ${l}`);
  process.exit(1);
}
refuseIfBroken(projectDay(blocks, { moves: result.moves, created: result.created, removed }), nowMinute, "this change");
if (!dry) await applyPlan({ date, moves: result.moves, created: result.created, removed, blocksById: byId, pinCreated: result.created.filter(c => add.some(a => a.title === c.title && Number.isInteger(a.at))).map(c => c.id) }).catch((e) => fail(`orion-reschedule: ${e.message}`, 1));
if (!dry) await verifyWritten(date, nowMinute);
// 2026-09-29: "could not fit side project today" came back and ORION told Nick
// it was booked for Wednesday. The headline now says what was and was not written.
for (const p of otherDays) lines.push(`NOT BOOKED: ${p.title} is on ${p.date} — run again with --date ${p.date} --say "${p.title}${p.start !== null ? ` at ${hhmm(p.start)}` : ""}"`);
if (said.length) lines.push(`(read from his words: ${said.map((p) => `${p.title} ${p.date}${p.start !== null ? ` ${hhmm(p.start)}` : ""} ${p.minutes} min${p.assumed.length ? ` [assumed ${p.assumed.join(", ")}]` : ""}`).join("; ")})`);
const written = removed.length + result.moves.length + result.created.length;
if (!written) console.log(`NOTHING WAS BOOKED on ${dayName} (${date}). Do not tell him anything was added or moved.`);
